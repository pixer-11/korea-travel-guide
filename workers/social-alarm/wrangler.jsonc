// wa-social-alarm — standalone on purpose: the site worker stays untouched, so
// a bug here can never take the site down. Deployed BY HAND with
// scripts/deploy-social-alarm.sh — there is no CI workflow for it, so a change
// here is not live just because it is on main (checked 2026-09-01: the
// deploy-social-alarm.yml this line used to name does not exist).
{
  "name": "wa-social-alarm",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  // workers.dev URL stays on for the guarded manual test endpoint (Cloudflare
  // offers no "run cron now" button). Unauthenticated visits only see the name.
  "workers_dev": true,
  // One tick every five minutes; worker.mjs's SCHEDULE decides what each tick
  // owes. Cloudflare's free plan allows 5 cron triggers PER ACCOUNT and counts
  // expressions, not firings, so this uses 1 and leaves 4.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
