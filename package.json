{
  "name": "korea-travel-guide",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Automated, legally-sourced Korea travel guide for international visitors.",
  "scripts": {
    "dev": "astro dev",
    "build": "node -e \"for(const d of ['.astro','node_modules/.astro'])require('fs').rmSync(d,{recursive:true,force:true})\" && astro build",
    "preview": "astro preview",
    "generate": "node scripts/generate.mjs",
    "generate:dummy": "cross-env DUMMY=1 node scripts/generate.mjs",
    "seed": "cross-env POSTS_PER_RUN=25 node scripts/generate.mjs",
    "seed:dummy": "cross-env DUMMY=1 POSTS_PER_RUN=25 node scripts/generate.mjs",
    "refresh": "node scripts/refresh.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^5.1.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/fluent-emoji-flat": "^1.2.5",
    "@iconify-json/ph": "^1.2.2",
    "astro-icon": "^1.1.5",
    "cross-env": "^10.1.0"
  }
}
