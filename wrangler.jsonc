{
  // Cloudflare Workers config — static Astro site (asset-first) + a small
  // worker for the non-asset endpoints (/preferences, /tg Telegram webhook).
  // Static requests never touch the worker; missing env vars only disable
  // the endpoints, never the site.
  "name": "korea-travel-guide",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.mjs",
  // OG image mirror (scripts/mirror-og-images.mjs). Uncomment ONLY after R2 is
  // enabled on the account and the bucket exists — a binding to a missing
  // bucket fails the whole deploy:
  // "r2_buckets": [{ "binding": "OG_IMAGES", "bucket_name": "wa-og-images" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve dist/404.html for unknown paths. Without this, Workers assets
    // answers a wrong URL with a ZERO-BYTE 404 — the custom page shipped on
    // 07-29 was built into every deploy and never shown to anyone.
    "not_found_handling": "404-page"
  }
}
