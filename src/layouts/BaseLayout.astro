---
// Self-hosted variable fonts (no CDN, no external requests).
import '@fontsource-variable/fraunces'; // display serif (라틴)
import '@fontsource-variable/inter'; // body sans
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterPopup from '../components/NewsletterPopup.astro';
import { SITE } from '../siteConfig';
import { getLangFromUrl, localeCodes, localizePath, stripLocale, useTranslations, type Lang } from '../i18n/utils';
import { fitsWidth } from '../lib/textWidth.mjs';

interface Props {
  title: string;
  description: string;
  // Accepted and ignored. Five callers pass it; the layout derives the locale
  // from the URL instead (getLangFromUrl below), which is the same answer and
  // cannot drift from the route. Declared so those callers type-check rather
  // than sitting on a permanent error — remove it only by removing the prop
  // from all five at once.
  lang?: Lang;
  image?: string;
  article?: boolean;
  jsonLd?: Record<string, unknown>;
  // Set on pages that have a translated version at every locale, so we emit
  // hreflang alternates. Leave false for English-only pages.
  localized?: boolean;
  // The locales this exact page actually exists in (for the language switcher's
  // path-preserving links). Defaults from `localized`: all 5 when true, English
  // only when false. A post passes just the languages it's been translated into,
  // so the switcher never offers a link to a page that would 404.
  localizedLangs?: Lang[];
  // Set on low-value pages (e.g. a one-off event that has already ended) to keep
  // the URL live but out of the index — avoids thin/outdated pages dragging the
  // young domain's overall quality. Recurring events stay indexed.
  noindex?: boolean;
  // Set on pages that carry their OWN inline email capture (itineraries,
  // when-to-go): two interrupts competing for the same signup measurably hurt
  // both, and the page-matched inline offer is the stronger of the two
  // (subscriber-growth research 2026-08-14).
  suppressPopup?: boolean;
}

const { title, description, image, article = false, jsonLd, localized = false, localizedLangs, noindex = false, suppressPopup = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Which locales the language switcher may link to WITHOUT preserving the path
// (falls back to that locale's homepage for the rest, which always exists).
const availableLangs: Lang[] = localizedLangs ?? (localized ? ['en', 'ko', 'ja', 'es', 'zh'] : ['en']);
const htmlLang = localeCodes[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
// hreflang alternates (localized pages only). x-default points to English.
const canonicalPath = stripLocale(Astro.url.pathname);
// Built from availableLangs, NOT from a hardcoded five. The list above already
// knows which translations exist; this block used to ignore it and advertise all
// five regardless, so a post translated into es and zh still told Google that
// /ko/ and /ja/ versions existed — and those URLs 404, because the route only
// builds a page per translation file that is actually on disk. One post trips it
// today; the four translation steps in publish.yml are continue-on-error, so any
// API hiccup makes the next one.
const alternates = localized
  ? availableLangs.map((l) => ({
      hreflang: localeCodes[l],
      href: new URL(localizePath(canonicalPath, l), Astro.site).toString(),
    }))
  : [];
// Share cards. 2,529 of 4,869 built pages had no og:image — every region hub,
// every when-to-go page, essentials, destinations, events, itineraries and the
// static pages — so they unfurled on KakaoTalk, LINE, X and Pinterest as a bare
// text link. A page-specific photo is still much better, and the components pass
// one where they have it; this guarantees the tag is never absent, which is the
// part that was costing distribution on exactly the page types the Pinterest and
// Instagram pipelines feed.
// Self-hosted share images: heroes mirrored to R2 serve from /og/<hash>.webp
// (scripts/mirror-og-images.mjs fills the table). An unmirrored hero keeps its
// original URL — the table starts empty and the fallback is the status quo,
// so the mirror can grow incrementally without ever breaking a page.
import ogMirror from '../../data/og-mirror.json';
const mirrored = (u: string) => (ogMirror as Record<string, string>)[u] ?? u;
const ogImage = new URL(mirrored(image || '/og-default.jpg'), Astro.site);
const siteName = SITE.name;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

// Sitewide entity graph — establishes the brand as a recognized entity,
// which 2026 AI search rewards with far higher citation/click rates.
const orgLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#org`,
      name: siteName,
      url: siteUrl,
      logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
      description: 'Editor-reviewed, AI-assisted travel guides for destinations around the world.',
      slogan: SITE.tagline,
      foundingDate: '2026',
      // Named topical expertise + a transparent editorial policy are the E-E-A-T
      // signals AI search rewards. Authorship: articles are credited to the
      // editor's PEN NAME (#editor below) — a real person writing under
      // "Pixer", disclosed as a pen name on /about. This replaced org-only
      // attribution on 2026-08-08; the old comment here forbade a *fabricated*
      // human byline, which a disclosed pen name is not.
      knowsAbout: [
        'Travel', 'Tourism', 'Travel destinations', 'Local food and restaurants',
        'Public transport', 'Visa requirements', 'Travel events and festivals',
      ],
      publishingPrinciples: `${siteUrl}/about`,
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#editor`,
      name: 'Pixer',
      url: `${siteUrl}/about`,
      description: 'Korean travel editor who has personally traveled countries across Asia, Europe, the Americas and Oceania, and keeps traveling. Pixer is a pen name, disclosed on the editorial policy page.',
      worksFor: { '@id': `${siteUrl}/#org` },
      knowsAbout: ['Travel', 'Southeast Asia', 'East Asia', 'Travel planning'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#site`,
      name: siteName,
      url: siteUrl,
      description: SITE.description,
      publisher: { '@id': `${siteUrl}/#org` },
      // Was hardcoded 'en' on all 4,400 localized pages, contradicting both
      // <html lang> and the hreflang block on the same page — a Korean page told
      // Google it was English (found 2026-08-06).
      inLanguage: localeCodes[lang],
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Pinterest domain verification (business account "wander atlas") — enables
        rich pins + attribution on every pin pointing at this site. */}
    <meta name="p:domain_verify" content="1431a0577ccfe0a5fe2da9ba3c582bc2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Every post hero lives on one of these two hosts; opening the connection
        during HTML parse saves the measured 150ms of DNS+TCP+TLS on the LCP
        image. Wikimedia also sends no Cache-Control, so this is paid often. */}
    <link rel="preconnect" href="https://upload.wikimedia.org" crossorigin />
    <link rel="preconnect" href="https://fastly.4sqi.net" crossorigin />
    {/* Per-language webfont, loaded ONLY on that language's pages — the Latin
        faces have no CJK glyphs. Pretendard ships a dynamic subset (downloads
        just the glyphs used); Google serves Noto with unicode-range subsets.
        Spanish stays on Inter. Matching CSS lives in global.css. */}
    {lang === 'ko' && (
      <>
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
        />
        {/* 제목용 명조 — Hahmlet(함렡). 1940년대 한국 '햄릿' 영화 포스터 레터링에서
            온 세리프라 라틴의 Fraunces 와 성격이 같다. 본문은 Pretendard(고딕) 유지:
            명조는 크게 쓸 때 아름답지만 작은 본문에서는 획이 뭉개진다. */}
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@600;700;800&display=swap"
        />
      </>
    )}
    {(lang === 'ja' || lang === 'zh') && (
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    )}
    {lang === 'ja' && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@600;700;800&display=swap"
      />
    )}
    {lang === 'zh' && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@600;700;800&display=swap"
      />
    )}
    {/* Width, not .length. A CJK glyph takes about twice the horizontal space of
        a Latin letter, so counting characters applied a Latin ruler to every
        language: 89% of Japanese titles, 95% of Korean and 68% of Chinese were
        over the real ceiling and near-certainly rewritten by Google — and a
        rewritten title is one we no longer control. Same number, 60, now means
        the same thing in every language. */}
    <title>{title.includes(siteName) ? title : (fitsWidth(`${title} · ${siteName}`, 60) ? `${title} · ${siteName}` : title)}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {localized && <link rel="alternate" hreflang="x-default" href={new URL(localizePath(canonicalPath, 'en'), Astro.site).toString()} />}
    <!-- Allow large image previews (required for Google Discover cards) -->
    <meta name="robots" content={noindex ? 'noindex, follow, max-image-preview:large' : 'max-image-preview:large'} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    {/* Dimensions let an unfurler reserve the card before the image loads; the
        fallback is a known 1200×630 and post heroes are rendered at that ratio. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter — explicit tags rather than relying on the OG fallback, so the
         large-image card renders reliably on X and in link unfurlers. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />

    <!-- Privacy-friendly analytics by Plausible (cookieless, no consent banner).
         Our `Affiliate click` custom events fire via window.plausible() below. -->
    <script is:inline async src="https://plausible.io/js/pa-8beY2XpeZiWKI7EzsoQ6f.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

    {/*
    Travelpayouts Drive (marker 553157) loaded here on every page and has been
         removed. Measured on a live venue page: 26 of the page's 38 requests went
         to emrld.ltd, and it pulled in doubleclick, googlesyndication, a
         third-party error collector, a duplicate Google Fonts copy of a font we
         already self-host, and a tracking cookie — while drawing nothing on the
         page itself.

         Removing it costs no revenue. Attribution does not depend on it:
         marker=754088 is written directly into the hotel, flight and tour links
         (15 places across the components), and the July dashboard attributes all
         94 clicks through those programs — Klook 32, Kiwi 31, Localrent 13,
         Yesim 7 — with nothing recorded against 553157.

         Worth revisiting if the site ever has the traffic for Drive's
         auto-monetization to matter; re-adding it is four lines.
    */}
  </head>
  <body>
    {/* First tabbable element on every page. Without it a keyboard user
        re-traverses the whole header on each navigation — and when the mobile
        menu bug made the header unreachable, there was no way past it at all. */}
    <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>
    <Header availableLangs={availableLangs} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!suppressPopup && <NewsletterPopup />}
    <script is:inline>
      // Outbound affiliate-click tracking. Fires to whatever analytics is present
      // (GA4/gtag, Plausible, or dataLayer) — a harmless no-op until one is added,
      // so we can measure which CTAs/widgets actually drive booking clicks.
      document.addEventListener('click', function (e) {
        var t = e.target;
        var a = t && t.closest && t.closest('a[rel~="sponsored"], a[href*="klook"], a[href*="hotellook"], a[href*="tp.media"], a[href*="tpx.lv"], a[href*="aviasales"]');
        if (!a) return;
        var label = (a.textContent || '').trim().slice(0, 60) || a.href;
        // WHICH widget, on WHICH page. The event used to carry only the
        // destination, and every hotel CTA on the site builds the identical
        // /go/klook link — so the 94 recorded clicks could not be traced to a
        // placement or a page type, which is half of why "clicks up, bookings
        // zero" stayed undiagnosable. Booking-side attribution is a separate
        // problem: it needs a partner-supported sub_id, and Travelpayouts'
        // short link drops the one we tried (verified 2026-08-06).
        var holder = a.closest && a.closest('[data-affiliate-placement]');
        var props = {
          url: a.href,
          placement: (holder && holder.getAttribute('data-affiliate-placement')) || 'inline',
          page: location.pathname,
          partner: /klook/.test(a.href) ? 'klook' : /hotellook/.test(a.href) ? 'hotellook' : 'other',
        };
        try {
          if (window.gtag) window.gtag('event', 'affiliate_click', { link_url: a.href, link_text: label, placement: props.placement, partner: props.partner });
          else if (window.plausible) window.plausible('Affiliate click', { props: props });
          (window.dataLayer = window.dataLayer || []).push({ event: 'affiliate_click', link_url: a.href, link_text: label, placement: props.placement, partner: props.partner });
        } catch (_) {}
      }, true);
    </script>
  </body>
</html>
