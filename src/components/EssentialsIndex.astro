---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Flag from './Flag.astro';
import Emoji from './Emoji.astro';
import Newsletter from './Newsletter.astro';
import { siteHref } from '../lib/urls.mjs';
import { pickOgPhoto } from '../lib/ogPhoto.mjs';
import { wikimediaThumb } from '../lib/wikimediaThumb.mjs';
import { COUNTRY_TIME, hubRegion, type HubRegion } from '../lib/countryTime';
import { COUNTRY_TZ } from '../lib/venue-tz.mjs';
import { bodyHash } from '../../scripts/lib/essentials-facts.mjs';
import essentialsFacts from '../../data/essentials-facts.json';
import countryPlugs from '../../data/country-plugs.json';
import countriesData from '../../data/countries.json';
import esimFacts from '../../data/esim-facts.json';
import { useTranslations, localizePath, localeCodes, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { essHubStrings } from '../i18n/essentials-hub-strings';

// Shared /essentials hub for en + /[lang]/essentials. Redesign 2026-09-30
// after the owner's "필수정보 허브 개선안": a hero with a country finder, a
// dark "30-second summary" panel per country, the six topics as cards with
// the question each answers, countries by region, tools, an FAQ, the
// newsletter.
//
// Everything country-shaped is generated from the essentials collection, so a
// country appears here the day its guide is published. The summary cells come
// from the same vetted cards the country page uses (data/essentials-facts.json,
// only while the English guide is unchanged — the country page's own rule),
// plus data/country-plugs.json and lib/countryTime for power and time. A cell
// with no data is left out, never guessed.
interface Props { lang: Lang }
const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const h = essHubStrings(lang);
const locale = localeCodes[lang];

const guides = await getCollection('essentials', ({ data }) => !data.draft);
const byName = new Map(countriesData.countries.map((c) => [c.name, c]));
const facts = (essentialsFacts as any).countries ?? {};
const plugs = (countryPlugs as any).countries ?? {};
const esim = new Set(Object.keys(esimFacts).filter((k) => !k.startsWith('_')));

const KO_PLUG_OK = new Set(['C', 'E', 'F']);
const rows = guides
  .map((g) => {
    const c: any = byName.get(g.data.country);
    if (!c) return null;
    const fe = facts[g.data.country];
    const fresh = !!fe && fe.srcHash === bodyHash(String(g.body ?? ''));
    const F: any = fresh ? (lang === 'en' ? fe.en : fe[lang]) : null;
    const visa0 = F?.visa?.cards?.[0];
    const card = (key: string) => F?.summary?.find((s: any) => s.key === key)
      // No vetted entry summary (Hong Kong's named an office the guide does not):
      // the first vetted visa card says the same thing in its own words.
      // …unless the guide has several per-nationality cards: then the country's
      // answer is "it depends", with the cards named (10-01, Hong Kong).
      ?? (key === 'entry' && (F?.visa?.cards?.length ?? 0) > 1 ? { title: h('byPassport'), sub: F.visa.cards.map((c: any) => c.name).join(' · ') } : null)
      ?? (key === 'entry' && visa0 ? { title: visa0.name, sub: [visa0.stay, visa0.cost].filter(Boolean).join(' · ') } : null);
    const nums = (F?.emergency?.numbers ?? []).slice(0, 2);
    const pw = plugs[g.data.country];
    // A country not in COUNTRY_TIME still gets its time cell when the venue
    // table (lib/venue-tz, which event pages need anyway) knows its zone.
    const time = COUNTRY_TIME[String(c.iso2).toUpperCase()]
      ?? ((COUNTRY_TZ as Record<string, string>)[g.data.country] ? { tz: (COUNTRY_TZ as Record<string, string>)[g.data.country], city: g.data.country, multi: false } : undefined);
    const cells = [
      { key: 'entry', label: h('cellEntry'), tone: 'leaf', title: card('entry')?.title, sub: card('entry')?.sub },
      { key: 'money', label: h('cellMoney'), title: card('money')?.title, sub: card('money')?.sub },
      pw && {
        key: 'plug', label: h('cellPlug'), title: h('plug', { v: pw.v, p: pw.plugs.join('·') }),
        // Korean sockets take C and F plugs; a Korean reader is told whether
        // those fit and whether 220 V-only kit needs a converter. Other
        // readers' home plugs differ, so they get the facts alone.
        sub: lang === 'ko'
          ? [pw.plugs.every((p: string) => KO_PLUG_OK.has(p)) ? '한국 플러그 그대로 사용 가능'
              : pw.plugs.some((p: string) => KO_PLUG_OK.has(p)) ? '꽂히는 곳이 많지만 어댑터 챙기기 권장'
              : '한국 기기는 어댑터(돼지코) 필요',
             Number(pw.v) < 200 ? '220V 전용 기기는 변압기 필요' : ''].filter(Boolean).join(' · ')
          : `${pw.hz} Hz`,
      },
      nums.length && { key: 'emergency', label: h('cellEmergency'), tone: 'peach', title: nums.map((n: any) => n.number).join(' · '), sub: nums.map((n: any) => n.label).join(' · ') },
      time && { key: 'time', label: h('cellTime'), tz: time.tz, multi: time.multi ? h('multi', { city: localizePlace(time.city, lang) }) : '' },
      { key: 'transport', label: h('cellTransit'), title: card('transport')?.title, sub: card('transport')?.sub },
    ].filter((x: any) => x && (x.title || x.tz));
    return {
      slug: g.id, name: g.data.country, iso2: c.iso2, priority: c.priority ?? 99, continent: c.continent,
      label: localizePlace(g.data.country, lang), reviewed: g.data.lastReviewed as Date,
      href: localizePath(`/essentials/${g.id}`, lang),
      esim: esim.has(g.id) ? localizePath(`/tools/esim/${g.id}`, lang) : '',
      cells,
    };
  })
  .filter(Boolean)
  .sort((a: any, b: any) => a.priority - b.priority || a.label.localeCompare(b.label)) as any[];

const n = rows.length;
// A Korean reader is not going to Korea: their jump list and default panel
// skip it. Every other language keeps it (it is a destination for them).
const destRows = lang === 'ko' ? rows.filter((r) => r.slug !== 'south-korea') : rows;
const quick = destRows.slice(0, 5);
const defaultSlug = (destRows.find((r) => r.cells.length >= 4) ?? destRows[0])?.slug;
const latest = rows.reduce((m, r) => (r.reviewed > m ? r.reviewed : m), new Date(0));
const latestLabel = latest.getTime() ? latest.toLocaleDateString(locale, { month: 'long', day: 'numeric' }) : '';

const REGION_ORDER: HubRegion[] = ['asia', 'europe', 'meca', 'africa', 'amoc'];
const REGION_LABEL: Record<HubRegion, string> = { asia: h('rAsia'), europe: h('rEurope'), meca: h('rMeca'), africa: h('rAfrica'), amoc: h('rAmOc') };
const collator = new Intl.Collator(locale);
const regions = REGION_ORDER
  .map((key) => ({ key, label: REGION_LABEL[key], list: rows.filter((r) => hubRegion(r.continent, r.iso2) === key).sort((a, b) => collator.compare(a.label, b.label)) }))
  .filter((g) => g.list.length);

// Hero photo: the best-rated real place photo among these countries' guides
// (pickOgPhoto keeps the 1200px floor), shown with its credit.
const names = new Set(rows.map((r) => r.name));
const placePosts = (await getCollection('posts', ({ data }) => !data.draft && data.category !== 'event' && names.has(data.country ?? 'South Korea')))
  .sort((a, b) => ((b.data.place?.rating ?? 0) * Math.log10((b.data.place?.userRatingsTotal ?? 0) + 10)) - ((a.data.place?.rating ?? 0) * Math.log10((a.data.place?.userRatingsTotal ?? 0) + 10)));
const ogPhoto = pickOgPhoto(placePosts);
const heroPost = ogPhoto ? placePosts.find((p) => p.data.heroImage?.url === ogPhoto) : null;
const hero = heroPost?.data.heroImage ?? null;
const heroSrc = hero ? wikimediaThumb(hero.url, 960) : null;
const heroFocus = hero?.focus ? `${hero.focus.x ?? 50}% ${hero.focus.y ?? 50}%` : '50% 50%';

const ICON: Record<string, string> = {
  visa: 'M9 12.5l2 2 4-4M7 3h7l5 5v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z',
  transport: 'M9 4L3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14',
  luggage: 'M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M6 7h12a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1zM9 7v13M15 7v13',
  money: 'M4 7h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7zm0 0l1.5-3H17M16 13.5h.01',
  season: 'M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z',
  emergency: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z',
  entry: 'M9 12.5l2 2 4-4M7 3h7l5 5v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z',
  plug: 'M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0V8zM12 17v4',
  time: 'M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z',
};
// icon: the registry name (src/data/icons-line.json) the topic uses elsewhere;
// scripts/essentials-topics-registered.test.mjs checks every topic has one.
const topics = [
  { key: 'visa', icon: 'passport-control', href: '/essentials/visa', name: t('ess.visa'), dek: t('ess.visaDek'), q: h('qVisa'), tone: 'brown' },
  { key: 'transport', icon: 'metro', href: '/essentials/transport', name: t('ess.transport'), dek: t('ess.transportDek'), q: h('qTransport') },
  { key: 'luggage', icon: 'luggage', href: '/essentials/luggage-storage', name: t('ess.luggage'), dek: t('ess.luggageDek'), q: h('qLuggage') },
  { key: 'money', icon: 'credit-card', href: '/essentials/money', name: t('ess.money'), dek: t('ess.moneyDek'), q: h('qMoney'), tone: 'forest' },
  { key: 'season', icon: 'cherry-blossom', href: '/essentials/best-time-to-visit', name: t('ess.bestTime'), dek: t('ess.bestTimeDek'), q: h('qSeason') },
  { key: 'emergency', icon: 'police-car-light', href: '/essentials/emergency', name: t('ess.emergency'), dek: t('ess.emergencyDek'), q: h('qEmergency'), tone: 'peach' },
];
const tools = [
  { href: '/tools/whats-closed', name: h('tClosed'), dek: h('tClosedDek') },
  { href: '/tools/when-to-go', name: h('tWhen'), dek: h('tWhenDek') },
  { href: '/tools/esim', name: h('tEsim'), dek: h('tEsimDek') },
  { href: '/free/trip-checklist', name: h('tChecklist'), dek: h('tChecklistDek') },
];
const faq = [1, 2, 3, 4, 5].map((i) => ({ q: h(`faq${i}q` as any), a: h(`faq${i}a` as any) }));

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteHref(Astro.url.pathname, Astro.site);
const title = h('seoTitle');
const description = h('dek');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: title, description, url: pageUrl, isPartOf: { '@id': `${site}/#site` } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.home'), item: siteHref(localizePath('/', lang), Astro.site) },
      { '@type': 'ListItem', position: 2, name: t('home.travelEssentials'), item: pageUrl },
    ] },
    { '@type': 'ItemList', itemListElement: rows.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: siteHref(r.href, Astro.site), name: r.label })) },
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} localized={true} image={ogPhoto ?? undefined}>
  <div class="exh" data-exh data-ahead={h('ahead')} data-behind={h('behind')} data-same={h('same')} data-now={h('timeNow')}>
    <section class="exh-hero">
      <div class="wrap exh-hero-grid">
        <div>
          <nav class="exh-crumbs" aria-label={t('a11y.breadcrumb')}><a href={localizePath('/', lang)}>{t('post.home')}</a><span aria-hidden="true">·</span><span>{t('home.travelEssentials')}</span></nav>
          <p class="exh-badge">{h('badge', { n })}</p>
          <h1 class="exh-h1">{h('h1a')}<span>{h('h1b')}</span></h1>
          <p class="exh-dek">{h('dek')}</p>
          <div class="exh-search" data-exh-search>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.3-4.3"/></svg>
            <input type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="exh-suggest" aria-label={h('searchLabel')} placeholder={h('searchPh', { ex: quick.slice(0, 2).map((r) => r.label).join(', ') })} autocomplete="off" data-exh-q />
            <ul class="exh-suggest" id="exh-suggest" data-exh-suggest hidden>
              {rows.map((r) => (
                <li><button type="button" data-exh-go={r.slug} data-search={`${r.label} ${r.name}${r.slug === 'south-korea' ? ' 한국 korea' : ''}`.toLowerCase()}><Flag code={r.iso2} size="1.1em" class="flag-ico" /> {r.label}</button></li>
              ))}
            </ul>
          </div>
          <p class="exh-quick"><span>{h('quick')}</span>{quick.map((r) => <button type="button" data-exh-pick={r.slug}>{r.label}</button>)}</p>
        </div>
        {heroSrc && (
          <figure class="exh-photo">
            <img src={heroSrc} alt="" width="960" height="1100" style={`object-position:${heroFocus}`} fetchpriority="high" />
            {hero?.source && <a class="exh-credit" href={hero.source} rel="nofollow noopener" target="_blank" title={hero.credit ?? ''}>{t('ess.photoBy')}</a>}
            {latestLabel && (
              <figcaption class="exh-reviewed">
                <span class="exh-check" aria-hidden="true">✓</span>
                <span><strong>{h('reviewed', { date: latestLabel })}</strong><small>{h('reviewedSub')}</small></span>
              </figcaption>
            )}
          </figure>
        )}
      </div>
    </section>

    <section class="section exh-summary-sec" id="summary">
      <div class="wrap">
        <div class="exh-summary">
          <p class="exh-kicker">{h('panelKicker')}</p>
          <div class="exh-tabs" role="tablist" aria-label={h('searchLabel')}>
            {destRows.map((r) => (
              <button type="button" role="tab" id={`exh-tab-${r.slug}`} aria-controls={`exh-panel-${r.slug}`} aria-selected={r.slug === defaultSlug ? 'true' : 'false'} tabindex={r.slug === defaultSlug ? 0 : -1} data-exh-tab={r.slug}>{r.label}</button>
            ))}
          </div>
          {destRows.map((r) => (
            <div class="exh-panel" role="tabpanel" id={`exh-panel-${r.slug}`} aria-labelledby={`exh-tab-${r.slug}`} data-exh-panel={r.slug} hidden={r.slug !== defaultSlug}>
              <h2 class="exh-panel-title"><Flag code={r.iso2} size="0.9em" class="flag-ico" /> {h('panelTitle', { c: r.label })}</h2>
              {r.cells.length > 0 && (
                <div class="exh-cells">
                  {r.cells.map((c: any) => (
                    <div class:list={['exh-cell', c.tone && `exh-cell--${c.tone}`]} data-tz={c.tz}>
                      <span class="exh-cell-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d={ICON[c.key] ?? ICON.entry} /></svg></span>
                      <span class="exh-cell-body">
                        <small>{c.label}</small>
                        {c.tz
                          ? (<><strong data-exh-diff>—</strong><span data-exh-now>{c.multi}</span></>)
                          : (<><strong>{c.title}</strong>{c.sub && <span>{c.sub}</span>}</>)}
                      </span>
                    </div>
                  ))}
                </div>
              )}
              <p class="exh-disclaimer">{h('disclaimer')}</p>
              <p class="exh-cta">
                {r.esim && <a class="exh-btn exh-btn--ghost" href={r.esim}>{h('ctaEsim', { c: r.label })}</a>}
                <a class="exh-btn" href={r.href}>{h('ctaAll', { c: r.label })}</a>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="exh-head"><h2 class="exh-h2">{h('topicsTitle')}</h2><span>{h('topicsSub', { n })}</span></div>
        <div class="exh-topics">
          {topics.map((tp) => (
            <a class:list={['exh-topic', tp.tone && `exh-topic--${tp.tone}`]} href={localizePath(tp.href, lang)}>
              <span class="exh-topic-top">
                <span class="exh-topic-ico" aria-hidden="true"><Emoji name={tp.icon} size="1.35rem" /></span>
                <span aria-hidden="true">→</span>
              </span>
              <strong>{tp.name}</strong>
              <span class="exh-topic-dek">{tp.dek}</span>
              <span class="exh-topic-q"><b>{h('answers')}</b> · {tp.q}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="exh-head"><h2 class="exh-h2">{h('countriesTitle')}</h2><span>{h('countriesSub', { n })}</span></div>
        <div class="exh-regions">
          {regions.map((g) => (
            <div class:list={['exh-region', { 'exh-region--wide': g.list.length > 6 }]}>
              <div class="exh-region-head"><h3>{g.label}</h3><span>{h('countN', { n: g.list.length })}</span></div>
              <ul>
                {g.list.map((r) => (
                  <li><a href={r.href}><Flag code={r.iso2} size="1.05em" class="flag-ico" /> {r.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section exh-tools-sec">
      <div class="wrap exh-tools">
        {tools.map((tl) => (
          <a class="exh-tool" href={localizePath(tl.href, lang)}>
            <small>{h('toolsKicker')}</small>
            <strong>{tl.name}</strong>
            <span>{tl.dek}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="wrap exh-faq-grid">
        <div>
          <h2 class="exh-h2">{h('faqTitle')}</h2>
          <p class="exh-faq-dek">{h('faqDek')}</p>
        </div>
        <div class="exh-faq">
          {faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<span aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>

  <Newsletter lang={lang} heading={h('nlHeading')} dek={h('nlDek')} />
</BaseLayout>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-exh]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-exh-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-exh-panel]')];
    const show = (slug: string, scroll = false) => {
      if (!panels.some((p) => p.dataset.exhPanel === slug)) {
        // Not in the summary (e.g. the reader's own country): go to its page.
        const go = root.querySelector<HTMLButtonElement>(`[data-exh-go="${slug}"]`);
        // Compared by path: the built link ends in "/" ("/essentials/south-korea/"),
        // and an ends-with selector without it matched nothing, so the Korean
        // hub's "대한민국" result went nowhere (Codex review, 10-01).
        const href = [...root.querySelectorAll<HTMLAnchorElement>('.exh-region a[href]')]
          .find((a) => new URL(a.href).pathname.replace(/\/$/, '').endsWith(`/essentials/${slug}`))?.href;
        if (go && href) location.href = href;
        return;
      }
      for (const t of tabs) { const on = t.dataset.exhTab === slug; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; }
      for (const p of panels) p.hidden = p.dataset.exhPanel !== slug;
      history.replaceState(null, '', `#c=${slug}`);
      if (scroll) root.querySelector('#summary')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    for (const t of tabs) t.addEventListener('click', () => show(t.dataset.exhTab!));
    root.querySelector('.exh-tabs')?.addEventListener('keydown', (ev: Event) => {
      const e = ev as KeyboardEvent;
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const i = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
      show(next.dataset.exhTab!); next.focus();
    });
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-exh-pick]')) b.addEventListener('click', () => show(b.dataset.exhPick!, true));

    // Country finder: filter as you type, Enter takes the first match.
    const q = root.querySelector<HTMLInputElement>('[data-exh-q]')!;
    const list = root.querySelector<HTMLElement>('[data-exh-suggest]')!;
    const opts = [...list.querySelectorAll<HTMLButtonElement>('[data-exh-go]')];
    const filter = () => {
      const v = q.value.trim().toLowerCase();
      let shown = 0;
      for (const o of opts) { const on = !v || o.dataset.search!.includes(v); o.parentElement!.hidden = !on; if (on) shown++; }
      list.hidden = shown === 0 || (document.activeElement !== q && !list.contains(document.activeElement));
      q.setAttribute('aria-expanded', String(!list.hidden));
    };
    const closeList = () => { list.hidden = true; q.setAttribute('aria-expanded', 'false'); };
    // Tabbing out of the finder closes it (it used to stay open over the panel).
    root.querySelector('[data-exh-search]')?.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (!next || !root.querySelector('[data-exh-search]')!.contains(next)) closeList();
    });
    q.addEventListener('input', filter);
    q.addEventListener('focus', filter);
    q.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); if (q.value.trim()) opts.find((o) => !o.parentElement!.hidden)?.click(); }
      if (e.key === 'Escape') closeList();
    });
    document.addEventListener('click', (e) => { if (!(e.target as Element).closest('[data-exh-search]')) closeList(); });
    for (const o of opts) o.addEventListener('click', () => { q.value = ''; closeList(); show(o.dataset.exhGo!, true); });

    // A shared link (#c=japan) opens on that country, as does a hash change on
    // this page (the back button, a pasted link).
    const fromHash = () => {
      const m = /(?:^|[#&])c=([a-z-]+)/.exec(location.hash);
      if (m && panels.some((p) => p.dataset.exhPanel === m[1])) show(m[1]);
    };
    fromHash();
    addEventListener('hashchange', fromHash);

    // Time cells, against the reader's own clock (DST included by Intl).
    const S = { ahead: root.dataset.ahead, behind: root.dataset.behind, same: root.dataset.same, now: root.dataset.now };
    const offsetMin = (tz: string, at: Date) => {
      const p = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone: tz, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }).formatToParts(at).map((x) => [x.type, x.value]));
      return (Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour, +p.minute) - Date.UTC(at.getUTCFullYear(), at.getUTCMonth(), at.getUTCDate(), at.getUTCHours(), at.getUTCMinutes())) / 60000;
    };
    const tick = () => {
      const now = new Date();
      const mine = -now.getTimezoneOffset();
      for (const cell of root.querySelectorAll<HTMLElement>('[data-tz]')) {
        const tz = cell.dataset.tz!;
        let there: number;
        try { there = offsetMin(tz, now); } catch { continue; }
        const d = (there - mine) / 60;
        // Quarter hours survive: Kathmandu → Tokyo is 3.25 h, not "3.3" (Codex review).
        const hrs = String(Math.round(Math.abs(d) * 100) / 100);
        const diff = cell.querySelector<HTMLElement>('[data-exh-diff]');
        const nowEl = cell.querySelector<HTMLElement>('[data-exh-now]');
        if (diff && S.ahead && S.behind && S.same) diff.textContent = d === 0 ? S.same : (d > 0 ? S.ahead : S.behind).replace('{h}', hrs);
        if (nowEl && S.now) {
          const clock = new Intl.DateTimeFormat(document.documentElement.lang || undefined, { timeZone: tz, hour: '2-digit', minute: '2-digit' }).format(now);
          const multi = nowEl.dataset.multi ?? (nowEl.dataset.multi = nowEl.textContent || '');
          nowEl.textContent = S.now.replace('{t}', clock) + (multi ? ` · ${multi}` : '');
        }
      }
    };
    tick();
    setInterval(tick, 60_000);
  }
</script>

