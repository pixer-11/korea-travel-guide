---
// 라인 아이콘(Lucide)을 인라인으로 그린다.
//
// 2026-08-08 까지는 Microsoft Fluent Emoji Flat(full-colour)을 썼다. OS 마다
// 모양이 달라지는 문제는 해결했지만 색이 제각각이라 편집 톤과 겉돌았고,
// 카드마다 다른 색 이모지가 시선을 흩뜨렸다. 라인 아이콘은 currentColor 를
// 따라가므로 어디에 놓든 그 자리의 글자색과 같은 무게로 읽힌다.
//
// 호출부는 그대로다 — <Emoji name="airplane" /> 처럼 예전 이름을 쓰면
// scripts/build-icon-data.mjs 의 MAP 이 Lucide 이름으로 옮겨준다. 새 아이콘을
// 추가할 때는 그 MAP 에 한 줄 넣고 스크립트를 다시 돌린다(전체 1,834개를
// 번들에 넣으면 Cloudflare 빌드가 메모리를 넘긴다).
//
// 아이콘 옆에는 항상 보이는 글자 라벨이 있다 → 장식 → aria-hidden.
import iconData from '../data/icons-line.json';

interface Props { name: string; size?: string | number; class?: string; stroke?: number }
const { name, size = '1em', class: cls, stroke = 2.1 } = Astro.props;

const key = name?.includes(':') ? name.split(':').pop()! : name;
const icons = iconData.icons as Record<string, { body: string; width?: number; height?: number }>;
const icon = icons[key];
const w = icon?.width ?? iconData.width ?? 24;
const h = icon?.height ?? iconData.height ?? 24;
---

{icon && (
  <svg
    width={size} height={size} viewBox={`0 0 ${w} ${h}`}
    class:list={['emoji', 'ico-line', cls]}
    fill="none" stroke="currentColor" stroke-width={stroke}
    stroke-linecap="round" stroke-linejoin="round"
    aria-hidden="true" set:html={icon.body}
  />
)}
