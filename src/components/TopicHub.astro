  .tph-hero { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 1.5rem; align-items: center; background: var(--tp-brown); color: var(--tp-on-dark); border-radius: 28px; padding: 2.4rem 2.2rem; }
  .tph-kicker { display: inline-block; margin: 0 0 1rem; padding: .25rem .7rem; border-radius: var(--r-pill); background: rgba(255, 255, 255, .12); font-size: .8rem; font-weight: 600; }
  .tph-hero h1 { font-family: var(--font-display); font-size: clamp(1.9rem, 4.6vw, 2.9rem); line-height: 1.15; letter-spacing: -0.02em; margin: 0; color: #fff; word-break: keep-all; overflow-wrap: anywhere; }
  .tph-hook { font-family: var(--font-display); font-size: clamp(1.3rem, 3vw, 1.9rem); font-weight: 800; line-height: 1.2; color: #f2b48a; margin: .35rem 0 1rem; word-break: keep-all; overflow-wrap: anywhere; }
  .tph-dek { margin: 0; line-height: 1.7; max-width: 38rem; opacity: .92; }
  .tph-checked { margin: 1rem 0 0; font-size: .85rem; font-weight: 600; opacity: .85; }
  .tph-hero-art { justify-self: end; width: min(15rem, 100%); aspect-ratio: 1; border-radius: 50%; background: rgba(255, 255, 255, .1); display: grid; place-items: center; font-size: clamp(4rem, 10vw, 7rem); }

  .tph-quick { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; align-items: start; margin: 1rem 0 0; padding: 1.3rem 1.5rem; border-radius: 22px; background: var(--tp-peach); }
  .tph-quick p { margin: 0; line-height: 1.75; color: var(--ink); }
  .tph-quick-label { padding: .2rem .65rem; border-radius: var(--r-pill); background: var(--tp-cream); font-size: .75rem; font-weight: 700; white-space: nowrap; }

  .tph-sec { margin-top: 2.6rem; }
  .tph-head { display: flex; align-items: flex-end; justify-content: space-between; gap: .6rem 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .tph-head h2, .tph-h2 { font-family: var(--font-display); font-size: clamp(1.35rem, 3.2vw, 1.75rem); font-weight: 800; margin: 0; color: var(--ink); letter-spacing: -0.01em; }
  .tph-h2 { margin-bottom: 1rem; }
  .tph-head .tph-h2 { margin-bottom: .2rem; }
  .tph-note { color: var(--muted); font-size: .88rem; margin: 0; }
  .tph-remember { color: var(--muted); font-size: .82rem; margin: .2rem 0 1rem; }

  .tph-chips { display: flex; flex-wrap: wrap; gap: .45rem; margin-bottom: .6rem; }
