  .tph-crumbs a { color: inherit; text-decoration: none; }
  .tph-crumbs a:hover { color: var(--accent-text); }
  .tph-here { color: var(--ink); font-weight: 700; }

  /* Flex, not six equal columns: "Emergencies & safety" was cut to "Emergency & sa…". */
  .tph-tabs { display: flex; gap: .5rem; margin-bottom: 1rem; overflow-x: auto; scrollbar-width: none; }
  .tph-tab { flex: 1 0 auto; display: flex; align-items: center; justify-content: center; gap: .4rem; padding: .7rem .6rem; border-radius: var(--r-pill); background: var(--tp-cream); border: 1px solid var(--line-soft, var(--line)); color: var(--ink); text-decoration: none; font-weight: 700; font-size: .9rem; min-width: 0; }
  .tph-tab span { white-space: nowrap; }
  .tph-tab:hover { border-color: var(--accent); }
