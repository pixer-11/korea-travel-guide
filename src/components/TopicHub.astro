    :global(:root:not([data-theme='light'])) .tph { --tp-brown: #4a2610; --tp-brown-2: #3d1f0d; --tp-peach: #3a2620; --tp-sand: #2a251d; --tp-cream: #221f19; --tp-leaf: #26301c; --tp-amber: #3a3020; --tp-red: #432720; }
  }
  :global(:root[data-theme='dark']) .tph { --tp-brown: #4a2610; --tp-brown-2: #3d1f0d; --tp-peach: #3a2620; --tp-sand: #2a251d; --tp-cream: #221f19; --tp-leaf: #26301c; --tp-amber: #3a3020; --tp-red: #432720; }

