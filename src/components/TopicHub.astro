---
import { getCollection, render } from 'astro:content';
import { siteHref } from '../lib/urls.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Flag from './Flag.astro';
import Emoji from './Emoji.astro';
import { useTranslations, localizePath, localeCodes, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { essTopicStrings, type EssTopicKey } from '../i18n/essentials-topic-strings';
import { essHubStrings } from '../i18n/essentials-hub-strings';
import { hubRegion, type HubRegion } from '../lib/countryTime';
import { bodyHash } from '../../scripts/lib/essentials-facts.mjs';
import essentialsFacts from '../../data/essentials-facts.json';
import countriesData from '../../data/countries.json';
import esimFacts from '../../data/esim-facts.json';
import seasonRegions from '../../data/season-regions.json';

// Shared essentials-topic page (visa / transport / luggage storage / money /
// best time / emergency) for the English route and /[lang]/essentials/<topic>.
//
// Redesign 2026-10-01 from the owner's "주제별 필수정보 개선안": topic tabs, a
// hero, the quick answer, an interactive picker (country, month or situation),
// the topic's own prose as numbered basics, a comparison table across every
// country, one call-to-action band, the FAQ, and the other five topics.
//
// Everything per country comes from the vetted cards in
// data/essentials-facts.json, used only while fresh against the guide's body
// (same rule as the country pages and the hub), in the page's language. A new
// country guide with vetted facts appears in every picker and table on the
// next build; a country without them is simply not listed. Nothing is
// hand-kept per country here.
interface Props { topic: any; translation: any; lang: Lang }
const { topic, translation, lang } = Astro.props;
const t = useTranslations(lang);
const s = essTopicStrings(lang);
const h = essHubStrings(lang);
const d = translation?.data ?? topic.data;
const locale = localeCodes[lang];
const entry = translation ?? topic;
await render(entry);

type K = 'Visa' | 'Transport' | 'Luggage' | 'Money' | 'Season' | 'Emergency';
const TOPICS: { id: string; k: K }[] = [
  { id: 'visa', k: 'Visa' }, { id: 'transport', k: 'Transport' }, { id: 'luggage-storage', k: 'Luggage' },
  { id: 'money', k: 'Money' }, { id: 'best-time-to-visit', k: 'Season' }, { id: 'emergency', k: 'Emergency' },
];
const k: K = TOPICS.find((x) => x.id === topic.id)?.k ?? 'Visa';
const key = (base: string) => `${base}${k}` as EssTopicKey;

// ── Topic tabs: each topic's own (translated) short name and icon ──
const allTopics = await getCollection('essentialsTopics');
const allTr = lang === 'en' ? [] : await getCollection('essentialsTopicsI18n', (e) => e.id.startsWith(`${lang}/`));
const tabs = TOPICS.map((x) => {
  const en = allTopics.find((e) => e.id === x.id);
  const tr = allTr.find((e) => e.id === `${lang}/${x.id}`);
  return { ...x, name: (tr?.data ?? en?.data)?.breadcrumbName ?? x.id, icon: en?.data.icon ?? 'globe-with-meridians', href: localizePath(`/essentials/${x.id}`, lang) };
}).filter((x) => allTopics.some((e) => e.id === x.id));

// ── Countries: every non-draft guide whose vetted facts are fresh ──
const guides = await getCollection('essentials', ({ data }) => !data.draft);
const byName = new Map(countriesData.countries.map((c) => [c.name, c]));
const facts = (essentialsFacts as any).countries ?? {};
const esim = new Set(Object.keys(esimFacts).filter((x) => !x.startsWith('_')));
const collator = new Intl.Collator(locale);
const rows = guides.map((g) => {
  const c: any = byName.get(g.data.country);
  const fe = facts[g.data.country];
  if (!c || !fe || fe.srcHash !== bodyHash(String(g.body ?? ''))) return null;
  const F: any = lang === 'en' ? fe.en : fe[lang];
  if (!F) return null;
  const E: any = fe.en; // English labels, only to sort emergency numbers into columns
  const visa0 = F.visa?.cards?.[0];
  const card = (kk: string) => F.summary?.find((x: any) => x.key === kk);
  // No country-wide entry card: one visa card can stand for the country, but
  // several are per-nationality ("Visa-free (US/Canada/…)" read to a Korean as
  // "not me" on Hong Kong — subagent review, 10-01): say so, and list them.
  const vCards: any[] = F.visa?.cards ?? [];
  const entryCard = card('entry') ?? (vCards.length > 1
    ? { title: s('byPassport'), sub: vCards.map((c: any) => c.name).join(' · ') }
    : visa0 ? { title: visa0.name, sub: [visa0.stay, visa0.cost].filter(Boolean).join(' · ') } : null);
  const moneyCard = card('money') ?? (F.money?.budget ? { title: F.money.budget.amount, sub: F.money.budget.label } : F.money?.tips?.[0] ? { title: F.money.tips[0].title, sub: '' } : null);
  const transportCard = card('transport') ?? (F.transport?.tips?.[0] ? { title: F.transport.tips[0].title, sub: '' } : null);
  // Season, for the COUNTRY: the guide's own country-wide best months
  // (season.best) plus rows that speak for the whole country ("Whole country",
  // "Peninsula overall"). Region and niche rows stay on the country page:
  // unioning them painted India best in July (Ladakh), Uzbekistan in August
  // (Nuratau), the Philippines in typhoon season ("Shoulder months") and the
  // UAE in May (subagent review, 10-01). Only a guide with no country-wide
  // months falls back to all its rows (Japan's are nationwide seasons).
  const sRows: any[] = F.season?.rows ?? [];
  const sEn: any[] = E?.season?.rows ?? [];
  // A row speaks for the whole country when it is named for it ("Whole
  // country") or for a season ("Winter", "Dry season"); shoulder, regional and
  // activity rows do not. Matching only "whole country" dropped Hong Kong's
  // Winter row (January best) and Indonesia's Dry season row (busy December)
  // — Codex review, 10-01 — while still keeping out Ladakh, Nuratau and the
  // Philippines' and the UAE's shoulder months.
  const NATIONWIDE = /^(whole country|nationwide|entire country|.*\boverall|spring|summer|autumn|fall|winter|((cool|hot|dry|wet|rainy|cool dry|hot dry) )?(dry|wet|rainy|cool|hot|monsoon) season|monsoon)$/i;
  const national = sRows.filter((_: any, i: number) => NATIONWIDE.test(String(sEn[i]?.label ?? '').trim()));
  const top: number[] = F.season?.best ?? [];
  const useRows = top.length ? national : sRows;
  const best = new Set<number>([...top, ...useRows.flatMap((r: any) => r.best ?? [])]);
  const busy = new Set<number>(useRows.flatMap((r: any) => r.busy ?? []));
  const avoid = new Set<number>(useRows.flatMap((r: any) => r.avoid ?? []));
  const monthOf = (m: number) => (best.has(m) ? 'best' : busy.has(m) ? 'busy' : avoid.has(m) ? 'avoid' : '');
  const nums = (F.emergency?.numbers ?? []).map((n: any, i: number) => ({ ...n, en: String(E?.emergency?.numbers?.[i]?.label ?? '') }));
  // Sorted by the ENGLISH label. A unified number (Australia's Triple Zero, the
  // UK's 999, the US 911, Spain's 112 "General emergency") answers for police
  // and ambulance both; a backup / SMS / tourist / advice line is "other" —
  // Triple Zero first sat under "other" with two empty columns (10-01).
  const backup = (n: any) => /alternat|backup|mobile emergency|international emergency|eu emergency|sms/i.test(n.en);
  const aside = (n: any) => backup(n) || /non-emergency|advice|tourist|hotline|info|coast ?guard|red cross|weather|traffic|social|search and rescue/i.test(n.en);
  const unified = (n: any) => !backup(n) && /triple zero|unified|national emergency|general emergency|^police, (fire|ambulance)/i.test(n.en);
  const isPolice = (n: any) => unified(n) || (!aside(n) && /police|polic[ií]a|guardia civil/i.test(n.en));
  const isMedical = (n: any) => unified(n) || (!aside(n) && /ambulance|medical|fire|samu/i.test(n.en));
  return {
    slug: g.id, name: g.data.country, iso2: c.iso2, priority: c.priority ?? 99,
    region: hubRegion(c.continent, c.iso2) as HubRegion,
    label: localizePlace(g.data.country, lang),
    href: localizePath(`/essentials/${g.id}`, lang),
    esim: esim.has(g.id) ? localizePath(`/tools/esim/${g.id}`, lang) : '',
    entry: entryCard, money: moneyCard, transport: transportCard,
    visaCards: (F.visa?.cards ?? []).slice(0, 3), warning: F.visa?.warnings?.[0] ?? null,
    transportTips: (F.transport?.tips ?? []).slice(0, 3),
    budget: F.money?.budget ?? null, moneyTips: (F.money?.tips ?? []).slice(0, 4),
    months: Array.from({ length: 12 }, (_, i) => monthOf(i + 1)),
    seasonRated: best.size + busy.size + avoid.size > 0,
    numbers: nums,
    police: nums.filter(isPolice), medical: nums.filter(isMedical), other: nums.filter((n: any) => !isPolice(n) && !isMedical(n)),
    // Regions whose seasons differ, split out on the best-time grid (Vietnam:
    // north / central / south, owner 10-01) — data/season-regions.json, each
    // row resting on its guide's own sentences (season-regions.test.mjs).
    seasonRegions: ((seasonRegions as any)[g.data.country]?.regions ?? []).map((x: any) => ({
      label: x.label?.[lang] ?? x.label?.en ?? x.key,
      months: Array.from({ length: 12 }, (_, i) => (x.best?.includes(i + 1) ? 'best' : x.busy?.includes(i + 1) ? 'busy' : x.avoid?.includes(i + 1) ? 'avoid' : '')),
    })),
    reviewed: g.data.lastReviewed as Date,
  };
}).filter(Boolean)
  .sort((a: any, b: any) => a.priority - b.priority || collator.compare(a.label, b.label)) as any[];

// A Korean reader is not travelling to Korea: the picker skips it (same rule
// as the hub). The comparison table keeps every country.
const pickRows = (lang === 'ko' ? rows.filter((r) => r.slug !== 'south-korea') : rows)
  .filter((r) => (k === 'Visa' ? r.entry : k === 'Transport' ? r.transport : k === 'Money' ? r.money : k === 'Emergency' ? r.numbers.length : true));
const defaultSlug = pickRows[0]?.slug ?? '';
const tableRows = [...rows].sort((a, b) => collator.compare(a.label, b.label));
const latest = rows.reduce((m, r) => (r.reviewed > m ? r.reviewed : m), new Date(0));
const latestLabel = latest.getTime() ? latest.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const REGION_ORDER: HubRegion[] = ['asia', 'europe', 'meca', 'africa', 'amoc'];
const REGION_LABEL: Record<HubRegion, string> = { asia: h('rAsia'), europe: h('rEurope'), meca: h('rMeca'), africa: h('rAfrica'), amoc: h('rAmOc') };
const regionChips = REGION_ORDER.filter((r) => tableRows.some((x) => x.region === r)).map((r) => ({ key: r, label: REGION_LABEL[r] }));

// ── Season: the month picker and the 12-month grid ──
const monthLong = (m: number) => new Intl.DateTimeFormat(locale, { month: 'long', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, m - 1, 1)));
const monthShort = (m: number) => new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, m - 1, 1)));
// A country with region rows stands as one entry per region ("Vietnam · North").
const bySeasonRegion = (list: any[]) => list.flatMap((r) => (r.seasonRegions.length
  ? r.seasonRegions.map((x: any) => ({ ...r, label: `${r.label} · ${x.label}`, months: x.months, seasonRated: true }))
  : [r]));
const seasonRows = bySeasonRegion(lang === 'ko' ? rows.filter((r) => r.slug !== 'south-korea') : rows).filter((r) => r.seasonRated);
const monthBlocks = Array.from({ length: 12 }, (_, i) => {
  const m = i + 1;
  return {
    m, name: monthLong(m), short: monthShort(m),
    best: seasonRows.filter((r) => r.months[i] === 'best'),
    busy: seasonRows.filter((r) => r.months[i] === 'busy'),
    avoid: seasonRows.filter((r) => r.months[i] === 'avoid'),
  };
});
// The build's month; the script moves to the reader's own month on load.
const buildMonth = new Date().getUTCMonth() + 1;

// ── Luggage: country guides that carry a "Luggage storage" section, linked
// to it (the country page ids its extra sections by position: ess-more-N) ──
const luggage = k !== 'Luggage' ? [] : guides
  .map((g) => {
    const heads = [...String(g.body ?? '').matchAll(/^## (.+)$/gm)].map((m) => m[1].trim().toLowerCase());
    const i = heads.findIndex((x) => x.startsWith('luggage storage'));
    const c: any = byName.get(g.data.country);
    return i < 0 || !c ? null : { slug: g.id, iso2: c.iso2, label: localizePlace(g.data.country, lang), href: `${localizePath(`/essentials/${g.id}`, lang)}#ess-more-${i + 1}` };
  })
  .filter(Boolean)
  .sort((a: any, b: any) => collator.compare(a.label, b.label)) as any[];
const situations = [1, 2, 3, 4, 5].map((n) => ({
  n, label: s(`l${n}` as EssTopicKey), where: s(`l${n}Where` as EssTopicKey), text: s(`l${n}Text` as EssTopicKey),
  cost: s(`l${n}Cost` as EssTopicKey), watch: s(`l${n}Watch` as EssTopicKey),
}));

// ── The topic's own prose as numbered cards (every word stays on the page) ──
// Numeric entities too: the renderer writes "&" as &#x26;, and "City subways
// &#x26; buses" showed literally (Codex review, 10-01).
const decode = (x: string) => x.replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCodePoint(parseInt(n, 16))).replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n))).replace(/&#x27;|&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
const html = String(entry.rendered?.html ?? '');
const parts = html.split(/<h2[^>]*>/);
const intro = parts[0].trim();
const basics = parts.slice(1).map((p) => {
  const end = p.indexOf('</h2>');
  return { title: decode(p.slice(0, end).replace(/<[^>]+>/g, '')).trim(), html: p.slice(end + 5) };
});

// ── Call to action: one band per topic, two links ──
const esimHref = localizePath('/tools/esim', lang);
const pickup = `https://kiwitaxi.tpx.lv/yRbl5tIp?sub_id=essentials_${topic.id}`;
const CTA: Record<K, { a: [string, string, string]; b: [string, string, string] }> = {
  Visa: { a: [s('goNewsletter'), s('tagFree'), localizePath('/newsletter', lang)], b: [s('goFlights'), s('tagFlights'), localizePath('/flights', lang)] },
  Transport: { a: [s('goPickup'), s('tagPickup'), pickup], b: [s('goEsim'), s('tagEsim'), esimHref] },
  Luggage: { a: [s('goTours'), s('tagTours'), 'https://klook.tpx.lv/2NXPH8MA'], b: [s('goPickup'), s('tagPickupBags'), pickup] },
  Money: { a: [s('goChecklist'), s('tagPrint'), localizePath('/free/trip-checklist', lang)], b: [s('goEsim'), s('tagEsimPay'), esimHref] },
  Season: { a: [s('goFlights'), s('tagFlights'), localizePath('/flights', lang)], b: [s('goEvents'), s('tagEvents'), localizePath('/events', lang)] },
  Emergency: { a: [s('goChecklist'), s('tagPrint'), localizePath('/free/trip-checklist', lang)], b: [s('goEsim'), s('tagEsimCalls'), esimHref] },
};
const cta = CTA[k];
const external = (href: string) => /^https?:/.test(href);

const related = tabs.filter((x) => x.id !== topic.id).map((x) => ({ ...x, blurb: s(`rel${x.k}` as EssTopicKey) }));
// Only a dialable number becomes a tel: link — the Philippines lists "VHF
// Channel 16", which would have dialled 16.
const telOf = (n: string) => (/[a-z]/i.test(String(n)) ? undefined : `tel:${String(n).replace(/[^\d+]/g, '')}`);
// An SMS-only line (Hong Kong 992, Singapore 70999) opens the messages app, not
// the dialer — someone who cannot speak is exactly who uses it (Codex review).
const isSms = (n: any) => /sms/i.test(String(n.en ?? ''));
const linkOf = (n: any) => { const tel = telOf(n.number); return tel && isSms(n) ? tel.replace(/^tel:/, 'sms:') : tel; };
const vcf = (r: any) => JSON.stringify({ name: r.label, numbers: r.numbers.filter((n: any) => telOf(n.number)).map((n: any) => ({ number: n.number, label: n.label })) });

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteHref(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: d.metaTitle, description: d.metaDescription, url: pageUrl, isPartOf: { '@id': `${site}/#site` } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.home'), item: siteHref(localizePath('/', lang), Astro.site) },
      { '@type': 'ListItem', position: 2, name: t('ess.label'), item: siteHref(localizePath('/essentials', lang), Astro.site) },
      { '@type': 'ListItem', position: 3, name: d.breadcrumbName, item: pageUrl },
    ] },
    { '@type': 'FAQPage', mainEntity: (d.faq ?? []).map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
const pickTitle = s(key('pick'));
const tableHead = k === 'Visa' ? s('colEntry') : k === 'Transport' ? s('colTransport') : s('colMoney');
const cellOf = (r: any) => (k === 'Visa' ? r.entry : k === 'Transport' ? r.transport : r.money);
---

<BaseLayout title={d.metaTitle} description={d.metaDescription} jsonLd={jsonLd} localized={true}>
  <div class="tph" data-topic={topic.id}>
    <div class="wrap">
      <nav class="tph-crumbs" aria-label="breadcrumb">
        <a href={localizePath('/', lang)}>{t('post.home')}</a><span aria-hidden="true">·</span>
        <a href={localizePath('/essentials', lang)}>{t('ess.label')}</a><span aria-hidden="true">·</span>
        <span class="tph-here">{d.breadcrumbName}</span>
      </nav>

      <nav class="tph-tabs" aria-label={s('tabsLabel')}>
        {tabs.map((x) => (
          <a class:list={['tph-tab', { on: x.id === topic.id }]} href={x.href} aria-current={x.id === topic.id ? 'page' : undefined}>
            <Emoji name={x.icon} /> <span>{x.name}</span>
          </a>
        ))}
      </nav>

      <header class="tph-hero">
        <div class="tph-hero-text">
          <p class="tph-kicker">{t('ess.label')} · {d.breadcrumbName}</p>
          <h1>{d.h1}</h1>
          <p class="tph-hook">{s(key('hook'))}</p>
          <p class="tph-dek">{d.dek}</p>
          {latestLabel && <p class="tph-checked"><span aria-hidden="true">✓</span> {s('checked', { date: latestLabel, n: rows.length })}</p>}
        </div>
        <div class="tph-hero-art" aria-hidden="true"><Emoji name={topic.data.icon ?? 'globe-with-meridians'} /></div>
      </header>

      <aside class="tph-quick">
        <span class="tph-quick-label">{t('post.quickAnswer')}</span>
        <p>{d.quickAnswer}</p>
      </aside>

      {/* ── The picker: a country (four topics), a month, or a situation ── */}
      {k === 'Season' ? (
        <section class="tph-sec tph-pick" data-months data-build-month={buildMonth}>
          <div class="tph-head">
            <h2>{pickTitle}</h2>
            <span class="tph-note">{s('pickNote', { n: new Set(seasonRows.map((r) => r.slug)).size })}</span>
          </div>
          <div class="tph-chips tph-chips--months" role="group" aria-label={pickTitle}>
            {monthBlocks.map((b) => (
              <button type="button" class="tph-chip" data-month={b.m} aria-pressed={b.m === buildMonth ? 'true' : 'false'}>{b.short}</button>
            ))}
          </div>
          {monthBlocks.map((b) => (
            <div class="tph-months" data-mblock={b.m} hidden={b.m !== buildMonth}>
              {b.best.length + b.busy.length + b.avoid.length === 0 ? <p class="tph-empty">{s('sNone', { m: b.name })}</p> : (
                <div class="tph-mgrid">
                  {b.best.length > 0 && (
                    <div class="tph-mcol tph-mcol--best">
                      <h3>{s('sBest', { m: b.name })}</h3>
                      <ul>{b.best.map((r) => <li><a href={`${r.href}#ess-season`}><Flag code={r.iso2} size="1.1em" /> {r.label}</a></li>)}</ul>
                    </div>
                  )}
                  {b.busy.length > 0 && (
                    <div class="tph-mcol tph-mcol--busy">
                      <h3>{s('sBusy')}</h3>
                      <ul>{b.busy.map((r) => <li><a href={`${r.href}#ess-season`}><Flag code={r.iso2} size="1.1em" /> {r.label}</a></li>)}</ul>
                    </div>
                  )}
                  {b.avoid.length > 0 && (
                    <div class="tph-mcol tph-mcol--avoid">
                      <h3>{s('sAvoid', { m: b.name })}</h3>
                      <ul>{b.avoid.map((r) => <li><a href={`${r.href}#ess-season`}><Flag code={r.iso2} size="1.1em" /> {r.label}</a></li>)}</ul>
                    </div>
                  )}
                </div>
              )}
            </div>
          ))}
        </section>
      ) : k === 'Luggage' ? (
        <section class="tph-sec tph-pick" data-situations>
          <div class="tph-head"><h2>{pickTitle}</h2></div>
          <div class="tph-sit">
            <div class="tph-sit-list" role="group" aria-label={pickTitle}>
              {situations.map((x) => (
                <button type="button" class="tph-sit-btn" data-sit={x.n} aria-pressed={x.n === 1 ? 'true' : 'false'}>{x.label}</button>
              ))}
            </div>
            {situations.map((x) => (
              <div class="tph-sit-card" data-sitblock={x.n} hidden={x.n !== 1}>
                <p class="tph-sit-kicker">{s('lWhere')}</p>
                <h3>{x.where}</h3>
                <p>{x.text}</p>
                <dl>
                  <div><dt>{s('lCost')}</dt><dd>{x.cost}</dd></div>
                  <div><dt>{s('lWatch')}</dt><dd>{x.watch}</dd></div>
                </dl>
              </div>
            ))}
          </div>
        </section>
      ) : pickRows.length > 0 && (
        <section class="tph-sec tph-pick" data-countries data-default={defaultSlug}>
          <div class="tph-head">
            <h2>{pickTitle}</h2>
            <span class="tph-note">{s('pickNote', { n: pickRows.length })}</span>
          </div>
          <div class="tph-chips" role="group" aria-label={pickTitle}>
            {pickRows.map((r) => (
              <button type="button" class="tph-chip" data-pick={r.slug} aria-pressed={r.slug === defaultSlug ? 'true' : 'false'}><Flag code={r.iso2} size="1.05em" /> {r.label}</button>
            ))}
          </div>
          <p class="tph-remember">{s('remember')}</p>
          {pickRows.map((r) => (
            <div class="tph-panel" data-panel={r.slug} hidden={r.slug !== defaultSlug}>
              {k === 'Visa' && (
                <div class="tph-pgrid">
                  <div class="tph-big">
                    <p class="tph-big-kicker"><Flag code={r.iso2} size="1em" /> {r.label} · {s('colEntry')}</p>
                    <p class="tph-big-title">{r.entry?.title}</p>
                    {r.entry?.sub && <p class="tph-big-sub">{r.entry.sub}</p>}
                    <a class="tph-big-link" href={`${r.href}#ess-visa`}>{s('fullGuide', { c: r.label })}</a>
                  </div>
                  {r.visaCards.map((v: any) => (
                    <div class="tph-cell">
                      <p class="tph-cell-kicker">{v.name}</p>
                      {v.who && <p class="tph-cell-title">{v.who}</p>}
                      <p class="tph-cell-sub">{[v.stay && `${s('lblStay')} ${v.stay}`, v.cost && `${s('lblCost')} ${v.cost}`].filter(Boolean).join(' · ')}</p>
                    </div>
                  ))}
                  {r.warning && (
                    <div class="tph-cell tph-cell--warn">
                      <p class="tph-cell-kicker">{s('lblKeep')}</p>
                      <p class="tph-cell-title">{r.warning.title}</p>
                      <p class="tph-cell-sub">{r.warning.text}</p>
                    </div>
                  )}
                </div>
              )}
              {k === 'Transport' && (
                <div class="tph-pgrid">
                  <div class="tph-big">
                    <p class="tph-big-kicker"><Flag code={r.iso2} size="1em" /> {r.label} · {s('colTransport')}</p>
                    <p class="tph-big-title">{r.transport?.title}</p>
                    {r.transport?.sub && <p class="tph-big-sub">{r.transport.sub}</p>}
                    <a class="tph-big-link" href={`${r.href}#ess-transport`}>{s('fullGuide', { c: r.label })}</a>
                  </div>
                  {r.transportTips.map((x: any, i: number) => (
                    <div class="tph-cell tph-cell--step">
                      <span class="tph-step">{i + 1}</span>
                      <p class="tph-cell-title">{x.title}</p>
                      <p class="tph-cell-sub">{x.text}</p>
                    </div>
                  ))}
                </div>
              )}
              {k === 'Money' && (
                <div class="tph-pgrid">
                  <div class="tph-big">
                    <p class="tph-big-kicker"><Flag code={r.iso2} size="1em" /> {r.label} · {s('colMoney')}</p>
                    <p class="tph-big-title">{r.money?.title}</p>
                    {r.money?.sub && <p class="tph-big-sub">{r.money.sub}</p>}
                    {r.budget && r.money?.title !== r.budget.amount && <p class="tph-big-sub"><strong>{s('lblBudget')}</strong> {r.budget.amount} · {r.budget.label}</p>}
                    <a class="tph-big-link" href={`${r.href}#ess-money`}>{s('fullGuide', { c: r.label })}</a>
                  </div>
                  {r.moneyTips.map((x: any) => (
                    <div class="tph-cell">
                      <p class="tph-cell-title">{x.title}</p>
                      <p class="tph-cell-sub">{x.text}</p>
                    </div>
                  ))}
                </div>
              )}
              {k === 'Emergency' && (
                <div class="tph-egrid">
                  {r.numbers.map((n: any) => (
                    <a class="tph-num" href={linkOf(n)}>
                      <span class="tph-num-label">{n.label}</span>
                      <strong class:list={['tph-num-n', { 'tph-num-n--long': String(n.number).length > 7 }]}>{n.number}</strong>
                      {n.note && <span class="tph-num-note">{n.note}</span>}
                      {linkOf(n) && <span class="tph-num-go">{isSms(n) ? s('text') : s('call')} →</span>}
                    </a>
                  ))}
                  {lang === 'ko' && (
                    <a class="tph-num tph-num--ko" href="tel:+82232100404">
                      <span class="tph-num-label">한국어로 도움받기 · 24시간</span>
                      <strong class="tph-num-n tph-num-n--long">+82-2-3210-0404</strong>
                      <span class="tph-num-note">외교부 영사콜센터. 여권 분실·사건사고 때.</span>
                      <span class="tph-num-go">{s('call')} →</span>
                    </a>
                  )}
                  <div class="tph-eactions">
                    <button type="button" class="tph-save" data-vcf={vcf(r)}>{s('saveContacts', { c: r.label })}</button>
                    <a class="tph-big-link tph-big-link--plain" href={`${r.href}#ess-emergency`}>{s('fullGuide', { c: r.label })}</a>
                  </div>
                </div>
              )}
            </div>
          ))}
        </section>
      )}

      {/* ── The topic's own prose, as numbered basics ── */}
      {basics.length > 0 && (
        <section class="tph-sec">
          <h2 class="tph-h2">{s(key('basics'))}</h2>
          {intro && <div class="tph-intro prose" set:html={intro} />}
          <ol class:list={['tph-basics', { 'tph-basics--odd': basics.length % 2 === 1 }]}>
            {basics.map((b, i) => (
              <li class="tph-basic">
                <span class="tph-basic-n">{i + 1}</span>
                <h3>{b.title}</h3>
                <div class="prose" set:html={b.html} />
              </li>
            ))}
          </ol>
        </section>
      )}

      {/* ── Every country at a glance ── */}
      {k === 'Luggage' ? luggage.length > 0 && (
        <section class="tph-sec">
          <div class="tph-head">
            <div><h2 class="tph-h2">{s('lcTitle')}</h2><p class="tph-note">{s('lcSub', { n: luggage.length })}</p></div>
          </div>
          <ul class="tph-lug">
            {luggage.map((x) => <li><a href={x.href}><Flag code={x.iso2} size="1.3em" /> <span>{s('lcLink', { c: x.label })}</span></a></li>)}
          </ul>
        </section>
      ) : (
        <section class="tph-sec" data-table>
          <div class="tph-head">
            <div><h2 class="tph-h2">{d.countryHeading}</h2><p class="tph-note">{s('tableSub')}</p></div>
            <input class="tph-search" type="search" placeholder={s('search')} aria-label={s('search')} data-search />
          </div>
          {regionChips.length > 1 && (
            <div class="tph-chips tph-chips--small" role="group" aria-label={s('colCountry')}>
              <button type="button" class="tph-chip" data-region="all" aria-pressed="true">{s('all')}</button>
              {regionChips.map((r) => <button type="button" class="tph-chip" data-region={r.key} aria-pressed="false">{r.label}</button>)}
            </div>
          )}
          <div class="tph-table-wrap">
            {k === 'Season' ? (
              <table class="tph-table tph-table--season">
                <caption class="sr-only">{s('sGrid')}</caption>
                <thead><tr><th scope="col">{s('colCountry')}</th>{monthBlocks.map((b) => <th scope="col" class="tph-m">{b.short}</th>)}</tr></thead>
                <tbody>
                  {bySeasonRegion(tableRows).filter((r) => r.seasonRated).map((r) => (
                    <tr data-region={r.region} data-names={`${r.label} ${r.name}`.toLowerCase()}>
                      <th scope="row"><a href={`${r.href}#ess-season`}><Flag code={r.iso2} size="1em" /> {r.label}</a></th>
                      {r.months.map((v: string, i: number) => (
                        <td class={`tph-m tph-m--${v || 'none'}`} title={`${monthBlocks[i].name}: ${v === 'best' ? s('sLegendBest') : v === 'busy' ? s('sLegendBusy') : v === 'avoid' ? s('sLegendAvoid') : s('sLegendNone')}`}><span class="sr-only">{v === 'best' ? s('sLegendBest') : v === 'busy' ? s('sLegendBusy') : v === 'avoid' ? s('sLegendAvoid') : s('sLegendNone')}</span></td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : k === 'Emergency' ? (
              <table class="tph-table">
                <thead><tr><th scope="col">{s('colCountry')}</th><th scope="col">{s('colPolice')}</th><th scope="col">{s('colMedical')}</th><th scope="col">{s('colOther')}</th></tr></thead>
                <tbody>
                  {tableRows.filter((r) => r.numbers.length).map((r) => (
                    <tr data-region={r.region} data-names={`${r.label} ${r.name}`.toLowerCase()}>
                      <th scope="row"><a href={`${r.href}#ess-emergency`}><Flag code={r.iso2} size="1em" /> {r.label}</a></th>
                      <td data-label={s('colPolice')} class:list={[{ 'tph-nil': !r.police.length }]}>{r.police.length ? r.police.map((n: any) => <a class="tph-tel" href={linkOf(n)}>{n.number}</a>) : '—'}</td>
                      <td data-label={s('colMedical')} class:list={[{ 'tph-nil': !r.medical.length }]}>{r.medical.length ? r.medical.map((n: any) => <a class="tph-tel" href={linkOf(n)}>{n.number}</a>) : '—'}</td>
                      <td data-label={s('colOther')} class:list={[{ 'tph-nil': !r.other.length }]}>{r.other.length ? r.other.slice(0, 2).map((n: any) => <span class="tph-other"><a class="tph-tel" href={linkOf(n)}>{n.number}</a> <small>{n.label}</small></span>) : '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <table class="tph-table">
                <thead><tr><th scope="col">{s('colCountry')}</th><th scope="col">{tableHead}</th><th scope="col">{s('colDetail')}</th></tr></thead>
                <tbody>
                  {tableRows.filter((r) => cellOf(r)).map((r) => (
                    <tr data-region={r.region} data-names={`${r.label} ${r.name}`.toLowerCase()}>
                      <th scope="row"><a href={r.href}><Flag code={r.iso2} size="1em" /> {r.label}</a></th>
                      <td><span class="tph-pill">{cellOf(r).title}</span></td>
                      <td class="tph-detail">{cellOf(r).sub || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
          {k === 'Season' && (
            <ul class="tph-legend">
              <li><span class="tph-m--best"></span>{s('sLegendBest')}</li>
              <li><span class="tph-m--busy"></span>{s('sLegendBusy')}</li>
              <li><span class="tph-m--avoid"></span>{s('sLegendAvoid')}</li>
              <li><span class="tph-m--none"></span>{s('sLegendNone')}</li>
            </ul>
          )}
          <p class="tph-empty" data-nomatch hidden>{s('noMatch')}</p>
        </section>
      )}

      {/* ── One call to action ── */}
      <section class="tph-cta">
        <div class="tph-cta-text">
          <h2>{s(`cta${k}T` as EssTopicKey)}</h2>
          <p>{s(`cta${k}S` as EssTopicKey)}</p>
        </div>
        <div class="tph-cta-links">
          {[cta.a, cta.b].map(([label, tag, href]) => (
            <a class="tph-cta-link" href={href} rel={external(href) ? 'sponsored noopener' : undefined} target={external(href) ? '_blank' : undefined}>
              <span>{label}</span><small>{tag}</small>
            </a>
          ))}
          <p class="tph-aff">{s('affNote')}</p>
        </div>
      </section>

      {/* ── FAQ, the first one open ── */}
      {(d.faq ?? []).length > 0 && (
        <section class="tph-sec tph-faq">
          <div class="tph-faq-head">
            <h2 class="tph-h2">{t('post.faqTitle')}</h2>
            <p class="tph-note">{d.disclosure}</p>
          </div>
          <div class="tph-faq-list">
            {(d.faq ?? []).map((f: any, i: number) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="tph-sec tph-more">
        <h2 class="tph-more-title">{s('moreTitle')}</h2>
        <ul class="tph-rel">
          {related.map((x) => (
            <li><a href={x.href}><strong><Emoji name={x.icon} /> {x.name} →</strong><span>{x.blurb}</span></a></li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  // Progressive: without this every panel's content is still in the page and
  // the default country / the build's month / the first situation shows.
  const KEY = 'wa-ess-country';
  const store = {
    get() { try { return localStorage.getItem(KEY) || ''; } catch { return ''; } },
    set(v: string) { try { localStorage.setItem(KEY, v); } catch { /* private mode */ } },
  };
  const hashGet = (k: string) => new RegExp(`(?:^|[#&])${k}=([^&]+)`).exec(location.hash)?.[1] ?? '';
  const hashSet = (k: string, v: string) => history.replaceState(null, '', `#${k}=${v}`);

  // 1. Country picker: hash (#c=japan) > the reader's last pick > default.
  const pick = document.querySelector<HTMLElement>('[data-countries]');
  if (pick) {
    const chips = [...pick.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const panels = [...pick.querySelectorAll<HTMLElement>('[data-panel]')];
    const valid = new Set(chips.map((c) => c.dataset.pick || ''));
    const show = (slug: string, save: boolean) => {
      if (!valid.has(slug)) return;
      for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.pick === slug));
      for (const p of panels) p.hidden = p.dataset.panel !== slug;
      if (save) { store.set(slug); hashSet('c', slug); }
    };
    for (const c of chips) c.addEventListener('click', () => show(c.dataset.pick || '', true));
    // Bring the picked chip into view sideways only: scrollIntoView also moved
    // the page down past the heading on a phone (Codex review, 10-01).
    const centre = () => {
      const on = chips.find((c) => c.getAttribute('aria-pressed') === 'true');
      const row = on?.parentElement;
      if (on && row && row.scrollWidth > row.clientWidth) row.scrollLeft = on.offsetLeft - row.offsetLeft - (row.clientWidth - on.offsetWidth) / 2;
    };
    const first = hashGet('c') || store.get();
    if (first) show(first, false);
    centre();
    addEventListener('hashchange', () => { const c = hashGet('c'); if (c) { show(c, false); centre(); } });
  }

  // 2. Month picker: hash (#m=4) > the reader's own month.
  const months = document.querySelector<HTMLElement>('[data-months]');
  if (months) {
    const btns = [...months.querySelectorAll<HTMLButtonElement>('[data-month]')];
    const blocks = [...months.querySelectorAll<HTMLElement>('[data-mblock]')];
    const show = (m: string, save: boolean) => {
      if (!btns.some((b) => b.dataset.month === m)) return;
      for (const b of btns) b.setAttribute('aria-pressed', String(b.dataset.month === m));
      for (const b of blocks) b.hidden = b.dataset.mblock !== m;
      if (save) hashSet('m', m);
    };
    for (const b of btns) b.addEventListener('click', () => show(b.dataset.month || '', true));
    show(hashGet('m') || String(new Date().getMonth() + 1), false);
    addEventListener('hashchange', () => { const m = hashGet('m'); if (m) show(m, false); });
  }

  // 3. Luggage situations.
  const sits = document.querySelector<HTMLElement>('[data-situations]');
  if (sits) {
    const btns = [...sits.querySelectorAll<HTMLButtonElement>('[data-sit]')];
    const cards = [...sits.querySelectorAll<HTMLElement>('[data-sitblock]')];
    for (const b of btns) b.addEventListener('click', () => {
      for (const x of btns) x.setAttribute('aria-pressed', String(x === b));
      for (const c of cards) c.hidden = c.dataset.sitblock !== b.dataset.sit;
    });
  }

  // 4. Table: region chips × search.
  const table = document.querySelector<HTMLElement>('[data-table]');
  if (table) {
    const rows = [...table.querySelectorAll<HTMLElement>('tbody tr')];
    const chips = [...table.querySelectorAll<HTMLButtonElement>('[data-region]')].filter((b) => b.tagName === 'BUTTON');
    const input = table.querySelector<HTMLInputElement>('[data-search]');
    const none = table.querySelector<HTMLElement>('[data-nomatch]');
    let region = 'all';
    const apply = () => {
      const q = (input?.value || '').trim().toLowerCase();
      let n = 0;
      for (const r of rows) {
        const on = (region === 'all' || r.dataset.region === region) && (!q || (r.dataset.names || '').includes(q));
        r.hidden = !on;
        if (on) n++;
      }
      if (none) none.hidden = n > 0;
    };
    for (const c of chips) c.addEventListener('click', () => {
      region = c.dataset.region || 'all';
      for (const x of chips) x.setAttribute('aria-pressed', String(x === c));
      apply();
    });
    input?.addEventListener('input', apply);
  }

  // 5. Emergency numbers → a contact card the phone can import.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-vcf]')) {
    btn.addEventListener('click', () => {
      let data: { name: string; numbers: { number: string; label: string }[] };
      try { data = JSON.parse(btn.dataset.vcf || ''); } catch { return; }
      const esc = (x: string) => x.replace(/[\\,;]/g, (m) => `\\${m}`).replace(/\n/g, ' ');
      const lines = ['BEGIN:VCARD', 'VERSION:3.0', `FN:${esc(`${data.name} SOS`)}`, `N:SOS;${esc(data.name)};;;`];
      data.numbers.forEach((n, i) => {
        lines.push(`item${i + 1}.TEL:${n.number}`, `item${i + 1}.X-ABLabel:${esc(n.label)}`);
      });
      lines.push(`NOTE:${esc(data.numbers.map((n) => `${n.label} ${n.number}`).join(' / '))}`, 'END:VCARD');
      const url = URL.createObjectURL(new Blob([lines.join('\r\n')], { type: 'text/vcard' }));
      const a = Object.assign(document.createElement('a'), { href: url, download: `${data.name}-SOS.vcf` });
      document.body.append(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
    });
  }
</script>

<style>
