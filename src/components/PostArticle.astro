---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from './Newsletter.astro';
import ShareRow from './ShareRow.astro';
import SaveButton from './SaveButton.astro';
import countriesData from '../../data/countries.json';
import { SITE } from '../siteConfig';
import { wikimediaThumb } from '../lib/wikimediaThumb.mjs';
import PlanTrip from './PlanTrip.astro';
import PostCard from './PostCard.astro';
import StickyBook from './StickyBook.astro';
import Emoji from './Emoji.astro';
import { isEventPast } from '../lib/eventStatus';
import { eventSchemaName } from '../lib/eventName';
import { isRecurringEvent as resolveRecurring } from '../lib/eventRecurrence.mjs';
import { resolveBusyness } from '../lib/busyness.mjs';
import { slugifyRegion } from '../lib/slug';
import { getLangFromUrl, useTranslations, localeCodes, defaultLang, localizePath, klookLocale } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { formatHourRanges, localizeOpeningLine } from '../lib/hours.mjs';
import { tileMosaic, TILE_ATTRIBUTION } from '../lib/osmTile.mjs';
import { stripPlusCode } from '../lib/address.mjs';
import { linkMentions } from '../lib/body-links.mjs';
import ogMirror from '../../data/og-mirror.json';
import { klookCityDest } from '../lib/klookCities';

// Shared article view for BOTH the English page (/posts/…) and the localized
// pages (/ko/posts/… etc). One template, so a fix can never land on only one of
// them. `translation` is a postI18n entry: it supplies PROSE only — every hard
// fact (place, rating, address, hours, images, dates, schema) still comes from
// the English source post, so a translation can't contradict verified data.
interface Props {
  post: any;
  translation?: any;
}
const { post, translation } = Astro.props;
// Chrome labels (fact box, section headings, CTAs) follow the URL's locale, so a
// /ko/ page reads Korean end-to-end rather than Korean prose in English chrome.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const renderedEntry = translation ?? post;
const { Content } = await render(renderedEntry);
const d = post.data;
// In-body photo placement: Google's image guidance is to put a photo next to the
// text it illustrates, so gallery shots go INSIDE the prose (before an <h2> near
// the middle) rather than after it. We split the already-rendered HTML at a
// heading boundary — never mid-sentence — and fall back to <Content /> whenever
// the split isn't clean, so a prose change can't silently break the article.
const renderedHtml: string = (renderedEntry as any).rendered?.html ?? '';
function splitProse(html: string): [string, string] | null {
  if (!html) return null;
  const heads = [...html.matchAll(/<h2\b/gi)].map((m) => m.index!);
  if (heads.length < 2) return null; // too few sections to interrupt
  // Prefer the heading closest to the 45% mark, but never the very first one.
  const target = html.length * 0.45;
  const cut = heads.slice(1).reduce((best, i) => (Math.abs(i - target) < Math.abs(best - target) ? i : best), heads[1]);
  if (cut < html.length * 0.15 || cut > html.length * 0.85) return null;
  return [html.slice(0, cut), html.slice(cut)];
}
// Split even without a gallery since 2026-08-13: the same heading boundary now
// also carries the mid-prose "read next" card (A3), so text-only posts get the
// recirculation link too. All the old guards hold — unsplittable prose falls
// back to <Content /> untouched.
// `linkedHtml` (same HTML with in-body guide links) is computed further down,
// after the collection lookups it needs; splitProse runs on it lazily.
let proseParts: [string, string] | null = null;
// In-page jump links (growth research A2, 2026-08-13): NN/g finds readers use
// and prefer in-page links on long articles, and 68% of travel search arrives
// on mobile where scanning is costliest. Built from the SAME rendered HTML the
// page displays, so translated pages get translated labels for free (markdown
// h2s carry slug ids in every language; template chrome h2s like "At a glance"
// have no id and are naturally excluded). Shown only at 4+ sections — a
// shorter list costs more attention than it saves.
const tocItems = [...renderedHtml.matchAll(/<h2 id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/gi)]
  .map((m) => ({ id: m[1], label: m[2].replace(/<[^>]+>/g, '').trim() }))
  .filter((x) => x.label);
const showToc = tocItems.length >= 4;
const tr = translation?.data;
const title = tr?.title ?? post.data.title;
const description = tr?.description ?? post.data.description;
const quickAnswer = tr?.quickAnswer ?? post.data.quickAnswer;
const faq = (tr?.faq?.length ? tr.faq : post.data.faq) ?? [];
// Place names are data, not UI strings — localize them via the places table so a
// Korean page reads "제주 / 아부다비", not "Jeju / Abu Dhabi". URLs keep the
// English slug; only the visible label changes.
const regionLabel = localizePlace(post.data.region, lang);
const p = d.place;

// Country-aware values (this was a Korea-only template — everything below must
// derive from the post's country, not hardcode "Korea"/"KR"/"South Korea").
const country = d.country ?? 'South Korea';
const countrySlug = country.toLowerCase().replace(/\s+/g, '-');
// City-states (Singapore, Hong Kong) set region === country, which would render
// a duplicated "Singapore / Singapore" breadcrumb — collapse it to one crumb.
const sameRegionCountry = d.region.toLowerCase() === country.toLowerCase();
// Derived from data/countries.json rather than a hand-typed map, so a newly added
// country keeps `addressCountry` in its schema instead of silently losing it.
const COUNTRY_ISO: Record<string, string> = Object.fromEntries(
  countriesData.countries.map((c: { name: string; iso2: string }) => [c.name, c.iso2.toUpperCase()])
);
const countryISO = COUNTRY_ISO[country];

// Peak-intent affiliate links for the top "Book this trip" band (city-specific,
// correct attribution, work regardless of flight/hotel program approval).
// Mapped city → curated destination page; a specific PLACE (below) keeps the
// search link — places have no destination page.
const klookTop = `/go/klook?to=${encodeURIComponent(klookCityDest(d.region, klookLocale(lang)))}`;
// language= keeps the reader in their own language after the click — 7,959
// of these links landed every reader, five languages alike, on English
// booking.com, which is where the measured 94 clicks / 0 bookings die.
const hotelTop = `https://search.hotellook.com/?marker=754088.post_top&language=${lang}&destination=${encodeURIComponent(d.region)}`;
// Place-specific "get tickets" link for the fact box — only for ticketable
// categories, keyed to the venue name itself.
const ticketable = ['attraction', 'trendy', 'hidden-gem'].includes(d.category);
const klookPlace = p?.name
  ? `/go/klook?to=${encodeURIComponent(`https://www.klook.com/${klookLocale(lang)}/search/?query=${p.name}`)}`
  : klookTop;

// Currency-neutral relative price scale (like Google Maps' $–$$$$ worldwide).
// Was Korean ₩ hardcoded — wrong on every non-Korea venue (e.g. a Tokyo café).
// index 0 is a WORD, not a symbol — it has to follow the page language.
const priceLabels = [t('post.free'), '$', '$$', '$$$', '$$$$'];
// schema.org priceRange stays English regardless of the page's language.
const priceLabelsSchema = ['Free', '$', '$$', '$$$', '$$$$'];
const stars = p?.rating ? '★'.repeat(Math.round(p.rating)) + '☆'.repeat(5 - Math.round(p.rating)) : null;
const updated = d.updatedDate ?? d.pubDate;
// Static map facade (lib/osmTile.mjs): four OSM tiles around the place, a
// CSS pin, the whole thing a link to Google Maps. Pages that outrank ours
// show a map; an iframe on every guide would cost LCP/INP (2026-08-23).
const mapMosaic = p && Number.isFinite(p.lat) && Number.isFinite(p.lng) ? tileMosaic(p.lat, p.lng) : null;
// Shown address = Google's minus a leading plus code (lib/address.mjs).
const shownAddress = p ? stripPlusCode(p.address) : '';
// Seven identical "Open 24 hours" lines (138 guides, mostly parks, beaches,
// waterfalls, markets) are Google's listing, not a schedule — a beach is
// "open" at 3am; its lifeguards and showers are not. One hedged line instead
// of a seven-line accordion (competitor audit 2026-08-23: Hyeopjae "24h" vs
// the official 10:00–19:00).
const hoursAllDay = Array.isArray(p?.openingHours) && p.openingHours.length === 7 && p.openingHours.every((l: string) => /open 24 hours/i.test(l));
const mapsSearchUrl =`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([p?.name, (d.tags && d.tags[1]) || d.category, d.region, country].filter(Boolean).join(' '))}`;

// Strip non-Latin scripts from the Google Places name (e.g. Arabic
// "مطعم الركن اليمني Yemeni Corner" → "Yemeni Corner"), same rule as titles, so
// the fact box, schema, hero alt, Klook query and related links all stay clean.
// Falls back to the original if nothing Latin remains.
const cleanName = (s: string | undefined | null) => {
  const t = (s || '')
    .replace(/[؀-ۿ一-鿿가-힣฀-๿Ѐ-ӿ぀-ヿ]/g, '')
    .replace(/\s{2,}/g, ' ')
    .replace(/^[\s\-–—,·|]+|[\s\-–—,·|]+$/g, '')
    .trim();
  return t || (s || '');
};
const placeName = cleanName(p?.name);
// The venue's own name is stored in English (Google Places) and there is no
// per-venue translation table — but the localized TITLE carries it ("광장시장:
// 서울 여행 가이드"), so its leading segment is the venue name in the reader's
// language. Falls back to the English name when a translation is missing.
const placeLabel = (lang === defaultLang
  ? placeName
  : String(title).split(/[:—]/)[0].trim() || placeName) || placeName;

// Same trick for an event: the localized title's leading segment is the event's
// name in the reader's language. On the English page the article suffix comes
// off with the shared helper instead.
const eventLabel = (lang === defaultLang
  ? eventSchemaName(post.data.title)
  : String(title).split(/[:—]/)[0].trim()) || eventSchemaName(post.data.title);

// Photo alt text, in the reader's language. It used to be an English template
// ("Gwangjang Market in Seoul, South Korea") on every page including the 1,431
// CJK ones — alt text is what image search indexes, so those photos were
// described in a language their readers never search in. Subject, region and
// country are all localized; only a venue with no translated title keeps its
// English name, which is the name on its own sign.
const photoSubject = d.category === 'event'
  ? eventLabel
  : placeLabel || (lang === defaultLang
    ? ((d.tags && d.tags[1]) || d.category)
    : t(`cat.${d.category}` as any));
const photoAlt = (subject: string) => t('post.altPlace')
  .replace('{name}', subject)
  .replace('{region}', regionLabel)
  .replace('{country}', localizePlace(country, lang));

// Real foot-traffic (BestTime.app): stored 24h hour arrays become reader-friendly
// ranges. The formatter moved to src/lib/hours.mjs so the when-to-go pages can
// print the same thing — they were headlining "verified quiet times" and showing
// venue cards with no times on them.
const fmtHourRanges = (hours: number[] | undefined) => formatHourRanges(hours, { am: t('post.am'), pm: t('post.pm'), lang });
// Resolved, not raw. 37 places store a weekend hour in BOTH the quiet and the
// busy list, and this block prints the two lines next to each other — "quiet
// 9am-5pm / busy 11am-7pm" on the same card reads as a broken page. Busy wins;
// the rule and the reasoning live in lib/busyness, shared with the crowd API.
const bz = resolveBusyness(p?.busyness);
const quietWd = fmtHourRanges(bz.weekdayQuiet), quietWe = fmtHourRanges(bz.weekendQuiet);
const busyWd = fmtHourRanges(bz.weekdayBusy), busyWe = fmtHourRanges(bz.weekendBusy);
const hasBusyness = !!(quietWd || quietWe || busyWd || busyWe);

// Map our category to a schema.org place type (helps travel AI results).
const placeType =
  d.category === 'restaurant'
    ? 'Restaurant'
    : d.category === 'attraction' || d.category === 'trendy'
    ? 'TouristAttraction'
    : 'LocalBusiness';

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Related guides for internal linking (session depth + crawl equity).
//
// The old scoring gave a point for a matching CATEGORY alone, so once a city ran
// out of its own guides the list filled with whatever shared the category —
// anywhere on earth. A Mumbai museum was recommending a lake park in Goyang and a
// pier in Qingdao. Worse, the tie-break was pubDate, so the handful of posts
// published that morning won every one of those ties and got injected across the
// whole site: three or four slugs were collecting a hundred-plus inbound links
// each while real hubs sat lower.
//
// Proximity now decides, and it never crosses a border. Same city first, then
// genuinely nearby (within ~120km — a realistic day trip, computed from the
// coordinates we already store), then same country. A post with no honest
// neighbour shows fewer cards, which is a better outcome than a wrong one.
const NEAR_KM = 120;
const distKm = (a: any, b: any) => {
  if (!a?.lat || !a?.lng || !b?.lat || !b?.lng) return Infinity;
  const R = 6371, toRad = (x: number) => (x * Math.PI) / 180;
  const dLat = toRad(b.lat - a.lat), dLng = toRad(b.lng - a.lng);
  const s =
    Math.sin(dLat / 2) ** 2 +
    Math.cos(toRad(a.lat)) * Math.cos(toRad(b.lat)) * Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(s));
};
const thisCountry = d.country ?? 'South Korea';
const related = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((r) => r.id !== post.id && (r.data.country ?? 'South Korea') === thisCountry)
  .map((r) => {
    const km = distKm(d.place, r.data.place);
    const sameCity = r.data.region === d.region;
    // 100 same city · 60 within a day trip · 20 same country. Category only ever
    // breaks a tie between equally close places — it can no longer summon a
    // continent-away venue on its own.
    const proximity = sameCity ? 100 : km <= NEAR_KM ? 60 : 20;
    return { r, km, score: proximity + (r.data.category === d.category ? 5 : 0) };
  })
  .sort((a, b) => b.score - a.score || a.km - b.km || a.r.id.localeCompare(b.r.id))
  .slice(0, 4);
// Mid-prose "read next" (growth research A3, 2026-08-13): readers who click an
// internal link average 3.7 pages/session vs 1.2 for those who don't, and the
// end-of-page Related section only reaches people who finish. One inline card
// at the same heading boundary the gallery uses — but only when the best
// neighbour is genuinely close (same city or a ≤120km day trip, score ≥60);
// a same-country-but-800km "next read" mid-article would be noise.
const midRelated = related[0] && related[0].score >= 60 ? related[0].r : null;
const relatedPosts = related.map((x) => x.r);

// More same-city guides beyond the 4 "Related" — strengthens the city cluster with
// contextual internal links (the site otherwise has almost no in-body post→post links).
// Keep internal links inside the reader's language: show the translated title and
// point at the localized URL — but only when that translation actually exists,
// otherwise fall back to the English page rather than linking to a 404.
const sameLangTitles =
  lang === defaultLang
    ? new Map<string, string>()
    : new Map(
        (await getCollection('postI18n', ({ data }) => data.lang === lang)).map((e) => [e.data.slug, e.data.title])
      );
const postHref = (id: string) => (sameLangTitles.has(id) ? `/${lang}/posts/${id}/` : `/posts/${id}/`);
const postTitle = (r: any) => sameLangTitles.get(r.id) ?? r.data.title;

// Which languages THIS post exists in — English always, plus each language it's
// been translated into — so the switcher only offers real, non-404 links.
const translatedLangs = new Set(
  (await getCollection('postI18n', ({ data }) => data.slug === post.id)).map((e) => e.data.lang)
);
const availableLangs = (['en', 'ko', 'ja', 'es', 'zh'] as const).filter(
  (l) => l === 'en' || translatedLangs.has(l)
);

const relatedIds = new Set(relatedPosts.map((r) => r.id));
// Same-city previous/next (2026-08-23): of the 55 sessions that entered on a
// guide in the clean analytics window, ONE moved to a second page. The
// related list sat below the newsletter as four lines of text; it is now
// thumbnail cards above it, plus a fixed pair of neighbours in the same city
// so there is always a "next" even when the scorer finds little.
const cityPosts = (await getCollection('posts', ({ data }) => !data.draft && data.region === d.region && (data.country ?? 'South Korea') === thisCountry))
  .sort((a, b) => a.id.localeCompare(b.id));
const cityIdx = cityPosts.findIndex((r) => r.id === post.id);
const prevInCity = cityIdx > 0 ? cityPosts[cityIdx - 1] : null;
const nextInCity = cityIdx >= 0 && cityIdx < cityPosts.length - 1 ? cityPosts[cityIdx + 1] : null;
// Nearest first when both sides have coordinates (2026-08-23): "More Genoa
// guides" used to be the first six by file name; now it is the six closest,
// each with its distance, so the line reads as a map rather than a list.
const nearby = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((r) => r.id !== post.id && r.data.region === d.region && !relatedIds.has(r.id))
  .map((r) => ({ r, km: distKm(d.place, r.data.place) }))
  .sort((a, b) => a.km - b.km || a.r.id.localeCompare(b.r.id))
  .slice(0, 6);
const kmLabel = (km: number) => (Number.isFinite(km) ? (km < 1 ? `${Math.max(1, Math.round(km * 10)) * 100} m` : `${km < 10 ? km.toFixed(1) : Math.round(km)} km`) : '');

// In-body links to our own guides (lib/body-links.mjs): the first plain-text
// mention of a same-country place we cover becomes a link, at most four per
// article, never inside an existing link or heading. A place guide carried
// ONE body link against an event guide's six (UX audit 2026-08-23). Names
// are the localised title heads, so a Korean page links Korean mentions.
const ownHead = postTitle(post).split(/[:—|]/)[0].trim().toLowerCase();
const linkTargets = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((r) => r.id !== post.id && (r.data.country ?? 'South Korea') === thisCountry)
  .map((r) => ({ name: postTitle(r).split(/[:—|]/)[0].trim(), href: postHref(r.id) }))
  // Korean/Japanese/Chinese names are short ("경복궁" is three characters);
  // the five-character floor is for Latin names, where "Bar" would link noise.
  .filter((x) => x.name.length >= (/[぀-鿿가-힯]/.test(x.name) ? 2 : 5) && x.name.toLowerCase() !== ownHead);
const linkedHtml = linkMentions(renderedHtml, linkTargets, { max: 4, minLen: 2 });
proseParts = splitProse(linkedHtml);

// Itinerary flywheel (spec §3): if this post is a stop in a published itinerary,
// link back to it — "This spot is Day N of our City X-day itinerary". Computed
// ONCE as a slug→itinerary map (not per-post work inside a loop) so N posts
// cost one getCollection call + one pass over itineraries, not N passes.
const itinerariesForBacklinks = await getCollection('itineraries', ({ data }) => !data.draft);
const itinBacklinksBySlug = new Map<string, { itineraryId: string; city: string; days: number; dayNumber: number }[]>();
for (const it of itinerariesForBacklinks) {
  it.data.itinerary.forEach((day: any, di: number) => {
    for (const stop of day.stops) {
      const list = itinBacklinksBySlug.get(stop.slug) ?? [];
      list.push({ itineraryId: it.id, city: it.data.city, days: it.data.days, dayNumber: di + 1 });
      itinBacklinksBySlug.set(stop.slug, list);
    }
  });
}
// A post could theoretically appear in more than one itinerary — show at most 2.
const itineraryBacklinks = (itinBacklinksBySlug.get(post.id) ?? []).slice(0, 2);
const itineraryHref = (id: string) => localizePath(`/itinerary/${id}`, lang);

// A RECURRING event (annual festival, GP, championship, film festival…) keeps
// its page indexed after it ends AND advertises a yearly cadence in schema, so it
// can win "when is X <next year>" as the next edition approaches. The rule lives
// in eventRecurrence.mjs because the sitemap filter needs the SAME answer — when
// it had its own (nonexistent) rule, three recurring events were indexable here
// and missing from the sitemap.
// Reads the stored eventRecurring when the discovery search answered, and
// falls back to the title heuristic for everything published before that
// question was asked. Matches the ENGLISH source data, never the translation.
const isRecurringEvent = resolveRecurring({ ...post.data, title: post.data.title });

// ---- Structured data graph (Article + Place + FAQ + Breadcrumbs) ----
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    headline: title,
    description: description,
    datePublished: d.pubDate.toISOString(),
    dateModified: updated.toISOString(),
    image: d.heroImage?.url ? { '@type': 'ImageObject', url: new URL(d.heroImage.url, Astro.site).toString() } : undefined,
    // Author is the editor's disclosed pen name (Person #editor in BaseLayout,
    // 2026-08-08); the org stays publisher. A consistent named author across
    // every article is the E-E-A-T signal an org-only byline can't send.
    author: { '@id': `${site}/#editor` },
    publisher: { '@id': `${site}/#org` },
    isPartOf: { '@id': `${site}/#site` },
    // Was 'en' on all 2,332 localized article pages — see BaseLayout.
    inLanguage: localeCodes[lang],
    mainEntityOfPage: pageUrl,
  },
  {
    '@type': 'BreadcrumbList',
    // Names and URLs both follow the page's own language. They used to be
    // English throughout — "Home / South Korea / Andong" pointing at /destinations/…
    // — while the visible trail on the same page read "홈 / 대한민국 / 안동"
    // linking to /ko/…. A Japanese searcher saw an English breadcrumb in the
    // SERP, and the schema pulled every localized page into the English tree
    // (found 2026-08-06).
    itemListElement: [
      { name: t('post.home'), item: `${site}${localizePath('/', lang)}` },
      { name: localizePlace(country, lang), item: `${site}${localizePath(`/destinations/${countrySlug}`, lang)}/` },
      ...(sameRegionCountry ? [] : [{ name: regionLabel, item: `${site}${localizePath(`/regions/${slugifyRegion(d.region)}`, lang)}/` }]),
      { name: title, item: pageUrl },
    ].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })),
  },
];

if (p?.name) {
  graph.push({
    '@type': placeType,
    name: placeName,
    address: stripPlusCode(p.address)
      ? { '@type': 'PostalAddress', streetAddress: stripPlusCode(p.address), ...(countryISO && { addressCountry: countryISO }) }
      : undefined,
    geo: p.lat && p.lng ? { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lng } : undefined,
    // NOTE: we deliberately do NOT emit aggregateRating here. The rating is
    // Google's, not review data we host, so marking it up as our own would
    // violate Google's review-snippet policy (manual-action risk). We still
    // SHOW the rating on-page, clearly attributed to Google.
    priceRange: typeof p.priceLevel === 'number' ? priceLabelsSchema[p.priceLevel] : undefined,
    telephone: p.phone || undefined,
    hasMap: p.googleMapsUrl,
  });
}

if (faq.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f: any) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

// Event schema for event posts with a known date — lets Google/AI surface it as a
// dated event (the whole reason the events hub can win "upcoming …" queries).
if (d.category === 'event' && d.eventStartDate) {
  const isoDay = (x: string | Date) => new Date(x).toISOString().slice(0, 10);
  graph.push({
    '@type': 'Event',
    // The event's own name, never the article headline — Google prints this
    // verbatim in the event card. See eventName.mjs for why it comes from the
    // English title on every language's page.
    name: eventSchemaName(post.data.title),
    startDate: isoDay(d.eventStartDate),
    ...(d.eventEndDate && { endDate: isoDay(d.eventEndDate) }),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    // Recurring events advertise a yearly cadence (byMonth from the start date) so
    // search engines understand the next edition is expected ~annually.
    ...(isRecurringEvent && {
      eventSchedule: {
        '@type': 'Schedule',
        repeatFrequency: 'P1Y',
        byMonth: new Date(d.eventStartDate).getUTCMonth() + 1,
      },
    }),
    location: {
      '@type': 'Place',
      name: d.region,
      address: { '@type': 'PostalAddress', addressLocality: d.region, ...(countryISO && { addressCountry: countryISO }) },
    },
    ...(d.heroImage?.url && { image: new URL(d.heroImage.url, Astro.site).toString() }),
    description: description,
    // Organizer only when it is the REAL one, verified and stored in the
    // post's own frontmatter (eventOrganizer). This used to declare Wander
    // Atlas as the organizer of every event on the site — that we run La
    // Tomatina, the Spanish Grand Prix and Comiket — a false statement in
    // machine-readable form on 98 live pages. Removed 2026-08-07; GSC then
    // flagged the absence (non-critical) on 2026-08-08, and the answer to
    // that warning is verified data, never a placeholder: an absent optional
    // property is worth strictly more than a wrong one.
    ...(d.eventOrganizer && {
      organizer: {
        '@type': 'Organization',
        name: d.eventOrganizer.name,
        ...(d.eventOrganizer.url && { url: d.eventOrganizer.url }),
      },
    }),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };

// Expiry 2-track (SEO): a ONE-OFF past event (single concert/tour stop) → noindex
// to keep the young domain clean of thin/outdated pages (URL stays live at 200).
// RECURRING events stay indexed (see isRecurringEvent above) — they win
// "when is X 2027" as the next edition approaches.
const noindexPost = isEventPast(d) && !isRecurringEvent;
// What the visitor carries away. Written at save time so /my-trip needs no
// lookup: the phone number, hours and quiet window are the things people
// actually want once they are standing outside the place.
// The WHOLE week, not one line. Taking openingHours[0] took MONDAY and dropped the
// day name, so 54 venues saved hours wrong on up to six days and 16 — including
// Chatuchak WEEKEND Market and the Forbidden City — saved the word "Closed" as
// their hours. /my-trip picks the line for the day the reader is actually looking.
// Weekday names went untranslated here too — the saved trip showed a Korean
// reader "Monday: 8:00 오전". Same helper as the fact box, so they cannot drift.
// The list thumbnail is 92x68; the stored hero URL is a 1920px original, and
// saving it as-is meant six saved places downloaded 3.2MB of image into a page
// of thumbnails. Both hosts render smaller sizes on request — ask for one that
// Wikimedia actually serves (see wikimediaThumb: the ladder is fixed).
const saveThumb = wikimediaThumb(String(d.heroImage?.url ?? ''), 500)
  .replace(/(fastly\.4sqi\.net\/img\/general\/)original\//, '$1width320/');
// The hero <img> renders at 1200 CSS px but shipped the stored 1920px
// original — 2.3x the bytes on the page's LCP element (Lighthouse audit,
// 2026-08-10; post LCP 1.59s vs home 0.68s).
// That fix asked for /1200px-, which is NOT on Wikimedia's served ladder, and
// every hero on the site went blank the same day. 1280 is the next rung up and
// is served; the <img> below also falls back to the stored URL on error, so a
// future ladder change cannot blank the page again.
// og:image keeps the ORIGINAL — the Discover ≥1200px invariant and its width
// scanner are untouched.
const heroDisplay = wikimediaThumb(String(d.heroImage?.url ?? ''), 1280)
  .replace(/(fastly\.4sqi\.net\/img\/general\/)original\//, '$1width1200/');
// Self-hosted first (2026-08-23): 1,192 heroes are already mirrored to R2 as
// 1200px WebP for og:image (data/og-mirror.json, same photo, never cropped).
// The hero <img> hotlinked Wikimedia/Foursquare instead — on an event guide
// the frame was still empty two seconds after load, and readers behind
// networks that stall upload.wikimedia.org (the owner's, for one) saw a grey
// box. The mirrored copy is one origin, one hop, and already warm; the
// Wikimedia rung stays as the fallback, and the stored URL behind that.
const heroMirror = (ogMirror as Record<string, string | null>)[String(d.heroImage?.url ?? '').trim()] || '';
const heroSrc = heroMirror || heroDisplay || d.heroImage?.url;

const saveHours = (p?.openingHours ?? []).map((l: string) =>
  localizeOpeningLine(l, lang, { am: t('post.am'), pm: t('post.pm') })
);
// Weekday and weekend quiet windows differ at 15 of the 26 venues that have both,
// so both travel and /my-trip shows whichever matches today.
const saveQuiet = { wd: quietWd || '', we: quietWe || '' };

---

<BaseLayout
  title={title}
  description={description}
  image={d.heroImage?.url}
  article={true}
  jsonLd={jsonLd}
  noindex={noindexPost}
  localized={true}
  localizedLangs={availableLangs}
>
  <article class="article wrap">
    {/* Every crumb goes through localizePath. The country and region hrefs were
        hardcoded English while their labels were translated, so a Korean reader
        tapping "아랍에미리트" was dropped onto the English country page — 3,796
        links, the single biggest way translated readers fell out of their
        language. The label was right and the destination was wrong. */}
    <nav class="crumbs" aria-label={t('a11y.breadcrumb')}>
      <a href={localizePath('/', lang)}>{t('post.home')}</a> <span>/</span>
      <a href={localizePath(`/destinations/${countrySlug}/`, lang)}>{localizePlace(country, lang)}</a> <span>/</span>
      {!sameRegionCountry && (
        <><a href={localizePath(`/regions/${slugifyRegion(d.region)}/`, lang)}>{regionLabel}</a> <span>/</span></>
      )}
      <span aria-current="page">{t(('cat.' + d.category) as any)}</span>
    </nav>

    <div class="article-head">
      <div class="kicker">
        <span class="badge">{t(('cat.' + d.category) as any)}</span>
        <span>{regionLabel}</span>
        <span>·</span>
        <time datetime={updated.toISOString()}>
          {d.updatedDate ? t('post.updated') : t('post.published')} {updated.toLocaleDateString(localeCodes[lang], { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
      <h1>{title}</h1>
      <p class="byline">
        <Fragment set:html={t('post.byline').replace('{team}', `<a href="${localizePath('/about', lang)}">${SITE.name} ${t('post.editorialTeam')}</a>`)} />
      </p>
      {/* Photoless posts still need a reachable save — the hero overlay below
          (the primary placement) only exists when there is a hero. */}
      {!d.heroImage && p?.name && (
        <div class="head-save">
          <SaveButton
            slug={post.id}
            title={placeLabel}
            region={regionLabel}
            country={localizePlace(country, lang)}
            href={Astro.url.pathname}
            lat={p.lat}
            lng={p.lng}
            phone={p.phone ?? ""}
            hours={saveHours}
            quiet={saveQuiet}
            image={saveThumb}
            lang={lang}
            prominent={true}
          />
        </div>
      )}
    </div>

    {d.heroImage && (
      <figure class="article-hero">
        {/* Save floats on the hero, top-right — the position Airbnb/Pinterest
            taught everyone means "keep this" (owner iteration 2, 2026-08-13:
            a pill under the byline still read as chrome and got skipped; on
            the photo it reads as an action on the PLACE). White chip so it
            carries on any photo; the fact-box twin stays for readers who
            decide at the bottom. */}
        {p?.name && (
          <div class="hero-save">
            <SaveButton
              slug={post.id}
              title={placeLabel}
              region={regionLabel}
              country={localizePlace(country, lang)}
              href={Astro.url.pathname}
              lat={p.lat}
              lng={p.lng}
              phone={p.phone ?? ""}
              hours={saveHours}
              quiet={saveQuiet}
              image={saveThumb}
              lang={lang}
              overlay={true}
            />
          </div>
        )}
        {/* data-full is the STORED url — the one Wikimedia handed us, so the one
            that is certain to resolve. If the display rung ever 400s (the whole
            site's heroes went blank on 2026-08-10 when an off-ladder width
            shipped), the reader still gets the photo instead of an empty frame. */}
        <img
          src={heroSrc}
          data-full={heroMirror && heroDisplay ? heroDisplay : d.heroImage.url}
          data-stored={d.heroImage.url}
          alt={photoAlt(photoSubject)}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          style={d.heroImage.focus ? `object-position:${d.heroImage.focus.x}% ${d.heroImage.focus.y}%` : undefined}
          data-focus={d.heroImage.focus ? 'stored' : 'auto'}
          onerror="if(this.dataset.full&&this.src!==this.dataset.full){this.src=this.dataset.full}else if(this.dataset.stored&&this.src!==this.dataset.stored){this.src=this.dataset.stored}"
        />
        {d.heroImage.credit && (
          <figcaption>
            {d.heroImage.source?.startsWith('http') ? (
              <a href={d.heroImage.source} target="_blank" rel="noopener nofollow">{d.heroImage.credit}</a>
            ) : d.heroImage.credit}
          </figcaption>
        )}
      </figure>
    )}

    {quickAnswer && (
      <aside class="quick-answer">
        <span class="qa-label">{t('post.quickAnswer')}</span>
        <p>{quickAnswer}</p>
      </aside>
    )}

    {isEventPast(d) ? (
      <div class="book-cta">
        <span class="book-cta-label">{t('post.eventEnded')}</span>
        <div class="book-cta-btns">
          <a class="book-btn book-btn-primary" href="/events"><Emoji name="admission-tickets" /> {t('post.upcomingEvents')}</a>
          <a class="book-btn" href="#newsletter"><Emoji name="wrapped-gift" /> {t('post.eventUpdates')}</a>
        </div>
      </div>
    ) : (
      <div class="book-cta">
        <span class="book-cta-label">{t('post.planningTrip').replace('{region}', regionLabel)}</span>
        <div class="book-cta-btns">
          {/* An event's OWN ticket/official page first, when discovery verified
              one (38 of 51 upcoming events, 2026-08-23). The winners for
              event queries all carry a ticket button; ours had only the
              city-level Klook link. Plain rel — this is not an affiliate. */}
          {d.category === 'event' && d.eventOrganizer?.url && (
            <a class="book-btn book-btn-primary" href={d.eventOrganizer.url} target="_blank" rel="noopener"><Emoji name="admission-tickets" /> {t('post.officialTickets')}</a>
          )}
          <a class:list={['book-btn', { 'book-btn-primary': !(d.category === 'event' && d.eventOrganizer?.url) }]} href={klookTop} target="_blank" rel="sponsored noopener"><Emoji name="admission-tickets" /> {t('post.thingsToDo')}</a>
          <a class="book-btn" href={hotelTop} target="_blank" rel="sponsored noopener"><Emoji name="hotel" /> {t('post.findHotels')}</a>
        </div>
        {/* Trust signal beside the FIRST ask (authority bias): the fact box proving
            the data is real sits far below, so restate it where the click happens. */}
        {p && (
          <p class="cta-trust">✓ {t('post.verified')} · {updated.toLocaleDateString(localeCodes[lang], { year: 'numeric', month: 'short', day: 'numeric' })}</p>
        )}
      </div>
    )}

    {p && (p.address || p.rating || p.priceLevel !== undefined) && (
      <div class="fact-box">
        <h2>{t('post.atAGlance')}</h2>
        <div class="fact-grid">
          {placeName && <div class="fact"><span class="k">{t('post.place')}</span><span class="v">{placeLabel}</span></div>}
          {shownAddress && <div class="fact"><span class="k">{t('post.address')}</span><span class="v">{shownAddress}</span></div>}
          {typeof p.rating === 'number' && (
            <div class="fact"><span class="k">{t('post.rating')}</span><span class="v"><span class="stars">{stars}</span> {p.rating}
              {p.userRatingsTotal ? ` (${p.userRatingsTotal.toLocaleString()})` : ''}</span></div>
          )}
          {typeof p.priceLevel === 'number' && <div class="fact"><span class="k">{t('post.price')}</span><span class="v">{priceLabels[p.priceLevel]}</span></div>}
          {p.phone && (
            <div class="fact"><span class="k">{t('post.phone')}</span><span class="v"><a class="phone-link" href={`tel:${p.phone.replace(/[^+\d]/g, '')}`}>{p.phone}</a></span></div>
          )}
        </div>
        {hoursAllDay ? (
          <div class="fact"><span class="k">{t('post.openingHours')}</span><span class="v">{t('post.open24')}</span></div>
        ) : p.openingHours && p.openingHours.length > 0 && (
          <details class="hours">
            <summary><Emoji name="three-oclock" /> {t('post.openingHours')}</summary>
            <ul>
              {p.openingHours.map((line: string) => <li>{localizeOpeningLine(line, lang, { am: t('post.am'), pm: t('post.pm') })}</li>)}
            </ul>
          </details>
        )}
        {hasBusyness && (
          <div class="busyness">
            <span class="bz-title"><Emoji name="chart-increasing" /> {t('post.bestTime')}</span>
            {(quietWd || quietWe) && (
              <div class="bz-row"><span class="bz-k">{t('post.quietest')}</span><span class="bz-v">
                {quietWd && <><b>{t('post.weekdays')}</b> {quietWd}</>}{quietWd && quietWe ? ' · ' : ''}{quietWe && <><b>{t('post.weekends')}</b> {quietWe}</>}
              </span></div>
            )}
            {(busyWd || busyWe) && (
              <div class="bz-row"><span class="bz-k">{t('post.busiest')}</span><span class="bz-v">
                {busyWd && <><b>{t('post.weekdays')}</b> {busyWd}</>}{busyWd && busyWe ? ' · ' : ''}{busyWe && <><b>{t('post.weekends')}</b> {busyWe}</>}
              </span></div>
            )}
            <p class="bz-credit">{t('post.footTraffic')} <a href="https://besttime.app" target="_blank" rel="noopener nofollow">BestTime.app</a></p>
            {/* The crowd tool is the site's #2 page, and until now the ~157 posts
                that display this exact data linked to it from nowhere — it lived
                only in the header dropdown. A reader looking at one venue's quiet
                hours is precisely the person who wants to compare a whole city. */}
            <p class="bz-more"><a href={localizePath('/tools/best-time', lang)}>{t('post.compareQuiet')} →</a></p>
            {/* Any site can embed this chart; the snippet carries a link back here,
                so the data earns backlinks instead of us chasing them. */}
            <details class="bz-embed">
              <summary>{t('post.embedChart')}</summary>
              <p class="bz-embed-hint">{t('post.embedHint')}</p>
              <textarea readonly rows="3" class="bz-embed-code" onclick="this.select()">{`<iframe src="${site}/embed/crowd/${post.id.replace(/\.md$/, '')}" width="100%" height="260" style="border:1px solid #e4dccd;border-radius:12px;max-width:420px" loading="lazy" title="${(p.name || '').replace(/"/g, '&quot;')} busy times — Wander Atlas"></iframe>`}</textarea>
            </details>
          </div>
        )}
        {mapMosaic && (
          <a class="map-facade" href={p.googleMapsUrl || mapsSearchUrl} target="_blank" rel="noopener" aria-label={t('post.openMaps')}>
            <span class="map-tiles" style={`width:${mapMosaic.width}px;height:${mapMosaic.height}px;margin-left:${-Math.round(mapMosaic.px)}px;margin-top:${-Math.round(mapMosaic.py)}px`}>
              {mapMosaic.tiles.map((tl) => (
                <img src={tl.url} width="256" height="256" loading="lazy" decoding="async" alt="" style={`left:${tl.dx}px;top:${tl.dy}px`} />
              ))}
            </span>
            <span class="map-pin" aria-hidden="true"></span>
            <span class="map-facade-label"><Emoji name="round-pushpin" /> {t('post.openMaps')} →</span>
            <span class="map-attr">{TILE_ATTRIBUTION}</span>
          </a>
        )}
        <div class="fact-actions">
          {p?.name && (
            <SaveButton
              slug={post.id}
              title={placeLabel}
              region={regionLabel}
              country={localizePlace(country, lang)}
              href={Astro.url.pathname}
              lat={p.lat}
              lng={p.lng}
              phone={p.phone ?? ""}
              hours={saveHours}
              quiet={saveQuiet}
              image={saveThumb}
              lang={lang}
            />
          )}
          {ticketable && p.name && (
            <a class="fact-ticket" href={klookPlace} target="_blank" rel="sponsored noopener"><Emoji name="admission-tickets" /> {t('post.ticketsFor').replace('{place}', placeLabel)}</a>
          )}
          {p.googleMapsUrl && (
            <a class="map-link" href={p.googleMapsUrl} target="_blank" rel="noopener"><Emoji name="round-pushpin" /> {t('post.openMaps')}</a>
          )}
        </div>
      </div>
    )}

    {!(p && p.googleMapsUrl) && d.region && (
      <p class="map-cta">
        <a
          class="map-link"
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
            [p?.name, (d.tags && d.tags[1]) || d.category, d.region, country]
              .filter(Boolean)
              .join(' ')
          )}`}
          target="_blank"
          rel="noopener nofollow"
        >
          <Emoji name="round-pushpin" /> {t('post.exploreMaps')}
        </a>
      </p>
    )}

    {/* The AI/data disclosure used to be the literal LAST element on the page —
        a compliance footnote as the reader's final impression (Peak-End violation).
        Collapsed here next to the facts it describes; related guides now end the page. */}
    <details class="disclosure-details">
      <summary>{t('post.disclosureTitle')}</summary>
      <p>{t('post.disclosureBody')} <a href={localizePath('/about', lang)}>{t('post.editorialPolicy')}</a></p>
    </details>

    {showToc && (
      <nav class="post-toc" aria-label={t('post.toc')}>
        <span class="post-toc-label">{t('post.toc')}</span>
        {tocItems.map((h) => (
          <a href={`#${h.id}`}>{h.label}</a>
        ))}
      </nav>
    )}

    <div class="prose">
      {proseParts ? (
        <>
          <Fragment set:html={proseParts[0]} />
          {d.gallery.length > 0 && (
            <section class="gallery">
              {d.gallery.map((img: any) => (
                <figure>
                  <img
                    src={img.url}
                    alt={placeLabel ? photoAlt(placeLabel) : title}
                    width="1200"
                    height="900"
                    loading="lazy"
                    decoding="async"
                  />
                  {img.credit && <figcaption>{img.credit}</figcaption>}
                </figure>
              ))}
            </section>
          )}
          {midRelated && (
            <aside class="read-next">
              <span class="read-next-label">{t('post.readNext')}</span>
              <a href={postHref(midRelated.id)}>{postTitle(midRelated)}</a>
              <span class="rel-region">{localizePlace(midRelated.data.region, lang)}</span>
            </aside>
          )}
          <Fragment set:html={proseParts[1]} />
        </>
      ) : (
        <Content />
      )}
    </div>

    {/* Gallery fallback: when the prose has too few headings to interrupt cleanly,
        the photos still render — right after the prose, before the widgets. */}
    {d.gallery.length > 0 && !proseParts && (
      <section class="gallery">
        {d.gallery.map((img: any) => (
          <figure>
            <img
              src={img.url}
              alt={placeLabel ? photoAlt(placeLabel) : title}
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
            />
            {img.credit && <figcaption>{img.credit}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    {/* Peak-motivation CTA: the reader just finished the case for visiting, so the
        FIRST thing after the prose names the actual place — the generic city-level
        blocks (Hotels/PlanTrip) used to sit here, wasting the strongest moment. */}
    {p?.name && !isEventPast(d) && (
      <div class="visit-cta">
        <span class="visit-cta-q">{t('post.visitCta').replace('{name}', placeLabel)}</span>
        <div class="book-cta-btns">
          <a class="book-btn book-btn-primary" href={klookPlace} target="_blank" rel="sponsored noopener"><Emoji name="admission-tickets" /> {t('post.visitTickets')}</a>
          <a class="book-btn" href={hotelTop} target="_blank" rel="sponsored noopener"><Emoji name="hotel" /> {t('post.visitHotels')}</a>
        </div>
      </div>
    )}

    {/* FAQ before the commerce. Three affiliate sections used to follow the
        prose (Tours widget, Where to stay, Plan your trip — ~1,250px on a
        phone) and the FAQ and related guides sat behind that wall; 94 clicks
        and 0 bookings said the extra surface was not converting anyone (UX
        audit 2026-08-23). One block now, hotels folded into it; Tours and
        Hotels still render on the region hubs. */}
    {faq.length > 0 && (
      <section class="faq">
        <h2>{t('post.faqTitle')}</h2>
        {faq.map((f: any) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}

    <PlanTrip city={d.region} country={d.country ?? 'South Korea'} hotels />

    <ShareRow url={pageUrl} title={title} lang={lang} />

    {(relatedPosts.length > 0 || prevInCity || nextInCity) && (
      <section class="related">
        <h2>{t('post.related')}</h2>
        {relatedPosts.length > 0 && (
          <div class="grid related-grid">
            {relatedPosts.slice(0, 3).map((r) => (
              <PostCard
                href={postHref(r.id)}
                title={postTitle(r)}
                region={r.data.region}
                category={r.data.category}
                image={r.data.heroImage?.url}
                rating={r.data.place?.rating}
                eventEndDate={r.data.eventEndDate}
              />
            ))}
          </div>
        )}
        {(prevInCity || nextInCity) && (
          <nav class="related-nav" aria-label={t('post.related')}>
            {prevInCity ? (
              <a class="related-nav-prev" href={postHref(prevInCity.id)}>
                <span class="related-nav-k">{t('post.prevInCity').replace('{city}', regionLabel)}</span>
                <span class="related-nav-t">{postTitle(prevInCity)}</span>
              </a>
            ) : <span />}
            {nextInCity && (
              <a class="related-nav-next" href={postHref(nextInCity.id)}>
                <span class="related-nav-k">{t('post.nextInCity').replace('{city}', regionLabel)}</span>
                <span class="related-nav-t">{postTitle(nextInCity)}</span>
              </a>
            )}
          </nav>
        )}
      </section>
    )}

    <Newsletter
      compact
      lang={lang}
      region={post.data.region}
      country={country}
      heading={d.category === 'event' ? t('ev.neverMissGlobal') : t('post.moreTips').replace('{region}', regionLabel)}
      dek={d.category === 'event' ? t('ev.neverMissDekGlobal') : t('region.newsletterDek').replace('{region}', regionLabel)}
    />

    {itineraryBacklinks.length > 0 && (
      <section class="itin-backlink" aria-label={t('itin.indexEyebrow')}>
        {itineraryBacklinks.map((b) => (
          <a class="itin-backlink-card" href={itineraryHref(b.itineraryId)}>
            <span class="itin-backlink-ico"><Emoji name="world-map" /></span>
            <p>{t('itin.postBacklink').replace('{n}', String(b.dayNumber)).replace('{city}', localizePlace(b.city, lang)).replace('{days}', String(b.days))}</p>
          </a>
        ))}
      </section>
    )}

    {nearby.length > 0 && (
      <p class="nearby-links">
        {t('post.moreGuides').replace('{region}', regionLabel)}{' '}
        {/* Translated title FIRST: place.name is the raw English Google name, so
            preferring it printed "Gyeongbokgung Palace" on the Korean page. */}
        {nearby.map(({ r, km }, i) => (
          <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={postHref(r.id)}>{postTitle(r).split(/[:—]/)[0].trim() || r.data.place?.name}</a>{kmLabel(km) && <span class="nearby-km"> {kmLabel(km)}</span>}</>
        ))}
      </p>
    )}

  </article>

  {/* Image lightbox — owner request 2026-08-01: click any article photo to see
      it large. Dependency-free <dialog> (ESC/backdrop close come built in);
      the credit line rides along because CC BY-SA attribution must stay with
      the image wherever it is shown, enlarged included. */}
  <dialog id="img-lightbox" aria-label={t('a11y.enlargedPhoto')}>
    <button type="button" class="lb-close" aria-label={t('a11y.close')}><Emoji name="close" /></button>
    <img alt="" />
    <p class="lb-credit"></p>
  </dialog>
  <script>
    const box = document.getElementById('img-lightbox') as HTMLDialogElement | null;
    if (box) {
      const pic = box.querySelector('img')!;
      const credit = box.querySelector('.lb-credit')!;
      // Wikimedia serves a FIXED ladder of widths and rejects anything else
      // (400/429, "Use thumbnail sizes listed on w.wiki/GHai"). 2400 was not on
      // it, so this only ever worked because of the onerror fallback below —
      // every enlarge quietly cost a failed request first. 1920 is the rung the
      // stored URLs already use, so ask for the one above it and let the
      // fallback handle originals that are smaller.
      const bigger = (src: string) =>
        src.replace(/\/(\d{2,4})px-/, (m, w) => (Number(w) < 1920 ? '/1920px-' : m));
      document.querySelectorAll<HTMLImageElement>('.article-hero img, .gallery img').forEach((img) => {
        img.addEventListener('click', () => {
          const big = bigger(img.src);
          pic.onerror = () => { if (pic.src !== img.src) pic.src = img.src; };
          pic.src = big;
          pic.alt = img.alt;
          credit.textContent = img.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
          box.showModal();
        });
      });
      box.querySelector('.lb-close')?.addEventListener('click', () => box.close());
      // Backdrop click closes: a click landing on the dialog element itself
      // (not its children) can only be the backdrop area.
      box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
      box.addEventListener('close', () => { pic.src = ''; });
    }
  </script>

  <StickyBook city={d.region} place={p?.name} />
</BaseLayout>
