---
// Site-wide email-capture slide-in (lead magnet: free trip checklist).
// SEO-safe by design: never shown on load, never full-screen — Google's
// intrusive-interstitial penalty targets content-blocking overlays, so this is
// a corner card (desktop) / bottom sheet above the sticky bar (mobile) that
// appears only on engagement (50% scroll) or exit intent (desktop mouseout).
// Frequency: once per session; dismiss = 14-day snooze; subscribe = never again
// (localStorage). Skipped on the checklist page itself (it IS the magnet).
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { interestFields } from '../lib/interest';
import Emoji from './Emoji.astro';

interface Props { region?: string; country?: string }
const { region = '', country = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const interest = interestFields({ region, country, lang, source: `popup:${Astro.url.pathname}` });
const checklistHref = lang === 'en' ? '/free/trip-checklist' : `/${lang}/free/trip-checklist`;
const onChecklistPage = Astro.url.pathname.includes('/free/trip-checklist');
---
{!onChecklistPage && (
<aside class="nl-popup" data-nl-popup hidden aria-hidden="true" role="dialog" aria-labelledby="nlp-title">
  <button class="nlp-close" data-nlp-close aria-label={t('a11y.close')}>&times;</button>
  <p class="nlp-title" id="nlp-title"><Emoji name="wrapped-gift" /> {t('popup.title')}</p>
  <p class="nlp-dek">{t('popup.dek')}</p>
  <form class="nlp-form" data-ml-action="/api/subscribe" data-checklist={checklistHref} data-success={t('popup.success')} data-error={t('popup.error')} novalidate>
    <input type="email" name="email" placeholder="you@email.com" aria-label={t('a11y.email')} autocomplete="email" required />
    <input type="hidden" name="region" value={interest.region} />
    <input type="hidden" name="lang" value={interest.lang} />
    <input type="hidden" name="source" value={interest.source} />
    <button type="submit" class="btn btn-primary nlp-cta">{t('popup.cta')}</button>
  </form>
  <p class="nlp-note" hidden aria-live="polite"></p>
  <button class="nlp-decline" data-nlp-close>{t('popup.decline')}</button>
</aside>
)}

<style>
  .nl-popup {
    position: fixed;
    z-index: 60;
    right: 1rem;
    bottom: 1rem;
    width: min(380px, calc(100vw - 2rem));
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: 0 12px 40px rgba(32, 28, 23, 0.18);
    padding: 1.2rem 1.3rem 1rem;
    animation: nlp-in 0.35s ease-out;
  }
  @keyframes nlp-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @media (max-width: 640px) {
    /* sits above StickyBook's mobile book bar */
    .nl-popup { right: 0.6rem; left: 0.6rem; width: auto; bottom: calc(0.6rem + 58px); }
  }
  .nlp-close {
    position: absolute; top: 0.4rem; right: 0.65rem;
    background: none; border: 0; cursor: pointer;
    font-size: 1.5rem; line-height: 1; color: var(--muted); padding: 0.25rem;
  }
  .nlp-title { font-family: var(--font-display); font-size: 1.12rem; font-weight: 550; margin: 0 1.2rem 0.4rem 0; }
  .nlp-dek { font-size: 0.9rem; color: var(--muted); line-height: 1.5; margin: 0 0 0.8rem; }
  .nlp-form { display: flex; flex-direction: column; gap: 0.55rem; }
  .nlp-form input[type='email'] {
    border: 1px solid var(--line); border-radius: var(--r-sm, 8px);
    padding: 0.6rem 0.8rem; font-size: 1rem; /* 16px floor — below it iOS Safari zooms in on focus and never zooms back */ background: var(--bg, #fff); color: inherit;
  }
  .nlp-cta { width: 100%; }
  .nlp-note { font-size: 0.88rem; margin: 0.5rem 0 0; }
  .nlp-note.ok { color: var(--accent); }
  .nlp-decline {
    display: block; margin: 0.55rem auto 0; background: none; border: 0;
    color: var(--muted); font-size: 0.82rem; cursor: pointer; text-decoration: underline;
  }
</style>

<script>
  const popup = document.querySelector('[data-nl-popup]') as HTMLElement | null;
  if (popup) {
    const KEY_SNOOZE = 'wa_nlp_snooze_until';
    const KEY_DONE = 'wa_nl_subscribed';
    const KEY_SESSION = 'wa_nlp_shown';
    const now = Date.now();
    const snoozed = Number(localStorage.getItem(KEY_SNOOZE) || 0) > now;
    const done = localStorage.getItem(KEY_DONE) === '1';
    const shownThisSession = sessionStorage.getItem(KEY_SESSION) === '1';
    let armed = !snoozed && !done && !shownThisSession;

    const show = () => {
      if (!armed) return;
      armed = false;
      sessionStorage.setItem(KEY_SESSION, '1');
      popup.hidden = false;
      popup.setAttribute('aria-hidden', 'false');
      if ((window as any).plausible) (window as any).plausible('Popup shown');
    };
    const hide = (snoozeDays: number) => {
      popup.hidden = true;
      popup.setAttribute('aria-hidden', 'true');
      if (snoozeDays > 0) localStorage.setItem(KEY_SNOOZE, String(now + snoozeDays * 864e5));
    };

    // Trigger 1: 50% scroll depth (engagement signal)
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (max > 400 && window.scrollY / max >= 0.5) { show(); window.removeEventListener('scroll', onScroll); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    // Trigger 2: exit intent (desktop only — cursor leaves toward browser chrome)
    document.addEventListener('mouseout', (e) => {
      if (!(e as MouseEvent).relatedTarget && (e as MouseEvent).clientY <= 0) show();
    });

    popup.querySelectorAll('[data-nlp-close]').forEach((b) =>
      b.addEventListener('click', () => hide(14))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popup.hidden) hide(14);
    });

    const form = popup.querySelector('.nlp-form') as HTMLFormElement | null;
    const note = popup.querySelector('.nlp-note') as HTMLElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.querySelector('input[name=email]') as HTMLInputElement | null)?.value?.trim() ?? '';
      if (!/.+@.+\..+/.test(email)) return;
      const data = new FormData();
      data.append('fields[email]', email);
      const rd = (n: string) => (form.querySelector(`input[name=${n}]`) as HTMLInputElement | null)?.value || '';
      if (rd('region')) data.append('fields[region]', rd('region'));
      data.append('fields[lang]', rd('lang') || 'en');
      data.append('fields[signup_source]', rd('source'));
      data.append('ml-submit', '1');
      data.append('anticsrf', 'true');
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      try {
        const res = await fetch(form.dataset.mlAction!, { method: 'POST', body: data });
        const json = await res.json().catch(() => ({}) as any);
        if (json && json.success) {
          localStorage.setItem(KEY_DONE, '1');
          if ((window as any).plausible) (window as any).plausible('Newsletter signup', { props: { via: 'popup' } });
          if (note) {
            note.hidden = false;
            note.classList.add('ok');
            note.innerHTML = `<a href="${form.dataset.checklist}">${form.dataset.success}</a>`;
          }
          form.hidden = true;
          setTimeout(() => hide(0), 6000);
        } else if (note) {
          note.hidden = false;
          note.textContent = form.dataset.error || 'Error';
        }
      } catch {
        if (note) { note.hidden = false; note.textContent = form.dataset.error || 'Error'; }
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>
