---
// "WHAT'S CLOSED ON YOUR DATES" — the date-range question, answered from data we
// already hold: dated public holidays per country and each venue's ordinary weekly
// hours. Deliberately one page rather than a country x month grid: indexing has
// been frozen since 2026-07-25, so a thousand new template URLs would reach nobody.
// Traffic comes from internal links, not new URLs.
//
// 2026-09-24 redesign (the owner's Claude Design proposal): the answer used to be
// a day-by-day list in which the same place repeated a dozen times, so "this
// market only opens at weekends" never showed. It is now three summary cards, a
// place × date grid, the holidays, and — the actual question — the days each
// place IS open. The whole results block comes from ONE renderer
// (src/lib/whats-closed-view.mjs): the server calls it with set:html so the
// answer is text in the delivered HTML, and the browser calls the same function
// when the reader changes the form, so the two can no longer drift.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { heroOf, TOOL_OG } from '../lib/toolOgPhoto.mjs';
import { useTranslations, localizePath, localeCodes, type Lang } from '../i18n/utils';
import { localizeHoliday } from '../i18n/holidays';
import { localizePlace, localizeVenue } from '../i18n/places';
import { shortPlaceLabel } from '../lib/placeLabel.mjs';
import { closuresInRange, holidaysInRange, closedWeekdaysOf } from '../lib/whats-closed.mjs';
import { renderResults, spanOf, MAX_GRID_DAYS } from '../lib/whats-closed-view.mjs';
import countryFacts from '../../data/country-facts.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getCollection('posts', ({ data }) => !data.draft);

// The translated title already carries the venue name in the reader's language.
// localizeVenue only knows the names in its own dictionary and falls back to
// English by design — which on 2026-09-10 meant ~75% of this tool's inventory
// printed an English venue against a fully translated city name. Dictionary
// first, then the translated title, then English.
const i18nTitles = lang === 'en'
  ? new Map<string, string>()
  : new Map(
      (await getCollection('postI18n', ({ data }: any) => data.lang === lang))
        .map((e: any) => [e.data.slug as string, e.data.title as string]),
    );

// Countries with holiday dates AND at least one venue we cover. A country that can
// only ever answer "nothing" is not worth offering in the picker.
const facts = (countryFacts as any).countries ?? {};
const countries = Object.keys(facts)
  .filter((c) => (facts[c].holidays ?? []).length > 0)
  .filter((c) => posts.some((p) => p.data.country === c))
  .sort();

const today = new Date().toISOString().slice(0, 10);
const in14 = new Date(Date.now() + 13 * 86400000).toISOString().slice(0, 10);

// The default country is the first one that actually has something to say in the
// default window, not the first alphabetically (the 2026-09-06 build defaulted to
// Cambodia and shipped an empty answer).
const saysSomething = (c: string) =>
  holidaysInRange(countryFacts, c, today, in14).length > 0 ||
  closuresInRange(posts, { country: c, fromISO: today, toISO: in14 }).length > 0;
const initial = countries.find(saysSomething) ?? countries[0] ?? '';

const venueLabel = (p: any) => {
  const fallback = p.data.place?.name ?? String(p.data.title).split(':')[0].trim();
  const dict = localizeVenue(fallback, lang);
  if (dict !== fallback) return dict;                     // the dictionary knew it
  const translated = i18nTitles.get(p.id.replace(/\.md$/, ''));
  return translated ? shortPlaceLabel(translated, lang) || fallback : fallback;
};

const DAY_INDEX: Record<string, number> = {
  Sunday: 0, Monday: 1, Tuesday: 2, Wednesday: 3, Thursday: 4, Friday: 5, Saturday: 6,
};

// Per country: its holidays (reader's-language name first, the local name kept
// for the small line under it) and the venues that keep a closing day, as
// getUTCDay() numbers — the one fact the browser needs from opening hours.
const island = Object.fromEntries(countries.map((c) => [c, {
  holidays: (facts[c].holidays ?? []).map((h: any) => ({
    date: h.date,
    label: localizeHoliday(c, h.name, lang) ?? h.localName ?? h.name,
    local: h.localName ?? '',
  })),
  venues: posts
    .filter((p) => p.data.country === c)
    .map((p) => ({
      slug: p.id.replace(/\.md$/, ''),
      name: venueLabel(p),
      city: localizePlace(p.data.region ?? '', lang) || null,
      closed: closedWeekdaysOf(p)
        .map((d: string) => DAY_INDEX[d])
        .filter((n: number | undefined): n is number => Number.isInteger(n)),
    }))
    .filter((v) => v.closed.length > 0),
}]));

// Every string the renderer prints, resolved here once for this language.
const S = {
  sumHolidays: t('wc.sumHolidays'), sumClosedPlaces: t('wc.sumClosedPlaces'),
  sumClosedSub: t('wc.sumClosedSub'), sumAllOpen: t('wc.sumAllOpen'),
  unitDays: t('wc.unitDays'), unitPlaces: t('wc.unitPlaces'), none: t('wc.none'),
  gridHeading: t('wc.gridHeading'), legendOpen: t('wc.legendOpen'),
  legendClosed: t('wc.legendClosed'), legendHoliday: t('wc.legendHoliday'),
  closedThatDay: t('wc.closedThatDay'), moreRows: t('wc.moreRows'),
  planHeading: t('wc.planHeading'), planOpenOn: t('wc.planOpenOn'), planAvoid: t('wc.planAvoid'), planNeverOpen: t('wc.planNeverOpen'),
  holidaysHeading: t('wc.holidaysHeading'), noHolidays: t('wc.noHolidays'),
  noClosures: t('wc.noClosures'), caveat: t('wc.caveat'), hoursSource: t('wc.hoursSource'),
};
const postBase = localizePath('/posts', lang);
const locale = localeCodes[lang];
const initialHtml = initial ? renderResults(island[initial], spanOf(today, in14), S, locale, postBase) : '';
// `<` escaped so no name can close the <script> it rides in.
const payload = JSON.stringify({ island, S, locale, postBase, maxDays: MAX_GRID_DAYS }).replace(/</g, '\\u003c');
---

{/* The page exists at every locale, so the switcher must keep the path and the
    head must carry hreflang alternates (caught 2026-09-06). */}
<BaseLayout image={heroOf(posts, TOOL_OG.whatsClosed)} title={t('wc.title')} description={t('wc.dek')} lang={lang} localized={true}>
  {/* A div, not <main>: BaseLayout already wraps every page in <main id="main">. */}
  <div class="wc wrap">
    <p class="wc-badge">{t('tool.kicker')} · {t('wc.noSignup')}</p>
    <h1>{t('wc.title')}</h1>
    <p class="wc-dek">{t('wc.dek')}</p>

    <form class="wc-form" id="wc-form">
      <label class="wc-field">
        <span>{t('wc.country')}</span>
        <select id="wc-country">
          {[...countries]
            .sort((a, b) => localizePlace(a, lang).localeCompare(localizePlace(b, lang), localeCodes[lang]))
            .map((c) => <option value={c} selected={c === initial}>{localizePlace(c, lang)}</option>)}
        </select>
      </label>
      <label class="wc-field"><span>{t('wc.from')}</span><input type="date" id="wc-from" value={today} /></label>
      <label class="wc-field"><span>{t('wc.to')}</span><input type="date" id="wc-to" value={in14} /></label>
      <button type="submit" class="wc-go">{t('wc.check')}</button>
    </form>
    <p class="wc-cap">{t('wc.capNote').replace('{n}', String(MAX_GRID_DAYS))}</p>

    <div id="wc-results" class="wc-results" set:html={initialHtml} />
    <span id="wc-results-end" hidden></span>

    <p class="wc-next">
      <a class="btn btn-ghost" href={localizePath('/tools/best-time', lang)}>{t('wc.quietLink')} →</a>
      <a class="btn btn-ghost" href={localizePath('/tools/holiday-overlap', lang)}>{t('ho.title')} →</a>
    </p>
  </div>

  <script type="application/json" id="wc-data" set:html={payload} />
  <script>
    import { renderResults, spanOf } from '../lib/whats-closed-view.mjs';

    const cfg = JSON.parse(document.getElementById('wc-data')!.textContent || '{}');
    const form = document.getElementById('wc-form') as HTMLFormElement;
    const countryEl = document.getElementById('wc-country') as HTMLSelectElement;
    const fromEl = document.getElementById('wc-from') as HTMLInputElement;
    const toEl = document.getElementById('wc-to') as HTMLInputElement;
    const out = document.getElementById('wc-results')!;

    const pad2 = (n: number) => String(n).padStart(2, '0');
    const localISO = (d: Date) => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
    const addDays = (iso: string, n: number) => {
      const d = new Date(`${iso}T00:00:00Z`);
      d.setUTCDate(d.getUTCDate() + n);
      return d.toISOString().slice(0, 10);
    };

    const draw = () => {
      const data = cfg.island?.[countryEl.value];
      if (!data) return;
      out.innerHTML = renderResults(data, spanOf(fromEl.value, toEl.value, cfg.maxDays), cfg.S, cfg.locale, cfg.postBase);
    };

    // Keep the end date inside the grid's window and never before the start.
    const clampTo = () => {
      if (!fromEl.value) return;
      toEl.min = fromEl.value;
      toEl.max = addDays(fromEl.value, cfg.maxDays - 1);
      if (!toEl.value || toEl.value < toEl.min) toEl.value = addDays(fromEl.value, 13);
      if (toEl.value > toEl.max) toEl.value = toEl.max;
    };

    form.addEventListener('submit', (e) => { e.preventDefault(); clampTo(); draw(); });
    // Picking a country or a date answers at once; the button stays for
    // keyboards and for readers who expect one.
    countryEl.addEventListener('change', draw);
    fromEl.addEventListener('change', () => { clampTo(); draw(); });
    toEl.addEventListener('change', () => { clampTo(); draw(); });

    // The dates in the HTML are the day the site was BUILT, in UTC. Move the
    // window to the reader's own today when the two differ, but only while the
    // field still holds the build's value — a date the reader picked, restored
    // by the browser on reload, is theirs (2026-09-14, Codex).
    const now = new Date();
    if (fromEl.value && fromEl.value === fromEl.defaultValue && fromEl.value !== localISO(now)) {
      fromEl.value = localISO(now);
      toEl.value = localISO(new Date(now.getFullYear(), now.getMonth(), now.getDate() + 13));
    }
    clampTo();
    // Redraw once on load: the reader's own today (above), and a country the
    // browser restored from history, both differ from what was built.
    draw();
  </script>
</BaseLayout>

<style>
  .wc { max-width: 64rem; padding-block: clamp(1.75rem, 4vh, 3rem) 4rem; }
  .wc-badge {
    display: inline-block; margin: 0 0 0.9rem; padding: 0.3rem 0.8rem; border-radius: 999px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.02em;
    background: color-mix(in srgb, var(--wc-sage) 22%, var(--surface)); color: var(--wc-sage-ink);
  }
  .wc h1 { font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.1; margin: 0 0 0.7rem; letter-spacing: -0.02em; }
  .wc-dek { color: var(--ink-soft); max-width: 60ch; font-size: 1.05rem; line-height: 1.65; margin: 0; }

  /* The picker: one rounded tray, soft pill fields, one accent button. */
  .wc-form {
    display: grid; grid-template-columns: 1.3fr 1fr 1fr auto; gap: 0.6rem; align-items: stretch;
    margin: 1.9rem 0 0.4rem; padding: 0.6rem; border-radius: 28px;
    background: var(--surface); border: 1px solid var(--line-soft);
    box-shadow: 0 10px 30px -18px color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .wc-field {
    display: flex; flex-direction: column; justify-content: center; gap: 0.1rem;
    padding: 0.55rem 1.1rem; border-radius: 22px; background: var(--surface-2);
    font-size: 0.72rem; font-weight: 700; color: var(--muted); min-width: 0;
  }
  .wc-field select, .wc-field input {
    border: 0; padding: 0; background: transparent; color: var(--ink);
    font: inherit; font-size: 1rem; font-weight: 700; min-height: 1.8rem; width: 100%; min-width: 0;
  }
  .wc-field:focus-within { outline: 2px solid var(--accent); outline-offset: 1px; }
  .wc-field select:focus-visible, .wc-field input:focus-visible { outline: none; }
  .wc-field select { cursor: pointer; }
  .wc-go {
    border: 0; border-radius: 22px; padding: 0 1.6rem; min-height: 3.4rem; cursor: pointer;
    background: var(--accent-fill); color: #fff; font: inherit; font-weight: 700; font-size: 0.98rem;
  }
  .wc-go:hover { background: var(--accent-deep); }
  .wc-go:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .wc-cap { margin: 0 0 1.4rem 1rem; font-size: 0.78rem; color: var(--muted); }

  .wc-next { margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }

  @media (max-width: 52rem) {
    .wc-form { grid-template-columns: 1fr 1fr; border-radius: 22px; }
    .wc-form .wc-field:first-child { grid-column: 1 / -1; }
    .wc-go { grid-column: 1 / -1; }
  }
  @media (max-width: 30rem) {
    .wc-form { grid-template-columns: 1fr; }
  }

  /* The results are drawn by the renderer as a string (server set:html, then
     innerHTML in the browser), so no element in them carries Astro's scope
     attribute. Everything below is :global, anchored on #wc-results, so both
     renders get exactly the same look (the 2026-09-14 lesson). */
  .wc { --wc-sage: #6f8a4e; --wc-sage-ink: #3f5427; --wc-open: color-mix(in srgb, #8fa86a 32%, var(--surface)); --wc-olive: #2f3a24; }
  :global(:root[data-theme='dark']) .wc { --wc-sage-ink: #b9cf98; --wc-open: color-mix(in srgb, #8fa86a 26%, var(--surface)); --wc-olive: #253019; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .wc { --wc-sage-ink: #b9cf98; --wc-open: color-mix(in srgb, #8fa86a 26%, var(--surface)); --wc-olive: #253019; }
  }

  #wc-results :global(.wcv-sum) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; margin: 0 0 1rem; }
  #wc-results :global(.wcv-card) { padding: 1.1rem 1.3rem; border-radius: var(--r-lg); background: var(--surface-2); }
  #wc-results :global(.wcv-card p) { margin: 0; }
  #wc-results :global(.wcv-card-k) { font-size: 0.82rem; font-weight: 700; color: var(--ink-soft); }
  #wc-results :global(.wcv-card-n) { font-size: 2.2rem; font-weight: 800; line-height: 1.15; margin: 0.35rem 0 0.2rem !important; font-variant-numeric: tabular-nums; }
  #wc-results :global(.wcv-card-s) { font-size: 0.84rem; color: var(--muted); line-height: 1.45; }
  #wc-results :global(.wcv-card-hol) { background: var(--accent-soft); }
  #wc-results :global(.wcv-card-open) { background: var(--wc-olive); }
  #wc-results :global(.wcv-card-open p) { color: #f3efe4; }
  #wc-results :global(.wcv-card-open .wcv-card-s) { color: #cfd5bf; }

  #wc-results :global(.wcv-panel) {
    padding: 1.3rem 1.4rem; margin: 0 0 1rem; border-radius: var(--r-lg);
    background: var(--surface); border: 1px solid var(--line-soft);
  }
  #wc-results :global(.wcv-panel h2), #wc-results :global(.wcv-plan h2) { font-size: 1.15rem; margin: 0; }
  #wc-results :global(.wcv-panel-head) { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem 1rem; margin: 0 0 1rem; }
  #wc-results :global(.wcv-legend) { display: flex; gap: 0.9rem; margin: 0; font-size: 0.8rem; color: var(--ink-soft); }
  #wc-results :global(.wcv-legend span) { display: inline-flex; align-items: center; gap: 0.35rem; }
  #wc-results :global(.wcv-legend .wcv-dot) { width: 0.8rem; height: 0.8rem; font-size: 0; }
  #wc-results :global(.wcv-ring) { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 50%; border: 2px solid var(--accent); }

  /* The grid scrolls inside its own box; the place column stays put. */
  #wc-results :global(.wcv-scroll) { overflow-x: auto; max-width: 100%; }
  #wc-results :global(.wcv-grid) { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 0.84rem; font-variant-numeric: tabular-nums; }
  #wc-results :global(.wcv-grid th), #wc-results :global(.wcv-grid td) { padding: 0.3rem 0.15rem; text-align: center; }
  #wc-results :global(.wcv-grid thead th) { font-weight: 700; vertical-align: bottom; padding-bottom: 0.5rem; }
  #wc-results :global(.wcv-grid thead time) { display: flex; flex-direction: column; align-items: center; line-height: 1.25; }
  #wc-results :global(.wcv-wd) { font-size: 0.72rem; color: var(--muted); font-weight: 600; }
  #wc-results :global(.wcv-grid thead th.wcv-hol time) {
    border: 2px solid var(--accent); border-radius: 12px; padding: 0.2rem 0.3rem; background: var(--accent-soft);
  }
  #wc-results :global(.wcv-grid tbody th) {
    position: sticky; left: 0; z-index: 1; background: var(--surface);
    text-align: left; padding: 0.55rem 0.9rem 0.55rem 0; min-width: 11rem; max-width: 15rem;
    border-top: 1px solid var(--line-soft); font-weight: 700; line-height: 1.3;
  }
  #wc-results :global(.wcv-grid tbody th a) { color: var(--ink); text-decoration: none; }
  #wc-results :global(.wcv-grid tbody th a:hover) { text-decoration: underline; }
  #wc-results :global(.wcv-city) { display: block; font-size: 0.74rem; color: var(--muted); font-weight: 500; }
  #wc-results :global(.wcv-grid tbody td) { border-top: 1px solid var(--line-soft); }
  #wc-results :global(.wcv-dot) {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.2rem; height: 1.7rem; border-radius: 999px; font-weight: 800; font-size: 0.9rem; line-height: 1;
  }
  #wc-results :global(.wcv-open) { background: var(--wc-open); }
  #wc-results :global(.wcv-closed) { background: var(--accent-deep); color: #fff; }
  #wc-results :global(.wcv-foot th), #wc-results :global(.wcv-foot td) { border-top: 1px solid var(--line); font-weight: 700; color: var(--ink-soft); padding-top: 0.6rem; }
  #wc-results :global(.wcv-foot th) { font-size: 0.8rem; }
  #wc-results :global(.wcv-more) { margin: 0.8rem 0 0; font-size: 0.86rem; color: var(--ink-soft); line-height: 1.7; }
  #wc-results :global(.wcv-note) { margin: 0.9rem 0 0; font-size: 0.8rem; color: var(--muted); line-height: 1.55; }
  #wc-results :global(.wcv-empty) { margin: 0.6rem 0 0; color: var(--muted); }

  /* Holidays beside the plan — two halves that belong together. */
  #wc-results :global(.wcv-pair) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; align-items: start; }
  #wc-results :global(.wcv-pair > *) { margin: 0; }
  #wc-results :global(.wcv-hol-panel) { background: var(--surface-2); border-color: transparent; }
  #wc-results :global(.wcv-hols) { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.6rem; }
  #wc-results :global(.wcv-hols li) { display: flex; align-items: center; gap: 0.85rem; padding: 0.6rem 0.8rem; border-radius: 18px; background: var(--surface); }
  #wc-results :global(.wcv-badge) {
    flex: none; width: 3rem; height: 3rem; border-radius: 50%; display: flex; flex-direction: column;
    align-items: center; justify-content: center; background: var(--accent-deep); color: #fff; font-weight: 800; font-size: 1.1rem; line-height: 1;
  }
  #wc-results :global(.wcv-badge small) { font-size: 0.62rem; font-weight: 700; opacity: 0.9; margin-bottom: 0.15rem; }
  #wc-results :global(.wcv-hols strong) { display: block; font-size: 0.98rem; }
  #wc-results :global(.wcv-hols li small) { display: block; font-size: 0.8rem; color: var(--muted); margin-top: 0.1rem; }
  /* The month inside the red date badge. The grey rule above also matched it
     (it is a <small> inside the <li>) and put grey text on red — unreadable on
     the live page (2026-09-24 visual check). */
  #wc-results :global(.wcv-hols .wcv-badge small) { display: block; color: #fff; opacity: 0.9; font-size: 0.62rem; margin: 0 0 0.15rem; }

  #wc-results :global(.wcv-plan) { padding: 1.3rem 1.4rem; border-radius: var(--r-lg); background: var(--wc-olive); color: #f3efe4; }
  #wc-results :global(.wcv-plan h2) { color: #f3efe4; }
  #wc-results :global(.wcv-plan ul) { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.55rem; }
  #wc-results :global(.wcv-plan li) {
    padding: 0.75rem 0.95rem 0.75rem 2.3rem; border-radius: 16px; position: relative;
    background: color-mix(in srgb, #ffffff 9%, var(--wc-olive)); font-size: 0.92rem; line-height: 1.55; color: #e7e4d6;
  }
  #wc-results :global(.wcv-plan li::before) {
    content: '✓'; position: absolute; left: 0.85rem; top: 0.72rem; font-weight: 800; color: #b9cf98;
  }
  #wc-results :global(.wcv-plan li strong) { color: #fff; }

  @media (max-width: 52rem) {
    #wc-results :global(.wcv-pair) { grid-template-columns: 1fr; }
  }
  @media (max-width: 40rem) {
    #wc-results :global(.wcv-sum) { grid-template-columns: 1fr; }
    #wc-results :global(.wcv-card) { display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: 0.8rem; }
    #wc-results :global(.wcv-card-n) { grid-row: 1 / span 2; grid-column: 2; margin: 0 !important; font-size: 1.9rem; }
    #wc-results :global(.wcv-grid tbody th) { min-width: 8.5rem; }
  }
</style>
