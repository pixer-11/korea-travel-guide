---
// "WHAT'S CLOSED ON YOUR DATES" — the date-range question, answered from data we
// already hold: dated public holidays per country and each venue's ordinary weekly
// hours. Deliberately one page rather than a country x month grid: indexing has
// been frozen since 2026-07-25, so a thousand new template URLs would reach nobody.
// Traffic comes from internal links, not new URLs.
//
// The default view (first country, next 14 days) is SERVER-rendered, so the answer
// exists as text in the delivered HTML — the same reason BestTimeTool renders its
// cards at build time. The pickers then filter a build-time island.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { heroOf, TOOL_OG } from '../lib/toolOgPhoto.mjs';
import { useTranslations, localizePath, localeCodes, type Lang } from '../i18n/utils';
import { holidayLabel } from '../i18n/holidays';
import { localizePlace, localizeVenue } from '../i18n/places';
import { shortPlaceLabel } from '../lib/placeLabel.mjs';
import { closuresInRange, holidaysInRange, closedWeekdaysOf } from '../lib/whats-closed.mjs';
import countryFacts from '../../data/country-facts.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getCollection('posts', ({ data }) => !data.draft);

// The translated title already carries the venue name in the reader's language.
// localizeVenue only knows the names in its own dictionary and falls back to
// English by design — which on 2026-09-10 meant ~75% of this tool's inventory
// printed an English venue against a fully translated city name:
// 「Siem Reap Art Center Night Market, シェムリアップ」, on a page whose linked
// article says 「シェムリアップ・アートセンター・ナイトマーケット」. The name was
// one collection away. Dictionary first, then the translated title, then English.
const i18nTitles = lang === 'en'
  ? new Map<string, string>()
  : new Map(
      (await getCollection('postI18n', ({ data }: any) => data.lang === lang))
        .map((e: any) => [e.data.slug as string, e.data.title as string]),
    );

// Countries with holiday dates AND at least one venue we cover. A country that can
// only ever answer "nothing" is not worth offering in the picker.
const facts = (countryFacts as any).countries ?? {};
const countries = Object.keys(facts)
  .filter((c) => (facts[c].holidays ?? []).length > 0)
  .filter((c) => posts.some((p) => p.data.country === c))
  .sort();

const today = new Date().toISOString().slice(0, 10);
const in14 = new Date(Date.now() + 13 * 86400000).toISOString().slice(0, 10);

// The default country is the first one that actually has something to say in the
// default window, not the first alphabetically. The 2026-09-06 build defaulted to
// Cambodia, which had neither a holiday nor a closing day in the next fortnight,
// so the delivered HTML carried an empty answer — and an empty answer is exactly
// what server-rendering this page was meant to prevent. Alphabetical order among
// the candidates keeps the choice deterministic for a given day's build.
const saysSomething = (c: string) =>
  holidaysInRange(countryFacts, c, today, in14).length > 0 ||
  closuresInRange(posts, { country: c, fromISO: today, toISO: in14 }).length > 0;
const initial = countries.find(saysSomething) ?? countries[0] ?? '';

// ONE name for a venue, and both renderers use it. A Korean page printing
// "Forbidden City, Beijing" is the i18n leak this site has fought before:
// the dictionary first, then the translated guide's own title, then the
// original name when nothing else exists, on purpose.
//
// Until 2026-09-14 only the browser island went through this chain. The
// server-rendered list — the first screen every reader sees — called
// localizeVenue alone, so the live Korean page opened on "Siem Reap Art Center
// Night Market" while the island a few lines below carried "시엠립 아트센터
// 나이트마켓" for the same place. The two agreed only after the reader pressed
// the button.
const venueLabel = (p: any) => {
  const fallback = p.data.place?.name ?? String(p.data.title).split(':')[0].trim();
  const dict = localizeVenue(fallback, lang);
  if (dict !== fallback) return dict;                     // the dictionary knew it
  const translated = i18nTitles.get(p.id.replace(/\.md$/, ''));
  return translated ? shortPlaceLabel(translated, lang) || fallback : fallback;
};
const labelBySlug = new Map<string, string>(posts.map((p: any) => [p.id.replace(/\.md$/, ''), venueLabel(p)]));

const DAY_INDEX: Record<string, number> = {
  Sunday: 0, Monday: 1, Tuesday: 2, Wednesday: 3, Thursday: 4, Friday: 5, Saturday: 6,
};

// The island: per country, its holidays and the venues that keep a closing day.
// Small (20 countries, ~130 venues) and built from the same data as the server
// view, so the two cannot disagree.
const island = Object.fromEntries(countries.map((c) => [c, {
  holidays: (facts[c].holidays ?? []).map((h: any) => ({
    date: h.date,
    label: holidayLabel(c, h.localName, h.name, lang),
  })),
  venues: posts
    .filter((p) => p.data.country === c)
    .map((p) => ({
      slug: p.id.replace(/\.md$/, ''),
      name: venueLabel(p),
      city: localizePlace(p.data.region ?? '', lang) || null,
      // The browser needs ONE fact from opening hours — which weekdays the
      // place is shut — and it used to receive all seven lines to work that
      // out for itself. 1,000 venues x "Monday: 9:30 AM – 5:30 PM" x 7 made
      // this page 501 KB of HTML, 346 KB of it inline JSON nobody reads
      // (measured 2026-09-12). Computed here with the same closedWeekdaysOf
      // the server view uses, so the two cannot drift, and sent as day
      // numbers: getUTCDay() order, Sunday = 0.
      closed: closedWeekdaysOf(p)
        .map((d: string) => DAY_INDEX[d])
        .filter((n: number | undefined): n is number => Number.isInteger(n)),
    }))
    .filter((v) => v.closed.length > 0),
}]));

// One date formatter for this page. The closures list was fixed on 2026-09-10
// and the holidays list right above it was left printing the raw ISO string —
// so the same screen showed "2026-09-24" and "2026년 9월 13일" together. Both
// lists and both renderers (server here, browser below) go through this.
const fmtDay = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString(localeCodes[lang], {
    year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
  });

const holidays = initial ? holidaysInRange(countryFacts, initial, today, in14) : [];
const closures = initial ? closuresInRange(posts, { country: initial, fromISO: today, toISO: in14 }) : [];
---

{/* The page exists at every locale, so the switcher must keep the path and the
    head must carry hreflang alternates. Without this the live Korean button on
    /tools/whats-closed/ sent readers to the homepage (caught 2026-09-06). */}
<BaseLayout image={heroOf(posts, TOOL_OG.whatsClosed)} title={t('wc.title')} description={t('wc.dek')} lang={lang} localized={true}>
  <main class="wc">
    <h1>{t('wc.title')}</h1>
    <p class="wc-dek">{t('wc.dek')}</p>

    <form class="wc-form" id="wc-form">
      <label>{t('wc.country')}
        <select id="wc-country">
          {/* In the reader's own alphabet. The list used to follow the English
              names on every page, so the Korean picker ran 캄보디아, 중국,
              프랑스, 홍콩 and put 대한민국 twelfth. `countries` itself stays in
              English order — the default country is picked from it and must
              not change with the language. */}
          {[...countries]
            .sort((a, b) => localizePlace(a, lang).localeCompare(localizePlace(b, lang), localeCodes[lang]))
            .map((c) => <option value={c} selected={c === initial}>{localizePlace(c, lang)}</option>)}
        </select>
      </label>
      <label>{t('wc.from')} <input type="date" id="wc-from" value={today} /></label>
      <label>{t('wc.to')} <input type="date" id="wc-to" value={in14} /></label>
      <button type="submit">{t('wc.check')}</button>
    </form>

    <section id="wc-holidays" class="wc-section">
      <h2>{t('wc.holidaysHeading')}</h2>
      <ul id="wc-holiday-list" class="wc-list">
        {holidays.map((h: any) => (
          <li><time datetime={h.date}>{fmtDay(h.date)}</time> — {holidayLabel(initial, h.localName, h.name, lang)}</li>
        ))}
      </ul>
      <p id="wc-holiday-empty" hidden={holidays.length > 0}>{t('wc.noHolidays')}</p>
      <p class="wc-caveat">{t('wc.caveat')}</p>
    </section>

    <section id="wc-closures" class="wc-section">
      <h2>{t('wc.closedHeading')}</h2>
      <ul id="wc-closure-list" class="wc-list">
        {closures.map((d: any) => (
          <li>
            <time datetime={d.date}>{fmtDay(d.date)}</time>
            <ul>
              {d.venues.map((v: any) => (
                <li><a href={localizePath(`/posts/${v.slug}`, lang)}>{labelBySlug.get(v.slug) ?? localizeVenue(v.name, lang)}</a>{v.city ? `, ${localizePlace(v.city, lang)}` : ''}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <p id="wc-closure-empty" hidden={closures.length > 0}>{t('wc.noClosures')}</p>
      <p class="wc-caveat">{t('wc.hoursSource')}</p>
      <p><a href={localizePath('/tools/best-time', lang)}>{t('wc.quietLink')} →</a></p>
    </section>
  </main>

  <script is:inline define:vars={{ island, postBase: localizePath('/posts', lang), localeCode: localeCodes[lang] }}>
    // Client filter over the same island the server view was built from.
    // Same shape as the server's fmtDay — the two renderers draw the same list.
    const fmtDay = (iso) => new Date(iso + 'T00:00:00Z').toLocaleDateString(localeCode, {
      year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
    });
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    // `v.closed` arrives as getUTCDay() numbers, worked out on the server by the
    // same helper the server view uses. Parsing seven opening-hours lines here
    // is what made the island 346 KB.

    const spanOf = (from, to) => {
      const a = Date.parse(from + 'T00:00:00Z');
      const b = Date.parse(to + 'T00:00:00Z');
      if (Number.isNaN(a) || Number.isNaN(b) || b < a) return [];
      const out = [];
      for (let t = a; t <= b && out.length < 60; t += 86400000) out.push(new Date(t).toISOString().slice(0, 10));
      return out;
    };

    document.getElementById('wc-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const data = island[document.getElementById('wc-country').value];
      if (!data) return;
      const span = spanOf(document.getElementById('wc-from').value, document.getElementById('wc-to').value);

      const hs = data.holidays.filter((h) => span.includes(h.date));
      document.getElementById('wc-holiday-list').innerHTML =
        hs.map((h) => '<li><time datetime="' + h.date + '">' + esc(fmtDay(h.date)) + '</time> — ' + esc(h.label) + '</li>').join('');
      document.getElementById('wc-holiday-empty').hidden = hs.length > 0;

      const byDay = {};
      for (const v of data.venues) {
        for (const d of v.closed) {
          if (!byDay[d]) byDay[d] = [];
          byDay[d].push(v);
        }
      }
      for (const list of Object.values(byDay)) list.sort((x, y) => x.name.localeCompare(y.name));

      const rows = span
        .map((d) => ({ date: d, venues: byDay[new Date(d + 'T00:00:00Z').getUTCDay()] || [] }))
        .filter((r) => r.venues.length);

      document.getElementById('wc-closure-list').innerHTML = rows.map((r) =>
        '<li><time datetime="' + r.date + '">' + esc(fmtDay(r.date)) + '</time><ul>' +
        r.venues.map((v) =>
          '<li><a href="' + postBase + '/' + esc(v.slug) + '">' + esc(v.name) + '</a>' +
          (v.city ? ', ' + esc(v.city) : '') + '</li>').join('') +
        '</ul></li>').join('');
      document.getElementById('wc-closure-empty').hidden = rows.length > 0;
    });

    // The dates in the HTML are the day the site was BUILT, in UTC. A page
    // built yesterday opened on yesterday, and its first answer was a closing
    // day that had already gone by (live, 2026-09-14). Move a stale window to
    // the reader's own today and redraw — only when it is stale, so a fresh
    // page keeps the server's answer and nothing flickers.
    const pad2 = (n) => String(n).padStart(2, '0');
    const localISO = (d) => d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
    const fromEl = document.getElementById('wc-from');
    const toEl = document.getElementById('wc-to');
    const now = new Date();
    if (fromEl.value && fromEl.value < localISO(now)) {
      fromEl.value = localISO(now);
      toEl.value = localISO(new Date(now.getFullYear(), now.getMonth(), now.getDate() + 13));
      document.getElementById('wc-form').requestSubmit();
    }
  </script>
</BaseLayout>

<style>
  .wc { max-width: 46rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
  .wc-dek { color: var(--muted, #555); margin-bottom: 1.5rem; }
  .wc-form { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; align-items: end; margin-bottom: 2rem; }
  .wc-form label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.9rem; }
  .wc-form select, .wc-form input { padding: 0.45rem 0.5rem; font: inherit; }
  .wc-form button { padding: 0.5rem 1rem; font: inherit; cursor: pointer; }
  .wc-section { margin-bottom: 2.5rem; }
  /* A date with the places under it was a bullet inside a bullet — two marker
     columns and a reader counting indents to see which day they were on. The
     date is now a heading-ish line and the places sit as plain rows beneath
     it, which is the shape the list actually has (2026-09-13). */
  .wc-list { line-height: 1.7; list-style: none; padding: 0; margin: 0; }
  .wc-list > li { padding: 0.5rem 0; border-bottom: 1px solid var(--line-soft, #eee); }
  .wc-list > li:last-child { border-bottom: 0; }
  .wc-list > li > time { display: block; font-weight: 700; font-size: 0.92rem;
    font-variant-numeric: tabular-nums; }
  .wc-list ul { list-style: none; margin: 0.15rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.15rem 0.9rem; }
  .wc-list ul li { font-size: 0.94rem; color: var(--ink-soft, #333); }
  /* The holidays list is a single line per row, so it keeps its marker. */
  #wc-holiday-list > li { display: flex; gap: 0.5rem; align-items: baseline; }
  #wc-holiday-list > li > time { flex: none; }
  .wc-caveat { font-size: 0.88rem; color: var(--muted, #555); margin-top: 0.75rem; }
</style>
