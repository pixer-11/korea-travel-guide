---
import { getCollection } from 'astro:content';
import { pickOgPhoto } from '../lib/ogPhoto.mjs';
import { siteHref } from '../lib/urls.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventsList from './EventsList.astro';
import Flag from './Flag.astro';
import Newsletter from './Newsletter.astro';
import { SITE } from '../siteConfig';
import { isEventPast, eventSortValue } from '../lib/eventStatus';
import { eventCategory } from '../lib/eventCategory.mjs';
import { eventShortName } from '../lib/eventShortName.mjs';
import { fmtEventRange } from '../lib/eventDates.mjs';
import { tileSize } from '../lib/repImage';
import countriesData from '../../data/countries.json';
import { useTranslations, localizePath, localeCodes, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { evStrings } from '../i18n/events-strings';
import { loadCardTranslations, cardHelpers } from '../i18n/cards';

// Shared /events index for en + /[lang]/events. Redesign 2026-09-30 after the
// owner's "이벤트 개선안": a two-line headline with the three numbers that
// answer "is anything on?", three photo cards for what is coming up, the four
// that close first, then month lists that fold after eight rows. Nothing on it
// is written by hand or invented: the picks are chosen by a rule (below), their
// text is the guide's own description, and every number is counted from the
// posts at build time and recounted from the reader's date in the browser.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const e = evStrings(lang);
const locale = localeCodes[lang];
const tr = await loadCardTranslations(lang);
// The guide's own quick answer (translated where a translation exists) is the
// card's blurb: it says what and where in plain words, where the meta
// description reads like a search snippet.
const qaByPost = lang === 'en' ? new Map<string, string>()
  : new Map((await getCollection('postI18n', ({ data }) => data.lang === lang)).map((x) => [x.data.slug, x.data.quickAnswer ?? '']));
const firstSentences = (text: string, max = 150) => {
  const parts = (text || '').match(/[^.!?。！？]+[.!?。！？]+(?:\s|$)|[^.!?。！？]+$/g) ?? [];
  let out = '';
  for (const part of parts) { if (out && (out + part).length > max) break; out += part; }
  return out.trim();
};
const card = cardHelpers(tr, lang);

const all = await getCollection('posts', ({ data }) => !data.draft && data.category === 'event');
const today = new Date();
const upcoming = all
  .filter((p) => !isEventPast(p.data, today))
  .sort((a, b) => eventSortValue(a.data, today) - eventSortValue(b.data, today));
const past = all
  .filter((p) => isEventPast(p.data, today))
  .sort((a, b) => eventSortValue(a.data, today) - eventSortValue(b.data, today));

const countries = new Set(upcoming.map((p) => p.data.country ?? 'South Korea')).size;

const slugByName = new Map(countriesData.countries.map((c) => [c.name, c]));
const evCount = new Map<string, number>();
for (const p of all) {
  const n = p.data.country ?? 'South Korea';
  evCount.set(n, (evCount.get(n) ?? 0) + 1);
}
const upCount = new Map<string, number>();
for (const p of upcoming) {
  const n = p.data.country ?? 'South Korea';
  upCount.set(n, (upCount.get(n) ?? 0) + 1);
}
const countryLinks = [...evCount.entries()]
  .filter(([name, n]) => n >= 2 && slugByName.has(name))
  .map(([name]) => ({ name, slug: slugByName.get(name)!.slug, flag: slugByName.get(name)!.iso2, up: upCount.get(name) ?? 0 }))
  .sort((a, b) => b.up - a.up || a.name.localeCompare(b.name));

// ── Day arithmetic (event dates are date-only, stored as UTC midnight) ──
const DAY = 86_400_000;
const dayNum = (d: any) => Math.floor(new Date(d).getTime() / DAY);
const todayNum = Math.floor(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()) / DAY);
const startN = (p: any) => (p.data.eventStartDate ? dayNum(p.data.eventStartDate) : NaN);
const endN = (p: any) => (p.data.eventEndDate ? dayNum(p.data.eventEndDate) : startN(p));

// The three numbers in the hero. The script recounts them from the reader's
// own date (the page is built once a day and read in every time zone).
const stats = {
  // No end date counts as still on, as the list's "on now" group treats it.
  now: upcoming.filter((p) => startN(p) <= todayNum && (!p.data.eventEndDate || endN(p) >= todayNum)).length,
  week: upcoming.filter((p) => startN(p) >= todayNum && startN(p) <= todayNum + 6).length,
  today: upcoming.filter((p) => p.data.eventEndDate && endN(p) === todayNum).length,
};

const CAT_KEY = { concerts: 'catConcerts', sports: 'catSports', festivals: 'catFestivals', exhibitions: 'catExhibitions', other: 'catOther' } as const;
const catLabel = (p: any) => e(CAT_KEY[eventCategory(p.data) as keyof typeof CAT_KEY] ?? 'catOther');

const nameOf = (p: any) => {
  const x = tr.get(p.id);
  return x ? eventShortName(x.title, lang) : eventShortName(p.data.title, 'en');
};
const whereOf = (p: any) => {
  const city = localizePlace(p.data.region, lang);
  const ctry = localizePlace(p.data.country ?? 'South Korea', lang);
  return !city || city === ctry ? ctry : `${city} · ${ctry}`;
};

// ── The three picks ──
// A rule, re-run on every daily build, so the row follows the events as they
// are added and end — nothing here is chosen by hand. Annual events only
// (eventRecurring comes from the discovery search: the established festivals,
// races and film weeks a trip is planned around), with a real photo, starting
// far enough ahead to still book: one in each of three windows (5–20, 21–40,
// 41–60 days out), each a different category and country where the calendar
// allows. Search data cannot rank them: every upcoming event guide shows 0
// impressions while the index is frozen (2026-09-30), so "most searched" would
// have been a claim with nothing under it. Nor are these "the editor's flights"
// with a travel time from Korea, as in the mock-up: none of that is recorded.
const hasPhoto = (p: any) => !!p.data.heroImage?.url && p.data.heroImage.license !== 'placeholder';
const ahead = (p: any) => startN(p) - todayNum;
const pool = upcoming.filter((p) => p.data.eventRecurring === true && hasPhoto(p) && ahead(p) >= 5 && ahead(p) <= 60)
  .sort((a, b) => startN(a) - startN(b));
const picks: any[] = [];
const clash = (p: any) => picks.some((q) => eventCategory(q.data) === eventCategory(p.data) || (q.data.country ?? '') === (p.data.country ?? ''));
for (const [lo, hi] of [[5, 20], [21, 40], [41, 60]]) {
  const inWin = pool.filter((p) => ahead(p) >= lo && ahead(p) <= hi && !picks.includes(p));
  const p = inWin.find((x) => !clash(x)) ?? inWin[0];
  if (p) picks.push(p);
}
for (const p of pool) { if (picks.length >= 3) break; if (!picks.includes(p) && !clash(p)) picks.push(p); }
for (const p of pool) { if (picks.length >= 3) break; if (!picks.includes(p)) picks.push(p); }
picks.sort((a, b) => startN(a) - startN(b));

const itineraries = (await getCollection('itineraries', ({ data }) => !data.draft))
  .sort((a, b) => a.data.days - b.data.days);
const itinFor = (city: string) => itineraries.find((it) => it.data.city === city);
const wd = new Intl.DateTimeFormat(locale, { weekday: 'short', timeZone: 'UTC' });
const mon = new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' });
const pickView = picks.map((p, i) => {
  const s = new Date(p.data.eventStartDate);
  const len = p.data.eventEndDate ? endN(p) - startN(p) + 1 : 0;
  const h = p.data.heroImage;
  const it = itinFor(p.data.region);
  return {
    p, tone: ['brown', 'night', 'cream'][i % 3],
    day: s.getUTCDate(),
    when: `${mon.format(s)} · ${wd.format(s)}`,
    range: fmtEventRange(p.data.eventStartDate, p.data.eventEndDate, locale),
    ddayLabel: startN(p) - todayNum <= 0 ? e('dToday') : e('dDay', { n: startN(p) - todayNum }),
    len: !len ? '' : len === 1 ? e('oneDay') : e('nDays', { n: len }),
    blurb: firstSentences((lang === 'en' ? p.data.quickAnswer : qaByPost.get(p.id)) || '') || card.desc(p.id, p.data.description),
    img: tileSize(h.url), pos: h.focus ? `${h.focus.x}% ${h.focus.y}%` : '50% 50%',
    credit: h.credit ?? '', source: h.source ?? '',
    itin: it ? { href: localizePath(`/itinerary/${it.id}`, lang), label: e('ctaItin', { city: localizePlace(it.data.city, lang) }) } : null,
  };
});

// ── Missed it? Annual events that ended this year (eventRecurring comes from
// the discovery search, not guessed from the title). ──
const again = [...past]
  // "This year" must be true: only runs that ended in the current year.
  .filter((p) => p.data.eventRecurring === true && p.data.eventStartDate &&
    new Date(p.data.eventEndDate ?? p.data.eventStartDate).getUTCFullYear() === today.getUTCFullYear())
  .sort((a, b) => endN(b) - endN(a))
  .slice(0, 4);

const year = today.getUTCFullYear();
const seoTitle = e('seoTitle', { y: year });
const summary = t('ev.summaryGlobal').replace('{n}', String(upcoming.length)).replace('{c}', String(countries));

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteHref(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: seoTitle, description: summary, url: pageUrl, isPartOf: { '@id': `${site}/#site` } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.home'), item: siteHref(localizePath('/', lang), Astro.site) },
      { '@type': 'ListItem', position: 2, name: t('nav.events'), item: pageUrl },
    ] },
    ...(upcoming.length ? [{ '@type': 'ItemList', itemListElement: upcoming.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: siteHref(card.href(p.id), Astro.site), name: card.title(p.id, p.data.title) })) }] : []),
  ],
};

// Share image: this hub has real guides under it, so it unfurls as one of
// their photographs rather than the brand card. pickOgPhoto enforces the
// 1200px Discover floor and falls back to the brand card when nothing
// qualifies (policy in lib/toolOgPhoto.mjs, 2026-09-13 sweep).
const ogPhoto = pickOgPhoto([...all].sort((a, b) =>
  ((b.data.place?.rating ?? 0) * Math.log10((b.data.place?.userRatingsTotal ?? 0) + 10)) -
  ((a.data.place?.rating ?? 0) * Math.log10((a.data.place?.userRatingsTotal ?? 0) + 10))));
---

<BaseLayout image={ogPhoto}
  title={`${seoTitle} — ${SITE.name}`}
  description={summary}
  jsonLd={jsonLd}
  localized={true}
>
  <div class="evx">
    <section class="evx-hero">
      <div class="wrap evx-hero-grid">
        <div class="evx-hero-copy">
          <nav class="evx-crumbs" aria-label="breadcrumb"><a href={localizePath('/', lang)}>{t('post.home')}</a><span aria-hidden="true">·</span><span>{t('nav.events')}</span></nav>
          <h1 class="evx-h1">{e('h1a')}<span>{e('h1b')}</span></h1>
          <p class="evx-dek">{e('dek', { n: upcoming.length, c: countries })}</p>
        </div>
        <div class="evx-panel" data-ev-stats>
          <div class="evx-stats">
            <div class="evx-stat"><span>{e('statNow')}</span><strong data-stat="now">{stats.now}</strong></div>
            <div class="evx-stat"><span>{e('statWeek')}</span><strong data-stat="week">{stats.week}</strong></div>
            <div class="evx-stat"><span>{e('statToday')}</span><strong data-stat="today">{stats.today}</strong></div>
          </div>
          <a class="evx-cal" href="/events.ics">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM12 12v5M9.5 14.5h5"/></svg>
            {e('subscribe')}
          </a>
          <p class="evx-cal-hint">{t('ev.addToCalendarHint')}</p>
        </div>
      </div>
    </section>

    {upcoming.length === 0 && (
      <section class="section"><div class="wrap"><div class="fact-box" style="text-align:center"><p>{t('ev.noneGlobal')}</p></div></div></section>
    )}

    {pickView.length > 0 && (
      <section class="section evx-picks-sec" data-dday-strings={JSON.stringify({ d: e('dDay'), today: e('dToday') })}>
        <div class="wrap">
          <div class="evx-head">
            <h2 class="evx-h2">{e('pickTitle')}</h2>
            <span class="evx-sub">{e('pickSub')}</span>
          </div>
          <div class="evx-picks">
            {pickView.map((v) => (
              <article class={`evx-pick evx-pick--${v.tone}`} data-start={v.p.data.eventStartDate.toISOString().slice(0, 10)}>
                <a class="evx-pick-photo" href={card.href(v.p.id)} tabindex="-1" aria-hidden="true">
                  <img src={v.img} alt={nameOf(v.p)} loading="lazy" decoding="async" width="640" height="400" style={`object-position:${v.pos}`} />
                </a>
                {v.source && <a class="evx-credit" href={v.source} rel="nofollow noopener" target="_blank" title={v.credit}>{t('ess.photoBy')}</a>}
                <div class="evx-pick-body">
                  <div class="evx-pick-top">
                    <span class={`evx-tag evx-tag--${eventCategory(v.p.data)}`}>{catLabel(v.p)}</span>
                    <span class="evx-dday" data-dday>{v.ddayLabel}</span>
                  </div>
                  <p class="evx-date"><span class="evx-day">{v.day}</span><span class="evx-when">{v.when}<br />{v.range}</span></p>
                  <h3 class="evx-pick-name"><a href={card.href(v.p.id)}>{nameOf(v.p)}</a></h3>
                  <p class="evx-pick-blurb">{v.blurb}</p>
                  <p class="evx-pills"><span>{whereOf(v.p)}</span>{v.len && <span>{v.len}</span>}</p>
                  <div class="evx-pick-cta">
                    <a class="evx-btn" href={card.href(v.p.id)}>{e('ctaGuide')} <span aria-hidden="true">→</span></a>
                    {v.itin && <a class="evx-link" href={v.itin.href}>{v.itin.label}</a>}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <EventsList lang={lang} upcoming={upcoming} past={past} card={card} trTitles={tr} today={today} flights={true}>
      <section class="section evx-bottom" slot="before-past">
        <div class="wrap evx-bottom-grid">
          {countryLinks.length > 1 && (
            <div class="evx-box">
              <h2 class="evx-h3">{e('byCountryTitle')}</h2>
              <p class="evx-box-dek">{e('byCountryDek')}</p>
              <nav class="evx-countries" aria-label={e('countriesLabel')}>
                {countryLinks.map((c) => (
                  <a href={localizePath(`/events/${c.slug}`, lang)}><Flag code={c.flag} size="1em" class="flag-ico" /> {localizePlace(c.name, lang)}{c.up > 0 && <span class="evx-n">{c.up}</span>}</a>
                ))}
              </nav>
            </div>
          )}
          {again.length > 0 && (
            <div class="evx-box">
              <h2 class="evx-h3">{e('againTitle')}</h2>
              <p class="evx-box-dek">{e('againDek')}</p>
              <ul class="evx-again">
                {again.map((p) => (
                  <li><a href={card.href(p.id)}><strong>{nameOf(p)}</strong><span>{e('againWhen', { date: fmtEventRange(p.data.eventStartDate, p.data.eventEndDate, locale) })}</span></a></li>
                ))}
              </ul>
              <a class="evx-past-link" href="#past-events">{e('pastAll', { n: past.length })} →</a>
            </div>
          )}
        </div>
      </section>
    </EventsList>

    <Newsletter
      lang={lang}
      heading={t('ev.neverMissGlobal')}
      dek={t('ev.neverMissDekGlobal')}
    />
  </div>
</BaseLayout>

<script>
  // Recount the hero numbers and the picks' D-day from the reader's own date;
  // without this they read as of the morning's build.
  const DAY = 86_400_000;
  const n = new Date();
  const today = Date.UTC(n.getFullYear(), n.getMonth(), n.getDate()) / DAY;
  const panel = document.querySelector<HTMLElement>('[data-ev-stats]');
  if (panel) {
    let now = 0, week = 0, end = 0;
    for (const el of document.querySelectorAll<HTMLElement>('[data-ev-list] [data-start]')) {
      const s = Date.parse(el.dataset.start || '') / DAY;
      const e = el.dataset.end ? Date.parse(el.dataset.end) / DAY : Infinity;
      if (!Number.isFinite(s)) continue;
      if (s <= today && e >= today) now++;
      if (s >= today && s <= today + 6) week++;
      if (e === today) end++;
    }
    const set = (k: string, v: number) => { const x = panel.querySelector(`[data-stat="${k}"]`); if (x) x.textContent = String(v); };
    set('now', now); set('week', week); set('today', end);
  }
  const picks = document.querySelector<HTMLElement>('[data-dday-strings]');
  if (picks) {
    let S: Record<string, string> = {};
    try { S = JSON.parse(picks.dataset.ddayStrings || '{}'); } catch { /* keep build-time labels */ }
    for (const card of picks.querySelectorAll<HTMLElement>('[data-start]')) {
      const s = Date.parse(card.dataset.start || '') / DAY;
      const out = card.querySelector('[data-dday]');
      if (!Number.isFinite(s) || !out || !S.d) continue;
      const left = s - today;
      out.textContent = left <= 0 ? S.today : S.d.split('{n}').join(String(left));
    }
  }
</script>

<style>
  .evx {
    --ev-forest: #3b4a2c; --ev-night: #262d1b; --ev-brown: #6b3413; --ev-rust: #b0562a;
    --ev-peach: #fde3d4; --ev-sand: #ece5d6; --ev-cream: #fbf7ef; --ev-on-dark: #f6f1e6;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .evx { --ev-peach: #3a2620; --ev-sand: #2a251d; --ev-cream: #221f19; --ev-rust: #e08a5a; }
  }
  :global(:root[data-theme='dark']) .evx { --ev-peach: #3a2620; --ev-sand: #2a251d; --ev-cream: #221f19; --ev-rust: #e08a5a; }

  /* Hero */
  .evx-hero { padding: 2.2rem 0 1rem; }
  .evx-hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 2rem; align-items: center; }
  .evx-crumbs { display: flex; gap: .5rem; font-size: .85rem; color: var(--muted); margin-bottom: 1rem; }
  .evx-crumbs a { color: inherit; text-decoration: none; }
  .evx-crumbs span:last-child { color: var(--ink); font-weight: 700; }
  .evx-h1 { font-family: var(--font-display); font-size: clamp(2rem, 5.2vw, 3.3rem); line-height: 1.12; letter-spacing: -0.02em; margin: 0 0 1rem; color: var(--ink); word-break: keep-all; overflow-wrap: anywhere; }
  .evx-h1 span { display: block; color: var(--ev-brown); }
  :global(:root[data-theme='dark']) .evx-h1 span { color: #e8a577; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .evx-h1 span { color: #e8a577; } }
  .evx-dek { color: var(--ink-soft); font-size: 1.05rem; line-height: 1.7; margin: 0; max-width: 36rem; }
  .evx-panel { background: var(--ev-night); color: var(--ev-on-dark); border-radius: 28px; padding: 1.4rem; }
  .evx-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; }
  .evx-stat { background: rgba(255, 255, 255, .09); border-radius: 18px; padding: .8rem .9rem; display: flex; flex-direction: column; gap: .25rem; min-width: 0; }
  .evx-stat span { font-size: .8rem; font-weight: 600; opacity: .85; line-height: 1.3; }
  .evx-stat strong { font-family: var(--font-display); font-size: 2rem; line-height: 1; }
  .evx-cal { display: flex; align-items: center; justify-content: center; gap: .5rem; margin-top: 1rem; padding: .75rem 1rem; border-radius: var(--r-pill); background: var(--ev-on-dark); color: #262d1b; font-weight: 700; text-decoration: none; }
  .evx-cal:hover { filter: brightness(.96); }
  .evx-cal-hint { margin: .6rem 0 0; font-size: .8rem; text-align: center; opacity: .8; }
  @media (max-width: 859px) { .evx-hero-grid { grid-template-columns: 1fr; gap: 1.4rem; } }

  /* Section heads */
  .evx-head { display: flex; align-items: baseline; justify-content: space-between; gap: .4rem 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .evx-h2 { font-family: var(--font-display); font-size: clamp(1.35rem, 3.4vw, 1.75rem); font-weight: 800; letter-spacing: -0.01em; margin: 0; color: var(--ink); }
  .evx-sub { color: var(--muted); font-size: .88rem; }

  /* Picks: photo on top, the mock-up's three tones below */
  .evx-picks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .evx-pick { position: relative; display: flex; flex-direction: column; min-width: 0; overflow: hidden; border-radius: 26px; }
  .evx-pick--brown { background: var(--ev-brown); color: var(--ev-on-dark); }
  .evx-pick--night { background: var(--ev-night); color: var(--ev-on-dark); }
  .evx-pick--cream { background: var(--ev-cream); color: var(--ink); border: 1px solid var(--line-soft); }
  .evx-pick-photo { display: block; }
  .evx-pick-photo img { display: block; width: 100%; aspect-ratio: 16 / 10; height: auto; object-fit: cover; background: var(--ev-sand); }
  .evx-credit { position: absolute; top: .6rem; right: .7rem; font-size: .68rem; padding: .15rem .5rem; border-radius: var(--r-pill); background: rgba(0, 0, 0, .45); color: #fff; text-decoration: none; }
  .evx-pick-body { display: flex; flex-direction: column; gap: .55rem; padding: 1.1rem 1.25rem 1.3rem; flex: 1; }
  .evx-pick-top { display: flex; justify-content: space-between; align-items: center; gap: .5rem; }
  .evx-tag { display: inline-block; padding: .18rem .65rem; border-radius: var(--r-pill); font-size: .75rem; font-weight: 700; background: rgba(255, 255, 255, .16); }
  .evx-pick--cream .evx-tag { background: var(--ev-sand); color: var(--ink-soft); }
