const T = L[lang];
const catLabel: Record<string, string> = {
  restaurant: t('cat.restaurant'), trendy: t('cat.trendy'), 'hidden-gem': t('cat.hidden-gem'), attraction: t('cat.attraction'),
};
const nf = new Intl.NumberFormat(lang === 'zh' ? 'zh-CN' : lang);
const STR = {
  stNow: T.stNow, stAt: T.stAt, local: T.local, weekday: T.weekday, weekend: T.weekend, whenNow: T.whenNow,
  add: T.add, added: T.added, saved: T.saved, copied: T.copied, noQuiet: T.noQuiet, multiCity: T.multiCity, overlap: T.overlap,
  wNone: T.wNone, guide: T.guide,
  am: AMPM.am, pm: AMPM.pm, lang,
};
// Every hour label pre-formatted here, so the script never re-implements the
// localized clock.
const HOUR_TEXT = Object.fromEntries(Array.from({ length: 24 }, (_, h) => [h, hr(h)]));
const DAY_SHORT = (['day.mon', 'day.tue', 'day.wed', 'day.thu', 'day.fri', 'day.sat', 'day.sun'] as const).map((k) => t(k));

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteHref(Astro.url.pathname, Astro.site);
// Dataset markup: what makes the page discoverable in Google Dataset Search.
// English on purpose: one dataset, one canonical identity across five routes.
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Quiet & busy visiting hours for ${index.length} travel venues`,
  description:
    'Quietest and busiest visiting hours per venue (cafés, restaurants, attractions) derived from BestTime.app live foot-traffic forecasts, clamped to each venue’s opening hours. Updated as new guides are published.',
  url: 'https://wanderatlasguides.com/tools/best-time/',
  creator: { '@type': 'Organization', name: 'Wander Atlas', url: 'https://wanderatlasguides.com' },
  isAccessibleForFree: true,
  temporalCoverage: '2026/..',
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: t('tool.h1'),
      applicationCategory: 'TravelApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: t('tool.metaDesc'),
      url: pageUrl,
      isPartOf: { '@id': `${site}/#site` },
    },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.home'), item: siteHref(localizePath('/', lang), Astro.site) },
      { '@type': 'ListItem', position: 2, name: t('tool.h1'), item: pageUrl },
    ] },
    { '@type': 'FAQPage', mainEntity: T.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};
const PAGE = 24;
const cellCls = { q: 'quiet', b: 'busy', m: 'mid', x: 'closed' } as const;
---
<BaseLayout image={heroOf(posts, TOOL_OG.bestTime)} title={t('tool.metaTitle')} description={t('tool.metaDesc')} jsonLd={jsonLd} localized={true}>
  <section class="bt" data-bt data-page={PAGE}>
    <nav class="bt-crumb" aria-label="breadcrumb"><a href={localizePath('/', lang)}>{t('post.home')}</a><span aria-hidden="true">·</span><span>{T.crumbTools}</span><span aria-hidden="true">·</span><span>{t('tool.h1')}</span></nav>

    <!-- Hero: search + the "quiet right now" widget -->
    <div class="bt-hero">
      <div class="bt-hero-copy">
        <span class="bt-pill">{T.badge}</span>
        <h1><span>{T.h1a}</span> <em>{T.h1b}</em></h1>
        <p class="bt-dek">{T.dek(index.length)}</p>
        <form class="bt-search" role="search" data-search-form>
          <span aria-hidden="true">⌕</span>
          <input type="search" name="q" placeholder={T.searchPh} aria-label={T.searchPh} data-q autocomplete="off" />
          <button type="submit">{T.searchBtn}</button>
        </form>
        <div class="bt-popular"><span>{T.popular}</span>{popularCities.map((r) => <button type="button" class="bt-tag" data-city={r}>{r}</button>)}</div>
      </div>
      <aside class="bt-widget">
        <p class="bt-w-kicker"><i></i><span data-w-kicker>{T.wNow}</span></p>
        <h2 class="bt-w-title" data-w-title>{T.wIdle}</h2>
        <ol class="bt-w-list" data-w-list></ol>
        <p class="bt-w-none" data-w-none hidden>{T.wNone}</p>
        <div class="bt-w-stats">
          <div><span>{T.sPlaces}</span><b>{nf.format(index.length)}</b></div>
          <div><span>{T.sCountries}</span><b>{countries.length}</b></div>
          <div><span>{T.sHours}</span><b>{hr(7)}–{hr(22)}</b></div>
        </div>
      </aside>
    </div>

    <!-- Filters -->
    <h2 class="bt-h2">{T.listTitle}</h2>
    <div class="bt-filters">
      <div class="bt-row">
        <div class="bt-seg" role="group" data-cat-group>
          <button type="button" class="is-on" aria-pressed="true" data-cat="">{T.all}</button>
          {(['attraction', 'hidden-gem', 'restaurant', 'trendy'] as const).filter((c) => catCount.get(c)).map((c) => <button type="button" aria-pressed="false" data-cat={c}>{catLabel[c]}</button>)}
        </div>
        <div class="bt-chips" role="group" data-country-group>
          <button type="button" class="is-on" aria-pressed="true" data-country="">{T.all} <small>{index.length}</small></button>
          {countries.map(([c, n]) => <button type="button" aria-pressed="false" data-country={c}>{c} <small>{n}</small></button>)}
        </div>
      </div>
    </div>
    <div class="bt-list">
    <div class="bt-sticky">
      <div class="bt-row">
        <div class="bt-seg bt-mode" role="group">
          <button type="button" class="is-on" aria-pressed="true" data-mode="now">{T.modeNow}</button>
          <button type="button" aria-pressed="false" data-mode="pick">{T.modePick}</button>
        </div>
        <span class="bt-note" data-mode-note>{T.modeNote}</span>
        <div class="bt-pick" data-pick hidden>
          <div class="bt-seg bt-days" role="group">{DAY_SHORT.map((d, i) => <button type="button" data-day={i} aria-pressed="false">{d}</button>)}</div>
          <input type="range" min="7" max="22" step="1" value="10" data-hour aria-label={T.modePick} />
          <output data-hour-out>{hr(10)}</output>
        </div>
        <select class="bt-select" data-region aria-label={T.cityAll}>
          <option value="">{T.cityAll}</option>
          {allRegions.map((r) => <option value={r}>{r}</option>)}
        </select>
        <div class="bt-seg bt-sort" role="group">
          <button type="button" class="is-on" aria-pressed="true" data-sort="quiet">{T.sortQuiet}</button>
          <button type="button" aria-pressed="false" data-sort="rating">{T.sortRating}</button>
          <button type="button" aria-pressed="false" data-sort="city">{T.sortCity}</button>
        </div>
      </div>
    </div>
    <div class="bt-meta">
      <p class="bt-count" data-count>{t('tool.places').replace('{n}', String(index.length))}</p>
      <div class="bt-legend">
        <span><i class="sw-quiet"></i>{t('tool.quiet')} <b data-n-q></b></span>
        <span><i class="sw-mid"></i>{t('tool.normal')} <b data-n-m></b></span>
        <span><i class="sw-busy"></i>{t('tool.busy')} <b data-n-b></b></span>
      </div>
    </div>

    <!-- Cards: rendered here, at build time. Assistants and crawlers do not run
         JavaScript; the hours in words and the bars are in the HTML. -->
    <div class="bt-results" data-results>
      {index.map((d, i) => (
        <article class:list={['bt-card', { 'is-more': i >= PAGE }]} data-s={d.s} data-c={d.c} data-r={d.r} data-cat={d.cat}
          data-rating={d.rating} data-tz={d.tz} data-p={d.pats} data-d={d.days}
          data-q={`${d.t} ${d.r} ${d.c} ${d.region} ${d.country}`.toLowerCase()}
          data-save={JSON.stringify({ slug: d.s, title: d.t, region: d.region, country: d.country, href: d.u, image: d.b, rs: d.rs })}>
          <a class="bt-photo" href={d.u} tabindex="-1" aria-hidden="true">
            {d.b ? <img src={d.b} alt="" loading="lazy" decoding="async" width="320" height="180" /> : <span class="bt-ph"></span>}
            <span class="bt-badge">{catLabel[d.cat] || d.cat}</span>
          </a>
          <div class="bt-body">
            <div class="bt-top"><span class="bt-where">{d.r} · {d.c}</span>{d.rating > 0 && <span class="bt-rate">★ {d.rating.toFixed(1)}</span>}</div>
            <h3><a href={d.u}>{d.t}</a></h3>
            <p class="bt-status" data-status></p>
            <div class="bt-barwrap" aria-hidden="true">
              <div class="bt-bar">{d.cells.map((c) => <i class={cellCls[c as keyof typeof cellCls]}></i>)}</div>
              <div class="bt-barlab"><span>{hr(7)}</span><span>{hr(12)}</span><span>{hr(17)}</span><span>{hr(22)}</span></div>
            </div>
            <p class="bt-hours">
              {d.quietLabel && <span class="bt-hq">{t('tool.quietest')} {d.quietLabel}</span>}
              {d.busyLabel && <span class="bt-hb">{t('tool.busy')} {d.busyLabel}</span>}
            </p>
            <div class="bt-actions">
              <a class="bt-guide" href={d.u}>{T.guide}</a>
              <button type="button" class="bt-add" data-add aria-pressed="false">{T.add}</button>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="bt-empty" data-empty hidden>{t('tool.empty')}</p>
    <button type="button" class="bt-more" data-more hidden></button>
    </div>

    <!-- Timed tickets -->
    <div class="bt-tickets">
      {bandPhoto && <img src={bandPhoto} alt="" loading="lazy" width="320" height="180" />}
      <div>
        <h2>{T.ticketsTitle}</h2>
        <p>{T.ticketsBody}</p>
      </div>
      <div class="bt-tickets-cta">
        <a class="bt-btn bt-btn-cta" href="https://klook.tpx.lv/2NXPH8MA" target="_blank" rel="sponsored noopener" data-affiliate-placement="besttime-tickets">{T.ticketsCta}</a>
        <a class="bt-btn bt-btn-ghost" href={localizePath('/itinerary', lang)}>{T.itinCta}</a>
      </div>
    </div>

    <!-- Quotable findings (the journalist asset) -->
    <section class="bt-findings" aria-labelledby="findings-h">
      <h2 id="findings-h">{t('tool.findings.h2')}</h2>
      <p class="bt-sub">{fill('tool.findings.intro', { n: index.length })}</p>
      <ul class="bt-facts">
        {wdQuietTotal >= 30 && <li>{fill('tool.findings.morning', { pct: morningPct })}</li>}
        {peakHour != null && <li>{fill('tool.findings.peak', { hour: hourLabel(peakHour) })}</li>}
        {attrTotal >= 10 && restHour != null && <li>{fill('tool.findings.cats', { aPct: attrPct, rHour: hourLabel(restHour) })}</li>}
      </ul>
      {cityRows.length > 0 && (
        <>
          <h3>{t('tool.findings.city.h3')}</h3>
          <div class="bt-tbl">
            <table>
              <thead><tr><th>{t('tool.findings.city.city')}</th><th>{t('tool.findings.city.hour')}</th><th>{t('tool.findings.city.n')}</th></tr></thead>
              <tbody>{cityRows.map((r) => <tr><td>{r.city}</td><td>{r.hour}</td><td>{r.n}</td></tr>)}</tbody>
            </table>
          </div>
        </>
      )}
      <h3>{t('tool.findings.method.h3')}</h3>
      <p>{fill('tool.findings.method.body', { n: index.length })}</p>
      <h3>{t('tool.cite.h3')}</h3>
      <p>{t('tool.cite.body')}</p>
      <p class="bt-foot">{t('tool.foot')}</p>
      <p class="bt-foot" set:html={t('tool.apiCite')
        .replace('{api}', '<a href="https://besttime.app" rel="noopener">besttime.app</a>')
        .replace('{method}', '<a href="/methodology/">wanderatlasguides.com/methodology</a>')} />
    </section>

    <!-- FAQ -->
    <section class="bt-faq">
      <div>
        <h2 class="bt-h2">{T.faqTitle}</h2>
        <p class="bt-sub">{T.faqDek} <a href={localizePath('/methodology', lang)}>{T.faqLink}</a>.</p>
      </div>
      <div class="bt-faq-list">{T.faq.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}</div>
    </section>

    <!-- Day plan: bottom bar + dialog -->
    <div class="bt-planbar" data-planbar hidden>
      <span>♥ <b data-plan-n></b></span>
      <button type="button" class="bt-btn bt-btn-ghost bt-sm" data-plan-clear>{T.clear}</button>
      <button type="button" class="bt-btn bt-btn-cta bt-sm" data-plan-open>{T.build}</button>
    </div>
    <dialog class="bt-dialog" data-plan-dialog aria-labelledby="bt-plan-h">
      <div class="bt-dialog-head">
        <h2 id="bt-plan-h">{T.planTitle}</h2>
        <button type="button" class="bt-x" data-plan-close aria-label={T.close}>×</button>
      </div>
      <div class="bt-seg bt-days" data-plan-days role="group">{DAY_SHORT.map((d, i) => <button type="button" data-day={i} aria-pressed="false">{d}</button>)}</div>
      <p class="bt-plan-note">{T.planNote}</p>
      <p class="bt-plan-warn" data-plan-warn hidden></p>
      <ol class="bt-timeline" data-plan-list></ol>
      <div class="bt-dialog-actions">
        <button type="button" class="bt-btn bt-btn-cta" data-plan-save>{T.saveTrip}</button>
        <button type="button" class="bt-btn bt-btn-ghost" data-plan-copy>{T.copy}</button>
        <a class="bt-link" href={localizePath('/my-trip', lang)}>{T.myTrip}</a>
      </div>
    </dialog>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(datasetLd)} />
  <script type="application/json" id="bt-strings" set:html={JSON.stringify({ ...STR, days: DAY_SHORT, hours: HOUR_TEXT, regions: regionsByCountry, wTitleNow: T.wTitleNow(0), more: T.more(0), planBar: T.planBar(0), count: T.count(0, '{when}'), wTitlePick: T.wTitlePick(0), wPick: T.wPick('{when}'), quietUntil: T.quietUntil('{h}'), wNow: T.wNow })} />

  <Newsletter lang={lang} />

  <script>
    // ── Data the server rendered ─────────────────────────────────────────
    const root = document.querySelector<HTMLElement>('[data-bt]')!;
    root.classList.add('bt-js');
    const S = JSON.parse(document.getElementById('bt-strings')!.textContent || '{}');
    // Counted phrases arrive rendered with 0; swap the number for the live one.
    const num = (tpl: string, n: number) => tpl.replace(/0/, String(n));
    const H = (h: number) => S.hours[h] as string;
    const PAGE = Number(root.dataset.page) || 24;
    type Card = { el: HTMLElement; tz: string; pats: string[]; days: string; rating: number; order: number; status: string; hour: number; day: number };
    const cards: Card[] = [...root.querySelectorAll<HTMLElement>('.bt-card')].map((el, i) => ({
      el, tz: el.dataset.tz || '', pats: (el.dataset.p || '').split('|'), days: el.dataset.d || '0000000',
      rating: Number(el.dataset.rating) || 0, order: i, status: 'o', hour: -1, day: 0,
    }));
    const WEEK = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
    const clock = (tz: string) => {
      try {
        const parts = new Intl.DateTimeFormat('en-US', { timeZone: tz || undefined, weekday: 'long', hour: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
        const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
        return { day: Math.max(0, WEEK.indexOf(get('weekday'))), hour: Number(get('hour')) % 24 };
      } catch { const d = new Date(); return { day: (d.getDay() + 6) % 7, hour: d.getHours() }; }
    };

    // ── State ────────────────────────────────────────────────────────────
    const todayIdx = (new Date().getDay() + 6) % 7;
    const st = { mode: 'now', day: todayIdx, hour: 10, cat: '', country: '', region: '', q: '', sort: 'quiet', shown: PAGE };
    const pattern = (c: Card, day: number) => c.pats[Number(c.days[day]) || 0] || '';
    const cellAt = (pat: string, h: number) => (h < 7 || h > 22 ? 'o' : pat[h - 7] || 'o');
    // End of the quiet run that contains `h` (exclusive hour).
    const quietEnd = (pat: string, h: number) => { let e = h; while (e <= 22 && pat[e - 7] === 'q') e++; return e; };
    const CLS: Record<string, string> = { q: 'quiet', b: 'busy', m: 'mid', x: 'closed' };
    // A guide's title is "Place: what to know (4.5★)"; small spaces want the place.
    const shortName = (c: Card) => (c.el.querySelector('h3')!.textContent || '').split(/\s*[:：(（]/)[0].trim();

    function evaluate() {
      for (const c of cards) {
        if (st.mode === 'now') { const k = clock(c.tz); c.day = k.day; c.hour = k.hour; }
        else { c.day = st.day; c.hour = st.hour; }
        const pat = pattern(c, c.day);
        c.status = cellAt(pat, c.hour);
        // Bar: that day's cells, the hour being looked at outlined.
        const cells = c.el.querySelectorAll<HTMLElement>('.bt-bar i');
        cells.forEach((cell, i) => {
          cell.className = CLS[pat[i]] || 'mid';
          if (i + 7 === c.hour) cell.classList.add('is-now');
        });
        const label = (st.mode === 'now' ? S.stNow : S.stAt)[c.status];
        const when = st.mode === 'now' ? `${S.local} ${H(c.hour)}` : `${S.days[st.day]} ${H(c.hour)}`;
        const p = c.el.querySelector<HTMLElement>('[data-status]')!;
        p.textContent = `${label} · ${when}`;
        p.className = `bt-status st-${c.status}`;
        c.el.classList.toggle('is-quiet', c.status === 'q');
      }
    }

    const matches = (c: Card) => {
      const d = c.el.dataset;
      return (!st.cat || d.cat === st.cat) && (!st.country || d.c === st.country) && (!st.region || d.r === st.region) && (!st.q || (d.q || '').includes(st.q));
    };
    const RANK: Record<string, number> = { q: 0, m: 1, b: 2, o: 3, x: 4 };

    function render() {
      const vis = cards.filter(matches);
      const sorted = [...vis].sort((a, b) =>
        st.sort === 'quiet' ? RANK[a.status] - RANK[b.status] || b.rating - a.rating || a.order - b.order
        : st.sort === 'rating' ? b.rating - a.rating || a.order - b.order
        : a.order - b.order);
      const rank = new Map(sorted.map((c, i) => [c, i]));
      for (const c of cards) {
        const i = rank.get(c);
        c.el.hidden = i == null;
        c.el.style.order = String(i ?? 0);
        c.el.classList.toggle('is-more', i != null && i >= st.shown);
      }
      const n = { q: 0, m: 0, b: 0 } as Record<string, number>;
      for (const c of vis) if (c.status in n) n[c.status]++;
      root.querySelector('[data-n-q]')!.textContent = String(n.q);
      root.querySelector('[data-n-m]')!.textContent = String(n.m);
      root.querySelector('[data-n-b]')!.textContent = String(n.b);
      const when = st.mode === 'now' ? S.whenNow : `${S.days[st.day]} ${H(st.hour)}`;
      root.querySelector('[data-count]')!.textContent = num(S.count, vis.length).replace('{when}', when);
      (root.querySelector('[data-empty]') as HTMLElement).hidden = vis.length > 0;
      const more = root.querySelector<HTMLButtonElement>('[data-more]')!;
      const left = vis.length - st.shown;
      more.hidden = left <= 0;
      if (left > 0) more.textContent = num(S.more, Math.min(left, PAGE));
      widget(sorted);
    }

    function widget(sorted: Card[]) {
      const quiet = sorted.filter((c) => c.status === 'q').sort((a, b) => b.rating - a.rating);
      const pick = st.mode === 'pick';
      const when = `${S.days[st.day]} ${H(st.hour)}`;
      root.querySelector('[data-w-kicker]')!.textContent = pick ? S.wPick.replace('{when}', when) : S.wNow;
      root.querySelector('[data-w-title]')!.textContent = num(pick ? S.wTitlePick : S.wTitleNow, quiet.length);
      const list = root.querySelector('[data-w-list]')!;
      list.replaceChildren(...quiet.slice(0, 3).map((c) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = c.el.querySelector<HTMLAnchorElement>('h3 a')!.href;
        const img = c.el.querySelector('img');
        if (img) { const im = document.createElement('img'); im.src = img.getAttribute('src')!; im.alt = ''; im.width = 44; im.height = 44; a.append(im); }
        const box = document.createElement('span');
        const b = document.createElement('b'); b.textContent = shortName(c);
        const small = document.createElement('small'); small.textContent = `${c.el.dataset.r} · ${pick ? '' : S.local + ' '}${H(c.hour)}`;
        box.append(b, small);
        const chip = document.createElement('em');
        chip.textContent = S.quietUntil.replace('{h}', H(quietEnd(pattern(c, c.day), c.hour)));
        a.append(box, chip);
        li.append(a);
        return li;
      }));
      (root.querySelector('[data-w-none]') as HTMLElement).hidden = quiet.length > 0;
    }

    const refresh = () => { evaluate(); render(); };

    // ── Controls ─────────────────────────────────────────────────────────
    const seg = (sel: string, attr: string, set: (v: string) => void) => {
      root.querySelectorAll<HTMLButtonElement>(`${sel} [${attr}]`).forEach((b) => b.addEventListener('click', () => {
        root.querySelectorAll(`${sel} [${attr}]`).forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
        set(b.getAttribute(attr) || '');
      }));
    };
    seg('[data-cat-group]', 'data-cat', (v) => { st.cat = v; st.shown = PAGE; render(); });
    seg('[data-country-group]', 'data-country', (v) => {
      st.country = v; st.region = ''; st.shown = PAGE;
      const sel = root.querySelector<HTMLSelectElement>('[data-region]')!;
      const regions: string[] = v ? (S.regions[v] || []) : [...new Set(Object.values(S.regions).flat() as string[])].sort();
      const first = sel.options[0].cloneNode(true) as HTMLOptionElement;
      sel.replaceChildren(first, ...regions.map((r) => new Option(r, r)));
      render();
    });
    seg('.bt-sort', 'data-sort', (v) => { st.sort = v; render(); });
    seg('.bt-mode', 'data-mode', (v) => {
      st.mode = v;
      (root.querySelector('[data-pick]') as HTMLElement).hidden = v !== 'pick';
      (root.querySelector('[data-mode-note]') as HTMLElement).hidden = v === 'pick';
      refresh();
    });
    seg('[data-pick]', 'data-day', (v) => { st.day = Number(v); refresh(); });
    const markDay = (sel: string, d: number) => root.querySelectorAll<HTMLElement>(`${sel} [data-day]`).forEach((x) => { const on = Number(x.dataset.day) === d; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', String(on)); });
    markDay('[data-pick]', st.day);
    const range = root.querySelector<HTMLInputElement>('[data-hour]')!;
    const out = root.querySelector<HTMLOutputElement>('[data-hour-out]')!;
    range.addEventListener('input', () => { st.hour = Number(range.value); out.textContent = H(st.hour); refresh(); });
    root.querySelector<HTMLSelectElement>('[data-region]')!.addEventListener('change', (e) => { st.region = (e.target as HTMLSelectElement).value; st.shown = PAGE; render(); });
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const setQ = () => { st.q = q.value.trim().toLowerCase(); st.shown = PAGE; render(); };
    q.addEventListener('input', setQ);
    root.querySelector('[data-search-form]')!.addEventListener('submit', (e) => { e.preventDefault(); setQ(); root.querySelector('.bt-h2')?.scrollIntoView({ behavior: 'smooth' }); });
    root.querySelectorAll<HTMLButtonElement>('[data-city]').forEach((b) => b.addEventListener('click', () => { q.value = b.dataset.city || ''; setQ(); root.querySelector('.bt-h2')?.scrollIntoView({ behavior: 'smooth' }); }));
    root.querySelector('[data-more]')!.addEventListener('click', () => { st.shown += PAGE; render(); });

    // ── Day plan (kept in this browser only) ─────────────────────────────
    const PLAN_KEY = 'wa-quiet-plan-v1';
    const readPlan = (): string[] => { try { return JSON.parse(localStorage.getItem(PLAN_KEY) || '[]'); } catch { return []; } };
    const writePlan = (p: string[]) => { try { localStorage.setItem(PLAN_KEY, JSON.stringify(p)); } catch { /* private mode */ } };
    let plan = readPlan().filter((s) => cards.some((c) => c.el.dataset.s === s));
    const fromUrl = new URLSearchParams(location.search).get('plan');
    if (fromUrl) { plan = fromUrl.split(',').filter((s) => cards.some((c) => c.el.dataset.s === s)); writePlan(plan); }
    const dayParam = new URLSearchParams(location.search).get('day');
    const bySlug = new Map(cards.map((c) => [c.el.dataset.s!, c]));
    function syncPlan() {
      for (const c of cards) {
        const on = plan.includes(c.el.dataset.s!);
        const b = c.el.querySelector<HTMLButtonElement>('[data-add]')!;
        b.setAttribute('aria-pressed', String(on));
        b.textContent = on ? S.added : S.add;
      }
      const bar = root.querySelector<HTMLElement>('[data-planbar]')!;
      bar.hidden = plan.length === 0;
      root.querySelector('[data-plan-n]')!.textContent = num(S.planBar, plan.length);
    }
    root.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) => b.addEventListener('click', () => {
      const s = (b.closest('.bt-card') as HTMLElement).dataset.s!;
      plan = plan.includes(s) ? plan.filter((x) => x !== s) : [...plan, s];
      writePlan(plan); syncPlan();
    }));
    root.querySelector('[data-plan-clear]')!.addEventListener('click', () => { plan = []; writePlan(plan); syncPlan(); });

    const dialog = root.querySelector<HTMLDialogElement>('[data-plan-dialog]')!;
    let planDay = dayParam != null && /^[0-6]$/.test(dayParam) ? Number(dayParam) : todayIdx;
    let planOrder: string[] = [];
    function buildPlan() {
      const day = planDay;
      markDay('[data-plan-days]', day);
      // Each place's first quiet hour that day, earliest first; then one hour
      // per place, never earlier than the place's own quiet start.
      const items = plan.map((s) => bySlug.get(s)).filter(Boolean).map((c) => {
        const pat = pattern(c!, day);
        const first = [...pat].findIndex((x) => x === 'q');
        return { c: c!, pat, start: first < 0 ? null : first + 7 };
      });
      items.sort((a, b) => (a.start ?? 99) - (b.start ?? 99));
      planOrder = items.map((it) => it.c.el.dataset.s!);
      const warn = dialog.querySelector<HTMLElement>('[data-plan-warn]')!;
      warn.hidden = new Set(items.map((it) => it.c.el.dataset.r)).size < 2;
      warn.textContent = S.multiCity;
      let clockAt = 0;
      const list = dialog.querySelector('[data-plan-list]')!;
      list.replaceChildren(...items.map((it) => {
        const li = document.createElement('li');
        const time = document.createElement('b');
        const body = document.createElement('div');
        const name = document.createElement('a');
        name.href = it.c.el.querySelector<HTMLAnchorElement>('h3 a')!.href;
        name.textContent = shortName(it.c);
        const sub = document.createElement('small');
        if (it.start == null) {
          time.textContent = '—';
          sub.textContent = `${it.c.el.dataset.r} · ${S.noQuiet}`;
          li.className = 'is-warn';
        } else {
          const at = Math.max(it.start, clockAt);
          clockAt = at + 1;
          time.textContent = H(at % 24);
          const ok = at <= 22 && it.pat[at - 7] === 'q';
          sub.textContent = `${it.c.el.dataset.r} · ${ok ? S.quietUntil.replace('{h}', H(quietEnd(it.pat, at))) : S.overlap}`;
          if (!ok) li.className = 'is-warn';
        }
        body.append(name, sub);
        li.append(time, body);
        return li;
      }));
    }
    root.querySelector('[data-plan-open]')!.addEventListener('click', () => { buildPlan(); dialog.showModal(); });
    root.querySelector('[data-plan-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.querySelectorAll<HTMLButtonElement>('[data-plan-days] [data-day]').forEach((b) => b.addEventListener('click', () => {
      planDay = Number(b.dataset.day) || 0; buildPlan();
    }));
    // Into /my-trip: the same list the Save button writes (wa_trip_v1). The
    // payload is the minimal one; /my-trip refreshes hours, rating and time
    // zone from /trip-data on open, as it does for any older save.
    dialog.querySelector('[data-plan-save]')!.addEventListener('click', (e) => {
      try {
        const KEY = 'wa_trip_v1';
        const list = JSON.parse(localStorage.getItem(KEY) || '[]');
        for (const s of (planOrder.length ? planOrder : plan)) {
          const c = bySlug.get(s);
          if (c && !list.some((x: any) => x.slug === s)) list.push(JSON.parse(c.el.dataset.save || '{}'));
        }
        localStorage.setItem(KEY, JSON.stringify(list));
        window.dispatchEvent(new CustomEvent('wa-trip-change', { detail: { count: list.length } }));
        (e.currentTarget as HTMLButtonElement).textContent = S.saved;
      } catch { /* storage blocked */ }
    });
    dialog.querySelector('[data-plan-copy]')!.addEventListener('click', async (e) => {
      const url = `${location.origin}${location.pathname}?plan=${(planOrder.length ? planOrder : plan).join(',')}&day=${planDay}`;
      try { await navigator.clipboard.writeText(url); (e.currentTarget as HTMLButtonElement).textContent = S.copied; } catch { prompt('', url); }
    });

    syncPlan();
    refresh();
    if (fromUrl && plan.length) { buildPlan(); dialog.showModal(); }
    // "Now" moves on its own: re-evaluate every minute while in now mode.
    setInterval(() => { if (st.mode === 'now' && !document.hidden) refresh(); }, 60_000);
  </script>

  <style is:global>
    .bt {
      --bt-forest: #26301f; --bt-olive: #3d4a2c; --bt-brown: #7a3b1d; --bt-cream: #fbf3e8; --bt-sand: #efe4d3; --bt-peach: #f6dccb;
      --q1: #45ad76; --q2: #26714b; --b1: #dd8b8b; --b2: #bd382e;
      max-width: var(--max); margin: 0 auto; padding: 18px 20px 120px; display: grid; gap: 22px;
    }
    @media (prefers-color-scheme: dark) { .bt { --bt-cream: #221d17; --bt-sand: #2a241c; --bt-peach: #3a2a20; } }
    .bt :is(div, section, article, aside, form, ol) { min-width: 0; }
    .bt a { color: inherit; }
    .bt-crumb { font-size: .82rem; color: var(--muted); display: flex; gap: 8px; flex-wrap: wrap; }
    .bt-crumb a { text-decoration: none; }
    .bt-pill { display: inline-block; font-size: .78rem; font-weight: 600; padding: 4px 12px; border-radius: var(--r-pill); background: #e3ecd9; color: #34502a; }
    .bt-h2 { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 1.9rem); margin: 8px 0 0; }
    .bt-sub { color: var(--muted); }
    .bt-btn { display: inline-flex; align-items: center; justify-content: center; padding: 10px 16px; border-radius: var(--r-pill); font: inherit; font-weight: 600; text-decoration: none; border: 1px solid transparent; cursor: pointer; }
    .bt-btn-cta { background: var(--cta); color: #fff !important; }
    .bt-btn-cta:hover { background: var(--cta-deep); }
    .bt-btn-ghost { background: var(--surface); border-color: var(--line-strong); color: var(--ink); }
    .bt-sm { padding: 7px 12px; font-size: .86rem; }

    /* hero */
    .bt-hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: 28px; align-items: start; }
    .bt-hero h1 { font-family: var(--font-display); font-size: clamp(2rem, 4.6vw, 3.1rem); line-height: 1.15; margin: 12px 0; }
    .bt-hero h1 span, .bt-hero h1 em { display: block; }
    .bt-hero h1 em { font-style: normal; color: var(--cta); }
    .bt-dek { color: var(--ink-soft); line-height: 1.7; max-width: 36em; }
    .bt-search { display: flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: 6px 6px 6px 16px; margin: 16px 0 10px; box-shadow: var(--shadow-sm); }
    .bt-search input { flex: 1; border: 0; background: transparent; font: inherit; color: var(--ink); outline: none; min-width: 0; }
    .bt-search button { border: 0; background: var(--cta); color: #fff; border-radius: var(--r-pill); padding: 8px 16px; font: inherit; font-weight: 600; cursor: pointer; }
    .bt-popular { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: .82rem; color: var(--muted); }
    .bt-tag { font: inherit; font-size: .84rem; padding: 5px 12px; border-radius: var(--r-pill); border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); cursor: pointer; }
    .bt-widget { background: var(--bt-forest); color: #fbf3e8; border-radius: var(--r-lg); padding: 22px; position: relative; overflow: hidden; box-shadow: var(--shadow-md); }
    .bt-widget::after { content: ''; position: absolute; width: 220px; height: 220px; border-radius: 50%; background: rgba(255,255,255,.06); right: -60px; top: -80px; }
    .bt-w-kicker { display: flex; gap: 8px; align-items: center; font-size: .78rem; opacity: .85; margin: 0; }
    .bt-w-kicker i { width: 8px; height: 8px; border-radius: 50%; background: var(--q1); box-shadow: 0 0 0 4px rgba(69,173,118,.25); }
    .bt-w-title { font-family: var(--font-display); font-size: 1.45rem; margin: 10px 0 12px; position: relative; z-index: 1; }
    .bt-w-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; position: relative; z-index: 1; }
    .bt-w-list a { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,.09); border-radius: 16px; padding: 8px 10px; text-decoration: none; }
    .bt-w-list img { width: 44px; height: 44px; border-radius: 12px; object-fit: cover; flex: none; }
    .bt-w-list span { flex: 1; min-width: 0; display: grid; }
    .bt-w-list b { font-size: .95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bt-w-list small { font-size: .74rem; opacity: .75; }
    .bt-w-list em { font-style: normal; font-size: .74rem; font-weight: 700; background: #e3ecd9; color: #26301f; padding: 4px 10px; border-radius: var(--r-pill); white-space: nowrap; }
    .bt-w-none { font-size: .9rem; opacity: .85; position: relative; }
    .bt-w-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; position: relative; z-index: 1; }
    .bt-w-stats div { background: rgba(255,255,255,.08); border-radius: 14px; padding: 10px; }
    .bt-w-stats span { display: block; font-size: .7rem; opacity: .8; }
    .bt-w-stats b { font-family: var(--font-display); font-size: 1.2rem; white-space: nowrap; }
    .bt-w-stats div:last-child b { font-size: .92rem; white-space: normal; line-height: 1.25; display: block; margin-top: 2px; }

