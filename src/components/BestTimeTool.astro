---
// FREE INTERACTIVE TOOL — "Best time to visit / Crowd finder", shared by the
// English route and the [lang] routes. Built from the busy/quiet hour data we
// already collect per venue (BestTime.app), which no other travel site aggregates
// like this → genuinely link-worthy. Pure client-side filter over a build-time
// JSON index; no API calls, no server.
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from './Newsletter.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { resolveBusyness } from '../lib/busyness.mjs';
import { createHash } from 'node:crypto';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

// Faint card background = the venue's own photo. Reuse the SELF-HOSTED 640px WebP
// thumbnails that build-wall.mjs already produces (public/wall/<sha1(heroUrl)>.webp,
// ~39KB each). Hot-linking the remote originals instead would be slow and gets
// rate-limited (Wikimedia 429s and restricts thumb sizes). Posts whose thumbnail
// hasn't been built yet simply render without a background — the daily job fills
// them in over time.
const wallHash = (s: string) => createHash('sha1').update(s).digest('hex').slice(0, 16);
const WALL_DIR = fileURLToPath(new URL('../../public/wall/', import.meta.url));
const wallFor = (heroUrl?: string) => {
  if (!heroUrl) return '';
  const name = `${wallHash(heroUrl)}.webp`;
  return existsSync(WALL_DIR + name) ? `/wall/${name}` : '';
};

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getCollection('posts', ({ data }) => !data.draft);

// Translated post titles, so a Korean visitor sees Korean venue names.
const i18nTitles = new Map<string, string>();
if (lang !== 'en') {
  const tr = await getCollection('postI18n', ({ data }) => data.lang === lang);
  for (const e of tr) i18nTitles.set(e.data.slug, e.data.title);
}

// Hours shown on the bar, and the labels that state the same thing in words.
// Both are computed HERE, at build time, because the cards below are rendered
// server-side now: the entire point is that the crowd hours exist as text in the
// delivered HTML.
const HOURS = Array.from({ length: 16 }, (_, i) => i + 7); // 7am … 10pm
const hr = (h: number) => {
  const x = ((h % 24) + 24) % 24;
  return `${x % 12 || 12}${x < 12 ? 'am' : 'pm'}`;
};
const range = (arr?: number[]) => {
  if (!arr?.length) return null;
  const s = [...arr].sort((a, b) => a - b);
  return `${hr(s[0])}–${hr(s[s.length - 1] + 1)}`;
};

const index = posts
  .filter((p) => p.data.place?.busyness && (
    (p.data.place.busyness.weekdayQuiet?.length) ||
    (p.data.place.busyness.weekendQuiet?.length) ||
    (p.data.place.busyness.weekendBusy?.length)
  ))
  .map((p) => {
    const slug = p.id.replace(/\.md$/, '');
    const country = p.data.country ?? 'South Korea';
    // The heatmap below already resolved quiet-vs-busy correctly, cell by cell
    // (`busy.has(h) ? 'busy' : …`), but the quiet LABEL beside it did not — so a
    // card could read "quiet 9am-5pm" while its own cells showed 11-16 red. Same
    // shared rule as the crowd API and the post page now.
    const rb = resolveBusyness(p.data.place?.busyness);
    const wq = rb.weekdayQuiet;
    const weq = rb.weekendQuiet;
    const web = rb.weekendBusy;
    const quiet = new Set([...wq, ...weq]);
    const busy = new Set(web);
    return {
      s: slug,
      u: localizePath(`/posts/${slug}`, lang),
      t: i18nTitles.get(slug) || p.data.title,
      r: localizePlace(p.data.region, lang),
      c: localizePlace(country, lang),
      cat: p.data.category,
      b: wallFor(p.data.heroImage?.url),
      quietLabel: range(wq) || range(weq),
      busyLabel: range(web),
      cells: HOURS.map((h) => (busy.has(h) ? 'busy' : quiet.has(h) ? 'quiet' : 'mid')),
    };
  })
  .sort((a, b) => a.c.localeCompare(b.c) || a.r.localeCompare(b.r) || a.t.localeCompare(b.t));

// Filter options are rendered into the <select>s at build time too, so the page
// is fully usable — and fully readable — before any script runs.
const countries = [...new Set(index.map((d) => d.c))].sort();
const regionsByCountry: Record<string, string[]> = {};
for (const d of index) (regionsByCountry[d.c] ??= []).includes(d.r) || regionsByCountry[d.c].push(d.r);
for (const k of Object.keys(regionsByCountry)) regionsByCountry[k].sort();
const allRegions = [...new Set(index.map((d) => d.r))].sort();

// Strings the client-side renderer needs.
const strings = {
  allCities: t('tool.allCities'),
  places: t('tool.places'),
  quietest: t('tool.quietest'),
  quiet: t('tool.quiet'),
  empty: t('tool.empty'),
  cat: {
    restaurant: t('cat.restaurant'),
    trendy: t('cat.trendy'),
    'hidden-gem': t('cat.hidden-gem'),
    attraction: t('cat.attraction'),
  },
};

// ---- Aggregate findings (build-time, quotable) ----
// The linkable asset is not the filter UI — it is a set of concrete figures a
// journalist or blogger can quote ("X% of venues are quietest before 11 AM").
// Computed here so they render as plain text in the delivered HTML, and stay
// current automatically as the daily pipeline adds venues.
let wdQuietTotal = 0, morningCount = 0, attrTotal = 0, attrMorning = 0;
const weekendBusyFreq = new Map<number, number>();
const restQuietFreq = new Map<number, number>();
const cityAgg = new Map<string, { n: number; freq: Map<number, number> }>();
for (const p of posts) {
  const b = p.data.place?.busyness;
  if (!b) continue;
  const wq = b.weekdayQuiet ?? [];
  if (wq.length) {
    wdQuietTotal++;
    const earliest = Math.min(...wq);
    if (earliest < 11) morningCount++;
    if (p.data.category === 'attraction') { attrTotal++; if (earliest < 11) attrMorning++; }
    if (p.data.category === 'restaurant') for (const h of wq) restQuietFreq.set(h, (restQuietFreq.get(h) ?? 0) + 1);
  }
  for (const h of b.weekendBusy ?? []) weekendBusyFreq.set(h, (weekendBusyFreq.get(h) ?? 0) + 1);
  const city = localizePlace(p.data.region, lang);
  const agg = cityAgg.get(city) ?? { n: 0, freq: new Map<number, number>() };
  agg.n++;
  for (const h of [...wq, ...(b.weekendQuiet ?? [])]) agg.freq.set(h, (agg.freq.get(h) ?? 0) + 1);
  cityAgg.set(city, agg);
}
const modeHour = (m: Map<number, number>) =>
  [...m.entries()].sort((a, b) => b[1] - a[1] || a[0] - b[0])[0]?.[0];
// Localized clock label ("2 PM" / "오후 2시" / "午後2時" / "下午2点") for the
// figure slots — hr() above is English-only bar labeling.
const hourLabel = (h: number | undefined) => {
  if (h == null) return '';
  const x = ((h % 24) + 24) % 24;
  const h12 = x % 12 || 12;
  if (lang === 'ko') return `${x < 12 ? '오전' : '오후'} ${h12}시`;
  if (lang === 'ja') return `${x < 12 ? '午前' : '午後'}${h12}時`;
  if (lang === 'zh') return `${x < 12 ? '上午' : '下午'}${h12}点`;
  return `${h12} ${x < 12 ? 'AM' : 'PM'}`;
};
const morningPct = wdQuietTotal ? Math.round((morningCount / wdQuietTotal) * 100) : 0;
const attrPct = attrTotal ? Math.round((attrMorning / attrTotal) * 100) : 0;
const peakHour = modeHour(weekendBusyFreq);
const restHour = modeHour(restQuietFreq);
// Cities with enough venues for the mode to mean something.
const cityRows = [...cityAgg.entries()]
  .filter(([, v]) => v.n >= 3 && v.freq.size)
  .sort((a, b) => b[1].n - a[1].n || a[0].localeCompare(b[0]))
  .slice(0, 10)
  .map(([city, v]) => ({ city, n: v.n, hour: hourLabel(modeHour(v.freq)) }));
const fill = (key: Parameters<typeof t>[0], vars: Record<string, string | number>) =>
  Object.entries(vars).reduce((s, [k, v]) => s.replace(`{${k}}`, String(v)), t(key));

// Dataset markup alongside the WebApplication: this is what makes the page
// discoverable in Google Dataset Search — a real inbound-link channel for a
// dataset no other travel site publishes. English on purpose: one dataset,
// one canonical identity across the five language routes.
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Quiet & busy visiting hours for ${index.length} travel venues`,
  description:
    'Quietest and busiest visiting hours per venue (cafés, restaurants, attractions) derived from BestTime.app live foot-traffic forecasts, clamped to each venue’s opening hours. Updated as new guides are published.',
  url: 'https://wanderatlasguides.com/tools/best-time/',
  creator: { '@type': 'Organization', name: 'Wander Atlas', url: 'https://wanderatlasguides.com' },
  isAccessibleForFree: true,
  temporalCoverage: '2026/..',
};

// Breadcrumbs. Every other hub type on the site emits a BreadcrumbList; the
// four tool pages were the only ones that never did, so Google had no parent
// for them and printed a bare URL where the other hubs get a Home > ... trail.
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: t('tool.h1'),
      applicationCategory: 'TravelApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: t('tool.metaDesc'),
      url: pageUrl,
      isPartOf: { '@id': `${site}/#site` },
    },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.home'), item: new URL(localizePath('/', lang), Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: t('tool.h1'), item: pageUrl },
    ] },
  ],
};
---
<BaseLayout title={t('tool.metaTitle')} description={t('tool.metaDesc')} jsonLd={jsonLd} localized={true}>
  <section class="tool">
    <div class="wrap">
      <p class="kicker gold">{t('tool.kicker')}</p>
      <h1>{t('tool.h1')}</h1>
      <p class="dek">{t('tool.dek').replace('{n}', String(index.length))}</p>

      <div class="filters">
        <label>{t('tool.country')}<select id="f-country">
          <option value="">{t('tool.allCountries')}</option>
          {countries.map((c) => <option value={c}>{c}</option>)}
        </select></label>
        <label>{t('tool.city')}<select id="f-region">
          <option value="">{t('tool.allCities')}</option>
          {allRegions.map((r) => <option value={r}>{r}</option>)}
        </select></label>
        <label>{t('tool.type')}<select id="f-cat">
          <option value="">{t('tool.allTypes')}</option>
          <option value="restaurant">{t('cat.restaurant')}</option>
          <option value="trendy">{t('cat.trendy')}</option>
          <option value="hidden-gem">{t('cat.hidden-gem')}</option>
          <option value="attraction">{t('cat.attraction')}</option>
        </select></label>
      </div>

      <div class="meta">
        <p id="count" class="count">{t('tool.places').replace('{n}', String(index.length))}</p>
        <div class="legend">
          <span><i class="sw-quiet"></i> {t('tool.quiet')}</span>
          <span><i class="sw-mid"></i> {t('tool.normal')}</span>
          <span><i class="sw-busy"></i> {t('tool.busy')}</span>
        </div>
      </div>
      {/* The page ran h1 straight into 157 h3 cards with no h2 anywhere — the
          largest single heading skip on the site. The results list is the
          section; it just never had a name a screen reader could see. */}
      <h2 class="sr-only">{t('a11y.results')}</h2>
      {/* Rendered here, at build time, not injected by the script below. The
          crowd hours are the one thing on this site that assistants cannot get
          from Google Maps — and assistants do not run JavaScript, so for as long
          as this list was written by the client it was a blank page to exactly
          the readers it was built for. The script now filters these nodes; it no
          longer creates them. */}
      <div id="results" class="results">
        {index.map((d) => (
          <a class="card" href={d.u} data-c={d.c} data-r={d.r} data-cat={d.cat}>
            <div class="photo" data-bg={d.b || undefined}>
              <span class="badge">{strings.cat[d.cat as keyof typeof strings.cat] || d.cat} · {d.r}</span>
              {d.quietLabel && <span class="chip">{d.quietLabel} {t('tool.quiet')}</span>}
            </div>
            <div class="body">
              <h3>{d.t}</h3>
              {/* The same figures the bar draws, in words — this is the part a
                  language model can quote. */}
              <p class="hours">
                {d.quietLabel && <span>{t('tool.quietest')} {d.quietLabel}</span>}
                {d.quietLabel && d.busyLabel && <span aria-hidden="true"> · </span>}
                {d.busyLabel && <span>{t('tool.busy')} {d.busyLabel}</span>}
              </p>
              <div class="barwrap">
                <div class="bar">{d.cells.map((cls, i) => <i class={cls} title={hr(HOURS[i])}></i>)}</div>
                <div class="barlab"><span>7am</span><span>2pm</span><span>10pm</span></div>
              </div>
            </div>
          </a>
        ))}
      </div>
      <p class="empty" id="empty" hidden>{t('tool.empty')}</p>
      <p class="foot">{t('tool.foot')}</p>

      <section class="findings" aria-labelledby="findings-h">
        <h2 id="findings-h">{t('tool.findings.h2')}</h2>
        <p class="dek">{fill('tool.findings.intro', { n: index.length })}</p>
        <ul class="facts">
          {wdQuietTotal >= 30 && <li>{fill('tool.findings.morning', { pct: morningPct })}</li>}
          {peakHour != null && <li>{fill('tool.findings.peak', { hour: hourLabel(peakHour) })}</li>}
          {attrTotal >= 10 && restHour != null && (
            <li>{fill('tool.findings.cats', { aPct: attrPct, rHour: hourLabel(restHour) })}</li>
          )}
        </ul>
        {cityRows.length > 0 && (
          <>
            <h3>{t('tool.findings.city.h3')}</h3>
            <div class="tblwrap">
              <table>
                <thead>
                  <tr>
                    <th>{t('tool.findings.city.city')}</th>
                    <th>{t('tool.findings.city.hour')}</th>
                    <th>{t('tool.findings.city.n')}</th>
                  </tr>
                </thead>
                <tbody>
                  {cityRows.map((r) => (
                    <tr><td>{r.city}</td><td>{r.hour}</td><td>{r.n}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}
        <h3>{t('tool.findings.method.h3')}</h3>
        <p>{fill('tool.findings.method.body', { n: index.length })}</p>
        <h3>{t('tool.cite.h3')}</h3>
        <p>{t('tool.cite.body')}</p>
      </section>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(datasetLd)} />

  <Newsletter lang={lang} />

  <script type="application/json" id="regions" set:html={JSON.stringify(regionsByCountry)} />
  <script is:inline data-count-tpl={t('tool.places')}>
    (() => {
      // Filters what the server already rendered. It does not build the list —
      // see the note on #results. Everything here degrades to "all cards
      // visible", which is a correct page.
      const REGIONS = JSON.parse(document.getElementById('regions').textContent);
      const COUNT_TPL = document.currentScript.dataset.countTpl;
      const $c = document.getElementById('f-country');
      const $r = document.getElementById('f-region');
      const $cat = document.getElementById('f-cat');
      const $count = document.getElementById('count');
      const $empty = document.getElementById('empty');
      const cards = Array.prototype.slice.call(document.querySelectorAll('#results .card'));
      const allCitiesOption = $r.options[0].cloneNode(true);

      function refreshRegions() {
        const c = $c.value;
        const regions = c ? (REGIONS[c] || []) : [...new Set(Object.values(REGIONS).flat())].sort();
        $r.replaceChildren(allCitiesOption.cloneNode(true));
        for (const r of regions) $r.add(new Option(r, r));
      }

      function render() {
        const c = $c.value, r = $r.value, cat = $cat.value;
        let n = 0;
        for (const el of cards) {
          const ok = (!c || el.dataset.c === c) && (!r || el.dataset.r === r) && (!cat || el.dataset.cat === cat);
          el.hidden = !ok;
          if (ok) n++;
        }
        $count.textContent = COUNT_TPL.replace('{n}', n);
        $empty.hidden = n > 0;
        lazyBackgrounds();
      }

      // Load each card's photo only when it scrolls near the viewport — with 184
      // cards, loading every background up front would cost megabytes on open.
      let io = null;
      function lazyBackgrounds() {
        if (!('IntersectionObserver' in window)) return; // no lazy support → skip images entirely
        if (io) io.disconnect();
        io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target;
            const src = el.dataset.bg;
            if (src) {
              const img = new Image();
              img.onload = () => { el.style.backgroundImage = `url("${src}")`; el.classList.add('on'); };
              img.src = src;
            }
            io.unobserve(el);
          }
        }, { rootMargin: '300px' });
        // Only cards currently on screen: a hidden card never intersects, so it
        // would otherwise hold an observer forever and never load when shown.
        for (const el of document.querySelectorAll('#results .card:not([hidden]) .photo[data-bg]')) io.observe(el);
      }

      $c.addEventListener('change', () => { refreshRegions(); render(); });
      $r.addEventListener('change', render);
      $cat.addEventListener('change', render);
      refreshRegions(); render();
    })();
  </script>

  <!-- is:global — the result cards are injected by JS, so Astro's scoped styles
       (which only tag build-time markup) would never reach them. Scoped under
       .tool so nothing leaks to the rest of the site. -->
  <style is:global>
    .tool { padding-block: clamp(2rem, 5vh, 4rem); }
    .tool h1 { font-size: clamp(1.9rem, 4vw, 2.7rem); margin: 0.2rem 0 0.5rem; letter-spacing: -0.01em; }
    .tool .dek { color: var(--ink-soft); max-width: 62ch; font-size: 1.05rem; line-height: 1.6; }

    .tool .filters { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.75rem 0 0.75rem; padding: 1rem; background: var(--surface-2); border: 1px solid var(--line-soft); border-radius: var(--r-lg); }
    .tool .filters label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
    .tool .filters select { padding: 0.6rem 0.75rem; border: 1px solid var(--line-strong); border-radius: var(--r-md); background: var(--surface); color: var(--ink); font-size: 0.95rem; min-width: 12rem; font-family: inherit; cursor: pointer; }
    .tool .filters select:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

    .tool .meta { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin: 0.75rem 0 1rem; }
    .tool .count { color: var(--muted); font-size: 0.85rem; margin: 0; font-weight: 600; }
    .tool .legend { display: flex; gap: 0.9rem; font-size: 0.72rem; color: var(--muted); }
    .tool .legend span { display: inline-flex; align-items: center; gap: 0.3rem; }
    .tool .legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
    /* Swatches reuse the exact bar-cell colours (was inline hex — the one
       un-tokenized spot the 2026-08-08 design audit found on this page). */
    .tool .legend i.sw-quiet { background: linear-gradient(180deg, #45ad76, #26714b); }
    .tool .legend i.sw-mid { background: var(--line); }
    .tool .legend i.sw-busy { background: linear-gradient(180deg, #dd8b8b, #bd382e); }
    /* The green dot the chip used to carry as a 🟢 emoji, now a CSS dot that
       matches the quiet colour in both themes. */
    .tool .chip::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: linear-gradient(180deg, #45ad76, #26714b); display: inline-block; margin-right: 0.4rem; vertical-align: baseline; }

    .tool .results { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
    .tool .card { position: relative; overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); text-decoration: none; color: var(--ink); transition: box-shadow .16s ease, transform .16s ease, border-color .16s ease; }
    .tool .card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); border-color: var(--accent-soft); }
    /* Photo band on top; the venue's real photo at full strength. Overlays sit on
       their own near-opaque pills so they clear WCAG AA over ANY photo (verified
       worst-case: white badge text 8.4:1 on a white photo, green chip 8.0:1 on a
       black one) — no scrim maths needed anywhere else. */
    /* No opacity fade: Chrome does not record LCP for an element that is not yet
       opaque, so the fade pushed measured LCP from 596ms to 4,160ms — the page
       looked slow to Google while being fast. The lazy-load reveal keeps working;
       the image simply appears when ready instead of fading in. */
    .tool .photo { height: 152px; background: var(--surface-2) center/cover no-repeat; position: relative; flex: none; }
    .tool .badge { position: absolute; left: 10px; top: 10px; max-width: calc(100% - 20px); background: rgba(20,18,15,0.78); color: #fff; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; padding: 0.25rem 0.5rem; border-radius: var(--r-pill); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tool .chip { position: absolute; left: 10px; bottom: 10px; background: rgba(255,253,249,0.95); color: #14523a; font-size: 0.78rem; font-weight: 800; padding: 0.25rem 0.55rem; border-radius: var(--r-pill); }
    .tool .body { padding: 0.85rem 1rem 1rem; display: flex; flex-direction: column; flex: 1; }
    @media (prefers-color-scheme: dark) {
      .tool .chip { background: rgba(30,26,21,0.92); color: #6fd39d; }
    }
    @media (prefers-reduced-motion: reduce) { .tool .photo { transition: none; } }

    .tool .card h3 { font-size: 1.02rem; margin: 0 0 0.45rem; line-height: 1.3; font-weight: 700; }
    /* The cards are display:flex, and that beats the `hidden` attribute's default
       display:none — without this rule the filters would appear to do nothing. */
    .tool .card[hidden] { display: none; }
    /* The crowd hours in words, directly under the venue name: the quotable line. */
    .tool .hours { margin: 0 0 0.7rem; font-size: 0.82rem; line-height: 1.45; color: var(--ink-soft); font-weight: 600; }

    /* The bar sits over the photo, so each cell gets a hairline + soft shadow to
       stay crisp, and the neutral "mid" cells are opaque rather than tinted. */
    .tool .barwrap { margin-top: auto; }
    .tool .bar { display: flex; gap: 2px; height: 26px; align-items: flex-end; }
    /* The neutral "normal" cells can't reach 3:1 on fill alone against a near-white
       card (any beige light enough to read as neutral tops out ~2:1), so they get a
       visible hairline OUTLINE instead — that's what makes the cell distinguishable. */
