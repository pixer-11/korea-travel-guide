---
// FREE INTERACTIVE TOOL — "Best time to visit / Crowd finder", shared by the
// English route and the [lang] routes. Built from the busy/quiet hour data we
// already collect per venue (BestTime.app), which no other travel site aggregates
// like this → genuinely link-worthy.
//
// Redesign 2026-10-01 from the owner's "한산한 시간 개선안": a "quiet right now"
// widget computed in each venue's OWN time zone, a sticky filter bar with a
// "pick a time" mode (day of the week + hour slider — moving it re-colours every
// card's status, the outlined hour on its bar, the counts and the widget), a
// day plan ordered by quiet hours that saves into /my-trip, and the venue
// photos the mock-up left out. Everything a crawler or an assistant reads —
// names, hours in words, the bars — is still rendered here at build time; the
// script only filters, re-orders and re-colours.
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteHref } from '../lib/urls.mjs';
import Newsletter from './Newsletter.astro';
import { getCollection } from 'astro:content';
import { heroOf, TOOL_OG } from '../lib/toolOgPhoto.mjs';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { resolveBusyness, quietDayGroups, perDayBusyness, dayGroupKind, dayGroupText, DAY_NAMES } from '../lib/busyness.mjs';
import { formatHour, formatHourRanges } from '../lib/hours.mjs';
import { parseWeek } from '../lib/open-now.mjs';
import { venueTimeZone } from '../lib/venue-tz.mjs';
import { slugifyRegion } from '../lib/slug';
import { createHash } from 'node:crypto';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

// Card photo = the venue's own photo. Reuse the SELF-HOSTED 640px WebP
// thumbnails that build-wall.mjs already produces (public/wall/<sha1(heroUrl)>.webp,
// ~39KB each). Hot-linking the remote originals instead would be slow and gets
// rate-limited (Wikimedia 429s and restricts thumb sizes). Posts whose thumbnail
// hasn't been built yet simply render without one — the daily job fills them in.
const wallHash = (s: string) => createHash('sha1').update(s).digest('hex').slice(0, 16);
const WALL_DIR = fileURLToPath(new URL('../../public/wall/', import.meta.url));
const wallFor = (heroUrl?: string) => {
  if (!heroUrl) return '';
  const name = `${wallHash(heroUrl)}.webp`;
  return existsSync(WALL_DIR + name) ? `/wall/${name}` : '';
};

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getCollection('posts', ({ data }) => !data.draft);

// Translated post titles, so a Korean visitor sees Korean venue names.
const i18nTitles = new Map<string, string>();
if (lang !== 'en') {
  const tr = await getCollection('postI18n', ({ data }) => data.lang === lang);
  for (const e of tr) i18nTitles.set(e.data.slug, e.data.title);
}

// Hours shown on the bar, and the labels that state the same thing in words.
// Both are computed HERE, at build time: the crowd hours exist as text in the
// delivered HTML.
const HOURS = Array.from({ length: 16 }, (_, i) => i + 7); // 7am … 10pm
const AMPM = { am: t('post.am'), pm: t('post.pm') };
const hr = (h: number) => formatHour(h, { ...AMPM, lang });
// The label is every quiet RUN, not first-to-last (2026-09-14: 211 of 735 cards
// had a printed range that swallowed hours the same card marks busy).
const range = (arr?: number[]) => formatHourRanges(arr ?? [], { ...AMPM, lang }) || null;

// One hour cell, for one day: closed (outside that day's opening hours), busy,
// quiet or neither. perDayBusyness has already removed quiet/busy hours that
// fall outside the day's opening hours; the week tells us which are closed.
type Cell = 'q' | 'b' | 'm' | 'x';
// An hour counts as open only when the WHOLE hour is — the same rule
// perDayBusyness applies — so 9:15 at a place opening 9:30 never reads
// "moderate now" (codex + review, 2026-10-01).
const openHour = (week: number[][][] | null, day: number, h: number) =>
  !week || week[day].some(([s, e]) => s <= h * 60 && e >= (h + 1) * 60) ||
  week[(day + 6) % 7].some(([, e]) => e > 1440 && e - 1440 >= (h + 1) * 60);

const index = posts
  .filter((p) => p.data.place?.busyness && (
    (p.data.place.busyness.weekdayQuiet?.length) ||
    (p.data.place.busyness.weekendQuiet?.length) ||
    (p.data.place.busyness.weekendBusy?.length)
  ))
  .map((p) => {
    const slug = p.id.replace(/\.md$/, '');
    const place = p.data.place!;
    const country = p.data.country ?? 'South Korea';
    const rb = resolveBusyness(place.busyness);
    // A card has room for one claim, so the words show the biggest group of days
    // that agree — and say which days those are unless it is the whole week.
    const groups = quietDayGroups(place.busyness, place.openingHours);
    const g = groups?.[0];
    const wq = groups ? (g?.quiet ?? []) : (rb.weekdayQuiet.length ? rb.weekdayQuiet : rb.weekendQuiet);
    const web = groups ? (g?.busy ?? []) : rb.weekendBusy;
    const dayLabel = g && dayGroupKind(g.days).kind !== 'daily' ? dayGroupText(g.days, t) : '';
    const withDays = (s: string | null) => (s && dayLabel ? `${dayLabel} ${s}` : s);
    // The bar, per day of the week. The script picks the day the reader is
    // looking at (today in the venue's own time zone, or the weekday/weekend
    // they chose); the server renders the words' group as the default.
    const perDay = perDayBusyness(place.busyness, place.openingHours);
    const week = place.hoursOmitted ? null : parseWeek(place.openingHours);
    const dayPatterns = DAY_NAMES.map((dn, di) => {
      const d = perDay?.get(dn) ?? (di >= 5 ? { quiet: rb.weekendQuiet, busy: rb.weekendBusy } : { quiet: rb.weekdayQuiet, busy: rb.weekdayBusy });
      const q = new Set(d.quiet), b = new Set(d.busy);
      return HOURS.map((h): Cell => (!openHour(week, di, h) ? 'x' : b.has(h) ? 'b' : q.has(h) ? 'q' : 'm')).join('');
    });
    const uniq = [...new Set(dayPatterns)];
    const quiet = new Set(wq), busy = new Set(web);
    const defaultCells = HOURS.map((h) => (busy.has(h) ? 'b' : quiet.has(h) ? 'q' : 'm'));
    return {
      s: slug,
      u: localizePath(`/posts/${slug}`, lang),
      t: i18nTitles.get(slug) || p.data.title,
      r: localizePlace(p.data.region, lang),
      rs: slugifyRegion(p.data.region ?? ''),
      region: p.data.region,
      country,
      c: localizePlace(country, lang),
      cat: p.data.category,
      rating: typeof place.rating === 'number' ? place.rating : 0,
      reviews: place.userRatingsTotal ?? 0,
      tz: venueTimeZone(country, p.data.region) ?? '',
      b: wallFor(p.data.heroImage?.url),
      quietLabel: withDays(range(wq)),
      busyLabel: withDays(range(web)),
      pats: uniq.join('|'),
      days: dayPatterns.map((x) => uniq.indexOf(x)).join(''),
      cells: defaultCells,
    };
  })
  .sort((a, b) => a.c.localeCompare(b.c) || a.r.localeCompare(b.r) || a.t.localeCompare(b.t));

// Filter options, rendered at build time so the page is usable before any script.
const countryCount = new Map<string, number>();
for (const d of index) countryCount.set(d.c, (countryCount.get(d.c) ?? 0) + 1);
const countries = [...countryCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const regionsByCountry: Record<string, string[]> = {};
for (const d of index) (regionsByCountry[d.c] ??= []).includes(d.r) || regionsByCountry[d.c].push(d.r);
for (const k of Object.keys(regionsByCountry)) regionsByCountry[k].sort();
const allRegions = [...new Set(index.map((d) => d.r))].sort();
const regionCount = new Map<string, number>();
for (const d of index) regionCount.set(d.r, (regionCount.get(d.r) ?? 0) + 1);
const popularCities = [...regionCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8).map(([r]) => r);
const catCount = new Map<string, number>();
for (const d of index) catCount.set(d.cat, (catCount.get(d.cat) ?? 0) + 1);

// The "timed tickets" band: the most-reviewed attraction we have a photo for.
const bandPhoto = [...index].filter((d) => d.cat === 'attraction' && d.b).sort((a, b) => b.reviews - a.reviews)[0]?.b ?? '';

// ---- Aggregate findings (build-time, quotable) ----
// The linkable asset is not the filter UI — it is a set of concrete figures a
// journalist or blogger can quote. Computed here so they render as plain text.
let wdQuietTotal = 0, morningCount = 0, attrTotal = 0, attrMorning = 0;
const weekendBusyFreq = new Map<number, number>();
const restQuietFreq = new Map<number, number>();
const cityAgg = new Map<string, { n: number; freq: Map<number, number> }>();
for (const p of posts) {
  const b = p.data.place?.busyness;
  if (!b) continue;
  const wq = b.weekdayQuiet ?? [];
  if (wq.length) {
    wdQuietTotal++;
    const earliest = Math.min(...wq);
    if (earliest < 11) morningCount++;
    if (p.data.category === 'attraction') { attrTotal++; if (earliest < 11) attrMorning++; }
    if (p.data.category === 'restaurant') for (const h of wq) restQuietFreq.set(h, (restQuietFreq.get(h) ?? 0) + 1);
  }
  for (const h of b.weekendBusy ?? []) weekendBusyFreq.set(h, (weekendBusyFreq.get(h) ?? 0) + 1);
  const city = localizePlace(p.data.region, lang);
  const agg = cityAgg.get(city) ?? { n: 0, freq: new Map<number, number>() };
  agg.n++;
  for (const h of [...wq, ...(b.weekendQuiet ?? [])]) agg.freq.set(h, (agg.freq.get(h) ?? 0) + 1);
  cityAgg.set(city, agg);
}
const modeHour = (m: Map<number, number>) =>
  [...m.entries()].sort((a, b) => b[1] - a[1] || a[0] - b[0])[0]?.[0];
const hourLabel = (h: number | undefined) => {
  if (h == null) return '';
  const x = ((h % 24) + 24) % 24;
  const h12 = x % 12 || 12;
  if (lang === 'ko') return `${x < 12 ? '오전' : '오후'} ${h12}시`;
  if (lang === 'ja') return `${x < 12 ? '午前' : '午後'}${h12}時`;
  if (lang === 'zh') return `${x < 12 ? '上午' : '下午'}${h12}点`;
  return `${h12} ${x < 12 ? 'AM' : 'PM'}`;
};
const morningPct = wdQuietTotal ? Math.round((morningCount / wdQuietTotal) * 100) : 0;
const attrPct = attrTotal ? Math.round((attrMorning / attrTotal) * 100) : 0;
const peakHour = modeHour(weekendBusyFreq);
const restHour = modeHour(restQuietFreq);
const cityRows = [...cityAgg.entries()]
  .filter(([, v]) => v.n >= 3 && v.freq.size)
  .sort((a, b) => b[1].n - a[1].n || a[0].localeCompare(b[0]))
  .slice(0, 10)
  .map(([city, v]) => ({ city, n: v.n, hour: hourLabel(modeHour(v.freq)) }));
const fill = (key: Parameters<typeof t>[0], vars: Record<string, string | number>) =>
  Object.entries(vars).reduce((s, [k, v]) => s.replace(`{${k}}`, String(v)), t(key));

