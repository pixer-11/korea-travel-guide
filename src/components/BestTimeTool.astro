            <li><i><Fragment set:html={svg('clock', 16)} /></i><div><b>{T.adjT}</b><span>{T.adjB}</span></div></li>
            <li><i><Fragment set:html={svg('shield', 16)} /></i><div><b>{T.ruleT}</b><span>{T.ruleB}</span></div></li>
