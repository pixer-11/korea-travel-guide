<BaseLayout image={heroOf(posts, TOOL_OG.bestTime)} title={t('tool.metaTitle')} description={t('tool.metaDesc')} jsonLd={jsonLd} localized={true}>
  <section class="bt" data-bt data-page={PAGE}>
    <nav class="bt-crumb" aria-label={t('a11y.breadcrumb')}><a href={localizePath('/', lang)}>{t('post.home')}</a><span aria-hidden="true">·</span><span>{T.crumbTools}</span><span aria-hidden="true">·</span><span>{t('tool.h1')}</span></nav>

    <!-- Hero: search + the "quiet right now" widget -->
    <div class="bt-hero">
      <div class="bt-hero-copy">
        <span class="bt-pill">{T.badge}</span>
        <h1><span>{T.h1a}</span> <em>{T.h1b}</em></h1>
        <p class="bt-dek">{T.dek(index.length)}</p>
        <form class="bt-search" role="search" data-search-form>
          <span aria-hidden="true">⌕</span>
          <input type="search" name="q" placeholder={T.searchPh} aria-label={T.searchPh} data-q autocomplete="off" />
          <button type="submit">{T.searchBtn}</button>
        </form>
        <div class="bt-popular"><span>{T.popular}</span>{popularCities.map((r) => <button type="button" class="bt-tag" data-pop-city={r}>{r}</button>)}</div>
      </div>
      <aside class="bt-widget">
        <p class="bt-w-kicker"><i></i><span data-w-kicker>{T.wNow}</span></p>
        <h2 class="bt-w-title" data-w-title>{T.wIdle}</h2>
        <ol class="bt-w-list" data-w-list></ol>
        <p class="bt-w-none" data-w-none hidden>{T.wNone}</p>
        <div class="bt-w-stats">
          <div><span>{T.sPlaces}</span><b>{nf.format(index.length)}</b></div>
          <div><span>{T.sCountries}</span><b>{countries.length}</b></div>
          <div><span>{T.sHours}</span><b>{hr(7)}–{hr(22)}</b></div>
        </div>
      </aside>
    </div>

    <!-- Filters: "where & what" and "when" (owner's mock-up 한산한 시간 섹션 수정안) -->
    <h2 class="bt-h2">{T.listTitle}</h2>
    <div class="bt-fcard">
      <h3 class="bt-ftitle">{T.whereTitle}</h3>
      <div class="bt-frow">
        <span class="bt-flbl">{T.lblCountry}</span>
        <div class="bt-pills" role="group" aria-label={T.lblCountry} data-country-group>
          <button type="button" class="bt-pill-b is-on" aria-pressed="true" data-country="">{T.all} <small>{index.length}</small></button>
          {countries.map(([c, n], i) => <button type="button" class:list={['bt-pill-b', { 'is-extra': i >= TOP_COUNTRIES }]} aria-pressed="false" data-country={c}>{c} <small>{n}</small></button>)}
          {countries.length > TOP_COUNTRIES && <button type="button" class="bt-morec" data-more-countries aria-expanded="false" data-more-label={T.moreCountries(countries.length - TOP_COUNTRIES)} data-fewer-label={T.fewer}>{T.moreCountries(countries.length - TOP_COUNTRIES)}</button>}
        </div>
      </div>
      <div class="bt-frow">
        <span class="bt-flbl">{T.lblCity}</span>
        <p class="bt-hint" data-city-hint><span aria-hidden="true">⌖</span> {T.cityHint}</p>
        <div class="bt-pills" role="group" aria-label={T.lblCity} data-city-row hidden></div>
      </div>
      <div class="bt-frow">
        <span class="bt-flbl">{T.lblType}</span>
