            <div><span class="bt-glbl is-we">{T.weGroup}</span><div class="bt-circles" role="group" aria-label={T.weGroup}>{DAY_SHORT.slice(5).map((d, i) => <button type="button" class="bt-circle" data-day={i + 5} aria-pressed="false">{d}</button>)}</div></div>
            <span class="bt-today-key"><i></i>{T.todayLbl}</span>
          </div>
          <div class="bt-hours-row" role="group" aria-label={T.modePick} data-hours>
            <span class="bt-glbl bt-am">{T.amLbl}</span><span class="bt-glbl bt-pm">{T.pmLbl}</span>
            {HOURS.map((h) => <button type="button" class:list={['bt-hourb', { 'is-on': h === 10 }]} data-hour={h} aria-pressed={h === 10 ? 'true' : 'false'} aria-label={hr(h)}>{h % 12 || 12}</button>)}
          </div>
        </div>
      </div>
    </div>
    <div class="bt-summary">
      <span class="bt-sc is-place" data-sum-where>{T.scopeWorld}</span>
      <span class="bt-sc is-place" data-sum-type>{T.typeAll}</span>
