          <p class="bt-sr">{t('tool.cite.body')}</p>
          <a class="bt-cite-row" href={widgetHref}><span>{T.widgetRow}</span><b>{T.widgetCta}</b></a>
          <a class="bt-cite-row" href="https://besttime.app" rel="noopener" target="_blank"><span>{T.apiRow}</span><b>besttime.app ↗</b></a>
        </div>
