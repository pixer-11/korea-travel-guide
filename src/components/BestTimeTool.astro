        </div>
        <div class="bt-cite" id="bt-cite" data-cite data-text={T.citeText(index.length, pageAbs)} data-html={`<a href="${pageAbs}">${T.linkText}</a>`} data-copied={T.copiedOk} data-copy={T.copyBtn}>
          <div class="bt-cite-head">
