          <div class="bt-axis" aria-hidden="true"><span>{hr(7)}</span><span>{hr(10)}</span><span>{hr(13)}</span><span>{hr(16)}</span><span>{hr(19)}</span><span>{hr(22)}</span></div>
          <p class="bt-insight"><Fragment set:html={svg('sparkles', 15)} /><b>{chartInsight}</b><span>{T.clickHint}</span></p>
