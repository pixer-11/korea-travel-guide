---
import { isEventPast } from '../lib/eventStatus';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { thumbOr } from '../lib/wall';
interface Props {
  href: string;
  title: string;
  description: string;
  region: string;
  category: string;
  image?: string;
  eventEndDate?: Date | string | null;
  /** Set on the first card of a grid: it is usually the LCP element. */
  priority?: boolean;
}
const { href, title, description, region, category, image, eventEndDate, priority = false } = Astro.props;
// Cards were rendering the remote hero at full size — 1920px Wikimedia originals
// and w=1600 Unsplash, drawn at 325 CSS px. One city roundup shipped 3.49 MB of
// images for seven thumbnails. Every published hero already has a 640px WebP
// (~40 KB) from build-wall.mjs; this uses it, falling back to the original when a
// hero is newer than the last wall build.
const src = thumbOr(image) || '/images/placeholder-market.svg';
// Card labels follow the page's language (cards appear on localized hubs too).
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const regionLabel = localizePlace(region, lang);
// Category badges are reader-facing: translate them (the same cat.* keys the
// crowd-finder filters use) instead of printing the raw English slug.
const label = t(`cat.${category}` as any) || category.replace('-', ' ');
const ended = isEventPast({ category, eventEndDate });
---

<a class:list={['card', { 'card--ended': ended }]} href={href}>
  <div class="thumb">
    <img
      src={src}
      alt={`${title} — ${region}`}
      width="600"
      height="400"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
    {ended ? <span class="badge badge-ended">{t('card.ended')}</span> : <span class="badge">{label}</span>}
  </div>
  <div class="card-body">
    <span class="region-label">{regionLabel}</span>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</a>
