---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import Hotels from './Hotels.astro';
import Tours from './Tours.astro';
import PlanTrip from './PlanTrip.astro';
import Newsletter from './Newsletter.astro';
import StickyBook from './StickyBook.astro';
import Emoji from './Emoji.astro';
import { slugifyRegion } from '../lib/slug';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { getRegionInfo } from '../i18n/regions';
import { buildRoundups } from '../lib/roundups.mjs';
import { pickOgPhoto } from '../lib/ogPhoto.mjs';

// Shared region-hub body for BOTH the English route (/regions/<region>) and the
// localized route (/[lang]/regions/<region>). Curated intros/FAQ come from
// getRegionInfo (native-quality per language, English fallback); all chrome via
// t(); place names via localizePlace(). Posts, categories, and facts are the same
// underlying data in every language — only the display strings differ.
interface Props {
  region: string;
  posts: any[];
  lang: Lang;
}
const { region, posts, lang } = Astro.props;
const t = useTranslations(lang);

// The region's country (from its posts) — so fallbacks read "…, Japan" not "…, Korea".
const country = posts[0]?.data.country ?? 'South Korea';
const regionLabel = localizePlace(region, lang);
const countryLabel = localizePlace(country, lang);

const info = getRegionInfo(region, lang);

// Itinerary flywheel (task 8): surface a matching itinerary prominently at the
// top of the hub. City/day-count/stop-count are all read from the itinerary
// file itself — never hardcoded. Usually 0 or 1 today; a list future-proofs
// for a region eventually having more than one itinerary.
const allItineraries = await getCollection('itineraries', ({ data }) => !data.draft);
const regionItineraries = allItineraries.filter((it) => it.data.city.toLowerCase() === region.toLowerCase());
const itinTranslations =
  lang === 'en'
    ? new Map<string, any>()
    : new Map((await getCollection('itinerariesI18n', ({ data }) => data.lang === lang))
        .map((e) => [e.data.slug, e.data]));
const itinTitle = (it: any) => itinTranslations.get(it.id)?.title ?? it.data.title;
const itinStopCount = (it: any) => it.data.itinerary.reduce((n: number, day: any) => n + day.stops.length, 0);

// Localized post text (title/description) for the cards, so a Korean hub shows
// Korean card titles. Only the current language is loaded; English uses the
// source post directly. A post links to its localized URL only when a translation
// exists (it always does today — all posts are translated — but this guards a
// future untranslated post from 404-ing).
const translations = lang === 'en' ? [] : await getCollection('postI18n', ({ data }) => data.lang === lang);
const trBySlug = new Map(translations.map((tr) => [tr.data.slug, tr.data]));
const cardTitle = (post: any) => trBySlug.get(post.id)?.title ?? post.data.title;
const cardDesc = (post: any) => trBySlug.get(post.id)?.description ?? post.data.description;
const cardHref = (post: any) =>
  lang !== 'en' && trBySlug.has(post.id) ? localizePath(`/posts/${post.id}`, lang) : `/posts/${post.id}`;

// Region-level FAQ — feeds a visible FAQ section + FAQPage schema. Questions are
// translated chrome; answers reuse the curated (already-localized) info fields.
// A question with no answer is worse than no question. 63 region entries are
// missing one or more of getting/days/blurb, which shipped 42 pages carrying a
// visible `<summary>How many days should I spend in Agra?</summary><p></p>` and
// an `acceptedAnswer` with no `text` — invalid FAQPage schema that Google drops
// outright — plus 16 pages rendering the literal placeholder "정보 없음" /
// "情報なし" / "暂无信息" / "No disponible" as both the answer and the schema
// text (found 2026-08-05). Drop the row instead: an unanswered question is worth
// exactly one fewer accordion entry.
const PLACEHOLDER_ANSWER = /^(정보\s*없음|情報なし|暂无信息|暫無資訊|No disponible|N\/?A|[-—])$/i;
const usableAnswer = (a) => typeof a === 'string' && a.trim().length > 0 && !PLACEHOLDER_ANSWER.test(a.trim());
const faq = info
  ? [
      { q: t('region.faqGetTo').replace('{region}', regionLabel), a: info.getting },
      { q: t('region.faqDays').replace('{region}', regionLabel), a: info.days },
      { q: t('region.faqKnownFor').replace('{region}', regionLabel), a: info.blurb },
    ].filter((f) => usableAnswer(f.a))
  : [];

// Group this region's posts by category into labelled sections. The 3rd entry is
// the roundup-hub slug (null = none). When a category has >= 4 posts a "See all,
// ranked" link surfaces its /regions/<city>/<slug> hub — must match ROUNDUPS + MIN
// in regions/[region]/[roundup].astro. The roundup pages aren't localized yet, so
// that link stays on the English route in every language (never 404s).
const CAT_LABEL_KEY: Record<string, any> = {
  attraction: 'region.cat.attraction',
  trendy: 'region.cat.trendy',
  restaurant: 'region.cat.restaurant',
  'hidden-gem': 'region.cat.hidden-gem',
  event: 'region.cat.event',
};
const CATS: [string, string | null][] = [
  ['attraction', 'things-to-do'],
  ['trendy', 'cafes'],
  ['restaurant', 'best-restaurants'],
  ['hidden-gem', 'hidden-gems'],
  ['event', null],
];
const groups = CATS.map(([cat, roundup]) => ({
  label: t(CAT_LABEL_KEY[cat]),
  roundup,
  items: posts.filter((p) => p.data.category === cat),
})).filter((g) => g.items.length > 0);
const ungrouped = posts.filter((p) => !CATS.some(([c]) => c === p.data.category));

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: t('region.guideTitle').replace('{region}', regionLabel),
      description: info?.blurb ?? t('region.fallbackBlurb').replace('{region}', regionLabel).replace('{country}', countryLabel),
      url: pageUrl,
      isPartOf: { '@id': `${site}/#site` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('post.home'), item: new URL(localizePath('/', lang), Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: regionLabel, item: pageUrl },
      ],
    },
    ...(posts.length
      ? [{
          '@type': 'ItemList',
          itemListElement: posts.map((p, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: new URL(cardHref(p), Astro.site).toString(),
            name: cardTitle(p),
          })),
        }]
      : []),
    ...(faq.length
      ? [{
          '@type': 'FAQPage',
          mainEntity: faq.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        }]
      : []),
  ],
};

const metaTitle = t('region.guideTitle').replace('{region}', regionLabel);
const metaDesc = info?.blurb?.slice(0, 155) ?? t('region.metaDesc').replace('{region}', regionLabel).replace('{country}', countryLabel);
// Share card: a hub about a place should unfurl as that place, not the logo.
// Falls through to the brand default in BaseLayout when nothing has a thumbnail.
// og:image gets the FULL-SIZE hero, not the 640px wall thumb: crawlers fetch
// og:image separately (page weight is unaffected) and Google Discover only
// serves large cards from images ≥1200px wide. Wall thumbs stay for on-page grids.
const ogPhoto = pickOgPhoto(posts);

// Which roundups this city actually HAS, from the same builder that creates the
// pages. The link used to be gated on this hub's own count of one category, so a
// city whose guides were spread across categories had a live roundup page that
// nothing linked to — 26 cities were in that state. It also means the "See all
// N" number is the roundup’s real length rather than this section’s.
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const roundupsHere = new Map(
  buildRoundups(allPosts)
    .filter((r) => r.region === region)
    .map((r) => [r.key, r.items.length])
);

---

<BaseLayout image={ogPhoto} title={metaTitle} description={metaDesc} jsonLd={jsonLd} localized={true}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{t('region.eyebrow')}</p>
      <h1>{regionLabel}</h1>
      {usableAnswer(info?.blurb)
        ? <p class="region-blurb">{info.blurb}</p>
        : <p>{t('region.fallbackBlurb').replace('{region}', regionLabel).replace('{country}', countryLabel)}</p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {regionItineraries.length > 0 && (
        <div class="itin-hub-promo">
          {regionItineraries.map((it) => (
            <a class="itin-hub-card" href={localizePath(`/itinerary/${it.id}`, lang)}>
              <span class="itin-hub-card-ico"><Emoji name="world-map" /></span>
              <div class="itin-hub-card-body">
                <span class="itin-hub-card-badge">{t('itin.badge').replace('{n}', String(it.data.days))}</span>
                <h2>{itinTitle(it)}</h2>
                <p>{t('itin.stopsCount').replace('{n}', String(itinStopCount(it)))}</p>
              </div>
              <span class="itin-hub-card-cta">{t('itin.viewItinerary')}</span>
            </a>
          ))}
        </div>
      )}

      {/* Same rule as the FAQ above: a labelled row whose value is blank or the
          literal "정보 없음" is worse than no row. Omit the row, and the box
          entirely when neither fact is usable. */}
      {info && (usableAnswer(info.getting) || usableAnswer(info.days)) && (
        <div class="region-facts">
          {usableAnswer(info.getting) && <div><span class="k">{t('region.gettingThere')}</span><span class="v">{info.getting}</span></div>}
          {usableAnswer(info.days) && <div><span class="k">{t('region.howLong')}</span><span class="v">{info.days}</span></div>}
        </div>
      )}

      {posts.length === 0 && (
        <div class="fact-box" style="text-align:center">
          <p>{t('region.comingSoon').replace('{region}', regionLabel)}</p>
        </div>
      )}

      {groups.map((g) => (
        <div class="region-group">
          <h2>{g.label}</h2>
          <div class="grid">
            {g.items.map((post) => (
              <PostCard
                href={cardHref(post)}
                title={cardTitle(post)}
                description={cardDesc(post)}
                region={post.data.region}
                category={post.data.category}
                image={post.data.heroImage?.url}
                eventEndDate={post.data.eventEndDate}
              />
            ))}
          </div>
          {g.roundup && roundupsHere.has(g.roundup) && (
            <p class="see-all">
              <a href={localizePath(`/regions/${slugifyRegion(region)}/${g.roundup}/`, lang)}>{t('region.seeAll').replace('{n}', String(roundupsHere.get(g.roundup)))}</a>
            </p>
          )}
        </div>
      ))}

      {ungrouped.length > 0 && (
        <div class="region-group">
          <h2>{t('region.more').replace('{region}', regionLabel)}</h2>
          <div class="grid">
            {ungrouped.map((post) => (
              <PostCard
                href={cardHref(post)}
                title={cardTitle(post)}
                description={cardDesc(post)}
                region={post.data.region}
                category={post.data.category}
                image={post.data.heroImage?.url}
                eventEndDate={post.data.eventEndDate}
              />
            ))}
          </div>
        </div>
      )}

      {posts.length > 0 && (
        <>
          <Tours city={region} />
          <Hotels city={region} country={country} />
          <PlanTrip city={region} country={country} />
        </>
      )}

      {faq.length > 0 && (
        <section class="faq">
          <h2>{t('region.faqTitle').replace('{region}', regionLabel)}</h2>
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}
    </div>
  </section>

  <Newsletter
    lang={lang}
    heading={t('post.planningTrip').replace('{region}', regionLabel)}
    dek={t('region.newsletterDek').replace('{region}', regionLabel)}
    region={region}
    country={country}
  />
  <StickyBook city={region} />
</BaseLayout>

<style>
  .see-all { margin-top: 1.25rem; }
  /* Pill button — prominent enough to actually get clicked, and >=44px tall so
     it's an easy mobile touch target. */
  .see-all a {
    display: inline-flex; align-items: center; gap: 0.45rem;
    min-height: 44px; padding: 0.55rem 1.2rem;
    font-weight: 600; color: var(--accent); text-decoration: none;
    border: 1.5px solid var(--accent); border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .see-all a:hover, .see-all a:focus-visible { background: var(--accent); color: #fff; }
</style>
