---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from './Newsletter.astro';
import PlanTrip from './PlanTrip.astro';
import { useTranslations, localizePath, localeCodes, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { holidayLabel } from '../i18n/holidays';
import { slugifyRegion } from '../lib/slug';
import countryFacts from '../../data/country-facts.json';
import countriesData from '../../data/countries.json';
import { pickOgPhoto } from '../lib/ogPhoto.mjs';

// Shared per-country essentials page for /essentials/<country> (en) +
// /[lang]/essentials/<country>. Renders the translated body when a translation
// exists, else the English source. Hard facts (lastReviewed, official links) come
// from the English source's frontmatter/body.
interface Props { entry: any; translation: any; lang: Lang }
const { entry, translation, lang } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const countryLabel = localizePlace(d.country, lang);
const title = translation?.data.title ?? d.title;
const description = translation?.data.description ?? d.description;
const { Content } = await render(translation ?? entry);
const reviewed = d.lastReviewed.toLocaleDateString(localeCodes[lang], { year: 'numeric', month: 'long', day: 'numeric' });

const policyLink = `<a href="${localizePath('/about', lang)}">${t('footer.editorialPolicy')}</a>`;
const reviewedNote = t('ess.reviewedNote').replace('{date}', reviewed).replace('{policy}', policyLink);

// Climate + holidays from data/country-facts.json (Open-Meteo + Nager.Date,
// refreshed monthly by refresh-country-facts.yml). Either may be absent for a
// country — sections render only when there is real data.
const facts = (countryFacts as any).countries?.[d.country] ?? {};
const monthName = (m: number) =>
  new Intl.DateTimeFormat(localeCodes[lang], { month: 'short' }).format(new Date(Date.UTC(2026, m - 1, 1)));
const todayIso = new Date().toISOString().slice(0, 10);
const upcomingHolidays = (facts.holidays ?? []).filter((h: any) => h.date >= todayIso).slice(0, 10);
const holidayDate = (iso: string) =>
  new Intl.DateTimeFormat(localeCodes[lang], { month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(iso + 'T00:00:00Z'));

// These pages were dead ends: eight sections of visa, money and transport advice
// for a country, and the only body links out were /about and the trip checklist.
// Nothing pointed at that country's cities, guides, events or itineraries — the
// exact things someone reading its entry rules is about to want — so the reader
// had to go back through the nav, and the crawler saw 23 leaves (115 across the
// languages) hanging off the country hub with nothing under them.
const countrySlug =
  countriesData.countries.find((c: any) => c.name === d.country)?.slug ?? null;
const countryPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((p) => (p.data.country ?? 'South Korea') === d.country);

// Cities, busiest first — the ones with enough guides to be worth a click.
const cityCounts = new Map<string, number>();
for (const p of countryPosts) {
  if (p.data.region) cityCounts.set(p.data.region, (cityCounts.get(p.data.region) ?? 0) + 1);
}
const topCities = [...cityCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 12);

const latestGuides = [...countryPosts]
  .sort((a, b) => (b.data.pubDate > a.data.pubDate ? 1 : -1))
  .slice(0, 6);

const countryItineraries = (await getCollection('itineraries', ({ data }) => !data.draft))
  .filter((it) => it.data.country === d.country)
  .slice(0, 4);

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: title, description, url: pageUrl, dateModified: d.lastReviewed.toISOString(), isPartOf: { '@id': `${site}/#site` } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.home'), item: new URL(localizePath('/', lang), Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: countryLabel, item: new URL(localizePath(`/destinations/${entry.id}`, lang), Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: t('ess.label'), item: pageUrl },
    ] },
  ],
};
// Share card: a hub about a place should unfurl as that place, not the
// logo. Falls through to the brand default in BaseLayout when the list is
// empty or the hero has no built thumbnail yet.
// og:image gets the FULL-SIZE hero, not the 640px wall thumb: crawlers fetch
// og:image separately (page weight is unaffected) and Google Discover only
// serves large cards from images ≥1200px wide. Wall thumbs stay for on-page grids.
const ogPhoto = pickOgPhoto(countryPosts);

---

<BaseLayout image={ogPhoto} title={title} description={description} jsonLd={jsonLd} localized={true}>
  <div class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{t('ess.label')} · {countryLabel}</p>
      <h1>{t('ess.knowBeforeYouGo').replace('{country}', countryLabel)}</h1>
      <p>{t('ess.countryDek')}</p>
    </div>
  </div>

  <article class="article wrap">
    <blockquote>
      {t('ess.disclaimer')} <strong>{t('ess.lastReviewedLabel').replace('{date}', reviewed)}</strong>
    </blockquote>

    {facts.climate && (
      <section class="climate">
        <h2>{t('ess.climateTitle')}</h2>
        <p class="section-dek">{t('ess.climateDek')}</p>
        <div class="climate-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">{t('ess.month')}</th>
                {facts.climate.map((c: any) => <th scope="col">{monthName(c.m)}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">{t('ess.hi')} °C</th>
                {facts.climate.map((c: any) => <td>{c.hi}</td>)}
              </tr>
              <tr>
                <th scope="row">{t('ess.lo')} °C</th>
                {facts.climate.map((c: any) => <td>{c.lo}</td>)}
              </tr>
              <tr>
                <th scope="row">{t('ess.rain')}</th>
                {facts.climate.map((c: any) => <td>{c.rain}</td>)}
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    )}

    {upcomingHolidays.length > 0 && (
      <section class="holidays">
        <h2>{t('ess.holidaysTitle')}</h2>
        <p class="section-dek">{t('ess.holidaysDek')}</p>
        <ul class="holiday-list">
          {upcomingHolidays.map((h: any) => (
            <li>
              <span class="holiday-date">{holidayDate(h.date)}</span>
              <span class="holiday-name">{holidayLabel(d.country, h.localName, h.name, lang)}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="prose">
      <Content />
    </div>

    <p class="disclosure" set:html={reviewedNote}></p>
    {(topCities.length > 0 || latestGuides.length > 0) && (
      <section class="ess-onward">
        <h2>{t('ess.exploreTitle').replace('{country}', countryLabel)}</h2>

        {topCities.length > 0 && (
          <ul class="ess-cities">
            {topCities.map(([region, n]) => (
              <li>
                {/* slugifyRegion, not a local lowercase-and-dash: the ad-hoc
                    version kept apostrophes and accents, so Xi'an, Alcañiz and
                    Buñol linked to /regions/xi'an/ etc. — 13 dead links on the
                    localized essentials pages, where no rescue redirect exists. */}
                <a href={localizePath(`/regions/${slugifyRegion(region)}`, lang)}>
                  {localizePlace(region, lang)} <span class="ess-count">{n}</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {countryItineraries.length > 0 && (
          <ul class="ess-links">
            {countryItineraries.map((it: any) => (
              <li><a href={localizePath(`/itinerary/${it.id}`, lang)}>{it.data.title}</a></li>
            ))}
          </ul>
        )}

        {latestGuides.length > 0 && (
          <ul class="ess-links">
            {latestGuides.map((g: any) => (
              <li>
                <a href={localizePath(`/posts/${g.id}`, lang)}>{g.data.place?.name ?? g.data.title}</a>
                {g.data.region && <span class="ess-count">{localizePlace(g.data.region, lang)}</span>}
              </li>
            ))}
          </ul>
        )}

        {countrySlug && (
          <p class="ess-all">
            <a href={localizePath(`/destinations/${countrySlug}`, lang)}>
              {t('ess.allGuides').replace('{country}', countryLabel)} →
            </a>
          </p>
        )}
      </section>
    )}
  </article>

  {/* These are the highest-planning-intent pages on the site — someone reading a
      country's visa and money rules is booking — and they carried no booking
      surface at all. */}
  <PlanTrip city={countryLabel} country={d.country} />

  <Newsletter
    lang={lang}
    heading={t('post.planningTrip').replace('{region}', countryLabel)}
    dek={t('dest.newsletterDek').replace('{country}', countryLabel)}
  />
</BaseLayout>

<style>
  /* Onward links out of what used to be a dead-end page. Cities first (widest
     net), then itineraries and recent guides. */
  .ess-onward { margin-top: 2.8rem; padding-top: 1.6rem; border-top: 1px solid var(--line); }
  .ess-onward h2 { margin: 0 0 0.9rem; font-size: 1.15rem; }
  .ess-cities { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ess-cities a {
    display: inline-flex; align-items: baseline; gap: 0.4rem;
    padding: 0.4rem 0.75rem; border: 1px solid var(--line); border-radius: 999px;
    background: var(--surface); color: var(--ink); text-decoration: none; font-size: 0.9rem;
  }
  .ess-cities a:hover { border-color: var(--accent); color: var(--accent); }
  .ess-links { list-style: none; margin: 0 0 0.9rem; padding: 0; }
  .ess-links li { padding: 0.45rem 0; border-bottom: 1px solid var(--line-soft); }
  .ess-links a { color: var(--ink); text-decoration: none; }
  .ess-links a:hover { color: var(--accent); text-decoration: underline; }
  .ess-count { color: var(--muted); font-size: 0.78rem; margin-left: 0.4rem; }
  .ess-all { margin: 0.6rem 0 0; }
  .ess-all a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .ess-all a:hover { text-decoration: underline; }

  .climate, .holidays { margin-top: 2.6rem; }
  .section-dek { color: var(--muted, #6b6357); margin: 0.3rem 0 1rem; }
  .climate-scroll { overflow-x: auto; }
  .climate table { border-collapse: collapse; font-size: 0.92rem; min-width: 640px; }
  .climate th, .climate td { padding: 0.45rem 0.6rem; text-align: center; border-bottom: 1px solid var(--line, #e5dfd2); }
  .climate thead th { font-weight: 650; }
  .climate tbody th { text-align: left; font-weight: 600; white-space: nowrap; }
  .holiday-list { list-style: none; padding: 0; margin: 0; }
  .holiday-list li { display: flex; gap: 0.9rem; padding: 0.45rem 0; border-bottom: 1px solid var(--line, #e5dfd2); }
  .holiday-date { min-width: 7.5rem; font-weight: 600; white-space: nowrap; }
  .holiday-name { color: var(--ink, #201c17); }
</style>
