---
import { buildToday } from '../lib/buildDay.mjs';
import { getCollection } from 'astro:content';
import { siteHref } from '../lib/urls.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventsList from './EventsList.astro';
import EventsHero from './events/EventsHero.astro';
import EventsPicks from './events/EventsPicks.astro';
import EventsFoot from './events/EventsFoot.astro';
import Newsletter from './Newsletter.astro';
import { hotelUrl } from '../lib/hotel-link.mjs';
import Emoji from './Emoji.astro';
import { isEventPast, eventSortValue } from '../lib/eventStatus';
import { hubStats, annualEndedThisYear, countryLinksOf } from '../lib/eventHub';
import { editorHasTraveled } from '../lib/editorVisited';
import { eunNeun } from '../lib/ko-particle.mjs';
import countriesData from '../../data/countries.json';
import { useTranslations, localizePath, klookLocale, type Lang } from '../i18n/utils';
import { evStrings } from '../i18n/events-strings';
import { localizePlace } from '../i18n/places';
import { loadCardTranslations, cardHelpers } from '../i18n/cards';
import { pickOgPhoto } from '../lib/ogPhoto.mjs';
import { eventsHubDescription } from '../lib/eventsHubMeta.mjs';

// Shared per-country events hub for /events/<country> (en) + /[lang]/events/<country>.
// Since 2026-09-30 it is built from the same parts as /events
// (components/events/), so the country pages and the global page look and
// count the same way; only the numbers are this country's.
interface Props { country: any; events: any[]; lang: Lang }
const { country, events, lang } = Astro.props;
const t = useTranslations(lang);
const e = evStrings(lang);
const countryLabel = localizePlace(country.name, lang);
const tr = await loadCardTranslations(lang);
const card = cardHelpers(tr, lang);

const today = buildToday(); // the build's one "today" (lib/buildDay.mjs)
const upcoming = events
  .filter((p) => !isEventPast(p.data, today))
  .sort((a, b) => eventSortValue(a.data, today) - eventSortValue(b.data, today));
const past = events
  .filter((p) => isEventPast(p.data, today))
  .sort((a, b) => eventSortValue(a.data, today) - eventSortValue(b.data, today));

// Links out: every other country hub, the same list the global page shows.
const allEvents = await getCollection('posts', ({ data }) => !data.draft && data.category === 'event');
const otherCountries = countryLinksOf(allEvents, allEvents.filter((p) => !isEventPast(p.data, today)), countriesData.countries, today)
  .filter((c) => c.slug !== country.slug);
const hasEssentials = (await getCollection('essentials', ({ data }) => !data.draft)).some((x) => x.id === country.slug);

// The editor-traveled line only where the owner has named the country
// (lib/editorVisited — never inferred), the same line a guide's byline uses.
const traveled = editorHasTraveled(country.name)
  ? t('post.editorTraveled').replace('{country}', countryLabel).replace('{eun}', eunNeun(countryLabel))
  : undefined;

const seoTitle = e('countrySeoTitle', { country: countryLabel, y: today.getUTCFullYear() });
const description = eventsHubDescription({ t, countryLabel, upcomingCount: upcoming.length });

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteHref(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    // description used to repeat the `name` title verbatim — the same defect
    // the 2026-08-31 fix addressed for the meta tag, left behind here in the
    // structured data (found 2026-09-07).
    { '@type': 'CollectionPage', name: seoTitle, description, url: pageUrl, isPartOf: { '@id': `${site}/#site` } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.home'), item: siteHref(localizePath('/', lang), Astro.site) },
      { '@type': 'ListItem', position: 2, name: t('nav.events'), item: siteHref(localizePath('/events', lang), Astro.site) },
      { '@type': 'ListItem', position: 3, name: countryLabel, item: pageUrl },
    ] },
    ...(upcoming.length ? [{ '@type': 'ItemList', itemListElement: upcoming.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: siteHref(card.href(p.id), Astro.site), name: card.title(p.id, p.data.title) })) }] : []),
  ],
};
// Share card: a hub about a place should unfurl as that place, not the
// logo. og:image gets the FULL-SIZE hero, not the 640px wall thumb: crawlers
// fetch og:image separately and Google Discover only serves large cards from
// images ≥1200px wide. The country's PLACE photos are offered first and the
// events only as a fallback: passing `events` alone meant the card could only
// ever be a performer — /events/vietnam/ unfurled as Miss World Ireland 2022,
// and /events/singapore/ and /events/thailand/ shared one photograph of David
// Byrne taken in Amsterdam (13 of 17 country hubs showed somewhere that was
// not that country).
const placePhotos = await getCollection(
  'posts',
  ({ data }) => !data.draft && data.category !== 'event' && (data.country ?? 'South Korea') === country.name,
);
const ogPhoto = pickOgPhoto([...placePhotos, ...events]);
---

<BaseLayout image={ogPhoto}
  title={seoTitle}
  description={description}
  jsonLd={jsonLd}
  localized={true}
>
  <EventsHero
    lang={lang}
    crumbs={[{ label: t('post.home'), href: localizePath('/', lang) }, { label: t('nav.events'), href: localizePath('/events', lang) }, { label: countryLabel }]}
    flag={country.iso2}
    h1a={e('countryH1a', { country: countryLabel })} h1b={e('countryH1b')}
    dek={e('countryDek', { country: countryLabel, n: '{n}' })} dekN={upcoming.length}
    note={traveled}
    stats={hubStats(upcoming, today)}
    icsHref={`/events/${country.slug}.ics`}
    links={[
      { label: t('ev.allEventsBack'), href: localizePath('/events', lang) },
      ...(hasEssentials ? [{ label: e('ctaEss', { country: countryLabel }), href: localizePath(`/essentials/${country.slug}`, lang) }] : []),
      { label: t('ev.countryGuides').replace('{country}', countryLabel), href: localizePath(`/destinations/${country.slug}`, lang) },
    ]}
  />

  {upcoming.length === 0 && (
    <section class="section"><div class="wrap"><div class="fact-box" style="text-align:center"><p>{t('ev.noneGlobal')}</p></div></div></section>
  )}

  <EventsPicks lang={lang} upcoming={upcoming} today={today} card={card} trTitles={tr} distinctCountry={false} />

  <EventsList lang={lang} upcoming={upcoming} past={past} card={card} trTitles={tr} today={today}>
    <EventsFoot slot="before-past"
      lang={lang}
      countryLinks={otherCountries}
      countriesTitle={e('otherTitle')}
      countriesDek={e('otherDek')}
      again={annualEndedThisYear(past, today)}
      pastCount={past.length}
      card={card}
      trTitles={tr}
    />
  </EventsList>

  <section class="section">
    <div class="wrap">
      <div class="book-cta">
        <span class="book-cta-label">{t('ev.planningAround').replace('{country}', countryLabel)}</span>
        <div class="book-cta-btns">
          <a class="book-btn book-btn-primary" href={hotelUrl({ submarker: 'events_hub', locale: klookLocale(lang), place: country.name })} target="_blank" rel="sponsored noopener"><Emoji name="hotel" /> {t('post.findHotels')}</a>
          <a class="book-btn" href={localizePath('/flights', lang)} rel="sponsored noopener"><Emoji name="airplane" /> {t('nav.flights')}</a>
        </div>
        <!-- Affiliate disclosure. Every other surface carrying these links
             has one — post pages, region hubs, itineraries, /flights,
             /tools/esim — and the two country hubs did not, across 20
             countries x 5 languages (found 2026-09-10). The links are
             rel="sponsored" and /go/klook is an affiliate redirect, so
             the page was earning a commission without saying so. -->
        <p class="tp-disclosure">{t('widget.livePrices')}</p>
      </div>
    </div>
  </section>

  <Newsletter
    lang={lang}
    heading={t('ev.neverMissCountry').replace('{country}', countryLabel)}
    dek={t('ev.neverMissDekCountry').replace('{country}', countryLabel)}
  />
</BaseLayout>
