---
// "Top-rated things to do in {city}" — for the 16 mapped cities we render the
// Klook price widget (tpemd.com, numeric city_id). For EVERY other city we now
// render a Klook city-search CTA instead of nothing, so tours (our best-
// converting, no-approval-needed inventory) monetize on every post.
// marker shmarker=754088, source trs=553157, category 1 = Attractions & Shows.
import Emoji from './Emoji.astro';
import { getLangFromUrl, useTranslations, klookLocale } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { KLOOK_CITY } from '../lib/klookCities';
interface Props { city: string }
const { city } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cityLabel = localizePlace(city, lang);

// The city map moved to src/lib/klookCities.ts on 2026-08-07 and grew 16→127:
// every post region whose name appears in Klook's own city sitemap, with the
// same-name-city risk (Valencia PH vs ES, Granada NI vs ES…) checked against
// the live Klook page. The PRICE WIDGET stays limited to the 16 dropdown-
// confirmed ids (`widget: true`) — an unverified city_id renders an empty box;
// a destination link cannot fail that way.
const mapped = KLOOK_CITY[city];
const src = mapped?.widget
  ? `https://tpemd.com/content?currency=USD&trs=553157&shmarker=754088&locale=${lang}&city_id=${mapped.id}&category=1&amount=3&powered_by=true&campaign_id=137&promo_id=4497`
  : null;

// A mapped city goes to its DESTINATION page; only an unmapped one falls back
// to search. Every link on this site used to be `search/?query=<city>`, which
// is a page Klook's own robots.txt disallows — not somewhere to send a reader
// who has just decided they want to do something in that city. The destination
// page is the curated one, and the URL form is taken from Klook's own sitemap
// (`/destination/c13-seoul/`), not guessed.
//
// SubID rides along so the Travelpayouts report can finally say WHICH page
// earned: of 138 clicks to date, 93 arrived with an empty SubID purely because
// almost no link set one.
const subId = `tours_${city.toLowerCase().replace(/[^a-z0-9]+/g, '_')}`;
const klookDest = mapped
  ? `https://www.klook.com/${klookLocale(lang)}/destination/c${mapped.id}-${mapped.slug}/`
  : city
  ? `https://www.klook.com/${klookLocale(lang)}/search/?query=${encodeURIComponent(city)}`
  : null;
const klookHref = klookDest
  ? `/go/klook?to=${encodeURIComponent(klookDest)}&sub_id=${encodeURIComponent(subId)}`
  : 'https://klook.tpx.lv/2NXPH8MA';
---
{city && (
  <section class="tp-tours" data-affiliate-placement="tours-widget">
    <div class="rule-head"><h2 class="kicker">{t('widget.topThingsToDo').replace('{city}', cityLabel)}</h2></div>
    {src ? (
      <div class="tp-widget-card">
        <script is:inline async src={src} charset="utf-8"></script>
      </div>
    ) : (
      <a class="plan-card tours-cta" href={klookHref} target="_blank" rel="sponsored noopener">
        <span class="plan-ico"><Emoji name="admission-tickets" /></span>
        <span class="plan-txt"><strong>{t('widget.toursInCity').replace('{city}', cityLabel)}</strong><span>{t('widget.toursCtaDesc')}</span></span>
        <span class="plan-arw">→</span>
      </a>
    )}
    <p class="tp-disclosure">{t('widget.livePrices')}</p>
  </section>
)}

<script>
  // Safety net: hide the block ONLY when the price widget rendered empty. The
  // link-fallback (no .tp-widget-card) always stays.
  window.addEventListener('load', () => {
    setTimeout(() => {
      document.querySelectorAll('.tp-tours').forEach((sec) => {
        const card = sec.querySelector('.tp-widget-card') as HTMLElement | null;
        if (card && !(card.querySelector('iframe') || card.offsetHeight > 120)) {
          (sec as HTMLElement).style.display = 'none';
        }
      });
    }, 3500);
  });
</script>
