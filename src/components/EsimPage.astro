---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteHref } from '../lib/urls.mjs';
import Newsletter from './Newsletter.astro';
import Emoji from './Emoji.astro';
import Flag from './Flag.astro';
import { SITE } from '../siteConfig';
import { useTranslations, localizePath, localeCodes, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { localizeEsim } from '../i18n/esim';
import { esimPageT } from '../i18n/esim-page-strings';
import { homeT } from '../i18n/home-strings';
import { esimCountries } from '../lib/esim-paths.mjs';
import { CMP_MARKS, alertTipIndex, monthRuns } from '../lib/esim-page.mjs';
import { homeGroup, GROUP_ORDER } from '../lib/home-data.mjs';
import essentialsFacts from '../../data/essentials-facts.json';
import { bodyHash } from '../../scripts/lib/essentials-facts.mjs';
import { COUNTRY_TIME } from '../lib/countryTime';
import { getCollection } from 'astro:content';
import { pickOgPhoto } from '../lib/ogPhoto.mjs';
import countriesData from '../../data/countries.json';

// One country's eSIM guide — the site's first high-intent money page type.
// Redesigned 2026-10-05 from the owner's "UAE eSIM 개선안" mock-up: a
// recommender that answers "so what do I buy?", the comparison as three cards,
// the country's one catch lifted out of the prose, a 30-second phone check,
// a tickable setup list, and the live-price button in four places.
//
// Unchanged contract: every sentence of chrome is a string table entry, the
// per-country prose comes from data/esim-facts.json (translated with a srcHash
// stamp), and there is deliberately not a single price on the page — plans
// change weekly, so the button goes to live pricing instead.
interface Props { country: { slug: string; name: string; iso2: string; facts: any }; lang: Lang }
const { country, lang } = Astro.props;
const countryPosts = (await getCollection('posts', ({ data }) => !data.draft && (data.country ?? 'South Korea') === country.name));
// Share image: a guide from the country this page is about, not the brand card
// (2026-09-13 sweep). Rated first so the picture is one of its better-known places.
const ogPhoto = pickOgPhoto(
  [...countryPosts].sort((a, b) =>
    ((b.data.place?.rating ?? 0) * Math.log10((b.data.place?.userRatingsTotal ?? 0) + 10)) -
    ((a.data.place?.rating ?? 0) * Math.log10((a.data.place?.userRatingsTotal ?? 0) + 10))));
const t = useTranslations(lang);
const E = esimPageT(lang);
const HT = homeT(lang);
const countryLabel = localizePlace(country.name, lang);
const prose = localizeEsim(country.slug, country.facts, lang);
const locale = localeCodes[lang] ?? 'en';

const fill = (key: string, vars: Record<string, string | number> = { country: countryLabel }) =>
  Object.entries(vars).reduce((s, [k, v]) => s.replaceAll(`{${k}}`, String(v)), t(key as any));

const metaTitle = fill('esim.metaTitle');
const metaDesc = fill('esim.metaDesc');

// The arrival city for the headline, where the country has one clock and so
// one obvious gateway (countryTime.ts); a country spread over several time
// zones (the US, Australia, Indonesia, Mexico) is named instead.
const tz = COUNTRY_TIME[country.iso2.toUpperCase()];
const place = tz && !tz.multi ? localizePlace(tz.city, lang) : countryLabel;

// Yesim, not Klook: 18% and a 90-day cookie against Klook's 2–5% through
// Travelpayouts and 7–30 days (confirmed on the account, 2026-08-07). No
// country-specific Yesim link exists, so the storefront carries a SubID. It
// keeps the esim_<country> prefix the reports already group by, and adds the
// button's place on the page so the report finally says WHICH button sells.
const esimHref = (spot: string) => `https://yesim.tpx.lv/KABevuVe?sub_id=${encodeURIComponent(`esim_${country.slug}_${spot}`)}`;

// The comparison as three cards: the existing row texts, each marked in or
// against its favour (lib/esim-page CMP_MARKS — facts about the three kinds of
// connection, the same everywhere).
const ROWS = ['Setup', 'Share', 'Battery', 'Cost', 'Risk'] as const;
const OPTIONS = [
  { key: 'esim', name: E('optEsim'), sub: E('subEsim'), icon: 'antenna-bars', letter: 'E' },
  { key: 'wifi', name: E('optWifi'), sub: E('subWifi'), icon: 'luggage', letter: 'W' },
  { key: 'roam', name: E('optRoam'), sub: E('subRoam'), icon: 'globe-showing-asia-australia', letter: 'R' },
] as const;
const cmpCards = OPTIONS.map((o) => ({
  ...o,
  rows: ROWS.map((r) => ({ label: t(`esim.row${r}` as any), text: t(`esim.row${r}${o.letter}` as any), mark: (CMP_MARKS as any)[o.key][r] })),
}));

// The country's one catch, lifted out of the tip list into its own card.
const alertIdx = alertTipIndex(country.slug, prose.tips);
const alertTip = alertIdx >= 0 ? prose.tips[alertIdx] : '';
const restTips = prose.tips.filter((_, i) => i !== alertIdx);

// Best months: the vetted season months of the country's essentials guide
// (data/essentials-facts.json), under the same rule its hub uses — only while
// the English guide they were read from is unchanged. Not the climate score:
// it ranks by rain first and put Dubai's "mildest" months in September, at a
// 38°C average high (checked 2026-10-05). No vetted months, no card.
const essEntry = (await getCollection('essentials', ({ data }) => !data.draft)).find((e: any) => e.data.country === country.name);
const essFacts = (essentialsFacts as any).countries?.[country.name];
const essFresh = !!essEntry && !!essFacts && essFacts.srcHash === bodyHash(String(essEntry.body ?? ''));
const bestMonths: number[] = essFresh ? (essFacts.en?.season?.best ?? []) : [];
const monthName = (m: number) => new Intl.DateTimeFormat(locale, { month: 'long', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, m - 1, 15)));
const goodRuns = monthRuns(bestMonths);
const monthsText = goodRuns.map(([s, e]) => (s === e ? monthName(s) : `${monthName(s)}–${monthName(e)}`)).join(', ');
const destSlug = countriesData.countries.find((c) => c.name === country.name)?.slug ?? country.slug;

const steps = [1, 2, 3, 4, 5].map((n) => fill(`esim.setup${n}`));
const buys = [1, 2, 3, 4, 5].map((n) => fill(`esim.buy${n}`));
const faqs = [1, 2, 3, 4, 5].map((n) => ({ q: fill(`esim.faqQ${n}`), a: fill(`esim.faqA${n}`) }));

// Other guides, grouped by region the way the home page groups countries.
const groupLabel: Record<string, string> = { east: HT('gEast'), sea: HT('gSea'), meca: HT('gMeca'), europe: HT('gEurope'), amoc: HT('gAmoc'), africa: HT('gAfrica') };
const others = esimCountries().filter((c) => c.slug !== country.slug);
const continentOf = (name: string) => countriesData.countries.find((c) => c.name === name)?.continent;
const otherGroups = GROUP_ORDER.map((g) => ({
  label: groupLabel[g],
  items: others.filter((c) => homeGroup(continentOf(c.name), c.iso2) === g),
})).filter((g) => g.items.length);

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteHref(Astro.url.pathname, Astro.site);
const people = { solo: E('pSolo'), small: E('pSmall'), group: E('pGroup') };
const prios = { cost: E('prCost'), share: E('prShare'), ease: E('prEase') };
const optNames = { esim: E('optEsim'), wifi: E('optWifi'), roam: E('optRoam') };
const DEFAULT = { people: 'solo', days: 5, prio: 'cost' } as const;
const fillT = (s: string, v: Record<string, string | number>) => Object.entries(v).reduce((a, [k, x]) => a.replaceAll(`{${k}}`, String(x)), s);
const pageData = JSON.stringify({
  slug: country.slug,
  people, prios, optNames,
  why: { esim: E('whyEsim'), wifi: E('whyWifi'), roam: E('whyRoam') },
  days: E('recDays'),
  bar: E('barTitle', { country: countryLabel }),
  barSub: E('barSub'),
  done: E('stDone'),
  barBtn: E('barBtn'),
  barBtnOther: E('recOther'),
  verdict: {
    wait: [E('vWait'), E('vWaitD')], ok: [E('vOk'), E('vOkD')], noEid: [E('vNoEid'), E('vNoEidD')],
    locked: [E('vLocked'), E('vLockedD')], unknown: [E('vUnknown'), E('vUnknownD')],
  },
}).replace(/</g, '\\u003c');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: metaTitle, description: metaDesc, url: pageUrl, isPartOf: { '@id': `${site}/#site` } },
    {
      // FAQ rendered visibly below — schema mirrors the page, never invents.
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.home'), item: siteHref(localizePath('/', lang), Astro.site) },
      { '@type': 'ListItem', position: 2, name: t('esim.indexTitle'), item: siteHref(localizePath('/tools/esim/', lang), Astro.site) },
      { '@type': 'ListItem', position: 3, name: countryLabel, item: pageUrl },
    ] },
  ],
};
---

<BaseLayout image={ogPhoto} title={metaTitle} description={metaDesc} lang={lang} localized={true}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="es" data-esim={country.slug}>
    <nav class="es-crumbs" aria-label={t('a11y.breadcrumb')}>
      <a href={localizePath('/', lang)}>{t('post.home')}</a> · <a href={localizePath('/tools/esim/', lang)}>{t('esim.indexTitle')}</a> · <span>{countryLabel}</span>
    </nav>

    <header class="es-hero">
      <div class="es-hero-copy">
        <p class="es-kicker"><Flag code={country.iso2} size="1.1em" class="flag-ico" /> {E('heroKicker', { country: countryLabel })}</p>
        <h1>{E('h1Lead', { country: countryLabel })}<span class="es-accent">{E('h1Accent', { place })}</span></h1>
        <p class="es-dek">{E('dek', { country: countryLabel })}</p>
        <div class="es-hero-btns">
          <a class="es-btn" href={esimHref('hero')} target="_blank" rel="sponsored noopener" data-esim-cta>{E('btnLive')} ↗</a>
          <a class="es-btn es-btn-ghost" href="#phone-check">{E('btnPhone')}</a>
        </div>
        <ul class="es-bens"><li>{E('ben1')}</li><li>{E('ben2')}</li><li>{E('ben3')}</li></ul>
      </div>

      <section class="es-rec" data-rec aria-labelledby="es-rec-h">
        <div class="es-rec-head"><h2 id="es-rec-h">{E('recTitle')}</h2><span>{E('recHint')}</span></div>
        <p class="es-rec-label" id="es-q-people">{E('recPeople')}</p>
        <div class="es-seg" data-q="people" role="group" aria-labelledby="es-q-people">
          {Object.entries(people).map(([k, v]) => <button type="button" data-v={k} aria-pressed={k === DEFAULT.people ? 'true' : 'false'}>{v}</button>)}
        </div>
        <label class="es-rec-label" for="es-days" data-days-label>{E('recDays', { n: DEFAULT.days })}</label>
        <input id="es-days" type="range" min="1" max="30" value={DEFAULT.days} data-days />
        <p class="es-rec-label" id="es-q-prio">{E('recPrio')}</p>
        <div class="es-seg es-seg-soft" data-q="prio" role="group" aria-labelledby="es-q-prio">
          {Object.entries(prios).map(([k, v]) => <button type="button" data-v={k} aria-pressed={k === DEFAULT.prio ? 'true' : 'false'}>{v}</button>)}
        </div>
        <div class="es-rec-out" aria-live="polite">
          <p class="es-rec-name"><span class="es-badge">{E('recBadge')}</span> <b data-rec-name>{optNames.esim}</b></p>
          <p class="es-rec-why" data-rec-why>{fillT(E('whyEsim'), { people: people.solo, n: DEFAULT.days })}</p>
          <a class="es-btn" href={esimHref('picker')} target="_blank" rel="sponsored noopener" data-rec-btn data-esim-cta>{fill('esim.ctaBtn')} ↗</a>
          <a class="es-rec-other" href={esimHref('picker_other')} target="_blank" rel="sponsored noopener" data-rec-other hidden>{E('recOther')} ↗</a>
        </div>
      </section>
    </header>

    <section class="es-sec">
      <div class="es-sec-head">
        <div><h2>{t('esim.cmpH')}</h2><p>{E('cmpDek')}</p></div>
        <span class="es-legend">{E('cmpLegend')}</span>
      </div>
      <div class="es-cmp">
        {cmpCards.map((o) => (
          <div class:list={['es-opt', { 'is-pick': o.key === 'esim' }]} data-opt={o.key}>
            <div class="es-opt-top">
              <span class="es-opt-ico"><Emoji name={o.icon} /></span>
              <span class="es-pick-tag">{E('cmpMine')}</span>
            </div>
            <h3>{o.name}</h3>
            <p class="es-opt-sub">{o.sub}</p>
            <ul>
              {o.rows.map((r) => (
                <li class={`m-${r.mark}`}><i aria-hidden="true">{r.mark === 'g' ? '✓' : r.mark === 'w' ? '!' : '×'}</i><span><small>{r.label}</small>{r.text}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="es-rule"><Emoji name="compass" /> {E('recRule')}</p>
    </section>

    <section class="es-sec es-duo">
      <div class="es-card">
        <h2><span class="es-h-ico"><Emoji name="antenna-bars" /></span>{fill('esim.netH')}</h2>
        <p class="es-chips">{country.facts.carriers.map((c: string) => <span>{c}</span>)}</p>
        <p>{prose.intro}</p>
        <p>{prose.coverage}</p>
      </div>
      {alertTip && (
        <div class="es-card es-alert">
          <p class="es-alert-k"><Emoji name="police-car-light" /> {E('alertKicker', { country: countryLabel })}</p>
          <p class="es-alert-t">{alertTip}</p>
        </div>
      )}
    </section>

    <section class="es-sec es-phone" id="phone-check" data-phone>
      <div class="es-phone-l">
        <span class="es-tag">{E('phTag')}</span>
        <h2>{E('phTitle')}</h2>
        <p>{E('phDek')}</p>
        <div class="es-dial"><small>{E('phFast')}</small><b>*#06#</b><span>{E('phDial')}</span></div>
      </div>
      <div class="es-phone-r">
        <div class="es-seg es-os" data-os role="group" aria-label="iPhone / Android">
          <button type="button" data-v="ios" aria-pressed="true">iPhone</button>
          <button type="button" data-v="and" aria-pressed="false">Android</button>
        </div>
        <div class="es-os-box" data-os-box="ios"><b>{E('iosPath')}</b><p>{E('iosNote')}</p></div>
        <div class="es-os-box" data-os-box="and" hidden><b>{E('andPath')}</b><p>{E('andNote')}</p></div>
        {[['eid', E('q1')], ['lock', E('q2')]].map(([q, label]) => (
          <div class="es-q" data-check={q}>
            <span id={`es-q-${q}`}>{label}</span>
            <div class="es-seg es-seg-mini" role="group" aria-labelledby={`es-q-${q}`}>
              <button type="button" data-v="yes" aria-pressed="false">{E('ansYes')}</button>
              <button type="button" data-v="no" aria-pressed="false">{E('ansNo')}</button>
              <button type="button" data-v="dunno" aria-pressed="false">{E('ansDunno')}</button>
            </div>
          </div>
        ))}
        <p class="es-verdict" data-verdict aria-live="polite"><b>{E('vWait')}</b><span>{E('vWaitD')}</span></p>
      </div>
    </section>

    <section class="es-sec" data-steps>
      <div class="es-sec-head">
        <div><span class="es-tag">{E('stTag')}</span><h2>{t('esim.setupH')}</h2></div>
        <span class="es-legend" data-steps-done>{E('stDone', { n: 0 })}</span>
      </div>
      <ol class="es-steps">
        {steps.map((s, i) => (
          <li>
            <label>
              <span class="es-step-n">{i + 1}</span>
              <span class="es-step-t">{s}</span>
              <input type="checkbox" data-step={i} />
            </label>
          </li>
        ))}
      </ol>
      <p class="es-note">{E('stSaved')}</p>
    </section>

    <section class="es-sec es-duo">
      <div class="es-card">
        <h2>{fill('esim.buyH')}</h2>
        <ol class="es-buy">{buys.map((b) => <li>{b}</li>)}</ol>
      </div>
      <div class="es-side">
        {restTips.length > 0 && (
          <div class="es-card es-tips">
            <h2>{fill('esim.tipsH')}</h2>
            <ul>{restTips.map((tip) => <li>{tip}</li>)}</ul>
            {countryPosts.length > 0 && <a class="es-more" href={localizePath(`/destinations/${destSlug}/`, lang)}>{E('guidesLink', { country: countryLabel, n: countryPosts.length })}</a>}
          </div>
        )}
        {monthsText && (
          <a class="es-card es-months" href={localizePath(`/tools/when-to-go/${destSlug}/`, lang)}>
            <span><b>{E('monTitle', { country: countryLabel })}</b><small>{E('monText', { months: monthsText, country: countryLabel })}</small></span>
            <em>{E('monBtn')}</em>
          </a>
        )}
      </div>
    </section>

    <section class="es-sec es-cta" data-cta>
      <div>
        <span class="es-tag es-tag-dark">{E('ctaTag')}</span>
        <h2>{E('ctaTitle', { country: countryLabel })}</h2>
        <p>{t('esim.ctaDek')} {t('esim.priceNote')}</p>
      </div>
      <div class="es-cta-card">
        <dl>
          <div><dt>{E('sumCond')}</dt><dd data-sum>{people.solo} · {E('recDays', { n: DEFAULT.days }).split('·').pop()?.trim()} · {prios.cost}</dd></div>
          <div><dt>{t('esim.netCarriers')}</dt><dd>{country.facts.carriers.join(' · ')}</dd></div>
          <div><dt>{E('sumSeller')}</dt><dd>Yesim</dd></div>
        </dl>
        <a class="es-btn es-btn-wide" href={esimHref('cta')} target="_blank" rel="sponsored noopener" data-esim-cta>{fill('esim.ctaBtn')} ↗</a>
        <p class="es-disc">{t('widget.affDisclosure').replace('{site}', SITE.name)}</p>
      </div>
    </section>

    <section class="es-sec es-faq">
      <div><h2>{t('esim.faqH')}</h2></div>
      <div>
        {faqs.map((f, i) => (
          <details class="es-faq-item" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    {otherGroups.length > 0 && (
      <nav class="es-sec es-others" aria-label={t('esim.othersH')}>
        <div class="es-sec-head">
          <h2>{t('esim.othersH')}</h2>
          <a class="es-more" href={localizePath('/tools/esim/', lang)}>{t('esim.backIdx')} →</a>
        </div>
        {otherGroups.map((g) => (
          <div class="es-og">
            <span>{g.label}</span>
            <ul>
              {g.items.map((c) => (
                <li><a href={localizePath(`/tools/esim/${c.slug}/`, lang)}><Flag code={c.iso2} size="1em" class="flag-ico" /> {localizePlace(c.name, lang)}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    )}

    <div class="es-bar" data-bar hidden>
      <span><b data-bar-title>{E('barTitle', { country: countryLabel, opt: optNames.esim })}</b><small data-bar-sub>{fillT(E('barSub'), { people: people.solo, n: DEFAULT.days, prio: prios.cost })}</small></span>
      <a class="es-btn" href={esimHref('bar')} target="_blank" rel="sponsored noopener" data-esim-cta><span data-bar-btn>{E('barBtn')}</span> ↗</a>
    </div>
    <script type="application/json" data-esim-json set:html={pageData}></script>
  </article>

  <Newsletter lang={lang} />
</BaseLayout>

<script>
  import { recommend } from '../lib/esim-page.mjs';

  const root = document.querySelector<HTMLElement>('[data-esim]');
  const raw = root?.querySelector('[data-esim-json]')?.textContent;
  if (root && raw) {
    const D = JSON.parse(raw);
    const fill = (s: string, v: Record<string, string | number>) => Object.entries(v).reduce((a, [k, x]) => a.split(`{${k}}`).join(String(x)), s);
    const seg = (box: Element | null, on: (v: string) => void) => {
      if (!box) return;
      const btns = [...box.querySelectorAll<HTMLButtonElement>('button[data-v]')];
      for (const b of btns) b.addEventListener('click', () => {
        for (const x of btns) x.setAttribute('aria-pressed', String(x === b));
        on(b.dataset.v || '');
      });
    };

    // ── Recommender: answers → one option, the card it points at, the bar ──
    const state = { people: 'solo', days: 5, prio: 'cost' };
    const draw = () => {
      const pick = recommend(state as any);
      const name = D.optNames[pick];
      root.querySelector('[data-rec-name]')!.textContent = name;
      root.querySelector('[data-rec-why]')!.textContent = fill(D.why[pick], { people: D.people[state.people], n: state.days });
      (root.querySelector('[data-rec-btn]') as HTMLElement).hidden = pick !== 'esim';
      (root.querySelector('[data-rec-other]') as HTMLElement).hidden = pick === 'esim';
      for (const c of root.querySelectorAll<HTMLElement>('[data-opt]')) c.classList.toggle('is-pick', c.dataset.opt === pick);
      root.querySelector('[data-days-label]')!.textContent = fill(D.days, { n: state.days });
      const dayWord = fill(D.days, { n: state.days }).split('·').pop()!.trim();
      root.querySelector('[data-sum]')!.textContent = `${D.people[state.people]} · ${dayWord} · ${D.prios[state.prio]}`;
      root.querySelector('[data-bar-title]')!.textContent = fill(D.bar, { opt: name });
      root.querySelector('[data-bar-sub]')!.textContent = fill(D.barSub, { people: D.people[state.people], n: state.days, prio: D.prios[state.prio] });
      // The bar always opens the eSIM store: when the pick is something else it
      // says "compare eSIM prices" rather than "live prices" (Codex, 10-05).
      root.querySelector('[data-bar-btn]')!.textContent = pick === 'esim' ? D.barBtn : D.barBtnOther;
    };
    seg(root.querySelector('[data-q="people"]'), (v) => { state.people = v; draw(); });
    seg(root.querySelector('[data-q="prio"]'), (v) => { state.prio = v; draw(); });
    root.querySelector<HTMLInputElement>('[data-days]')?.addEventListener('input', (e) => { state.days = Number((e.target as HTMLInputElement).value) || 1; draw(); });
    draw();

    // ── Phone check ───────────────────────────────────────────────────────
    seg(root.querySelector('[data-os]'), (v) => {
      for (const b of root.querySelectorAll<HTMLElement>('[data-os-box]')) b.hidden = b.dataset.osBox !== v;
    });
    const ans: Record<string, string> = {};
    const verdict = () => {
      const { eid, lock } = ans;
      const key = eid === 'no' ? 'noEid'
        : lock === 'no' ? 'locked'
        : eid === 'yes' && lock === 'yes' ? 'ok'
        : eid === 'dunno' || lock === 'dunno' ? 'unknown' : 'wait';
      const out = root.querySelector<HTMLElement>('[data-verdict]')!;
      out.className = `es-verdict v-${key}`;
      out.querySelector('b')!.textContent = D.verdict[key][0];
      out.querySelector('span')!.textContent = D.verdict[key][1];
    };
    for (const q of root.querySelectorAll<HTMLElement>('[data-check]')) seg(q, (v) => { ans[q.dataset.check || ''] = v; verdict(); });

    // ── Setup checklist, remembered in this browser only ──────────────────
    const KEY = `wa-esim-steps-${D.slug}`;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-step]')];
    let saved: number[] = [];
    try { saved = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { saved = []; }
    const count = () => {
      const n = boxes.filter((b) => b.checked).length;
      root.querySelector('[data-steps-done]')!.textContent = fill(D.done, { n });
      for (const b of boxes) b.closest('li')?.classList.toggle('is-done', b.checked);
    };
    for (const b of boxes) {
      b.checked = saved.includes(Number(b.dataset.step));
      b.addEventListener('change', () => {
        try { localStorage.setItem(KEY, JSON.stringify(boxes.filter((x) => x.checked).map((x) => Number(x.dataset.step)))); } catch { /* private mode */ }
        count();
      });
    }
    count();

    // ── Sticky bar: once the hero's button has scrolled away, gone again at
    //    the price section (it would only repeat the button beside it). ────
    const bar = root.querySelector<HTMLElement>('[data-bar]');
    const hero = root.querySelector('.es-hero');
    const cta = root.querySelector('[data-cta]');
    if (bar && hero && cta && 'IntersectionObserver' in window) {
      let heroGone = false; let ctaShown = false;
      const popup = document.querySelector<HTMLElement>('[data-nl-popup]');
      const sync = () => { bar.hidden = !(heroGone && !ctaShown) || (!!popup && !popup.hidden); };
      // The newsletter popup opens over the same strip of screen (Codex, 10-05).
      if (popup) new MutationObserver(sync).observe(popup, { attributes: true, attributeFilter: ['hidden'] });
      new IntersectionObserver(([e]) => { heroGone = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(hero);
      new IntersectionObserver(([e]) => { ctaShown = e.isIntersecting; sync(); }).observe(cta);
    }
  }
</script>

