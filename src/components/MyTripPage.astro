---
import BaseLayout from '../layouts/BaseLayout.astro';
import Emoji from './Emoji.astro';
import Newsletter from './Newsletter.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';

// The saved list. Rendered entirely on the client from localStorage, because the
// list belongs to the visitor and this is a static site — no account, no server,
// nothing transmitted. The page ships empty and fills itself in.
//
// noindex: there is no content here for a crawler, and every visitor's copy is
// different.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const title = t('trip.title');
const dek = t('trip.dek');

// Strings the client script needs; passing them through data-attributes keeps
// the translation lookup on the server where the dictionary lives.
const strings = JSON.stringify({
  empty: t('trip.empty'),
  emptyCta: t('trip.emptyCta'),
  emptyHref: localizePath('/destinations', lang),
  // Saved hrefs freeze the language they were saved in, so someone who saved
  // in Korean and later reads in Spanish was thrown back into Korean. The slug
  // is language-neutral, so the path is rebuilt for the current locale.
  postBase: localizePath('/posts', lang) + '/',
  count: t('trip.count'),
  quiet: t('trip.quiet'),
  remove: t('trip.remove'),
  clearConfirm: t('trip.clearConfirm'),
});
---

<BaseLayout title={title} description={dek} lang={lang} localized={true} noindex={true}>
  <article class="trip">
    <h1>{title}</h1>
    <p class="dek">{dek}</p>

    <div class="trip-bar" hidden>
      <span class="trip-count"></span>
      <div class="trip-actions">
        <a class="trip-btn trip-maps" href="#" target="_blank" rel="noopener">
          <Emoji name="round-pushpin" /> {t('trip.openAll')}
        </a>
        <button type="button" class="trip-btn trip-print">
          <Emoji name="printer" /> {t('trip.print')}
        </button>
        <button type="button" class="trip-btn trip-clear">{t('trip.clear')}</button>
      </div>
    </div>

    <div class="trip-list" data-strings={strings}></div>
    {/* Removing an item silently told a screen-reader user nothing. */}
    <p class="sr-only" role="status" aria-live="polite"></p>

    <p class="trip-note">{t('trip.local')}</p>

    {/* Saved list → owned channel (growth research B1 bridge, 2026-08-13):
        someone with a saved list is planning a real trip — the one moment a
        subscribe ask is a favor rather than an interruption. The list itself
        stays in localStorage; only the email goes anywhere. */}
    <Newsletter compact={true} lang={lang} />
  </article>
</BaseLayout>

<!-- Global, not scoped: the header and footer belong to other components, and a
     scoped rule cannot reach them. TripChecklist has the same rule scoped, which
     is why it never worked there either. -->
<style is:global>
  @media print {
    .site-header, .site-footer, .newsletter, .sticky-book { display: none !important; }
  }
</style>

<style>
  .trip { max-width: var(--wrap); margin: 0 auto; padding: 2rem 1rem 0; }
  .trip h1 { margin: 0 0 0.5rem; }
  .dek { color: var(--muted); margin: 0 0 1.5rem; }

  /* `hidden` alone loses here: Astro scopes .trip-bar to an attribute selector,
     which outranks the [hidden]{display:none} in the reset. The toolbar rendered
     over the empty state on a first visit, with a Maps link pointing at "#".
     ItineraryPage.astro and .sticky-book already solve it this way. */
  .trip-bar[hidden], .trip-btn[hidden] { display: none; }
  .trip-bar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;
    padding: 0.9rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    margin-bottom: 1.4rem;
  }
  .trip-count { font-weight: 700; }
  .trip-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-left: auto; }
  .trip-btn {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.45rem 0.85rem; border: 1px solid var(--line-strong); border-radius: 999px;
    background: var(--surface); color: var(--ink); font: inherit; font-size: 0.85rem;
    font-weight: 600; text-decoration: none; cursor: pointer;
  }
  .trip-btn:hover { border-color: var(--accent); color: var(--accent); }

  .trip-note { margin: 2rem 0 0; color: var(--muted); font-size: 0.8rem; }

  @media print {
    .trip-bar, .trip-note, .dek { display: none; }
  }
</style>

<!-- Everything below styles nodes this page BUILDS WITH innerHTML, so it cannot
     be scoped. Astro compiles a scoped rule to `.trip-item[data-astro-cid-…]`
     and only stamps that attribute on markup it renders itself — the injected
     rows never carry it. The result was a polished header bar sitting directly
     above a list with no layout at all: zero-size thumbnails, default grey
     system buttons for "Remove", and an empty-state CTA that looked like plain
     black text instead of a link. The comment above says TripChecklist hit this
     same wall; it is the second time, so these rules live out here now. -->
<style is:global>
  .trip-item {
    display: flex; gap: 1rem; align-items: flex-start;
    padding: 1rem 0; border-bottom: 1px solid var(--line-soft);
  }
  .trip-thumb {
    width: 92px; height: 68px; flex: none; border-radius: var(--r-sm);
    object-fit: cover; background: var(--surface-2);
  }
  .trip-body { flex: 1; min-width: 0; }
  .trip-name { font-weight: 700; color: var(--ink); text-decoration: none; }
  .trip-name:hover { color: var(--accent); text-decoration: underline; }
  .trip-where { color: var(--muted); font-size: 0.85rem; margin: 0.15rem 0 0; }
  .trip-facts { margin: 0.4rem 0 0; font-size: 0.85rem; line-height: 1.7; }
  .trip-facts a { color: var(--accent); text-decoration: none; }
  .trip-facts .k { color: var(--muted); }
  .trip-quiet { font-weight: 700; color: var(--accent); }
  .trip-remove {
    flex: none; background: none; border: none; color: var(--muted);
    font: inherit; font-size: 0.8rem; cursor: pointer; padding: 0.2rem 0.4rem;
  }
  .trip-remove:hover { color: var(--accent); text-decoration: underline; }

  .trip-empty { padding: 2.5rem 0; color: var(--muted); }
  .trip-empty a { color: var(--accent); font-weight: 600; }

  @media print {
    .trip-item { break-inside: avoid; border-bottom: 1px solid #ddd; }
    .trip-thumb { display: none; }
    .trip-facts a { color: #000; text-decoration: none; }
    /* A printed tel: link does not need its own href stapled on — the number is
       already the visible text — and a Maps URL is 60 characters nobody can type. */
    .trip-facts .map-one { display: none; }
  }
</style>

<script>
  (() => {
    const KEY = 'wa_trip_v1';
    // Typed lookups throughout this script: querySelector returns Element,
    // which carries none of .dataset/.hidden/.href/.focus. The code was always
    // right at runtime; annotating it is what lets `astro check` become a gate
    // instead of 113 warnings nobody reads.
    const list = document.querySelector<HTMLElement>('.trip-list');
    if (!list) return;
    const bar = document.querySelector<HTMLElement>('.trip-bar');
    const S = JSON.parse(list.dataset.strings || '{}');

    const read = () => {
      try {
        const raw = localStorage.getItem(KEY);
        const v = raw ? JSON.parse(raw) : [];
        return Array.isArray(v) ? v : [];
      } catch { return []; }
    };
    const write = (v: unknown[]) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(v));
        window.dispatchEvent(new CustomEvent('wa-trip-change', { detail: { count: v.length } }));
      } catch { /* storage unavailable */ }
    };

    const esc = (s: unknown) =>
      String(s ?? '').replace(/[&<>"']/g, (c: string) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);

    const render = () => {
      const items = read();

      if (!items.length) {
        if (bar) bar.hidden = true;
        list.innerHTML =
          `<p class="trip-empty">${esc(S.empty)} <a href="${esc(S.emptyHref)}">${esc(S.emptyCta)} →</a></p>`;
        // This early return used to skip the count and the live region, so after
        // removing the last place the page read "Nothing saved yet." while the
        // header still said "1 saved" — and because the live region's text never
        // changed, a screen reader announced nothing at all. Both are updated
        // here before returning.
        const countEmpty = document.querySelector('.trip-count');
        if (countEmpty) countEmpty.textContent = (S.count || '{n}').replace('{n}', '0');
        const liveEmpty = document.querySelector('[aria-live]');
        if (liveEmpty) liveEmpty.textContent = S.empty;
        return;
      }

      if (bar) bar.hidden = false;
      const live = document.querySelector('[aria-live]');
      if (live) live.textContent = (S.count || '{n}').replace('{n}', String(items.length));
      const count = document.querySelector('.trip-count');
      if (count) count.textContent = (S.count || '{n}').replace('{n}', String(items.length));

      // Maps' `search` action takes ONE place — the previous version encoded every
      // coordinate into a single query string, so Google geocoded the lot as one
      // piece of free text and plotted nothing. The /dir/ path form takes any
      // number of points as path segments and is what actually shows the list.
      const withCoords = items.filter((i) => i.lat != null && i.lng != null);
      const maps = document.querySelector<HTMLAnchorElement>('.trip-maps');
      if (withCoords.length) {
        if (maps) maps.hidden = false;
        if (maps) maps.href =
          'https://www.google.com/maps/dir/' +
          withCoords.map((i) => `${Number(i.lat)},${Number(i.lng)}`).join('/');
      } else {
        if (maps) maps.hidden = true;
      }

      list.innerHTML = items
        .map((i) => {
          const facts = [];
          if (i.phone) facts.push(`<a href="tel:${esc(i.phone.replace(/[^\d+]/g, ''))}">${esc(i.phone)}</a>`);

          // Hours arrive as Google's seven lines starting Monday. Show the one for
          // the day the reader is looking at it — the old code kept only Monday's,
          // which told 16 venues' visitors "Closed" (Chatuchak, the Forbidden City)
          // and was wrong on up to six days for 54 more. Strings are older saves.
          const hoursToday = Array.isArray(i.hours)
            ? i.hours[(new Date().getDay() + 6) % 7] || ''
            : i.hours || '';
          if (hoursToday) facts.push(esc(hoursToday));

          // Weekday and weekend quiet windows differ at most venues that have both.
          const weekend = [0, 6].includes(new Date().getDay());
          const quiet = typeof i.quiet === 'object' && i.quiet
            ? (weekend ? i.quiet.we || i.quiet.wd : i.quiet.wd || i.quiet.we)
            : i.quiet || '';
          if (quiet) facts.push(`<span class="k">${esc(S.quiet)}</span> <span class="trip-quiet">${esc(quiet)}</span>`);

          if (i.lat != null && i.lng != null) {
            facts.push(
              `<a class="map-one" href="https://www.google.com/maps/search/?api=1&query=${Number(i.lat)},${Number(i.lng)}" target="_blank" rel="noopener">Google Maps</a>`
            );
          }
          const where = [i.region, i.country].filter(Boolean).join(' · ');
          return `
            <div class="trip-item">
              ${i.image ? `<img class="trip-thumb" src="${esc(i.image)}" alt="" loading="lazy" decoding="async">` : ''}
              <div class="trip-body">
                <a class="trip-name" href="${esc(S.postBase)}${esc(i.slug)}/">${esc(i.title)}</a>
                ${where ? `<p class="trip-where">${esc(where)}</p>` : ''}
                ${facts.length ? `<p class="trip-facts">${facts.join(' · ')}</p>` : ''}
              </div>
              <button type="button" class="trip-remove" data-slug="${esc(i.slug)}">${esc(S.remove)}</button>
            </div>`;
        })
        .join('');
    };

    list.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest<HTMLElement>('.trip-remove') : null;
      if (!btn) return;
      // render() replaces innerHTML, which destroys the focused button and dumps a
      // keyboard user back at the top of the document. Land them on the next row.
      const buttons = [...list.querySelectorAll<HTMLElement>('.trip-remove')];
      const idx = buttons.indexOf(btn);
      write(read().filter((x) => x.slug !== btn.dataset.slug));
      render();
      const now = list.querySelectorAll<HTMLElement>('.trip-remove');
      // Removing the LAST row hid the action bar, and the fallback target lived
      // inside it — so .focus() silently did nothing and focus fell to <body>.
      // The empty state's own link is the only thing left on the page worth
      // landing on.
      (now[Math.min(idx, now.length - 1)]
        || list.querySelector<HTMLElement>('.trip-empty a')
        || document.querySelector<HTMLElement>('.trip-clear'))?.focus();
    });

    document.querySelector('.trip-clear')?.addEventListener('click', () => {
      if (!confirm(S.clearConfirm)) return;
      write([]);
      render();
      list.querySelector<HTMLElement>('.trip-empty a')?.focus();   // same reason as above
    });
    document.querySelector('.trip-print')?.addEventListener('click', () => window.print());

    window.addEventListener('wa-trip-change', render);
    window.addEventListener('storage', (e) => { if (e.key === KEY) render(); });
    render();
  })();
</script>
