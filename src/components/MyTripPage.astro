</style>

<script>
  import { statusAt, venueClock, hhmm } from '../lib/open-now.mjs';

  const root = document.querySelector<HTMLElement>('[data-mt]');
  if (root) {
    const KEY = 'wa_trip_v1';
    const DAYS_KEY = 'wa_trip_days';
    const VIEW_KEY = 'wa_trip_view';
    const S: Record<string, string> = JSON.parse(root.dataset.strings || '{}');
    const LANG = root.dataset.lang || 'en';
    const f = (k: string, v: Record<string, string | number> = {}) =>
      Object.entries(v).reduce((s, [a, b]) => s.split(`{${a}}`).join(String(b)), S[k] ?? k);
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel as any) as T | null;
    const $$ = <T extends Element = HTMLElement>(sel: string) => [...root.querySelectorAll<T>(sel as any)] as T[];
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);
    const store = {
      get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
      set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* private mode */ } },
    };
    // "See an example trip": the same page over a list held in memory only —
    // every control works, nothing is stored until the reader saves it.
    let demo: any[] | null = null;
    const readStore = (): any[] => { try { const v = JSON.parse(store.get(KEY) || '[]'); return Array.isArray(v) ? v : []; } catch { return []; } };
    const read = (): any[] => demo ?? readStore();
    let demoDays = 0;
    const write = (v: any[]) => {
      // An emptied example is over: the first-visit page comes back and its
      // hearts save for real — not into a hidden empty example (Codex review).
      if (demo) { demo = v.length ? v : null; demoDays = 0; render(); return; }
      store.set(KEY, JSON.stringify(v));
      window.dispatchEvent(new CustomEvent('wa-trip-change', { detail: { count: v.length } }));
    };

    let view = store.get(VIEW_KEY) === 'days' ? 'days' : 'list';
    let filter = 'all';
    const regions = new Map<string, any>();
    let index: Record<string, string> | null = null; // city slug → country slug

    // ── City data: refresh old saves, nearby picks, course, prep ──
    // One file per country (/trip-data/<lang>/<country>.json): per city was
    // 1,271 files and broke the deploy's 20,000-file limit (10-01). Each
    // country file is split into the per-city records the page uses.
    const rsOf = (it: any) => it.rs || (index ? Object.keys(index).filter((r) => String(it.slug).startsWith(`${r}-`)).sort((a, b) => b.length - a.length)[0] : '') || '';
    const loadIndex = async () => {
      if (index) return;
      try { index = (await (await fetch('/trip-data/index.json')).json()).regions ?? {}; } catch { index = {}; }
    };
    const countries = new Map<string, Promise<void>>();
    const loadCountry = (cs: string) => {
      if (!countries.has(cs)) countries.set(cs, (async () => {
        try {
          const r = await fetch(`/trip-data/${LANG}/${cs}.json`);
          if (!r.ok) return;
          const d = await r.json();
          for (const [rs, meta] of Object.entries<any>(d.cities ?? {})) {
            regions.set(rs, { ...meta, region: rs, places: (d.places ?? []).filter((p: any) => p.rs === rs) });
          }
        } catch { /* offline: keep what was saved */ }
      })());
      return countries.get(cs)!;
    };
    const loadRegion = async (rs: string) => {
      if (!rs) return null;
      if (regions.has(rs)) return regions.get(rs);
      await loadIndex();
      const cs = index?.[rs];
      if (cs) await loadCountry(cs);
      if (!regions.has(rs)) regions.set(rs, null);
      return regions.get(rs);
    };
    const placeOf = (slug: string, rs: string) => regions.get(rs)?.places?.find((p: any) => p.slug === slug) ?? null;
    const refresh = async () => {
      const items = read();
      if (!items.length) return;
      if (items.some((it) => !it.rs)) await loadIndex();
      const loading = $('[data-loading]');
      if (loading) loading.hidden = false;
      await Promise.all([...new Set(items.map(rsOf).filter(Boolean))].map(loadRegion));
      if (loading) loading.hidden = true;
      // Fresh fields from the guide; the reader's own (day, savedAt) kept.
      let changed = false;
      const next = read().map((it) => {
        const p = placeOf(it.slug, rsOf(it));
        if (!p) return it;
        const merged = { ...it, ...p, day: it.day ?? 0, savedAt: it.savedAt };
        if (JSON.stringify(merged) !== JSON.stringify(it)) changed = true;
        return merged;
      });
      if (changed) write(next); else render();
    };

    // ── Live status in the venue's own clock ──
    type St = { kind: 'open' | 'soon' | 'closed' | 'none'; label: string; today: string };
    const WEEKDAY = (day: number) => new Intl.DateTimeFormat(LANG, { weekday: 'short', timeZone: 'UTC' }).format(new Date(Date.UTC(2024, 0, 1 + day)));
    const statusOf = (it: any, now: Date): St => {
      if (!Array.isArray(it.week) || !it.tz) return { kind: 'none', label: '', today: '' };
      let clock;
      try { clock = venueClock(now, it.tz); } catch { return { kind: 'none', label: '', today: '' }; }
      const { day, min } = clock;
      const todays = it.week[day] ?? [];
      const today = todays.length ? f('today', { h: todays.map(([s, e]: number[]) => `${hhmm(s)}–${hhmm(e % 1440)}`).join(', ') }) : f('closedToday');
      const s: any = statusAt(it.week, day, min);
      if (s.open) {
        if (s.closes == null) return { kind: 'open', label: f('open24'), today };
        const left = s.closesIn * 1440 + s.closes - min;
        return left <= 60 ? { kind: 'soon', label: f('closesAt', { t: hhmm(s.closes) }), today } : { kind: 'open', label: f('openUntil', { t: hhmm(s.closes) }), today };
      }
      if (s.opens == null) return { kind: 'closed', label: f('closedAll'), today };
      const label = s.opensIn === 0 ? f('opensAt', { t: hhmm(s.opens) }) : s.opensIn === 1 ? f('opensTomorrow', { t: hhmm(s.opens) }) : f('opensDay', { day: WEEKDAY((day + s.opensIn) % 7), t: hhmm(s.opens) });
      return { kind: 'closed', label, today };
    };
    const quietOf = (it: any, now: Date) => {
      const q = it.quiet;
      if (!q || typeof q !== 'object') return typeof q === 'string' ? q : '';
      let weekend = [0, 6].includes(now.getDay());
      if (it.tz) { try { weekend = venueClock(now, it.tz).day >= 5; } catch { /* reader's day */ } }
      return weekend ? q.we || q.wd : q.wd || q.we;
    };

    // ── Rendering ──
    // Days are whole numbers 0–30: a shared link once carried "1e309" and
    // the day picker threw building Infinity buttons (Codex review).
    const MAX_DAY = 30;
    const cleanDay = (x: unknown) => { const n = Number(x); return Number.isInteger(n) && n >= 0 && n <= MAX_DAY ? n : 0; };
    const daysCount = (items: any[]) => Math.min(MAX_DAY, Math.max(3, demo ? demoDays : Number(store.get(DAYS_KEY)) || 0, ...items.map((i) => cleanDay(i.day))));
    const mapsTo = (it: any) => `https://www.google.com/maps/dir/?api=1&destination=${Number(it.lat)},${Number(it.lng)}`;
    const route = (list: any[]) => {
      const pts = list.filter((i) => i.lat != null && i.lng != null);
      return pts.length ? 'https://www.google.com/maps/dir/' + pts.map((i) => `${Number(i.lat)},${Number(i.lng)}`).join('/') : '';
    };
    // Only a site path becomes a link: a stored href is page data, and
    // "javascript:…" would run on click (Codex review).
    const safeHref = (h: unknown) => (/^\/(?!\/)[\w\-./%~]*$/.test(String(h ?? '')) ? String(h) : '#');
    const card = (it: any, n: number, now: Date) => {
      const st = statusOf(it, now);
      const quiet = quietOf(it, now);
      const day = cleanDay(it.day);
      const area = [it.region, it.catLabel].filter(Boolean).join(' · ');
      const days = ['<button type="button" data-day-set="0" aria-pressed="' + (day === 0) + '">' + esc(S.dayUnset) + '</button>']
        .concat(Array.from({ length: n }, (_, i) => `<button type="button" data-day-set="${i + 1}" aria-pressed="${day === i + 1}">${esc(f('dayN', { n: i + 1 }))}</button>`)).join('');
      return `<article class="mt-item" data-slug="${esc(it.slug)}">
        <div class="mt-thumb">${it.image ? `<img src="${esc(it.image)}" alt="" loading="lazy" decoding="async">` : ''}
          <span class="mt-daybadge${day ? '' : ' mt-daybadge--unset'}">${esc(day ? f('dayN', { n: day }) : S.unsetBadge)}</span></div>
        <div class="mt-body">
          ${area ? `<p class="mt-area">${esc(area)}</p>` : ''}
          <a class="mt-name" href="${esc(safeHref(it.href))}">${esc(it.title)}</a>
          ${st.label ? `<span class="mt-status mt-status--${st.kind}" data-st="${esc(it.slug)}"><i class="dot dot--${st.kind === 'soon' ? 'soon' : st.kind === 'open' ? 'open' : 'closed'}"></i>${esc(st.label)}</span>` : ''}
          ${it.rating ? `<p class="mt-rating"><b>★ ${Number(it.rating).toFixed(1)}</b> (${Number(it.reviews || 0).toLocaleString(LANG)})</p>` : ''}
          <div class="mt-tags">
            ${st.today ? `<span class="mt-tag${st.today === S.closedToday ? ' mt-tag--closed' : ''}">${esc(st.today)}</span>` : ''}
            ${quiet ? `<span class="mt-tag mt-tag--quiet">${esc(f('quiet', { h: quiet }))}</span>` : ''}
            ${it.book ? `<span class="mt-tag mt-tag--book">${esc(S.bookTag)}</span>` : ''}
          </div>
          <div class="mt-acts">
            ${it.phone ? `<a class="mt-act" href="tel:${esc(String(it.phone).replace(/[^\d+]/g, ''))}">📞 ${esc(S.call)}</a>` : ''}
            ${it.lat != null && it.lng != null ? `<a class="mt-act" href="${esc(mapsTo(it))}" target="_blank" rel="noopener">➤ ${esc(S.directions)}</a>` : ''}
            ${it.address ? `<button type="button" class="mt-act" data-addr="${esc(it.slug)}">🔤 ${esc(S.address)}</button>` : ''}
          </div>
          <div class="mt-days" role="group" aria-label="${esc(S.viewDays)}">${days}</div>
        </div>
        <button type="button" class="mt-x" data-remove="${esc(it.slug)}" aria-label="${esc(f('remove', { place: it.title }))}">✕</button>
      </article>`;
    };

    const render = () => {
      const items = read();
      const now = new Date();
      for (const el of $$('[data-full-only]')) el.hidden = !items.length;
      for (const el of $$('[data-empty-only]')) el.hidden = !!items.length;
      const demoBar = $('[data-demo]');
      if (demoBar) demoBar.hidden = !demo;
      // One newsletter form on the page, in whichever state is showing.
      const nlBox = $('[data-nl]');
      const slot = $(items.length ? '[data-nl-slot-full]' : '[data-nl-slot-empty]');
      if (nlBox && slot && nlBox.parentElement !== slot) slot.append(nlBox);
      const live = $('[data-live]');
      if (live) live.textContent = (S.count || '{n}').replace('{n}', String(items.length));
      const head = $('[data-headline]');
      if (!items.length) { if (head) head.textContent = ''; renderStart(); return; }

      // Main city: where most of the list is.
      const byCity = new Map<string, any[]>();
      for (const it of items) { const k = rsOf(it) || it.region || ''; byCity.set(k, [...(byCity.get(k) ?? []), it]); }
      const [mainRs, mainItems] = [...byCity.entries()].sort((a, b) => b[1].length - a[1].length)[0];
      const R = regions.get(mainRs);
      const city = R?.label || mainItems[0]?.region || '';
      if (head) head.textContent = byCity.size > 1 ? f('headMulti', { n: items.length, k: byCity.size }) : f('headCity', { city, n: items.length });

      const statuses = items.map((it) => statusOf(it, now));
      const setStat = (k: string, n: number) => { const el = $(`[data-stat="${k}"]`); if (el) el.textContent = f('placesN', { n }); };
      setStat('saved', items.length);
      setStat('planned', items.filter((i) => cleanDay(i.day) > 0).length);
      setStat('book', items.filter((i) => i.book).length);
      setStat('quiet', items.filter((i) => i.quiet && (typeof i.quiet === 'string' ? i.quiet : i.quiet.wd || i.quiet.we)).length);
      tick(items, statuses, R, mainItems);

      // Filters
      const open = (i: number) => statuses[i].kind === 'open' || statuses[i].kind === 'soon';
      const counts = { all: items.length, open: items.filter((_, i) => open(i)).length, book: items.filter((i) => i.book).length };
      for (const [k, n] of Object.entries(counts)) { const el = $(`[data-fcount="${k}"]`); if (el) el.textContent = String(n); }
      for (const b of $$('[data-filter]')) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
      for (const b of $$('[data-view]')) b.setAttribute('aria-pressed', String(b.dataset.view === view));
      const shown = items.filter((it, i) => filter === 'all' || (filter === 'open' ? open(i) : it.book));
      const n = daysCount(items);
      const list = $('[data-list]');
      if (list) {
        if (view === 'days') {
          const groups = Array.from({ length: n }, (_, d) => ({ d: d + 1, list: shown.filter((it) => cleanDay(it.day) === d + 1) }))
            .concat([{ d: 0, list: shown.filter((it) => !(cleanDay(it.day) > 0)) }]);
          list.innerHTML = groups.filter((g) => g.list.length).map((g) => {
            const r = route(g.list);
            return `<div class="mt-day-head"><h3>${esc(g.d ? f('dayHead', { n: g.d, k: g.list.length }) : f('unsetHead', { k: g.list.length }))}</h3>${g.d && r ? `<a href="${esc(r)}" target="_blank" rel="noopener">${esc(S.dayMaps)}</a>` : ''}</div>` + g.list.map((it) => card(it, n, now)).join('');
          }).join('') + `<button type="button" class="mt-btn mt-addday" data-addday>${esc(S.addDay)}</button>`;
        } else {
          list.innerHTML = shown.map((it) => card(it, n, now)).join('');
        }
      }
      const none = $('[data-none]');
      if (none) none.hidden = shown.length > 0;
      const all = $<HTMLAnchorElement>('[data-openall]');
      const r = route(items);
      if (all) { all.hidden = !r; all.href = r || '#'; }
      const more = $<HTMLAnchorElement>('[data-more]');
      if (more && R?.regionHref) more.href = R.regionHref;

      renderNear(items, R);
      renderCourse(items, R, city);
      renderPrep(items, R, city);
    };

    const tick = (items: any[], statuses: St[], R: any, mainItems: any[]) => {
      const now = new Date();
      const tz = R?.tz || mainItems.find((i) => i.tz)?.tz;
      const city = R?.label || mainItems[0]?.region || '';
      const clockTitle = $('[data-clock-title]');
      if (clockTitle) clockTitle.textContent = f('clockTitle', { city });
      if (tz) {
        try {
          const time = new Intl.DateTimeFormat(LANG, { timeZone: tz, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(now);
          const date = new Intl.DateTimeFormat(LANG, { timeZone: tz, month: 'long', day: 'numeric', weekday: 'long' }).format(now);
          const parts = new Intl.DateTimeFormat('en-US', { timeZone: tz, year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(now);
          const g = (t: string) => Number(parts.find((p) => p.type === t)?.value);
          const there = Date.UTC(g('year'), g('month') - 1, g('day'), g('hour'), g('minute'));
          const here = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate(), now.getHours(), now.getMinutes());
          const diffH = Math.round((there - here) / 900000) / 4;
          const t = $('[data-clock-time]'); if (t) t.textContent = time;
          const d = $('[data-clock-date]'); if (d) d.textContent = date;
          const df = $('[data-clock-diff]');
          if (df) df.textContent = diffH === 0 ? S.clockSame : diffH > 0 ? f('clockAhead', { h: Math.abs(diffH) }) : f('clockBehind', { h: Math.abs(diffH) });
        } catch { /* unknown zone */ }
      }
      const c = { open: 0, soon: 0, closed: 0 };
      statuses.forEach((s) => { if (s.kind === 'open') c.open++; else if (s.kind === 'soon') c.soon++; else if (s.kind === 'closed') c.closed++; });
      for (const [k, n] of Object.entries(c)) { const el = $(`[data-count="${k}"]`); if (el) el.textContent = f('placesN', { n }); }
    };

    const walk = (a: any, b: any) => {
      const R = 6371, rad = Math.PI / 180;
      const dLat = (b.lat - a.lat) * rad, dLng = (b.lng - a.lng) * rad;
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(a.lat * rad) * Math.cos(b.lat * rad) * Math.sin(dLng / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(h));
    };
    let nearPicks: any[] = [];
    let nearCity = '';
    const renderNear = (items: any[], R: any) => {
      const box = $('[data-near]');
      const grid = $('[data-near-list]');
      if (!box || !grid) return;
      const saved = new Set(items.map((i) => i.slug));
      const anchors = items.filter((i) => i.lat != null && i.lng != null);
      if (!R?.places?.length || !anchors.length) { box.hidden = true; grid.innerHTML = ''; nearPicks = []; return; }
      // Keep the picks steady while the reader saves them one by one.
      // Recomputed when the list's main city changes (a Barcelona pick stayed
      // under a Seoul list — Codex review) or when every pick has been saved.
      if (!nearPicks.length || nearCity !== R.region || nearPicks.every((p) => saved.has(p.slug))) {
        nearCity = R.region;
        nearPicks = R.places
          .filter((p: any) => !saved.has(p.slug) && p.cat !== 'event' && p.lat != null && (p.reviews ?? 0) >= 50)
          .map((p: any) => {
            const best = anchors.map((a) => ({ a, km: walk(a, p) })).sort((x, y) => x.km - y.km)[0];
            return { ...p, from: best.a.title, km: best.km };
          })
          .filter((p: any) => p.km <= 3)
          .sort((a: any, b: any) => a.km - b.km)
          .slice(0, 3);
      }
      box.hidden = !nearPicks.length;
      if (!nearPicks.length) { grid.innerHTML = ''; return; }
      grid.innerHTML = nearPicks.map((p) => {
        const min = Math.max(1, Math.round((p.km * 1.25) / 4.5 * 60));
        const dist = min <= 40 ? f('nearFrom', { place: p.from, min }) : f('nearKm', { place: p.from, km: p.km.toFixed(1) });
        const on = saved.has(p.slug);
        return `<div class="mt-near-card"><span class="mt-near-img">${p.image ? `<img src="${esc(p.image)}" alt="" loading="lazy" decoding="async">` : ''}</span>
          <div><small>${esc([p.region, p.catLabel].filter(Boolean).join(' · '))}</small><a class="mt-near-name" href="${esc(p.href)}">${esc(p.title)}</a>
          <p>${esc(dist)}</p>${p.rating ? `<p>★ ${Number(p.rating).toFixed(1)} (${Number(p.reviews || 0).toLocaleString(LANG)})</p>` : ''}
          <button type="button" class="mt-btn" data-near-save="${esc(p.slug)}" aria-pressed="${on}">${esc(on ? S.nearSaved : S.nearSave)}</button></div></div>`;
      }).join('');
    };

    const renderCourse = (items: any[], R: any, city: string) => {
      const a = $<HTMLAnchorElement>('[data-course]');
      if (!a) return;
      const its = R?.itineraries ?? [];
      if (!its.length) { a.hidden = true; return; }
      const saved = new Set(items.map((i) => i.slug));
      const scored = its.map((it: any) => ({ it, k: it.slugs.filter((s: string) => saved.has(s)).length }))
        .sort((x: any, y: any) => y.k - x.k || x.it.days - y.it.days);
      const { it, k } = scored[0];
      a.hidden = false;
      a.href = it.href;
      const kicker = $('[data-course-kicker]'); if (kicker) kicker.textContent = f('courseKicker', { d: it.days, n: it.slugs.length });
      const title = $('[data-course-title]'); if (title) title.textContent = f('courseTitle', { city, d: it.days });
      const regionCount = items.filter((i) => rsOf(i) === R.region).length;
      // "Every place you saved" only when it is the whole list, not just this
      // city's share of a multi-city trip (Codex review).
      const text = $('[data-course-text]'); if (text) text.textContent = k && k >= items.length ? S.courseAll : k ? f('courseHas', { k }) : S.courseNone;
      const first = R.places.find((p: any) => it.slugs.includes(p.slug) && p.image);
      const img = $('[data-course-img]'); if (img) img.innerHTML = first ? `<img src="${esc(first.image)}" alt="" loading="lazy" decoding="async">` : '';
    };

    const renderPrep = (items: any[], R: any, city: string) => {
      const box = $('[data-prep]');
      const ul = $('[data-prep-list]');
      if (!box || !ul) return;
      if (!R?.prep) { box.hidden = true; return; }
      box.hidden = false;
      const title = $('[data-prep-title]'); if (title) title.textContent = f('prepTitle', { city });
      const book = items.filter((i) => i.book && rsOf(i) === R.region).length;
      const row = (ico: string, href: string, name: string, sub: string, ext: boolean) =>
        `<li><a href="${esc(href)}"${ext ? ' target="_blank" rel="sponsored noopener"' : ''}><i aria-hidden="true">${ico}</i><span><strong>${esc(name)}</strong><small>${esc(sub)}</small></span><em aria-hidden="true">→</em></a></li>`;
      ul.innerHTML = [
        row('🎟', R.prep.tickets, S.prepTickets, book ? f('prepTicketsSub', { n: book }) : f('prepTicketsNone', { city }), true),
        row('📶', R.prep.esim, S.prepEsim, f('prepEsimSub', { country: R.country }), false),
        row('🚖', R.prep.pickup, S.prepPickup, S.prepPickupSub, true),
        row('🛏', R.prep.hotel, S.prepHotel, f('prepHotelSub', { city }), true),
      ].join('');
    };

    // ── First visit: a start city's top places, a live preview card ──
    const startBox = $('[data-start]');
    let startRs = startBox?.dataset.start || '';
    const topOf = (R: any, n: number) => (R?.places ?? []).filter((p: any) => p.image && p.cat !== 'event').slice(0, n);
    const renderPreview = () => {
      const R = regions.get(startRs);
      const ul = $('[data-pv-list]');
      if (!R || !ul) return;
      const picks = topOf(R, 3);
      const now = new Date();
      const pt = $('[data-pv-title]'); if (pt) pt.textContent = `${R.label} · ${f('placesN', { n: picks.length })}`;
      const tm = $('[data-pv-time]');
      if (tm && R.tz) { try { tm.textContent = f('eLocal', { t: new Intl.DateTimeFormat(LANG, { timeZone: R.tz, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(now) }); } catch { /* unknown zone */ } }
      ul.innerHTML = picks.map((p: any) => {
        const st = statusOf(p, now);
        return `<li>${p.image ? `<img src="${esc(p.image)}" alt="" loading="lazy" decoding="async">` : '<i></i>'}<span><strong>${esc(p.title)}</strong>${st.label ? `<em>● ${esc(st.label)}</em>` : ''}</span></li>`;
      }).join('');
    };
    const renderStart = async () => {
      if (!startBox || !startRs) return;
      if (!regions.has(startRs)) { await loadRegion(startRs); if (read().length) return; }
      const R = regions.get(startRs);
      if (!R) return;
      const title = $('[data-start-title]'); if (title) title.textContent = f('startTitle', { city: R.label });
      const all = $<HTMLAnchorElement>('[data-start-all]'); if (all) { all.textContent = f('startAll', { city: R.label }); all.href = R.regionHref; }
      for (const c of $$('[data-start-rs]')) c.setAttribute('aria-pressed', String(c.dataset.startRs === startRs));
      const saved = new Set(read().map((i) => i.slug));
      const grid = $('[data-start-grid]');
      if (grid) grid.innerHTML = topOf(R, 6).map((p: any) => `<div class="mt-start-card">
          <span class="mt-start-img"><img src="${esc(p.image)}" alt="" loading="lazy" decoding="async"></span>
          <button type="button" class="mt-heart" data-start-save="${esc(p.slug)}" aria-pressed="${saved.has(p.slug)}" aria-label="${esc(S.nearSave)}">${saved.has(p.slug) ? '♥' : '♡'}</button>
          <div><small>${esc([p.region, p.catLabel].filter(Boolean).join(' · '))}</small><a href="${esc(p.href)}">${esc(p.title)}</a>
          ${p.rating ? `<p><b>★ ${Number(p.rating).toFixed(1)}</b> (${Number(p.reviews || 0).toLocaleString(LANG)})</p>` : ''}</div></div>`).join('');
      renderPreview();
    };
    const startDemo = async () => {
      if (!regions.has(startRs)) await loadRegion(startRs);
      const R = regions.get(startRs);
      if (!R) return;
      demo = topOf(R, 4).map((p: any, i: number) => ({ ...p, day: [1, 1, 2, 0][i] ?? 0 }));
      render();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // ── Share link: the list (slug + day) in the URL, nothing on a server ──
    const b64 = (s: string) => btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    const unb64 = (s: string) => atob(s.replace(/-/g, '+').replace(/_/g, '/'));
    const shareUrl = () => `${location.origin}${location.pathname}#share=${b64(JSON.stringify(read().map((i) => [i.slug, cleanDay(i.day), i.rs || ''])))}`;
    let shared: [string, number, string][] = [];
    const readShared = () => {
      const m = /#share=([\w-]+)/.exec(location.hash);
      if (!m) return;
      // A link is input: slugs and city slugs must look like ours, days are
      // 0–30, duplicates collapse, and at most 200 places come in (Codex review).
      try {
        const v = JSON.parse(unb64(m[1]));
        const seen = new Set<string>();
        shared = (Array.isArray(v) ? v : [])
          .filter((x) => Array.isArray(x) && typeof x[0] === 'string' && /^[a-z0-9-]{1,200}$/.test(x[0]) && !seen.has(x[0]) && seen.add(x[0]))
          .slice(0, 200)
          .map((x) => [x[0], cleanDay(x[1]), typeof x[2] === 'string' && /^[a-z0-9-]{0,80}$/.test(x[2]) ? x[2] : '']);
      } catch { shared = []; }
      const box = $('[data-shared]');
      if (box && shared.length) { box.hidden = false; const p = $('[data-shared-text]'); if (p) p.textContent = f('sharedBanner', { n: shared.length }); }
    };
    const importShared = async (replace: boolean) => {
      await loadIndex();
      const got: any[] = [];
      for (const [slug, day, rs0] of shared) {
        const rs = rs0 || rsOf({ slug });
        await loadRegion(rs);
        const p = placeOf(slug, rs);
        if (p) got.push({ ...p, day, savedAt: new Date().toISOString() });
      }
      // "Replace" only when every shared place came through: a failed fetch
      // must not wipe the reader's own list (Codex review). Otherwise it adds.
      const mine = replace && got.length === shared.length ? [] : read();
      const have = new Set(mine.map((i) => i.slug));
      write([...mine, ...got.filter((g) => !have.has(g.slug) && have.add(g.slug))]);
      dismissShared();
    };
    const dismissShared = () => {
      shared = [];
      const box = $('[data-shared]'); if (box) box.hidden = true;
      history.replaceState(null, '', location.pathname + location.search);
    };

    // ── Events ──
    root.addEventListener('click', async (e) => {
      const el = e.target instanceof Element ? e.target.closest<HTMLElement>('button, a') : null;
      if (!el) return;
      const d = el.dataset;
      if (d.daySet != null) {
        const slug = el.closest<HTMLElement>('[data-slug]')?.dataset.slug;
        write(read().map((i) => (i.slug === slug ? { ...i, day: Number(d.daySet) } : i)));
        (root.querySelector<HTMLElement>(`[data-slug="${CSS.escape(slug || '')}"] [data-day-set="${d.daySet}"]`))?.focus();
      } else if (d.remove) {
        const btns = $$('[data-remove]');
        const idx = btns.indexOf(el);
        write(read().filter((i) => i.slug !== d.remove));
        const now = $$('[data-remove]');
        (now[Math.min(idx, now.length - 1)] || root.querySelector<HTMLElement>('[data-empty-only] a'))?.focus();
      } else if (d.filter) { filter = d.filter; render(); }
      else if (d.view) { view = d.view; store.set(VIEW_KEY, view); render(); }
      else if (d.addday != null) {
        const n = Math.min(MAX_DAY, daysCount(read()) + 1);
        if (demo) demoDays = n; else store.set(DAYS_KEY, String(n));
        render();
      }
      else if (d.nearSave) {
        const p = nearPicks.find((x) => x.slug === d.nearSave);
        if (p && !read().some((i) => i.slug === p.slug)) {
          const { from, km, ...payload } = p;
          write([...read(), { ...payload, day: 0, savedAt: new Date().toISOString() }]);
        }
      } else if (d.addr) {
        const it = read().find((i) => i.slug === d.addr);
        const dlg = $<HTMLDialogElement>('[data-addr-dialog]');
        if (it && dlg) {
          const n = $('[data-addr-name]'); if (n) n.textContent = it.title;
          const tx = $('[data-addr-text]'); if (tx) tx.textContent = it.address;
          dlg.showModal();
        }
      } else if (d.addrCopy != null) {
        try { await navigator.clipboard.writeText($('[data-addr-text]')?.textContent || ''); el.textContent = S.copied; } catch { /* no clipboard */ }
      } else if (d.addrClose != null) { $<HTMLDialogElement>('[data-addr-dialog]')?.close(); }
      else if (d.share != null) {
        const url = shareUrl();
        try { await navigator.clipboard.writeText(url); el.textContent = S.shareCopied; }
        catch { prompt(S.shareCopy, url); }
        setTimeout(() => { el.textContent = S.shareCopy; }, 2500);
      } else if (d.demoStart != null) { await startDemo(); }
      else if (d.demoSave != null) { const v = demo ?? []; demo = null; write(v); }
      else if (d.demoClose != null) { demo = null; render(); }
      else if (d.startRs) { startRs = d.startRs; await renderStart(); }
      else if (d.startSave) {
        const p = (regions.get(startRs)?.places ?? []).find((x: any) => x.slug === d.startSave);
        const cur = readStore();
        if (p && !cur.some((i) => i.slug === p.slug)) { demo = null; write([...cur, { ...p, day: 0, savedAt: new Date().toISOString() }]); }
      } else if (d.sharedAdd != null) { await importShared(false); }
      else if (d.sharedReplace != null) { await importShared(true); }
      else if (d.sharedDismiss != null) { dismissShared(); }
      else if (d.print != null) { window.print(); }
      else if (d.clear != null) {
        if (confirm(S.clearConfirm)) { write([]); root.querySelector<HTMLElement>('[data-empty-only] a')?.focus(); }
      }
    });

    // A list that now holds a city not loaded yet (another tab, an import)
    // fetches it, or its nearby picks, course and prep would be the old city's.
    window.addEventListener('wa-trip-change', () => { render(); if (read().some((it) => !regions.has(rsOf(it)))) refresh(); });
    window.addEventListener('storage', (e) => { if (e.key === KEY) { render(); refresh(); } });
    readShared();
    // A share link opened in a tab already on this page changes only the hash.
    addEventListener('hashchange', readShared);
    render();
    refresh();
    // Open status and the clock move with time; only those nodes change.
    // Every 30 s: the clock always; the list too when anything a card or the
    // filters show has changed (open → closed, past local midnight) — the open
    // filter kept a place that had closed (Codex review). Not while the reader
    // is working inside the list, so focus is never pulled away.
    let lastSig = '';
    const sigOf = (items: any[], now: Date) => items.map((it) => { const st = statusOf(it, now); return `${st.kind}|${st.label}|${st.today}|${quietOf(it, now)}`; }).join('~');
    setInterval(() => {
      const items = read();
      if (!items.length) { renderPreview(); return; }
      const now = new Date();
      const sig = sigOf(items, now);
      const inList = root.querySelector('[data-list]')?.contains(document.activeElement);
      if (sig !== lastSig && !inList) { lastSig = sig; render(); return; }
      const byCity = new Map<string, any[]>();
      for (const it of items) { const k = rsOf(it) || it.region || ''; byCity.set(k, [...(byCity.get(k) ?? []), it]); }
      const [mainRs, mainItems] = [...byCity.entries()].sort((a, b) => b[1].length - a[1].length)[0];
      tick(items, items.map((it) => statusOf(it, now)), regions.get(mainRs), mainItems);
    }, 30000);
  }
</script>
