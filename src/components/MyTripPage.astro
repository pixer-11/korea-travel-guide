---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from './Newsletter.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';
import { myTripStrings, MY_TRIP_STRINGS } from '../i18n/my-trip-strings';
import { localizePlace } from '../i18n/places';
import { slugifyRegion } from '../lib/slug';
import countriesData from '../../data/countries.json';

// The saved list, redesigned 2026-10-01 from the owner's "내 여행 개선안".
//
// Still a static page that fills itself from localStorage (wa_trip_v1) — no
// account, no server, nothing sent. New since the redesign:
//   - each city's /trip-data/<lang>/<city>.json (built from the guides) refreshes
//     old saves (hours, rating, time zone) and feeds nearby picks, the course
//     that holds the saved places, and the trip-prep links;
//   - live status per place in the VENUE's time zone (lib/open-now), the city's
//     local clock, and open / closing-soon / closed counts, every 30 seconds;
//   - days per place (none, day 1, day 2…), a by-day view with one route link
//     per day, filters, and a share link that carries the list in the URL.
// noindex: there is nothing here for a crawler; every visitor's copy differs.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const m = myTripStrings(lang);

// First visit ("처음 온 사람", owner's second mock-up, 10-01): start from a city.
// Each country offers the city with the most saveable places; the list grows
// with the guides. Barcelona leads when it exists (the mock-up's city); a
// Korean reader is not offered Korea.
const placePosts = await getCollection('posts', ({ data }) => !data.draft && data.category !== 'event' && !!data.place && data.place.lat != null);
const byCountry = new Map<string, Map<string, number>>();
for (const p of placePosts) {
  const c = p.data.country ?? 'South Korea';
  const r = slugifyRegion(p.data.region ?? '');
  if (!r) continue;
  const m0 = byCountry.get(c) ?? new Map<string, number>();
  m0.set(r, (m0.get(r) ?? 0) + 1);
  byCountry.set(c, m0);
}
const startCountries = countriesData.countries
  .filter((c) => byCountry.has(c.name) && !(lang === 'ko' && c.name === 'South Korea'))
  .sort((a, b) => (a.priority ?? 99) - (b.priority ?? 99))
  .map((c) => ({ label: localizePlace(c.name, lang), rs: [...byCountry.get(c.name)!.entries()].sort((x, y) => y[1] - x[1])[0][0] }));
const defaultStart = startCountries.find((c) => c.rs === 'barcelona')?.rs ?? startCountries[0]?.rs ?? '';

const strings = JSON.stringify({ ...(MY_TRIP_STRINGS as any)[lang], count: t('trip.count') });
---

<BaseLayout title={t('trip.title')} description={t('trip.dek')} lang={lang} localized={true} noindex={true}>
  <div class="mt" data-mt data-lang={lang} data-strings={strings} data-dest={localizePath('/destinations', lang)}>
    <div class="wrap">
      <nav class="mt-crumbs" aria-label="breadcrumb">
        <a href={localizePath('/', lang)}>{t('post.home')}</a><span aria-hidden="true">·</span><span class="mt-here">{t('trip.title')}</span>
      </nav>

      <div class="mt-shared" data-shared hidden>
        <p data-shared-text></p>
        <div>
          <button type="button" class="mt-btn mt-btn--dark" data-shared-add>{m('sharedAdd')}</button>
          <button type="button" class="mt-btn" data-shared-replace>{m('sharedReplace')}</button>
          <button type="button" class="mt-btn mt-btn--plain" data-shared-dismiss>{m('sharedDismiss')}</button>
        </div>
      </div>

      <div class="mt-shared mt-demo" data-demo hidden>
        <p>{m('demoBanner')}</p>
        <div>
          <button type="button" class="mt-btn mt-btn--dark" data-demo-save>{m('demoSave')}</button>
          <button type="button" class="mt-btn mt-btn--plain" data-demo-close>{m('demoClose')}</button>
        </div>
      </div>

      <header class="mt-hero">
        <div class="mt-hero-text">
          <p class="mt-badge"><span aria-hidden="true">🔒</span> <span data-full-only hidden>{m('badge')}</span><span data-empty-only>{m('eBadge')}</span></p>
          <h1><span data-full-only hidden>{t('trip.title')}<span class="mt-h1-sub" data-headline></span></span><span data-empty-only>{m('eH1a')}<span class="mt-h1-sub">{m('eH1b')}</span></span></h1>
          <p class="mt-dek" data-full-only hidden>{m('dek')}</p>
          <p class="mt-dek" data-empty-only>{m('eDek')}</p>
          <div class="mt-ectas" data-empty-only>
            <button type="button" class="mt-btn mt-btn--rust mt-btn--big" data-demo-start>{m('eDemo')}</button>
            <a class="mt-btn mt-btn--big" href={localizePath('/destinations', lang)}>{m('emptyCta')}</a>
          </div>
          <div class="mt-stats" data-full-only hidden>
            <div class="mt-stat"><span>{m('statSaved')}</span><strong data-stat="saved"></strong></div>
            <div class="mt-stat"><span>{m('statPlanned')}</span><strong data-stat="planned"></strong></div>
            <div class="mt-stat mt-stat--peach"><span>{m('statBook')}</span><strong data-stat="book"></strong></div>
            <div class="mt-stat mt-stat--leaf"><span>{m('statQuiet')}</span><strong data-stat="quiet"></strong></div>
          </div>
        </div>

        <div class="mt-clock" data-full-only hidden>
          <p class="mt-clock-k" data-clock-title></p>
          <p class="mt-clock-time"><strong data-clock-time>--:--</strong> <span data-clock-date></span></p>
          <p class="mt-clock-note"><span data-clock-diff></span> · {m('clockNote')}</p>
          <div class="mt-clock-counts">
            <div><span><i class="dot dot--open"></i>{m('openNow')}</span><strong data-count="open">0</strong></div>
            <div><span><i class="dot dot--soon"></i>{m('closingSoon')}</span><strong data-count="soon">0</strong></div>
            <div><span><i class="dot dot--closed"></i>{m('closedNow')}</span><strong data-count="closed">0</strong></div>
          </div>
        </div>

        <div class="mt-preview-wrap" data-empty-only>
          <div class="mt-preview">
            <span class="mt-preview-heart" aria-hidden="true">♥</span>
            <div class="mt-preview-head"><strong data-pv-title></strong><span data-pv-time></span></div>
            <ul data-pv-list></ul>
            <div class="mt-preview-chips"><span>{m('chipCall')}</span><span>{m('chipAddr')}</span><span>{m('chipDays')}</span></div>
          </div>
        </div>
      </header>

      <section class="mt-steps" data-empty-only>
        <div><span class="mt-step-ico mt-step-ico--1" aria-hidden="true">♡</span><small>{m('stepN', { n: 1 })}</small><h2>{m('s1T')}</h2><p>{m('s1S')}</p></div>
        <div><span class="mt-step-ico mt-step-ico--2" aria-hidden="true">◷</span><small>{m('stepN', { n: 2 })}</small><h2>{m('s2T')}</h2><p>{m('s2S')}</p></div>
        <div><span class="mt-step-ico mt-step-ico--3" aria-hidden="true">▦</span><small>{m('stepN', { n: 3 })}</small><h2>{m('s3T')}</h2><p>{m('s3S')}</p></div>
      </section>

      <section class="mt-start" data-empty-only data-start={defaultStart}>
        <div class="mt-start-head">
          <div><h2 class="mt-h2" data-start-title></h2><p class="mt-note">{m('startSub')}</p></div>
          <a class="mt-more" data-start-all href={localizePath('/destinations', lang)}></a>
        </div>
        <div class="mt-start-grid" data-start-grid></div>
        {startCountries.length > 1 && (
          <div class="mt-start-other">
            <span>{m('startOther')}</span>
            {startCountries.map((c) => <button type="button" class="mt-chip" data-start-rs={c.rs} aria-pressed={c.rs === defaultStart ? 'true' : 'false'}>{c.label}</button>)}
          </div>
        )}
      </section>

      <section class="mt-trust" data-empty-only>
        <div class="mt-priv">
          <span class="mt-priv-ico" aria-hidden="true">🔒</span>
          <h2>{m('privTitle')}</h2>
          <p>{m('privSub')}</p>
          <ul><li>✓ {m('priv1')}</li><li>✓ {m('priv2')}</li><li>✓ {m('priv3')}</li></ul>
        </div>
        <div data-nl-slot-empty></div>
      </section>

      <div class="mt-bar" data-full-only hidden>
        <div class="mt-seg" role="group" aria-label={m('viewList')}>
          <button type="button" data-view="list" aria-pressed="true">☰ {m('viewList')}</button>
          <button type="button" data-view="days" aria-pressed="false">📅 {m('viewDays')}</button>
        </div>
        <div class="mt-chips" role="group" aria-label={m('fAll')}>
          <button type="button" class="mt-chip" data-filter="all" aria-pressed="true">{m('fAll')} <span data-fcount="all"></span></button>
          <button type="button" class="mt-chip" data-filter="open" aria-pressed="false">{m('fOpen')} <span data-fcount="open"></span></button>
          <button type="button" class="mt-chip" data-filter="book" aria-pressed="false">{m('fBook')} <span data-fcount="book"></span></button>
        </div>
        <a class="mt-more" data-more href={localizePath('/destinations', lang)}>{m('more')}</a>
      </div>

      <div class="mt-grid" data-full-only hidden>
        <div class="mt-main">
          <p class="mt-loading" data-loading hidden>{m('loading')}</p>
          <div class="mt-list" data-list></div>
          <p class="mt-empty" data-none hidden>{m('none')}</p>
          <div class="mt-tools">
            <a class="mt-btn" data-openall href="#" target="_blank" rel="noopener">📍 {m('openAll')}</a>
            <button type="button" class="mt-btn" data-print>🖨 {m('print')}</button>
            <button type="button" class="mt-btn mt-btn--plain" data-clear>{m('clear')}</button>
          </div>

          <section class="mt-near" data-near hidden>
            <h2 class="mt-h2">{m('nearTitle')}</h2>
            <p class="mt-note">♡ {m('nearSub')}</p>
            <div class="mt-near-grid" data-near-list></div>
          </section>

          <a class="mt-course" data-course hidden href="#">
            <span class="mt-course-img" data-course-img></span>
            <span class="mt-course-body">
              <span class="mt-pill" data-course-kicker></span>
              <strong data-course-title></strong>
              <span data-course-text></span>
            </span>
            <span class="mt-btn mt-btn--rust">{m('courseGo')}</span>
          </a>
        </div>

        <aside class="mt-side">
          <section class="mt-card mt-card--keep">
            <p class="mt-card-ico" aria-hidden="true">🔗</p>
            <h2>{m('keepTitle')}</h2>
            <p>{m('keepSub')}</p>
            <button type="button" class="mt-btn mt-btn--light mt-btn--wide" data-share>{m('shareCopy')}</button>
            <p class="mt-keep-note">{m('shareSub')}</p>
          </section>
          <div data-nl-slot-full><div class="mt-nl" data-nl><Newsletter compact={true} lang={lang} heading={m('nlTitle')} dek={m('nlSub')} /></div></div>
          <section class="mt-card" data-prep hidden>
            <h2 data-prep-title></h2>
            <ul class="mt-prep" data-prep-list></ul>
            <p class="mt-note">{m('affNote')}</p>
          </section>
        </aside>
      </div>

      <p class="mt-local">{t('trip.local')}</p>
      <p class="sr-only" role="status" aria-live="polite" data-live></p>
    </div>

    <dialog class="mt-dialog" data-addr-dialog aria-labelledby="mt-addr-name" aria-describedby="mt-addr-text">
      <p class="mt-dialog-name" id="mt-addr-name" data-addr-name></p>
      <p class="mt-dialog-addr" id="mt-addr-text" data-addr-text></p>
      <div>
        <button type="button" class="mt-btn mt-btn--dark" data-addr-copy>{m('copy')}</button>
        <button type="button" class="mt-btn" data-addr-close>{m('close')}</button>
      </div>
    </dialog>
  </div>
</BaseLayout>

<style is:global>
  @media print {
    .site-header, .site-footer, .newsletter, .sticky-book { display: none !important; }
  }
</style>

<!-- Global: most of this page is built by the script with innerHTML, which
     never carries Astro's scoping attribute. Every rule is under .mt. -->
<style is:global>
  .mt { --mt-brown: #6b3413; --mt-rust: #c0652f; --mt-forest: #26301c; --mt-forest-2: #3b4a2c; --mt-peach: #fde3d4; --mt-leaf: #e3ecd0; --mt-sand: #f1e8d8; --mt-cream: #fbf7ef; --mt-on-dark: #f6f1e6; --mt-brown-text: #6b3413; padding: 1.4rem 0 3rem; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .mt { --mt-brown: #4a2610; --mt-forest: #1c2414; --mt-forest-2: #2b3620; --mt-peach: #3a2620; --mt-leaf: #26301c; --mt-sand: #2a251d; --mt-cream: #221f19; --mt-brown-text: #e8a577; } }
  :root[data-theme='dark'] .mt { --mt-brown: #4a2610; --mt-forest: #1c2414; --mt-forest-2: #2b3620; --mt-peach: #3a2620; --mt-leaf: #26301c; --mt-sand: #2a251d; --mt-cream: #221f19; --mt-brown-text: #e8a577; }
  .mt [hidden] { display: none !important; }
  .mt-crumbs { display: flex; gap: .45rem; font-size: .85rem; color: var(--muted); margin-bottom: 1rem; }
  .mt-crumbs a { color: inherit; text-decoration: none; }
  .mt-here { color: var(--ink); font-weight: 700; }

  .mt-shared { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem 1rem; padding: 1rem 1.2rem; margin-bottom: 1rem; border-radius: 18px; background: var(--mt-leaf); }
  .mt-shared p { margin: 0; font-weight: 700; color: var(--ink); }
  .mt-shared div { display: flex; flex-wrap: wrap; gap: .4rem; }

  .mt-hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 1.6rem; align-items: stretch; }
  .mt-badge { display: inline-flex; gap: .35rem; align-items: center; margin: 0 0 1rem; padding: .3rem .8rem; border-radius: var(--r-pill); background: var(--mt-leaf); color: var(--pine, var(--ink)); font-size: .82rem; font-weight: 600; }
  .mt-hero h1 { font-family: var(--font-display); font-size: clamp(2.2rem, 5.6vw, 3.6rem); line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 1rem; color: var(--ink); word-break: keep-all; overflow-wrap: anywhere; }
  .mt-h1-sub { display: block; color: var(--mt-brown-text); }
  .mt-dek { color: var(--ink-soft); line-height: 1.75; margin: 0 0 1.2rem; max-width: 34rem; }
  .mt-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .6rem; }
  .mt-stat { display: flex; flex-direction: column; justify-content: space-between; gap: .4rem; padding: .9rem 1rem; border-radius: 18px; background: var(--mt-cream); border: 1px solid var(--line-soft, var(--line)); min-width: 0; }
  .mt-stat span { font-size: .8rem; font-weight: 700; color: var(--ink-soft); line-height: 1.3; }
  .mt-stat strong { font-family: var(--font-display); font-size: 1.5rem; color: var(--ink); }
  .mt-stat--peach { background: var(--mt-peach); border-color: transparent; }
  .mt-stat--leaf { background: var(--mt-leaf); border-color: transparent; }

  .mt-clock { position: relative; overflow: hidden; display: flex; flex-direction: column; padding: 1.8rem; border-radius: 28px; background: var(--mt-forest); color: var(--mt-on-dark); }
  .mt-clock::before { content: ''; position: absolute; right: -4rem; top: -4rem; width: 13rem; height: 13rem; border-radius: 50%; background: var(--mt-forest-2); }
  .mt-clock > * { position: relative; }
  .mt-clock-k { margin: 0; font-size: .88rem; font-weight: 700; opacity: .9; }
  .mt-clock-time { margin: .4rem 0 .2rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .8rem; }
  .mt-clock-time strong { font-family: var(--font-display); font-size: clamp(3rem, 8vw, 4.6rem); line-height: 1; color: #fff; font-variant-numeric: tabular-nums; }
  .mt-clock-time span { font-weight: 700; }
  .mt-clock-note { margin: 0; font-size: .82rem; opacity: .8; }
  .mt-clock-counts { margin-top: auto; padding-top: 1.4rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; }
  .mt-clock-counts div { display: flex; flex-direction: column; gap: .35rem; padding: .8rem .9rem; border-radius: 16px; background: rgba(255, 255, 255, .08); min-width: 0; }
  .mt-clock-counts span { font-size: .78rem; font-weight: 700; line-height: 1.3; display: flex; gap: .35rem; align-items: baseline; }
  .mt-clock-counts strong { font-family: var(--font-display); font-size: 1.8rem; color: #fff; }
  .mt .dot { width: .5rem; height: .5rem; border-radius: 50%; flex: none; display: inline-block; }
  .mt .dot--open { background: #8fc36b; } .mt .dot--soon { background: #f0a35c; } .mt .dot--closed { background: #b9b2a5; }
  .mt-how-title { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 800; margin: .6rem 0 1rem; color: #fff; line-height: 1.25; }
  .mt-how ol { list-style: none; margin: 0 0 1.4rem; padding: 0; display: flex; flex-direction: column; gap: .6rem; }
  .mt-how li { display: flex; gap: .8rem; align-items: flex-start; padding: .7rem .9rem; border-radius: 16px; background: rgba(255, 255, 255, .08); }
  .mt-how li b { flex: none; width: 1.7rem; height: 1.7rem; border-radius: 50%; display: grid; place-items: center; background: var(--mt-on-dark); color: var(--mt-forest); font-size: .85rem; }
  .mt-how li span { display: flex; flex-direction: column; font-size: .85rem; opacity: .9; }
  .mt-how li strong { font-size: .95rem; opacity: 1; color: #fff; }
  .mt-how .mt-btn { margin-top: auto; align-self: flex-start; }

  .mt-h2 { font-family: var(--font-display); font-size: clamp(1.3rem, 3vw, 1.65rem); font-weight: 800; color: var(--ink); margin: 0 0 .4rem; }
  .mt-note { color: var(--muted); font-size: .85rem; margin: 0 0 1rem; }
  /* ── First visit (owner's "처음 온 사람" mock-up) ── */
  .mt-ectas { display: flex; flex-wrap: wrap; gap: .6rem; }
  .mt-btn--big { padding: .75rem 1.3rem; font-size: .95rem; }
  .mt-preview-wrap { position: relative; padding: 1.2rem 1.2rem 1.2rem 1.6rem; }
  .mt-preview-wrap::before { content: ''; position: absolute; right: -1rem; top: -1rem; width: 12rem; height: 12rem; border-radius: 50%; background: var(--mt-peach); opacity: .7; }
  .mt-preview-wrap::after { content: ''; position: absolute; left: -.5rem; bottom: -1.2rem; width: 7rem; height: 7rem; border-radius: 50%; background: var(--mt-leaf); }
  .mt-preview { position: relative; z-index: 1; padding: 1.5rem; border-radius: 28px; background: var(--mt-forest); color: var(--mt-on-dark); box-shadow: 0 18px 40px rgba(40, 30, 15, .18); }
  .mt-preview-heart { position: absolute; left: -1.4rem; top: -1.4rem; width: 3.6rem; height: 3.6rem; border-radius: 50%; display: grid; place-items: center; background: var(--mt-brown); color: #fff; font-size: 1.6rem; box-shadow: 0 6px 16px rgba(0, 0, 0, .2); }
  .mt-preview-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin: 0 0 .9rem; }
  .mt-preview-head strong { font-family: var(--font-display); font-size: 1.25rem; color: #fff; }
  .mt-preview-head span { font-size: .8rem; font-weight: 700; color: #c9dba8; }
  .mt-preview ul { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-direction: column; gap: .55rem; }
  .mt-preview li { display: flex; align-items: center; gap: .8rem; padding: .5rem .8rem .5rem .5rem; border-radius: var(--r-pill); background: var(--mt-forest-2); }
  .mt-preview li img, .mt-preview li i { width: 2.8rem; height: 2.8rem; border-radius: 50%; object-fit: cover; flex: none; background: rgba(255, 255, 255, .1); }
  .mt-preview li span { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .mt-preview li strong { font-size: .95rem; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mt-preview li em { font-style: normal; align-self: flex-start; padding: .1rem .55rem; border-radius: var(--r-pill); background: var(--mt-on-dark); color: #26301c; font-size: .75rem; font-weight: 700; }
  .mt-preview-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .mt-preview-chips span { padding: .3rem .75rem; border-radius: var(--r-pill); background: rgba(255, 255, 255, .1); font-size: .78rem; font-weight: 700; }

  .mt-steps { margin-top: 3rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; }
  .mt-steps > div { padding: 1.5rem; border-radius: 24px; background: var(--mt-cream); border: 1px solid var(--line-soft, var(--line)); }
  .mt-step-ico { display: inline-grid; place-items: center; width: 2.8rem; height: 2.8rem; border-radius: 50%; color: #fff; font-size: 1.2rem; margin-right: .6rem; vertical-align: middle; }
  .mt-step-ico--1 { background: var(--mt-brown); } .mt-step-ico--2 { background: #5a6b3e; } .mt-step-ico--3 { background: #3d342b; }
  .mt-steps small { font-size: .8rem; font-weight: 700; color: var(--muted); vertical-align: middle; }
  .mt-steps h2 { margin: 1rem 0 .5rem; font-size: 1.1rem; font-weight: 800; color: var(--ink); }
  .mt-steps p { margin: 0; color: var(--ink-soft); line-height: 1.65; font-size: .92rem; }

  .mt-start { margin-top: 3rem; }
  .mt-start-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: .4rem 1rem; margin-bottom: 1rem; }
  .mt-start-head .mt-note { margin: 0; }
  .mt-start-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; }
  .mt-start-card { position: relative; display: flex; flex-direction: column; border-radius: 24px; overflow: hidden; background: var(--mt-cream); border: 1px solid var(--line-soft, var(--line)); min-width: 0; }
  .mt-start-card .mt-start-img { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--mt-sand); }
  .mt-start-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mt-start-card > div { display: flex; flex-direction: column; gap: .3rem; padding: 1rem 1.2rem 1.2rem; }
