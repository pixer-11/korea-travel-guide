---
// Contextual lead magnet on itinerary pages: "Email me this itinerary".
// Same backend as every other signup (worker /api/subscribe → MailerLite
// upsert, double opt-in) — the visitor is explicitly ASKING for this plan,
// which is what keeps the invite-only consent policy intact. Ships no JS of
// its own: Newsletter.astro renders further down every itinerary page and
// its script wires ALL .nl-form instances, this one included. The extra
// hidden `itinerary` input becomes fields[itinerary_url] so the welcome
// email can link straight back to this exact page.
import { useTranslations, type Lang } from '../i18n/utils';
import { siteHref } from '../lib/urls.mjs';
import { interestFields } from '../lib/interest';
import Emoji from './Emoji.astro';

interface Props { lang: Lang; region: string; country: string; slug: string }
const { lang, region, country, slug } = Astro.props;
const t = useTranslations(lang);
const interest = interestFields({ region, country, lang, source: `itinerary:${slug}` });
const itineraryUrl = siteHref(Astro.url.pathname, Astro.site);
---
<aside class="itin-email" aria-labelledby="itin-email-title">
  <p class="itin-email-title" id="itin-email-title"><Emoji name="world-map" /> {t('itin.emailTitle')}</p>
  <p class="itin-email-dek">{t('itin.emailDek')}</p>
  <form class="nl-form itin-email-form" data-ml-action="/api/subscribe" novalidate
    data-ok-plain="1" data-via="itinerary"
    data-msg-ok={t('itin.emailOk')} data-msg-err={t('nl.msgErr')} data-msg-net={t('nl.msgNet')}
    data-msg-unsub={t('nl.msgUnsub')}
    data-msg-invalid={t('nl.msgInvalid')} data-sending={t('nl.sending')}>
    <input type="email" name="email" placeholder="you@email.com" aria-label={t('a11y.email')} autocomplete="email" required />
    <input type="hidden" name="region" value={interest.region} />
    <input type="hidden" name="lang" value={interest.lang} />
    <input type="hidden" name="source" value={interest.source} />
    <input type="hidden" name="itinerary" value={itineraryUrl} />
    <button type="submit" class="btn btn-primary">{t('itin.emailCta')}</button>
  </form>
  <p class="nl-note" hidden aria-live="polite"></p>
</aside>

<style>
  .itin-email {
    margin: 2rem 0;
    padding: 1.2rem 1.4rem 1.1rem;
    background: var(--surface-2);
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--gold);
    border-radius: var(--r-lg);
  }
  .itin-email-title {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 550;
    margin: 0 0 0.35rem;
  }
  .itin-email-dek { font-size: 0.9rem; color: var(--muted); line-height: 1.5; margin: 0 0 0.85rem; }
  /* `.nl-form` is centred at max-width 460px for the full-bleed newsletter
     band. Inherited here it shoved the form 82px right of the title, breaking
     the card's left edge — the one axis the gold border is drawing attention to. */
  .itin-email-form { display: flex; gap: 0.55rem; flex-wrap: wrap; max-width: none; margin: 0; }
  .itin-email-form input[type='email'] {
    flex: 1 1 220px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-sm, 8px);
    padding: 0.6rem 0.8rem;
    font-size: 0.95rem;
    background: var(--surface);
    color: inherit;
  }
  @media (max-width: 640px) {
    /* global.css stacks .nl-form into a COLUMN here, which re-reads the
       220px flex-basis as a 220px-TALL input — the card ballooned to 420px
       with a giant empty box in it. Basis off, full width instead.
       16px is also the floor below which iOS Safari zooms the page on focus. */
    .itin-email-form input[type='email'] { flex: 0 0 auto; width: 100%; font-size: 16px; }
  }
  .itin-email :global(.nl-note) { font-size: 0.88rem; margin: 0.6rem 0 0; }
  .itin-email :global(.nl-note-ok) { color: var(--accent-text); font-weight: 600; }
  /* Specificity here has to beat BOTH `.nl-form .btn-primary` (white — meant
     for the dark newsletter band, a ghost button on this cream card) and the
     global dark-mode fill correction, hence the doubled class. */
  .itin-email .itin-email-form :global(.btn-primary) { background: var(--cta); color: #fff; border-radius: var(--r-pill, 999px); }
  .itin-email .itin-email-form :global(.btn-primary:hover) { background: var(--accent-deep); color: #fff; }
  /* In dark mode --accent lightens (#e0685c) for TEXT legibility; as a FILL
     behind white it measures 3.33:1 and fails AA. Same deep vermilion the
     rest of the site's buttons fall back to. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .itin-email .itin-email-form :global(.btn-primary) { background: #b3443a; }
  }
  :global(:root[data-theme='dark']) .itin-email .itin-email-form :global(.btn-primary) { background: #b3443a; }
</style>
