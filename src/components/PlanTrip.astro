---
// "Plan your trip" affiliate block for every guide — booking services that are
// already active on our Travelpayouts account (marker 553157). Link-based
// programs use city-agnostic homepage links (readers pick their city there);
// flights point to our own /flights page. Affiliate links use rel="sponsored".
import { SITE } from '../siteConfig';
import Emoji from './Emoji.astro';
import { getLangFromUrl, useTranslations, klookLocale, localizePath } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import countriesData from '../../data/countries.json';
import esimFacts from '../../data/esim-facts.json';
interface Props { city: string; country?: string }
const { city, country } = Astro.props;
// Labels follow the page's language; the `city` in affiliate links stays English
// (that's the search query the booking API expects), while the DISPLAYED city name
// is localized.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cityLabel = localizePlace(city, lang);

// City-specific Klook affiliate link, built automatically from the city name —
// works for every city (and every future auto-published post) with no per-city
// setup. Uses the account's own Klook redirect (campaign 13694, pid 754088);
// the query lands the reader on that city's tours & tickets.
const klookHref = city
  ? `/go/klook?to=${encodeURIComponent(`https://www.klook.com/${klookLocale(lang)}/search/?query=${city}`)}`
  : 'https://klook.tpx.lv/2NXPH8MA';

const services = [
  { icon: 'admission-tickets', label: t('widget.toursLabel'), desc: city ? t('widget.toursDescCity').replace('{city}', cityLabel) : t('widget.toursDesc'), href: klookHref },
  { icon: 'automobile', label: t('widget.carLabel'), desc: t('widget.carDesc'), href: 'https://localrent.tpx.lv/qivp9ZCc' },
  // Kiwitaxi shortlink code is yRbl5tIp with a CAPITAL I — it was transcribed as
  // lowercase l on 07-21 (the two glyphs are identical in the dashboard font) and
  // 404'd ever since. Corrected + verified: 302 → kiwitaxi.com, tpo …-754088.
  // (Owner's Welcome Pickups link https://tpx.lv/DR9LOcP9 also works — spare.)
  { icon: 'taxi', label: t('widget.transferLabel'), desc: t('widget.transferDesc'), href: 'https://kiwitaxi.tpx.lv/yRbl5tIp' },
  // eSIM: countries with their own /tools/esim guide funnel through it (an
  // internal money page converts better than a bare external link, and every
  // post becomes an interlink to it); everywhere else keeps the Yesim link.
  ...(() => {
    const esimSlug = country ? countriesData.countries.find((c) => c.name === country)?.slug : undefined;
    const hasGuide = esimSlug && (esimFacts as Record<string, unknown>)[esimSlug];
    return [hasGuide
      ? { icon: 'antenna-bars', label: t('widget.esimLabel'), desc: t('widget.esimDesc'), href: localizePath(`/tools/esim/${esimSlug}`, lang), internal: true }
      : { icon: 'antenna-bars', label: t('widget.esimLabel'), desc: t('widget.esimDesc'), href: 'https://yesim.tpx.lv/KABevuVe' }];
  })(),
  // Insurance card SHELVED until ~Oct 2026: EKTA left Travelpayouts (its links
  // 302 to VisitorsCoverage p=4552), and VisitorsCoverage is traffic-locked
  // ("3 consecutive months of stable traffic" review — same gate as Hotels.com).
  // Restore with a VisitorsCoverage link once the project passes that review.
  // { icon: 'shield', label: t('widget.insuranceLabel'), desc: t('widget.insuranceDesc'), href: '<VisitorsCoverage link after Oct review>' },
  { icon: 'airplane', label: t('widget.flightsLabel'), desc: city ? t('widget.flightsDescCity').replace('{city}', cityLabel) : t('widget.flightsDesc'), href: localizePath('/flights', lang), internal: true },
];
---
<section class="plan-trip" data-affiliate-placement="plan-trip">
  <div class="rule-head"><h2 class="kicker">{city ? t('widget.planTripCity').replace('{city}', cityLabel) : t('widget.planTrip')}</h2></div>
  <div class="plan-grid">
    {services.map((s) => (
      <a
        class="plan-card"
        href={s.href}
        target={s.internal ? undefined : '_blank'}
        rel={s.internal ? undefined : 'sponsored noopener'}
      >
        <span class="plan-ico"><Emoji name={s.icon} /></span>
        <span class="plan-txt"><strong>{s.label}</strong><span>{s.desc}</span></span>
        <span class="plan-arw">→</span>
      </a>
    ))}
  </div>
  <p class="tp-disclosure">{t('widget.affDisclosure').replace('{site}', SITE.name)}</p>
</section>
