---
// Client-side search over the build-time index (/search.json). Type a country,
// city, or place name and jump straight to it.
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props { placeholder?: string }
const { placeholder = 'Search a country, city, or place…' } = Astro.props;
// The visible placeholder arrives already localized; the aria-label was
// hardcoded English, so a screen reader on /ja/ announced this field in a
// language the rest of the page is not in.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// The index is per language (/ko/search.json …), built from the same function
// as the English one; until 2026-09-02 every localized page loaded /search.json
// and "서울" on /ko/ found nothing. Labels and the empty message travel as data
// attributes because the client script cannot call t().
const indexUrl = lang === 'en' ? '/search.json' : `/${lang}/search.json`;
const labels = JSON.stringify({
  Country: t('search.kind.Country'), City: t('search.kind.City'), Itinerary: t('search.kind.Itinerary'), Event: t('search.kind.Event'), Guide: t('search.kind.Guide'),
  ended: t('search.ended'), empty: t('search.empty'),
});
---
<div class="site-search" data-search data-index={indexUrl} data-labels={labels}>
  <svg class="search-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
  <input type="search" class="search-input" placeholder={placeholder} autocomplete="off" spellcheck="false" aria-label={t('a11y.searchInput')} />
  <div class="search-results" role="listbox" hidden></div>
</div>

<script>
  import { isOver } from '../lib/evDay';
  document.querySelectorAll('[data-search]').forEach((box) => {
    const input = box.querySelector('.search-input') as HTMLInputElement;
    const panel = box.querySelector('.search-results') as HTMLElement;
    let index: { t: string; a?: string; s: string; u: string; k: string; e?: string; z?: string }[] | null = null;
    let loading = false;
    const indexUrl = (box as HTMLElement).dataset.index || '/search.json';
    let labels: Record<string, string> = {};
    try { labels = JSON.parse((box as HTMLElement).dataset.labels || '{}'); } catch { labels = {}; }
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

    async function load() {
      if (index || loading) return;
      loading = true;
      try {
        const res = await fetch(indexUrl);
        index = await res.json();
      } catch { index = []; }
      loading = false;
      // The index (50–80 KB) is fetched on focus, and render() does nothing
      // until it arrives. A reader who typed "교토" inside that window saw no
      // results until they pressed another key — on a slow phone, often never
      // (2026-09-14). Answer whatever is in the box the moment the index lands.
      if (input.value.trim()) render(input.value);
    }

    function render(q: string) {
      if (!index) return;
      const query = q.trim().toLowerCase();
      if (!query) { panel.hidden = true; panel.innerHTML = ''; return; }
      const rank = { Country: 0, City: 1, Itinerary: 2, Event: 3, Guide: 4 } as Record<string, number>;
      // An event whose last day has passed is listed after everything live and
      // labelled ended — on 11-02 "도쿄" put three finished September/October
      // events above the city's guides, unmarked. Judged by the VENUE's date
      // (lib/evDay, the events hubs' own rule), in the browser: the index is
      // static, and search and /events/ must not disagree across time zones.
      const over = (i: { k: string; e?: string; z?: string }) => i.k === 'Event' && isOver(i.e, i.z);
      const rankOf = (i: { k: string; e?: string; z?: string }) => (over(i) ? 9 : (rank[i.k] ?? 8));
      // The English name (`a`) stays searchable on every language: "Kyoto"
      // typed on /ja/ still lands on the Japanese Kyoto page.
      const has = (i: { t: string; a?: string; s: string }) =>
        i.t.toLowerCase().includes(query) || (i.a ?? '').toLowerCase().includes(query) || i.s.toLowerCase().includes(query);
      // An itinerary counts as a prefix match when its CITY does: "5-Day Tokyo
      // Itinerary" fell below four Tokyo guides on "tokyo", and Singapore's and
      // Dubai's itineraries fell off the eight rows entirely (live check, 11-03).
      const starts = (i: { t: string; a?: string; s: string; k: string }) =>
        i.t.toLowerCase().startsWith(query) || (i.a ?? '').toLowerCase().startsWith(query)
        || (i.k === 'Itinerary' && i.s.toLowerCase().startsWith(query)) ? 0 : 1;
      const hits = index
        .filter(has)
        .sort((a, b) => (over(a) ? 1 : 0) - (over(b) ? 1 : 0) || starts(a) - starts(b) || rankOf(a) - rankOf(b) || a.t.length - b.t.length)
        .slice(0, 8);
      if (!hits.length) {
        panel.innerHTML = `<div class="search-empty">${esc(labels.empty || 'No matches — try a country or city.')}</div>`;
      } else {
        panel.innerHTML = hits
          .map((i) => `<a href="${esc(i.u)}" role="option" data-k="${esc(over(i) ? 'Ended' : i.k)}"${over(i) ? ' class="is-ended"' : ''}><span class="sr-kind">${esc(over(i) && labels.ended ? labels.ended : (labels[i.k] || i.k))}</span><span class="sr-t">${esc(i.t)}</span><span class="sr-s">${esc(i.s)}</span></a>`)
          .join('');
      }
      panel.hidden = false;
    }

    // Measurement (2026-11-02): which kind of result readers actually open —
    // the baseline the home redesign decision waits on. Kind only, never the
    // typed text.
    const track = (a: HTMLElement | null) => {
      if (a && (window as any).plausible) (window as any).plausible('Search used', { props: { kind: a.dataset.k || '' } });
    };
    panel.addEventListener('click', (e) => track((e.target as HTMLElement).closest('a')));

    input.addEventListener('focus', load);
    // load() too: text can arrive without a focus event first (autofill, a
    // restored value on back-navigation), and then nothing ever fetched.
    input.addEventListener('input', () => { load(); render(input.value); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const first = panel.querySelector('a') as HTMLAnchorElement | null;
        if (first) { track(first); window.location.href = first.href; }
      } else if (e.key === 'Escape') { panel.hidden = true; }
    });
    document.addEventListener('click', (e) => {
      if (!box.contains(e.target as Node)) panel.hidden = true;
    });
  });
</script>
