---
// /methodology (+ /[lang]/methodology), owner's mock-up "데이터 산출 방식
// 개선안" (2026-10-01). The prose is the staticPages markdown and its four
// translations, untouched, cut at each <h2>; the page adds what the mock-up
// adds around it: a "data sources at a glance" card that jumps to each
// section, a contents rail, a before/after toggle showing how a chart is
// fitted to opening hours (an illustration, labelled as one), the venue
// rules as three cards, and a citation builder.
import { render, getCollection } from 'astro:content';
import { createHash } from 'node:crypto';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutNav from './AboutNav.astro';
import { localizePath, useTranslations, type Lang } from '../i18n/utils';
import { formatHour } from '../lib/hours.mjs';

interface Props { entry: any; translation: any; lang: Lang }
const { entry, translation, lang } = Astro.props;
const t = useTranslations(lang);
const src = translation ?? entry;
const d = src.data;
let html: string = src.rendered?.html ?? '';
if (!html) { const r = await render(src); html = (r as any).rendered?.html ?? ''; }
const firstH2 = html.search(/<h2[\s>]/);
const intro = firstH2 >= 0 ? html.slice(0, firstH2) : html;
const IDS = ['crowd', 'venues', 'climate', 'itineraries', 'photos', 'editor', 'cite'];
const sections = [...(firstH2 >= 0 ? html.slice(firstH2) : '').matchAll(/<h2[^>]*>([\s\S]*?)<\/h2>([\s\S]*?)(?=<h2[\s>]|$)/g)]
  .map((m, i) => ({ i, title: m[1].replace(/<[^>]+>/g, '').trim(), body: m[2], id: IDS[i] ?? `s${i}` }));
const byId = Object.fromEntries(sections.map((s) => [s.id, s]));

// A real, credited photo for the photos section: the most-reviewed attraction
// with a built wall thumbnail.
const wallHash = (s: string) => createHash('sha1').update(s).digest('hex').slice(0, 16);
const WALL_DIR = fileURLToPath(new URL('../../public/wall/', import.meta.url));
const posts = await getCollection('posts', ({ data }) => !data.draft && data.category === 'attraction' && ['wikimedia', 'openverse-cc'].includes(data.heroImage?.license ?? ''));
const translated = lang === 'en' ? null : new Set((await getCollection('postI18n')).map((e) => e.id).filter((id) => id.startsWith(`${lang}/`)).map((id) => id.slice(lang.length + 1)));
const photo = posts
  .filter((p) => !translated || translated.has(p.id))
  .sort((a, b) => (b.data.place?.userRatingsTotal ?? 0) - (a.data.place?.userRatingsTotal ?? 0))
  .map((p) => ({ src: `/wall/${wallHash(p.data.heroImage!.url)}.webp`, file: `${wallHash(p.data.heroImage!.url)}.webp`, credit: p.data.heroImage!.credit ?? '', href: localizePath(`/posts/${p.id}`, lang) }))
  .find((p) => existsSync(WALL_DIR + p.file));

const ICON: Record<string, string> = {
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  pin: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
  sun: '<path d="M12 2v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="M20 12h2"/><path d="m19.07 4.93-1.41 1.41"/><path d="M15.947 12.65a4 4 0 0 0-5.925-4.128"/><path d="M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z"/>',
  calendar: '<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>',
  image: '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>',
  route: '<circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/>',
  quote: '<path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/>',
  bulb: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  copy: '<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
};
const svg = (n: string, s = 18) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[n] ?? ''}</svg>`;

type Src = [string, string, string, string, string]; // icon, title, from, badge, anchor
const L = {
  en: {
    pill: 'Methodology', accent: 'Every number has a source', citeCta: 'How to cite', policy: 'Editorial policy →', glance: 'Data sources at a glance', toc: 'On this page',
    sources: [['users', 'Crowd levels', 'BestTime.app measured foot traffic', 'Rolling refresh', 'crowd'], ['pin', 'Hours & ratings', 'Commercial venue databases, official sources', '≈ quarterly', 'venues'], ['sun', 'Temperature & rain', 'NASA POWER weather archive', '10 years', 'climate'], ['calendar', 'Public holidays', 'National holiday calendars', 'Twice a year', 'climate'], ['image', 'Photos', 'Licensed & open sources', 'Credited', 'photos']] as Src[],
    chartT: 'Every chart is fitted to real opening hours', chartSub: 'Illustration · a museum open 10 AM–6 PM', before: 'Before', after: 'After',
    shown: 'Shown as the quietest hour', okAfter: 'Right after opening — genuinely quiet', badBefore: 'Before opening — empty because it is shut',
    legend: ['Quiet', 'Moderate', 'Busy', 'Outside opening hours'], venueRule: 'The rules', climateTool: 'When-to-go tool →', holidayTool: 'Holiday overlap calendar →', itinLink: 'See the itineraries →',
    photoNote: 'A wrong photo never ships', editorLink: 'Editorial policy →', urlLbl: 'Page to cite', asText: 'As text', asHtml: 'Link HTML', copy: 'Copy', copied: 'Copied ✓',
