    legend: ['한산', '보통', '붐빔', '영업시간 외'], venueRule: '기준', climateTool: '언제 갈까 도구 →', holidayTool: '아시아 휴일 겹침 달력 →', itinLink: '추천 일정 보기 →',
    photoNote: '잘못된 사진은 절대 나가지 않아요', editorLink: '편집 원칙 보기 →', urlLbl: '인용할 페이지 주소', asText: '문장으로', asHtml: '링크 HTML', copy: '복사하기', copied: '복사했어요 ✓',
    citeText: (url: string) => `출처: Wander Atlas, ${url}`, pressQ: '언론 문의나 데이터 관련 질문이 있으신가요?', contact: '문의하기 →',
    more: [['편집 원칙 →', 'AI는 어디까지 돕고, 누가 검수하나요', '/about'], ['한산한 시간 찾기 →', '이 데이터로 만든 혼잡도 도구', '/tools/best-time'], ['문의하기 →', '정정 제보, 언론·데이터 문의', '/contact']],
  },
  ja: {
    pill: '調査方法', accent: 'すべての数字に出典があります', citeCta: '引用のしかた', policy: '編集方針 →', glance: 'データの出典が一目でわかる', toc: 'このページの内容',
    sources: [['users', '混雑度', 'BestTime.app の実測人流', '順次更新', 'crowd'], ['pin', '営業時間・評価', '商用スポットDB・公式情報源', '約四半期ごと', 'venues'], ['sun', '気温・降水量', 'NASA POWER の気象記録', '10年分', 'climate'], ['calendar', '祝日', '各国の祝日カレンダー', '年2回', 'climate'], ['image', '写真', 'ライセンス・公開の出典', '出典明記', 'photos']] as Src[],
    chartT: 'すべてのチャートを実際の営業時間に合わせて補正します', chartSub: '例 · 午前10時〜午後6時に開く博物館', before: '補正前', after: '補正後',
    shown: 'いちばん空いていると表示される時間', okAfter: '開館直後、本当に空いている時間', badBefore: '開館前なので誰もいない時間',
    legend: ['空いている', '普通', '混雑', '営業時間外'], venueRule: '基準', climateTool: 'いつ行くかツール →', holidayTool: 'アジアの休日重なりカレンダー →', itinLink: 'おすすめ日程を見る →',
    photoNote: '間違った写真は絶対に出しません', editorLink: '編集方針を見る →', urlLbl: '引用するページのURL', asText: '文章で', asHtml: 'リンクHTML', copy: 'コピー', copied: 'コピーしました ✓',
    citeText: (url: string) => `出典: Wander Atlas, ${url}`, pressQ: '取材やデータに関するご質問は？', contact: 'お問い合わせ →',
    more: [['編集方針 →', 'AIはどこまで手伝い、誰が確認するか', '/about'], ['空いている時間を探す →', 'このデータでつくった混雑度ツール', '/tools/best-time'], ['お問い合わせ →', '訂正、取材・データのお問い合わせ', '/contact']],
  },
  es: {
    pill: 'Metodología', accent: 'Cada número tiene una fuente', citeCta: 'Cómo citarnos', policy: 'Política editorial →', glance: 'Las fuentes de un vistazo', toc: 'En esta página',
    sources: [['users', 'Afluencia', 'Tráfico medido por BestTime.app', 'Actualización continua', 'crowd'], ['pin', 'Horarios y valoraciones', 'Bases comerciales y fuentes oficiales', '≈ cada trimestre', 'venues'], ['sun', 'Temperatura y lluvia', 'Archivo meteorológico NASA POWER', '10 años', 'climate'], ['calendar', 'Festivos', 'Calendarios nacionales', '2 veces al año', 'climate'], ['image', 'Fotos', 'Fuentes con licencia o abiertas', 'Con crédito', 'photos']] as Src[],
    chartT: 'Cada gráfico se ajusta al horario real', chartSub: 'Ilustración · un museo abierto de 10:00 a 18:00', before: 'Antes', after: 'Después',
    shown: 'Mostrada como la hora más tranquila', okAfter: 'Justo al abrir: tranquilo de verdad', badBefore: 'Antes de abrir: vacío porque está cerrado',
    legend: ['Tranquilo', 'Normal', 'Lleno', 'Fuera de horario'], venueRule: 'Las reglas', climateTool: 'Herramienta Cuándo ir →', holidayTool: 'Calendario de festivos que coinciden →', itinLink: 'Ver los itinerarios →',
    photoNote: 'Nunca se publica una foto equivocada', editorLink: 'Política editorial →', urlLbl: 'Página que quieres citar', asText: 'Como texto', asHtml: 'HTML del enlace', copy: 'Copiar', copied: 'Copiado ✓',
    citeText: (url: string) => `Fuente: Wander Atlas, ${url}`, pressQ: '¿Preguntas de prensa o sobre los datos?', contact: 'Contacto →',
    more: [['Política editorial →', 'Hasta dónde ayuda la IA y quién revisa', '/about'], ['Horas tranquilas →', 'La herramienta hecha con estos datos', '/tools/best-time'], ['Contacto →', 'Correcciones, prensa y datos', '/contact']],
  },
  zh: {
    pill: '研究方法', accent: '每个数字都有出处', citeCta: '如何引用', policy: '编辑原则 →', glance: '数据来源一览', toc: '本页内容',
    sources: [['users', '拥挤度', 'BestTime.app 实测人流', '滚动更新', 'crowd'], ['pin', '营业时间 · 评分', '商业地点数据库 · 官方来源', '约每季度一次', 'venues'], ['sun', '气温 · 降水', 'NASA POWER 气象档案', '10 年数据', 'climate'], ['calendar', '公共假期', '各国假期日历', '每年 2 次', 'climate'], ['image', '照片', '有授权或公开的来源', '注明出处', 'photos']] as Src[],
    chartT: '每张图表都按实际营业时间校正', chartSub: '示例 · 上午 10 点至下午 6 点开放的博物馆', before: '校正前', after: '校正后',
    shown: '显示为最空闲的时段', okAfter: '刚开门，真正空闲的时段', badBefore: '还没开门，所以空无一人',
    legend: ['空闲', '一般', '拥挤', '非营业时间'], venueRule: '标准', climateTool: '何时去工具 →', holidayTool: '亚洲假期重叠日历 →', itinLink: '查看推荐行程 →',
    photoNote: '错误的照片绝不会发布', editorLink: '查看编辑原则 →', urlLbl: '要引用的页面地址', asText: '文字', asHtml: '链接 HTML', copy: '复制', copied: '已复制 ✓',
    citeText: (url: string) => `来源：Wander Atlas，${url}`, pressQ: '有媒体或数据方面的问题？', contact: '联系我们 →',
    more: [['编辑原则 →', 'AI 帮到哪一步，谁来审核', '/about'], ['寻找空闲时段 →', '用这些数据做成的拥挤度工具', '/tools/best-time'], ['联系我们 →', '更正、媒体与数据咨询', '/contact']],
  },
} as const;
const T = L[lang];
const hr = (h: number) => formatHour(h, { am: t('post.am'), pm: t('post.pm'), lang });
// Illustration (labelled as one): raw forecast vs the same day clipped to a
// 10:00–18:00 opening. q quiet · m moderate · b busy · x outside opening hours.
const HOURS = Array.from({ length: 16 }, (_, i) => i + 7);
const RAW = 'qqqqmbbbmmqqqqqq';
const FIT = 'xxxqmbbbmmqxxxxx';
const pageAbs = (p: string) => new URL(localizePath(p, lang), Astro.site ?? 'https://wanderatlasguides.com').href;
---
<BaseLayout title={d.metaTitle} description={d.metaDescription} localized={true}>
  <div class="mt">
    <AboutNav lang={lang} current="methodology" />

    <div class="mt-hero">
      <div>
        <span class="mt-pill">{T.pill}</span>
        <h1><span>{d.h1}</span><em>{T.accent}</em></h1>
        <div class="mt-dek" set:html={intro} />
        {d.lastUpdated && <p class="mt-upd">{t('static.lastUpdated').replace('{date}', d.lastUpdated)}</p>}
        <div class="mt-ctas">
          <a class="mt-btn mt-btn-cta" href="#cite">{T.citeCta}</a>
          <a class="mt-btn mt-btn-ghost" href={localizePath('/about', lang)}>{T.policy}</a>
        </div>
      </div>
      <aside class="mt-glance">
        <p>{T.glance}</p>
        <ul>
          {T.sources.map(([ico, title, from, badge, anchor]) => (
            <li><a href={`#${anchor}`}><i><Fragment set:html={svg(ico, 16)} /></i><span><b>{title}</b><small>{from}</small></span><em>{badge}</em></a></li>
          ))}
        </ul>
      </aside>
    </div>

    <div class="mt-grid">
      <nav class="mt-toc" aria-label={T.toc}>
        <p>{T.toc}</p>
        <ol>{sections.map((s) => <li><a href={`#${s.id}`} data-toc={s.id}>{s.title}</a></li>)}</ol>
      </nav>
      <div class="mt-body">
        {byId.crowd && (
          <section class="mt-sec" id="crowd">
            <h2><i><Fragment set:html={svg('users')} /></i>{byId.crowd.title}</h2>
            <div class="prose mt-crowd" set:html={byId.crowd.body} />
            <div class="mt-fit" data-fit data-mode="after">
              <div class="mt-fit-head">
                <div><b>{T.chartT}</b><small>{T.chartSub}</small></div>
                <div class="mt-seg" role="group">
                  <button type="button" data-fit-mode="before" aria-pressed="false">{T.before}</button>
                  <button type="button" data-fit-mode="after" aria-pressed="true" class="is-on">{T.after}</button>
                </div>
              </div>
              <div class="mt-cells" data-raw={RAW} data-fit-cells={FIT} aria-hidden="true">
                {HOURS.map((h, i) => <i class:list={[`c-${FIT[i]}`, { 'is-pick': h === 10 }]}></i>)}
              </div>
              <div class="mt-axis" aria-hidden="true"><span>{hr(7)}</span><span>{hr(12)}</span><span>{hr(17)}</span><span>{hr(22)}</span></div>
              <div class="mt-shown">
                <span>{T.shown}</span>
                <b data-fit-hour data-before={hr(7)} data-after={hr(10)}>{hr(10)}</b>
                <em class="is-ok" data-fit-verdict data-ok={T.okAfter} data-bad={T.badBefore}><Fragment set:html={svg('check', 13)} /><span>{T.okAfter}</span></em>
              </div>
              <p class="mt-legend"><span><i class="c-q"></i>{T.legend[0]}</span><span><i class="c-m"></i>{T.legend[1]}</span><span><i class="c-b"></i>{T.legend[2]}</span><span><i class="c-x"></i>{T.legend[3]}</span></p>
            </div>
          </section>
        )}
        {byId.venues && (
          <section class="mt-sec" id="venues">
            <h2><i class="is-peach"><Fragment set:html={svg('pin')} /></i>{byId.venues.title}</h2>
            <div class="prose mt-rules" set:html={byId.venues.body} />
          </section>
        )}
        {byId.climate && (
          <section class="mt-sec" id="climate">
            <h2><i><Fragment set:html={svg('sun')} /></i>{byId.climate.title}</h2>
            <div class="prose mt-card is-green" set:html={byId.climate.body} />
            <p class="mt-links"><a href={localizePath('/tools/when-to-go', lang)}>{T.climateTool}</a><a href={localizePath('/tools/holiday-overlap', lang)}>{T.holidayTool}</a></p>
          </section>
        )}
        {byId.itineraries && (
          <section class="mt-sec" id="itineraries">
            <h2><i><Fragment set:html={svg('route')} /></i>{byId.itineraries.title}</h2>
            <div class="prose mt-card" set:html={byId.itineraries.body} />
            <p class="mt-links"><a href={localizePath('/itinerary', lang)}>{T.itinLink}</a></p>
          </section>
        )}
        {byId.photos && (
          <section class="mt-sec" id="photos">
            <h2><i class="is-peach"><Fragment set:html={svg('image')} /></i>{byId.photos.title}</h2>
            <div class="mt-photo-row">
              <div class="prose" set:html={byId.photos.body} />
              {photo && (
                <a class="mt-photo" href={photo.href}>
                  <img src={photo.src} alt="" loading="lazy" width="320" height="400" />
                  <span>{T.photoNote}</span>
                  <small>{photo.credit}</small>
                </a>
              )}
            </div>
          </section>
        )}
        {byId.editor && (
          <section class="mt-sec mt-editor" id="editor">
            <span class="mt-avatar" aria-hidden="true">P</span>
            <div><h2>{byId.editor.title}</h2><div class="prose" set:html={byId.editor.body} /></div>
            <a class="mt-btn mt-btn-ghost" href={localizePath('/about', lang)}>{T.editorLink}</a>
          </section>
        )}
        {byId.cite && (
          <section class="mt-sec mt-cite" id="cite">
            <h2><i><Fragment set:html={svg('quote')} /></i>{byId.cite.title}</h2>
            <div class="prose" set:html={byId.cite.body} />
            <div class="mt-tool" data-cite-tool data-copy={T.copy} data-copied={T.copied} data-tpl={T.citeText('{url}')}>
              <label><span>{T.urlLbl}</span><input type="url" value={pageAbs('/methodology')} data-cite-url /></label>
              <div class="mt-tool-row">
                <div class="mt-seg" role="group">
                  <button type="button" class="is-on" aria-pressed="true" data-cite-mode="text">{T.asText}</button>
                  <button type="button" aria-pressed="false" data-cite-mode="html">{T.asHtml}</button>
                </div>
                <button type="button" class="mt-btn mt-btn-cta mt-sm" data-cite-copy><Fragment set:html={svg('copy', 14)} /><span>{T.copy}</span></button>
              </div>
              <output data-cite-out>{T.citeText(pageAbs('/methodology'))}</output>
            </div>
            <p class="mt-press"><span>{T.pressQ}</span><a class="mt-btn mt-btn-ghost mt-sm" href={localizePath('/contact', lang)}>{T.contact}</a></p>
          </section>
        )}
      </div>
    </div>

    <div class="mt-more">
      {T.more.map(([title, sub, href]) => <a href={localizePath(href, lang)}><b>{title}</b><span>{sub}</span></a>)}
    </div>
  </div>
</BaseLayout>

<script>
  // Before/after: the same day, raw vs clipped to opening hours.
  document.querySelectorAll<HTMLElement>('[data-fit]').forEach((box) => {
    const cells = box.querySelector<HTMLElement>('.mt-cells')!;
    const hour = box.querySelector<HTMLElement>('[data-fit-hour]')!;
    const verdict = box.querySelector<HTMLElement>('[data-fit-verdict]')!;
    box.querySelectorAll<HTMLButtonElement>('[data-fit-mode]').forEach((b) => b.addEventListener('click', () => {
      const before = b.dataset.fitMode === 'before';
      box.querySelectorAll('[data-fit-mode]').forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      const pat = before ? cells.dataset.raw! : cells.dataset.fitCells!;
      cells.querySelectorAll('i').forEach((c, i) => { c.className = `c-${pat[i]}`; if (i === (before ? 0 : 3)) c.classList.add('is-pick'); });
      hour.textContent = before ? hour.dataset.before! : hour.dataset.after!;
      verdict.className = before ? 'is-bad' : 'is-ok';
      verdict.querySelector('span')!.textContent = before ? verdict.dataset.bad! : verdict.dataset.ok!;
      verdict.querySelector('svg')!.innerHTML = before ? '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>' : '<path d="M20 6 9 17l-5-5"/>';
    }));
  });

  // Contents rail: mark the section being read.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.mt-toc [data-toc]')];
  const secs = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
  if ('IntersectionObserver' in window && secs.length) {
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) links.forEach((a) => a.classList.toggle('is-on', a.dataset.toc === e.target.id));
    }, { rootMargin: '-30% 0px -60% 0px' });
    secs.forEach((s) => io.observe(s));
  }

  // Citation builder: any page URL → a sentence or a link, one click to copy.
  document.querySelectorAll<HTMLElement>('[data-cite-tool]').forEach((tool) => {
    const url = tool.querySelector<HTMLInputElement>('[data-cite-url]')!;
    const out = tool.querySelector<HTMLOutputElement>('[data-cite-out]')!;
    let mode = 'text';
    const draw = () => {
      const u = url.value.trim();
      const safe = u.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      out.textContent = mode === 'html' ? `<a href="${safe}">Wander Atlas</a>` : tool.dataset.tpl!.replace('{url}', u);
    };
    url.addEventListener('input', draw);
    tool.querySelectorAll<HTMLButtonElement>('[data-cite-mode]').forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.citeMode || 'text';
      tool.querySelectorAll('[data-cite-mode]').forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      tool.classList.toggle('is-html', mode === 'html');
      draw();
    }));
    const copy = tool.querySelector<HTMLButtonElement>('[data-cite-copy]')!;
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(out.textContent || ''); }
      catch {
        const r = document.createRange(); r.selectNodeContents(out);
        const s = getSelection(); s?.removeAllRanges(); s?.addRange(r);
        return;
      }
      const label = copy.querySelector('span')!;
      label.textContent = tool.dataset.copied!;
      setTimeout(() => { label.textContent = tool.dataset.copy!; }, 2000);
    });
  });
</script>

