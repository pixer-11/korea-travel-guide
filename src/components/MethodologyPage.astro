    sources: [['users', '혼잡도', 'BestTime.app 실측 유동인구', '순차 갱신', 'crowd'], ['pin', '영업시간·평점', '상업용 장소 DB·공식 출처', '약 분기 1회', 'venues'], ['sun', '기온·강수량', 'NASA POWER 기상 기록', '10년치', 'climate'], ['calendar', '공휴일', '각국 공휴일 달력', '연 2회', 'climate'], ['image', '사진', '라이선스·공개 출처', '출처 표기', 'photos']] as Src[],
