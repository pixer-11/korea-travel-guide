---
// The list half of both events hubs (/events/ and /events/<country>/), shared
// so the two cannot drift. Redesign 2026-09-24:
//
//   - filter chips by derived category (lib/eventCategory.mjs) — client-side
//     show/hide only; every event stays in the HTML, so crawlers and readers
//     without JavaScript still get every link;
//   - "On now" as cards with how much of the run has passed and days left;
//   - each future month as compact rows: weekday + day | name + dates |
//     city · country | category;
//   - past events folded, as the global hub already was.
//
// The grouping (now / month / date TBA) is still groupUpcomingEvents, and the
// month heading is still the bare <h2 class="kicker">{month}</h2> that
// scripts/audit-rendered-pages.mjs reads for PAST-MONTH-HEAD — the count lives
// in a sibling span so the audit keeps seeing the label on its own.
import Flag from './Flag.astro';
import { groupUpcomingEvents } from '../lib/eventGroups.mjs';
import { eventCategory } from '../lib/eventCategory.mjs';
import { eventShortName } from '../lib/eventShortName.mjs';
import { fmtEventRange } from '../lib/eventDates.mjs';
import { useTranslations, localizePath, localeCodes, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { evStrings } from '../i18n/events-strings';
import { tileSize } from '../lib/repImage';

interface CountryLink { name: string; slug: string; flag: string; up: number }
interface Props {
  lang: Lang;
  upcoming: any[];
  past: any[];
  // Card helpers from i18n/cards (localized title + href).
  card: { title: (id: string, en: string) => string; href: (id: string) => string };
  // Localized titles by post id; present only when this language has one.
  trTitles: Map<string, { title: string }>;
  countryLinks?: CountryLink[];
  today: Date;
  // The "flights and rooms go first" band after the first month (global hub).
  flights?: boolean;
}
const { lang, upcoming, past, card, trTitles, countryLinks = [], today, flights = false } = Astro.props as Props;
const t = useTranslations(lang);
const e = evStrings(lang);
const locale = localeCodes[lang];

const CAT_KEY = {
  concerts: 'catConcerts', sports: 'catSports', festivals: 'catFestivals',
  exhibitions: 'catExhibitions', other: 'catOther',
} as const;
type Cat = keyof typeof CAT_KEY;
const catOf = (p: any): Cat => eventCategory(p.data) as Cat;

// Chip order is fixed; a chip is shown only when this page has an upcoming
// event under it, so "Other" (and, on a small country hub, anything else)
// appears only when it would not lead to an empty list.
const catCounts = new Map<Cat, number>();
for (const p of upcoming) catCounts.set(catOf(p), (catCounts.get(catOf(p)) ?? 0) + 1);
const chips = (Object.keys(CAT_KEY) as Cat[]).filter((c) => (catCounts.get(c) ?? 0) > 0);

// Short display name in the page's language. A translated title is shortened
// with that language's rules; an untranslated post keeps the English rules
// (the card already falls back to the English title today).
const nameOf = (p: any) => {
  const tr = trTitles.get(p.id);
  return tr ? eventShortName(tr.title, lang) : eventShortName(p.data.title, 'en');
};
// "Singapore · Singapore" / "Hong Kong · Hong Kong" says one place twice.
const whereOf = (p: any) => {
  const city = localizePlace(p.data.region, lang);
  const ctry = localizePlace(p.data.country ?? 'South Korea', lang);
  return !city || city === ctry ? ctry : `${city} · ${ctry}`;
};
const whenOf = (p: any) => fmtEventRange(p.data.eventStartDate, p.data.eventEndDate, locale);
const countLabel = (n: number) => (n === 1 ? e('countOne') : e('count', { n }));

// Day arithmetic on calendar dates. Event dates are stored as date-only ISO
// strings (UTC midnight), so the UTC day number IS the event's day.
const DAY = 86_400_000;
const dayNum = (d: any) => Math.floor(new Date(d).getTime() / DAY);
const todayNum = Math.floor(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()) / DAY);
const iso = (d: any) => (d ? new Date(d).toISOString().slice(0, 10) : '');

// Build-time progress; the script below recomputes it from the READER's date,
// since the page is built once a day and read in every time zone.
function runState(p: any) {
  if (!p.data.eventStartDate || !p.data.eventEndDate) return null;
  const s = dayNum(p.data.eventStartDate);
  const en = dayNum(p.data.eventEndDate);
  if (Number.isNaN(s) || Number.isNaN(en) || en < s) return null;
  const total = en - s + 1;
  const passed = Math.min(Math.max(todayNum - s, 0), total);
  const left = en - todayNum;
  const label = left < 0 ? e('ended') : left === 0 ? e('lastDay') : left === 1 ? e('dayLeft') : e('daysLeft', { n: left });
  return { pct: Math.round((passed / total) * 100), label };
}

const wdFmt = new Intl.DateTimeFormat(locale, { weekday: 'short', timeZone: 'UTC' });
const monFmt = new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' });
function badge(p: any, withMonth = false) {
  const raw = p.data.eventStartDate;
  const d = raw ? new Date(raw) : null;
  if (!d || Number.isNaN(d.getTime())) return null;
  return { top: withMonth ? monFmt.format(d) : wdFmt.format(d), day: d.getUTCDate() };
}

const nowLabel = t('ev.nowOn');
const tbaLabel = t('ev.dateTBA');
const monthLabel = (d: any) =>
  d ? new Date(d).toLocaleDateString(locale, { month: 'long', year: 'numeric' }) : tbaLabel;
const groups = groupUpcomingEvents(upcoming, { now: nowLabel, tba: tbaLabel, month: monthLabel }, today);

// Redesign 2026-09-30 ("이벤트 개선안"): the fourteen "on now" cards became the
// four that close first, with a photo each; the rest fold under them. Each
// month shows eight rows and folds the others. Every event is still a link in
// the HTML either way — a fold is <details>, not a script — so crawlers and
// readers without JavaScript lose nothing.
const nowItems = groups.find(([l]) => l === nowLabel)?.[1] ?? [];
const monthGroups = groups.filter(([l]) => l !== nowLabel);
const endNum = (p: any) => (p.data.eventEndDate ? dayNum(p.data.eventEndDate) : Number.MAX_SAFE_INTEGER);
const nowByEnd = [...nowItems].sort((a, b) => endNum(a) - endNum(b));
const ENDING = 4;
// "Ending soon" is only what closes within two weeks (a months-long show with
// 76 days left is not ending soon, review 2026-09-30); when nothing does, the
// same four cards stand under the plain "on now" heading instead.
const closingSoon = nowByEnd.filter((p) => endNum(p) - todayNum <= 14);
const endingTitle = closingSoon.length ? e('endingTitle') : nowLabel;
const endingCards = (closingSoon.length ? closingSoon : nowByEnd).slice(0, ENDING);
const nowRest = nowByEnd.filter((p) => !endingCards.includes(p));
const CAP = 8;

// A real photo where the guide has one (the same 640px WebP the home wall
// serves from our own domain); no photo, no image — never a stand-in.
const photoOf = (p: any) => {
  const h = p.data.heroImage;
  if (!h?.url || h.license === 'placeholder') return null;
  return { src: tileSize(h.url), pos: h.focus ? `${h.focus.x}% ${h.focus.y}%` : '50% 50%' };
};

const shortMonth = new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' });
// A month is keyed by its date ("2026-10"), not its position, so a shared
// #m= link still means the same month after the first one ends.
const monthKey = (label: string, items: any[]) =>
  label === tbaLabel || !items[0]?.data.eventStartDate ? 'tba' : iso(items[0].data.eventStartDate).slice(0, 7);
const tabs = monthGroups.map(([label, items]) => ({
  key: monthKey(label, items), n: items.length,
  label: label === tbaLabel ? tbaLabel : items[0]?.data.eventStartDate ? shortMonth.format(new Date(items[0].data.eventStartDate)) : label,
}));
const upcomingInMonths = monthGroups.reduce((s, [, items]) => s + items.length, 0);
// The chips filter the month lists only, so they are counted there: counting
// the on-now cards too showed a "Festivals 0" chip that led to an empty list
// under two festivals (review 2026-09-30).
const monthCat = (c: Cat) => monthGroups.reduce((s, [, items]) => s + items.filter((p) => catOf(p) === c).length, 0);
const monthChips = chips.filter((c) => monthCat(c) > 0);

// Handed to the script as data, so the client side never carries English
// fallbacks of its own.
const clientStrings = JSON.stringify({
  count: e('count'), countOne: e('countOne'), daysLeft: e('daysLeft'), dayLeft: e('dayLeft'),
  lastDay: e('lastDay'), ended: e('ended'), progress: e('progress'),
});

const row = (p: any, withBadge = true) => ({ p, cat: catOf(p), b: withBadge ? badge(p) : null });
---

<div class="ev-list" data-ev-list data-strings={clientStrings}>
  {endingCards.length > 0 && (
    <section class="section ev-now">
      <div class="wrap">
        <div class="ev-head">
          <h2 class="ev-h2"><span class="ev-dot" aria-hidden="true"></span>{endingTitle}</h2>
          <span class="ev-count">{e('endingSub', { n: nowItems.length })}</span>
        </div>
        <div class="ev-end-grid">
          {endingCards.map((p) => {
            const cat = catOf(p);
            const st = runState(p);
            const ph = photoOf(p);
            return (
              <a class="ev-end-card" href={card.href(p.id)} data-start={iso(p.data.eventStartDate)} data-end={iso(p.data.eventEndDate)}>
                {ph && <img class="ev-end-img" src={ph.src} alt="" loading="lazy" decoding="async" width="640" height="360" style={`object-position:${ph.pos}`} />}
                <span class="ev-end-body">
                  <span class="ev-end-top">
                    <span class={`ev-tag ev-tag--${cat}`}>{e(CAT_KEY[cat])}</span>
                    {st && <span class="ev-left" data-left>{st.label}</span>}
                  </span>
                  <strong class="ev-name">{nameOf(p)}</strong>
                  <span class="ev-where">{whereOf(p)}</span>
                  {st && (
                    <span class="ev-bar" role="img" aria-label={e('progress', { p: st.pct })} data-bar>
                      <span class="ev-bar-fill" style={`width:${st.pct}%`} data-fill></span>
                    </span>
                  )}
                </span>
              </a>
            );
          })}
        </div>
        {nowRest.length > 0 && (
          <details class="ev-fold ev-fold--now">
            <summary>{e('allNow', { n: nowItems.length })}</summary>
            <ul class="ev-rows">
              {nowRest.map((p) => {
                const cat = catOf(p);
                const st = runState(p);
                return (
                  <li data-start={iso(p.data.eventStartDate)} data-end={iso(p.data.eventEndDate)}>
                    <a class="ev-row" href={card.href(p.id)}>
                      <span class="ev-badge ev-badge--now" aria-hidden="true"><span class="ev-badge-day">●</span></span>
                      <span class="ev-main">
                        <strong class="ev-name">{nameOf(p)}</strong>
                        <span class="ev-when">{whenOf(p)}{st && <> · <span data-left>{st.label}</span></>}</span>
                      </span>
                      <span class="ev-meta">
                        <span class="ev-where">{whereOf(p)}</span>
                        <span class={`ev-tag ev-tag--${cat}`}>{e(CAT_KEY[cat])}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </details>
        )}
      </div>
    </section>
  )}

  {upcomingInMonths > 0 && (tabs.length > 1 || monthChips.length > 1) && (
    <section class="ev-filters">
      <div class="wrap">
        {tabs.length > 1 && (
          <div class="ev-tabs" role="group" aria-label={e('monthsLabel')}>
            <button type="button" class="ev-tab" data-month="all" aria-pressed="true">{e('catAll')} <span class="ev-chip-n">{upcomingInMonths}</span></button>
            {tabs.map((tb) => (
              <button type="button" class="ev-tab" data-month={tb.key} aria-pressed="false">{tb.label} <span class="ev-chip-n">{tb.n}</span></button>
            ))}
          </div>
        )}
        {monthChips.length > 1 && (
          <div class="ev-chips" role="group" aria-label={e('filterLabel')}>
            <button type="button" class="ev-chip" data-filter="all" aria-pressed="true">
              {e('catAll')} <span class="ev-chip-n">{upcomingInMonths}</span>
            </button>
            {monthChips.map((c) => (
              <button type="button" class="ev-chip" data-filter={c} aria-pressed="false">
                {e(CAT_KEY[c])} <span class="ev-chip-n">{monthCat(c)}</span>
              </button>
            ))}
          </div>
        )}
        {countryLinks.length > 1 && (
          <nav class="ev-chips ev-chips--countries" aria-label={e('countriesLabel')}>
            {countryLinks.map((c) => (
              <a class="ev-chip ev-chip--link" href={localizePath(`/events/${c.slug}`, lang)}>
                <Flag code={c.flag} size="1em" class="flag-ico" /> {localizePlace(c.name, lang)}
              </a>
            ))}
          </nav>
        )}
      </div>
    </section>
  )}

  {monthGroups.map(([label, items], gi) => {
    const rows = items.map((p) => row(p, label !== tbaLabel));
    const shown = rows.slice(0, CAP);
    const rest = rows.slice(CAP);
    const li = ({ p, cat, b }: { p: any; cat: Cat; b: any }) => (
      <li data-category={cat} data-start={iso(p.data.eventStartDate)} data-end={iso(p.data.eventEndDate)}>
        <a class="ev-row" href={card.href(p.id)}>
          <span class="ev-badge" aria-hidden="true">
            {b ? (<><span class="ev-badge-top">{b.top}</span><span class="ev-badge-day">{b.day}</span></>) : <span class="ev-badge-day">–</span>}
          </span>
          <span class="ev-main">
            <strong class="ev-name">{nameOf(p)}</strong>
            <span class="ev-when">{whenOf(p) || tbaLabel}</span>
          </span>
          <span class="ev-meta">
            <span class="ev-where">{whereOf(p)}</span>
            <span class={`ev-tag ev-tag--${cat}`}>{e(CAT_KEY[cat])}</span>
          </span>
        </a>
      </li>
    );
    return (
      <>
        <section class="section ev-group" data-ev-group data-month={monthKey(label, items)}>
          <div class="wrap">
            <div class="rule-head ev-head">
              <h2 class="kicker">{label}</h2>
              <span class="ev-count" data-count>{countLabel(items.length)}</span>
            </div>
            <ul class="ev-rows">{shown.map(li)}</ul>
            {rest.length > 0 && (
              <details class="ev-fold" data-ev-more>
                <summary>{e('more', { n: rest.length })}</summary>
                <ul class="ev-rows">{rest.map(li)}</ul>
              </details>
            )}
          </div>
        </section>
        {gi === 0 && flights && (
          <section class="ev-flight-band" data-ev-aside>
            <div class="wrap">
              <div class="ev-flight">
                <span class="ev-flight-ico" aria-hidden="true">✈</span>
                <div class="ev-flight-copy">
                  <strong>{e('flightTitle')}</strong>
                  <span>{e('flightDek')}</span>
                </div>
                <a class="ev-flight-cta" href={localizePath('/flights', lang)}>{e('flightCta')} →</a>
              </div>
            </div>
          </section>
        )}
      </>
    );
  })}

  <section class="section ev-none" data-ev-none hidden>
    <div class="wrap"><div class="fact-box" style="text-align:center"><p>{e('noneInFilter')}</p></div></div>
  </section>

  <slot name="before-past" />

  {past.length > 0 && (
    <section class="section band">
      <div class="wrap">
        {/* Folded by default: 37 ended events rendered as full cards made the
            mobile page 45,000px tall under the 64 upcoming ones (2026-08-22).
            The archive still ships in the HTML (indexable, linkable) — it just
            no longer stands between the reader and the footer. The filters do
            not reach in here: they are about what a reader can still go to. */}
        <details class="past-events" id="past-events">
          <summary class="rule-head"><h2 class="kicker">{t('ev.pastEvents')} ({past.length})</h2></summary>
          <ul class="ev-rows">
            {past.map((p) => {
              const cat = catOf(p);
              const b = badge(p, true);
              return (
                <li>
                  <a class="ev-row" href={card.href(p.id)}>
                    <span class="ev-badge" aria-hidden="true">
                      {b ? (<><span class="ev-badge-top">{b.top}</span><span class="ev-badge-day">{b.day}</span></>) : <span class="ev-badge-day">–</span>}
                    </span>
                    <span class="ev-main">
                      <strong class="ev-name">{nameOf(p)}</strong>
                      <span class="ev-when">{whenOf(p)}</span>
                    </span>
                    <span class="ev-meta">
                      <span class="ev-where">{whereOf(p)}</span>
                      <span class={`ev-tag ev-tag--${cat}`}>{e(CAT_KEY[cat])}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      </div>
    </section>
  )}
</div>

<script>
  // Progressive: without this script every event is still a link on the page
  // and the "days left" is as of the morning's build.
  const DAY = 86_400_000;
  const fill = (s: string, n: number | string, key = 'n') => s.split(`{${key}}`).join(String(n));

  for (const root of document.querySelectorAll<HTMLElement>('[data-ev-list]')) {
    let S: Record<string, string> = {};
    try { S = JSON.parse(root.dataset.strings || '{}'); } catch { /* keep build-time text */ }

    // 1. "On now" progress from the reader's own calendar date.
    const now = new Date();
    const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / DAY;
    for (const el of root.querySelectorAll<HTMLElement>('.ev-now [data-start][data-end]')) {
      const s = Date.parse(el.dataset.start || '') / DAY;
      const e = Date.parse(el.dataset.end || '') / DAY;
      if (!Number.isFinite(s) || !Number.isFinite(e) || e < s) continue;
      const total = e - s + 1;
      const passed = Math.min(Math.max(today - s, 0), total);
      const pct = Math.round((passed / total) * 100);
      const left = e - today;
      const fillEl = el.querySelector<HTMLElement>('[data-fill]');
      const bar = el.querySelector<HTMLElement>('[data-bar]');
      const leftEl = el.querySelector<HTMLElement>('[data-left]');
      if (fillEl) fillEl.style.width = `${pct}%`;
      if (bar && S.progress) bar.setAttribute('aria-label', fill(S.progress, pct, 'p'));
      if (leftEl) {
        const text = left < 0 ? S.ended : left === 0 ? S.lastDay : left === 1 ? S.dayLeft : S.daysLeft && fill(S.daysLeft, left);
        if (text) leftEl.textContent = text;
      }
    }

    // 2. Month tabs × category chips: show/hide rows, recount each month,
    //    hide empty months, and open the folds while a filter is on (a
    //    filtered list is short; hiding half of it again would confuse).
    const chips = [...root.querySelectorAll<HTMLButtonElement>('button[data-filter]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('button[data-month]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-ev-group]')];
    const asides = [...root.querySelectorAll<HTMLElement>('[data-ev-aside]')];
    const none = root.querySelector<HTMLElement>('[data-ev-none]');
    const state = { cat: 'all', month: 'all' };
    let wasFiltered = false;
    const apply = () => {
      for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.filter === state.cat));
      for (const t of tabs) t.setAttribute('aria-pressed', String(t.dataset.month === state.month));
      const filtered = state.cat !== 'all' || state.month !== 'all';
      let shown = 0;
      for (const g of groups) {
        const monthOn = state.month === 'all' || g.dataset.month === state.month;
        let n = 0;
        for (const item of g.querySelectorAll<HTMLElement>('[data-category]')) {
          const on = monthOn && (state.cat === 'all' || item.dataset.category === state.cat);
          item.hidden = !on;
          if (on) n++;
        }
        g.hidden = n === 0;
        shown += n;
        // Open the folds while a filter is on; close them only when a filter
        // is taken off — never a fold the reader opened by hand.
        if (filtered || wasFiltered) for (const d of g.querySelectorAll<HTMLDetailsElement>('[data-ev-more]')) d.open = filtered;
        const countEl = g.querySelector<HTMLElement>('[data-count]');
        if (countEl && S.count) countEl.textContent = n === 1 ? S.countOne : fill(S.count, n);
      }
      for (const a of asides) a.hidden = filtered;
      wasFiltered = filtered;
      if (none) none.hidden = shown > 0;
    };
    // The choice lives in the address (#cat=festivals&m=1), so a shared link
    // or the back button keeps it (2026-09-24 usability pass).
    const validCat = new Set(chips.map((c) => c.dataset.filter || 'all'));
    const validMonth = new Set(tabs.map((t) => t.dataset.month || 'all'));
    const fromHash = () => {
      const c = /(?:^|[#&])cat=([a-z-]+)/.exec(location.hash)?.[1];
      const m = /(?:^|[#&])m=(\d{4}-\d{2}|tba)/.exec(location.hash)?.[1];
      state.cat = c && validCat.has(c) ? c : 'all';
      state.month = m && validMonth.has(m) ? m : 'all';
    };
    const toHash = () => {
      const parts = [state.cat !== 'all' && `cat=${state.cat}`, state.month !== 'all' && `m=${state.month}`].filter(Boolean);
      history.replaceState(null, '', parts.length ? `#${parts.join('&')}` : location.pathname + location.search);
    };
    for (const c of chips) c.addEventListener('click', () => { state.cat = c.dataset.filter || 'all'; apply(); toHash(); });
    for (const t of tabs) t.addEventListener('click', () => { state.month = t.dataset.month || 'all'; apply(); toHash(); });
    fromHash();
    if (state.cat !== 'all' || state.month !== 'all') apply();
    addEventListener('hashchange', () => {
      const before = state.cat + state.month;
      fromHash();
      if (state.cat + state.month !== before) apply();
    });

    // 3. A link to #past-events opens the archive it points at.
    const past = root.querySelector<HTMLDetailsElement>('#past-events');
    const openPast = () => { if (past && location.hash === '#past-events') past.open = true; };
    openPast();
    addEventListener('hashchange', openPast);
  }
</script>

<style>
  .ev-list {
    --ev-forest: #3b4a2c; --ev-night: #262d1b; --ev-brown: #6b3413; --ev-rust: #b0562a;
    --ev-peach: #fde3d4; --ev-sand: #ece5d6; --ev-leaf: #e3ecd0;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .ev-list { --ev-peach: #3a2620; --ev-sand: #2a251d; --ev-leaf: #26301c; --ev-rust: #e08a5a; }
  }
  :global(:root[data-theme='dark']) .ev-list { --ev-peach: #3a2620; --ev-sand: #2a251d; --ev-leaf: #26301c; --ev-rust: #e08a5a; }

  .ev-head { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem 1rem; flex-wrap: wrap; }
  /* Section titles were small grey kickers, so "on now" and each month barely
     separated the page (2026-09-24 visual check). */
  .ev-head .kicker, .ev-h2 { font-family: var(--font-display); font-size: clamp(1.35rem, 3.4vw, 1.75rem); font-weight: 800; color: var(--ink); letter-spacing: -0.01em; text-transform: none; margin: 0; }
  .ev-h2 { display: inline-flex; align-items: center; gap: .55rem; }
  .ev-dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--ev-rust); flex: none; }
  .ev-count { color: var(--muted); font-size: .9rem; }

