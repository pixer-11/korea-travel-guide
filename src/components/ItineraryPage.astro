  .ith-book-text { display: flex; flex-direction: column; min-width: 0; }
  .ith-book-text b { font-size: .9rem; color: var(--ink); overflow-wrap: anywhere; }
  .ith-book-text small { font-size: .78rem; color: var(--muted); }
  .ith-book-count { margin: .6rem 0 0; font-size: .78rem; color: var(--muted); text-align: center; }
  .ith-btn { display: block; text-align: center; padding: .65rem 1rem; border-radius: var(--r-pill); background: var(--x-rust); color: #fff; font-weight: 800; font-size: .9rem; text-decoration: none; }
  .ith-btn--dark { background: var(--x-forest); }
  .ith-btn:hover { filter: brightness(1.07); }
  .ith-stay .tp-disclosure { margin: .6rem 0 0; font-size: .72rem; }
