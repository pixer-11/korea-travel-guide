---
// Shared itinerary view for BOTH the English page (/itinerary/<slug>) and the
// localized pages (/ko/itinerary/<slug> etc). One template, same pattern as
// PostArticle.astro. `translation` is an itinerariesI18n entry — it supplies
// PROSE only (day labels/intros, per-stop "why", FAQ, title/description). Every
// HARD FACT shown on a stop card (rating, review count, address, hours, closed
// days, quiet windows, coordinates) is read from the source POST at render
// time — never from the itinerary file, which carries connective prose only.
// A translation is optional and never blocks the build: missing fields fall
// back to the English source, per stop.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from './Newsletter.astro';
import PlanTrip from './PlanTrip.astro';
import Emoji from './Emoji.astro';
import { slugifyRegion } from '../lib/slug';
import { getLangFromUrl, useTranslations, localeCodes, localizePath, klookLocale, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { closedDaysOf } from '../lib/itinerary.mjs';

interface Props {
  itinerary: any; // CollectionEntry<'itineraries'>
  translation?: any; // CollectionEntry<'itinerariesI18n'>
}
const { itinerary, translation } = Astro.props;
const d = itinerary.data;
const tr = translation?.data;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = tr?.title ?? d.title;
const description = tr?.description ?? d.description;
const quickAnswer = tr?.quickAnswer ?? d.quickAnswer;
const faq = (tr?.faq?.length ? tr.faq : d.faq) ?? [];

const regionLabel = localizePlace(d.city, lang);
const countryLabel = localizePlace(d.country, lang);
const countrySlug = String(d.country).toLowerCase().replace(/\s+/g, '-');
const sameRegionCountry = d.city.toLowerCase() === String(d.country).toLowerCase();
const updated = d.updatedDate ?? d.pubDate;

// ---- Resolve every stop's post. Facts NEVER come from the itinerary file. ----
// Loud failure by design: a stop that can't resolve to a live, non-draft post
// would otherwise silently vanish from the page — a wrong itinerary is worse
// than a broken build.
const allPosts = await getCollection('posts');
const postsById = new Map(allPosts.map((p) => [p.id, p]));
function resolveStop(slug: string) {
  const post = postsById.get(slug);
  if (!post) {
    throw new Error(`Itinerary "${itinerary.id}": stop slug "${slug}" has no matching post in the posts collection.`);
  }
  if (post.data.draft) {
    throw new Error(`Itinerary "${itinerary.id}": stop slug "${slug}" resolves to a DRAFT post — refusing to render.`);
  }
  return post;
}

// Same-language post titles/links as PostArticle's postHref/postTitle: a stop
// links to its localized post page only when that translation actually exists,
// otherwise falls back to the English post URL rather than a 404.
// Keep the whole translation entry, not just its title: the transit tip is
// lifted from the post BODY, so an English body here printed English prose on
// every localized itinerary page.
const sameLangPosts =
  lang === 'en'
    ? new Map<string, any>()
    : new Map((await getCollection('postI18n', ({ data }) => data.lang === lang)).map((e) => [e.data.slug, e]));
const sameLangPostTitles = new Map([...sameLangPosts].map(([k, e]) => [k, e.data.title]));

// Does any day hold more stops than the loosest pace keeps? If not, the pace
// radios are decorative (see the filter block below).
const maxStopsPerDay = Math.max(0, ...(d.itinerary ?? []).map((day: any) => (day.stops ?? []).length));
const paceCanChangeSomething = maxStopsPerDay > 3;
const postHref = (id: string) => (sameLangPostTitles.has(id) ? localizePath(`/posts/${id}`, lang) : `/posts/${id}`);
const postTitleFor = (post: any) => sameLangPostTitles.get(post.id) ?? post.data.title;

// Weekday name from Google's "Tuesday: Closed" style string, localized via the
// same Intl formatter used for dates elsewhere — no separate translation table
// needed. 2023-01-01 was a Sunday, so index 0 = Sunday.
const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
function localizedWeekday(name: string): string {
  const idx = WEEKDAYS.indexOf(name);
  if (idx === -1) return name;
  const date = new Date(Date.UTC(2023, 0, 1 + idx));
  return date.toLocaleDateString(localeCodes[lang], { weekday: 'long', timeZone: 'UTC' });
}

// Real foot-traffic hour ranges (same shape as PostArticle's fmtHourRanges),
// restricted to hours that fall inside the stop's own visit slot — never guess.
const SLOT_HOURS: Record<string, [number, number]> = {
  morning: [6, 11],
  lunch: [11, 14],
  afternoon: [14, 17],
  evening: [17, 23],
};
function fmtHourRanges(xs: number[]): string {
  const f = (h: number) => { const x = ((h % 24) + 24) % 24; return { t: x % 12 === 0 ? 12 : x % 12, m: x < 12 ? t('post.am') : t('post.pm') }; };
  const runs: [number, number][] = [];
  let s = xs[0], prev = xs[0];
  for (let i = 1; i < xs.length; i++) { if (xs[i] === prev + 1) { prev = xs[i]; continue; } runs.push([s, prev]); s = xs[i]; prev = xs[i]; }
  runs.push([s, prev]);
  return runs.map(([a, b]) => { const x = f(a), y = f(b + 1); return x.m === y.m ? `${x.t}–${y.t} ${y.m}` : `${x.t} ${x.m}–${y.t} ${y.m}`; }).join(', ');
}
function quietWindowFor(post: any, slot: string): string | null {
  const q = post.data.place?.busyness?.weekdayQuiet;
  if (!Array.isArray(q) || !q.length) return null;
  const [lo, hi] = SLOT_HOURS[slot] ?? [0, 24];
  const hours = [...new Set(q)].filter((h: number) => Number.isInteger(h) && h >= lo && h <= hi).sort((a: number, b: number) => a - b);
  if (!hours.length) return null;
  return fmtHourRanges(hours as number[]);
}

// First line of the post's own (already vetted) body that names a concrete
// transit detail — never invented, always lifted verbatim from the post.
// Latin patterns plus the localized equivalents, so a Korean/Japanese/Chinese
// body yields a tip instead of silently falling through to the English source.
const TRANSIT_RE = /(Line\s*\d|Station|Exit\s*\d|BTS|MRT|호선|출구|[역駅站]|번 출구|地下鉄|地铁|捷運|Estación|Línea\s*\d)/;
function transitTip(post: any): string | null {
  // Prefer the reader's own language; fall back to the English source only when
  // no translation exists for this post.
  const localized = sameLangPosts.get(post.id);
  const body = String(localized?.body || post.body || '');
  const lines = body.split(/\r?\n/).map((l) => l.replace(/^#+\s*/, '').replace(/[*_`]/g, '').trim()).filter(Boolean);
  return lines.find((l) => TRANSIT_RE.test(l)) ?? null;
}

// ---- Client filter data: coarse interest buckets from category + tags/title
// keywords. This powers the "Interests" filter's highlight/dim treatment
// ONLY — a stop never disappears from an interest mismatch, so a loose
// heuristic here can't misinform a reader the way a hard fact (hours,
// rating, distance) would. category:'restaurant' always buckets as food;
// everything else falls back to 'culture' so no stop is ever unmatched.
const FOOD_RE = /food|cuisine|caf[eé]|pizza|dining|bbq|dessert|bakery|noodle|snack/i;
const SHOPPING_RE = /market|shopping|mall|boutique|\bstore\b/i;
const CULTURE_RE = /palace|museum|temple|shrine|heritage|history|\bart\b|gallery|design|craft|traditional|architecture/i;
const NATURE_RE = /\bpark\b|garden|stream|river|mountain|forest|beach|nature|hike|trail|island/i;
const NIGHTLIFE_RE = /\bbar\b|\bclub\b|\bnight\b|\bpub\b|rooftop|newtro/i;
function interestCatsFor(post: any): string[] {
  const text = [post.data.title, post.data.category, ...(post.data.tags || [])].join(' ');
  const cats = new Set<string>();
  if (post.data.category === 'restaurant' || FOOD_RE.test(text)) cats.add('food');
  if (SHOPPING_RE.test(text)) cats.add('shopping');
  if (CULTURE_RE.test(text)) cats.add('culture');
  if (NATURE_RE.test(text)) cats.add('nature');
  if (NIGHTLIFE_RE.test(text)) cats.add('nightlife');
  if (!cats.size) cats.add('culture');
  return [...cats];
}

function formatDwell(min: number): string {
  // "min"/"h" are words, not symbols — they have to follow the page language.
  if (min < 60) return `~${min}${t('itin.unitMin')}`;
  const hours = Math.round((min / 60) * 2) / 2;
  const hStr = Number.isInteger(hours) ? String(hours) : hours.toFixed(1);
  return `~${hStr}${t('itin.unitHour')}`;
}

function legText(leg: { km: number; minutes: number; transit: boolean } | null): string | null {
  if (!leg) return null;
  if (leg.transit) return t('itin.legTransit');
  return t('itin.legWalk').replace('{min}', String(leg.minutes)).replace('{km}', String(leg.km));
}

function directionsUrl(a: any, b: any, transit: boolean): string {
  const mode = transit ? 'transit' : 'walking';
  return `https://www.google.com/maps/dir/?api=1&origin=${a.lat},${a.lng}&destination=${b.lat},${b.lng}&travelmode=${mode}`;
}

function dayRouteUrl(posts: any[]): string | null {
  if (posts.length < 2) return null;
  const first = posts[0].data.place, last = posts[posts.length - 1].data.place;
  const mids = posts.slice(1, -1).map((p) => `${p.data.place.lat},${p.data.place.lng}`).join('|');
  return `https://www.google.com/maps/dir/?api=1&origin=${first.lat},${first.lng}&destination=${last.lat},${last.lng}${mids ? `&waypoints=${encodeURIComponent(mids)}` : ''}`;
}

// Same Klook affiliate builder as PlanTrip.astro (aid/pid + locale + city query).
const klookDayHref = `https://affiliate.klook.com/redirect?aid=api%7C13694%7C-754088%7Cpid%7C754088&k_site=${encodeURIComponent(`https://www.klook.com/${klookLocale(lang)}/search/?query=${d.city}`)}`;

// ---- Resolve every day's stops once, up front (throws loudly on any gap). ----
const days = d.itinerary.map((day: any, di: number) => {
  const label = tr?.days?.[di]?.label ?? day.label;
  const intro = tr?.days?.[di]?.intro ?? day.intro;
  const stops = day.stops.map((s: any) => {
    const post = resolveStop(s.slug);
    const why = tr?.whys?.[s.slug] ?? s.why;
    return { ...s, post, why };
  });
  const rainPost = day.rainSwapSlug ? resolveStop(day.rainSwapSlug) : null;
  const rainWhy = day.rainSwapSlug ? (tr?.rainWhys?.[day.rainSwapSlug] ?? rainPost?.data.description ?? null) : null;
  return { label, intro, stops, rainPost, rainWhy };
});

// ---- Structured data: TouristTrip + BreadcrumbList + FAQPage. No aggregateRating
// (same site precedent as PostArticle — the ratings are Google's, not ours). ----
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const allStopPosts = days.flatMap((day) => day.stops.map((s: any) => s.post));

const graph: Record<string, unknown>[] = [
  {
    '@type': 'TouristTrip',
    name: title,
    description,
    itinerary: {
      '@type': 'ItemList',
      itemListElement: allStopPosts.map((post, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'TouristAttraction',
          name: post.data.place?.name || post.data.title,
          url: new URL(postHref(post.id), Astro.site).toString(),
        },
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: t('post.home'), item: `${site}${lang === 'en' ? '/' : `/${lang}/`}` },
      { name: countryLabel, item: `${site}${localizePath(`/destinations/${countrySlug}`, lang)}/` },
      ...(sameRegionCountry ? [] : [{ name: regionLabel, item: `${site}${localizePath(`/regions/${slugifyRegion(d.city)}`, lang)}/` }]),
      { name: title, item: pageUrl },
    ].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })),
  },
];

if (faq.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };

// Which locales this itinerary route exists in — always all 5 (unlike posts,
// every itinerary renders at every locale immediately; missing translations
// fall back to English prose per-field rather than skipping the page).
const availableLangs: Lang[] = ['en', 'ko', 'ja', 'es', 'zh'];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  localized={true}
  localizedLangs={availableLangs}
>
  <article class="article wrap itin-page">
    <nav class="crumbs" aria-label={t('a11y.breadcrumb')}>
      <a href={lang === 'en' ? '/' : `/${lang}/`}>{t('post.home')}</a> <span>/</span>
      <a href={localizePath(`/destinations/${countrySlug}`, lang)}>{countryLabel}</a> <span>/</span>
      {!sameRegionCountry && (
        <><a href={localizePath(`/regions/${slugifyRegion(d.city)}`, lang)}>{regionLabel}</a> <span>/</span></>
      )}
      <span aria-current="page">{t('itin.indexEyebrow')}</span>
    </nav>

    {/* 1. H1 + quickAnswer (answer-first) */}
    <div class="article-head">
      <div class="kicker">
        <span class="badge">{t('itin.badge').replace('{n}', String(d.days))}</span>
        <span>{regionLabel}</span>
      </div>
      <h1>{title}</h1>
    </div>

    {quickAnswer && (
      <aside class="quick-answer">
        <span class="qa-label">{t('post.quickAnswer')}</span>
        <p>{quickAnswer}</p>
      </aside>
    )}

    {/* 2. Trust strip + AI disclosure */}
    <p class="itin-trust">
      ✓ {t('itin.trustStrip').replace('{date}', updated.toLocaleDateString(localeCodes[lang], { year: 'numeric', month: 'long', day: 'numeric' }))}
    </p>
    <details class="disclosure-details">
      <summary>{t('post.disclosureTitle')}</summary>
      <p>{t('post.disclosureBody')} <a href={localizePath('/about', lang)}>{t('post.editorialPolicy')}</a></p>
    </details>

    {/* 3. Filter bar — progressive enhancement, works as plain content without JS.
        Task 7 wires the actual filtering behavior. */}
    <details class="itin-filters" name="itin-filters">
      <summary>{t('itin.filterTitle')}</summary>
      <form
        class="itin-filter-grid"
        data-itin-filters
        data-locale={localeCodes[lang]}
        data-trip-title={title}
        data-page-url={pageUrl}
        data-t-walk-leg={t('itin.legWalk')}
        data-t-transit-leg={t('itin.legTransit')}
        data-t-closed-warning={t('itin.closedOnArrival')}
        data-t-closed-warning-no-swap={t('itin.closedOnArrivalNoSwap')}
        data-t-long-walk={t('itin.longWalkAdvisory')}
        data-t-save-heading={t('itin.savePlanHeading')}
      >
        {/* Pace only ever trims a day's trailing stops (relaxed keeps 3, normal
            keeps 4), so on an itinerary whose busiest day already has 3 stops
            every option renders the identical plan. Showing it there gives the
            reader a control that visibly does nothing — worse than not offering
            it — so it appears only when it can actually change something. */}
        {paceCanChangeSomething && (
          <fieldset>
            <legend>{t('itin.pace')}</legend>
            <label><input type="radio" name="pace" value="relaxed" /> {t('itin.paceRelaxed')}</label>
            <label><input type="radio" name="pace" value="normal" checked /> {t('itin.paceNormal')}</label>
            {d.packedAvailable && (
              <label><input type="radio" name="pace" value="packed" /> {t('itin.pacePacked')}</label>
            )}
          </fieldset>
        )}
        <fieldset>
          <legend>{t('itin.party')}</legend>
          <label><input type="radio" name="party" value="solo" /> {t('itin.partySolo')}</label>
          <label><input type="radio" name="party" value="couple" /> {t('itin.partyCouple')}</label>
          <label><input type="radio" name="party" value="family" /> {t('itin.partyFamily')}</label>
          <label><input type="radio" name="party" value="seniors" /> {t('itin.partySeniors')}</label>
        </fieldset>
        <fieldset>
          <legend>{t('itin.interests')}</legend>
          <label><input type="checkbox" name="interest" value="food" /> {t('itin.interestFood')}</label>
          <label><input type="checkbox" name="interest" value="culture" /> {t('itin.interestCulture')}</label>
          <label><input type="checkbox" name="interest" value="nature" /> {t('itin.interestNature')}</label>
          <label><input type="checkbox" name="interest" value="shopping" /> {t('itin.interestShopping')}</label>
          <label><input type="checkbox" name="interest" value="nightlife" /> {t('itin.interestNightlife')}</label>
        </fieldset>
        <fieldset>
          <legend>{t('itin.arrivalDate')}</legend>
          <label class="sr-only" for="itin-arrival">{t('itin.arrivalDate')}</label>
          <input type="date" name="arrival" id="itin-arrival" />
        </fieldset>
      </form>
      <p class="itin-save-hint" data-itin-save-hint hidden>
        <a href="#newsletter" data-itin-save-link>{t('itin.savePlanHeading')}</a>
      </p>
    </details>

    {/* 4. Sticky day nav */}
    <nav class="itin-day-nav" aria-label={t('itin.indexEyebrow')}>
      {days.map((_, i) => (
        <a href={`#day-${i + 1}`}>{t('itin.day').replace('{n}', String(i + 1))}</a>
      ))}
    </nav>

    {/* 5–7. Per-day sections: label+intro → stop cards → legs → day footer */}
    {days.map((day, di) => (
      <section id={`day-${di + 1}`} class="itin-day" data-has-rain={day.rainPost ? '1' : ''}>
        <h2 class="itin-day-title">
          {t('itin.day').replace('{n}', String(di + 1))}
          <span class="itin-day-date" data-day-date hidden></span> · {day.label}
        </h2>
        <p class="itin-day-intro">{day.intro}</p>

        <ol class="itin-stops">
          {day.stops.map((stop: any, si: number) => {
            const post = stop.post;
            const p = post.data.place ?? {};
            const rating = typeof p.rating === 'number' ? p.rating : null;
            const stars = rating ? '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating)) : null;
            const closedRaw = closedDaysOf(p.openingHours);
            const closed = closedRaw.map(localizedWeekday);
            const quiet = quietWindowFor(post, stop.slot);
            const tip = transitTip(post);
            // Prefer the clean Google Places venue name over the full SEO post
            // title ("Gwangjang Market: Seoul Travel Guide") — an itinerary card
            // is a list of places, not a list of articles. Falls back to the
            // (localized, when available) post title for posts without a place.
            const stopLabel = (lang === 'en' ? null : postTitleFor(post).split(/[:—]/)[0].trim()) || post.data.place?.name || postTitleFor(post);
            const stopRegionLabel = localizePlace(post.data.region, lang);
            const leg = stop.walkToNext;
            return (
              <>
                <li
                  class="itin-stop"
                  data-slug={post.id}
                  data-priority={si + 1}
                  data-lat={p.lat}
                  data-lng={p.lng}
                  data-cats={interestCatsFor(post).join(',')}
                  data-closed={closedRaw.join(',')}
                  data-dwell={stop.dwellMin}
                >
                  <div class="itin-stop-thumb">
                    {post.data.heroImage && (
                      <img src={post.data.heroImage.url} alt={stopLabel} width="300" height="200" loading="lazy" decoding="async" />
                    )}
                  </div>
                  <div class="itin-stop-body">
                    <div class="itin-stop-meta">
                      <span class="itin-slot">{t(`itin.slot.${stop.slot}` as any)}</span>
                      <span class="itin-region-tag">{stopRegionLabel}</span>
                    </div>
                    <h3><a href={postHref(post.id)}>{stopLabel}</a></h3>
                    {stars && (
                      <p class="itin-rating"><span class="stars">{stars}</span> {rating}{p.userRatingsTotal ? ` (${p.userRatingsTotal.toLocaleString()})` : ''}</p>
                    )}
                    <p class="itin-why">{stop.why}</p>

                    <div class="itin-chips">
                      {closed.length > 0 && (
                        <span class="chip chip-closed">{t('itin.closedChip').replace('{days}', closed.join(', '))}</span>
                      )}
                      {quiet && <span class="chip chip-quiet">{t('itin.quietBadge').replace('{range}', quiet)}</span>}
                      <span class="chip chip-dwell"><Emoji name="three-oclock" /> {t('itin.dwellLabel')}: {formatDwell(stop.dwellMin)}</span>
                      {/* Family/seniors-only advisory — filled in and shown by the
                          client script from the stop's OWN (possibly recomputed
                          after a pace filter) leg minutes; never rendered with a
                          guessed value, so it starts empty and hidden. */}
                      <span class="chip chip-advisory" data-advisory hidden></span>
                    </div>

                    {tip && (
                      <p class="itin-transit-tip"><strong>{t('itin.transitTipLabel')}:</strong> {tip}</p>
                    )}
                  </div>
                </li>

                {/* 6. Leg row between cards */}
                {leg && (
                  <li class="itin-leg" aria-hidden="false" data-km={leg.km} data-minutes={leg.minutes ?? ''} data-transit={String(leg.transit)}>
                    <span class="itin-leg-icon">
                      {/* Both icons render server-side; the script only toggles
                          which is hidden — it never reconstructs an <Emoji> SVG
                          client-side, so a recomputed (post-filter) leg still
                          shows the exact same icon the server would have drawn. */}
                      <span data-icon-walk hidden={leg.transit}><Emoji name="compass" /></span>
                      <span data-icon-transit hidden={!leg.transit}><Emoji name="metro" /></span>
                    </span>
                    <span class="itin-leg-text">{legText(leg)}</span>
                    <a class="itin-leg-directions" href={directionsUrl(p, day.stops[si + 1].post.data.place, leg.transit)} target="_blank" rel="noopener">
                      {t('itin.directions')} →
                    </a>
                  </li>
                )}
              </>
            );
          })}
        </ol>

        {/* 7. Day footer: rain swap + full-day route + day-scoped Klook CTA */}
        <div class="itin-day-footer">
          {day.rainPost && (
            <p class="itin-rain">
              ☂ {t('itin.ifItRains').replace('{title}', '')}
              <a href={postHref(day.rainPost.id)}>{postTitleFor(day.rainPost)}</a>
              {day.rainWhy && <span class="itin-rain-why"> — {day.rainWhy}</span>}
            </p>
          )}
          <div class="itin-day-actions">
            {dayRouteUrl(day.stops.map((s: any) => s.post)) && (
              <a class="itin-day-route" href={dayRouteUrl(day.stops.map((s: any) => s.post))!} target="_blank" rel="noopener">
                <Emoji name="round-pushpin" /> {t('itin.dayRoute').replace('{n}', String(di + 1))}
              </a>
            )}
            {/* Enabled by the script once an arrival date is chosen — a day plan
                has no absolute dates until then, so there is nothing honest to
                put in an .ics file yet. */}
            <a class="itin-day-route itin-ics-link" data-ics-link download hidden href="#">
              <Emoji name="spiral-calendar" /> {t('itin.addToCalendar').replace('{n}', String(di + 1))}
            </a>
            <a class="book-btn book-btn-primary" href={klookDayHref} target="_blank" rel="sponsored noopener">
              <Emoji name="admission-tickets" /> {t('itin.bookDay').replace('{n}', String(di + 1))}
            </a>
          </div>
        </div>
      </section>
    ))}

    {/* 8. FAQ, PlanTrip, Newsletter, related region link */}
    {faq.length > 0 && (
      <section class="faq">
        <h2>{t('post.faqTitle')}</h2>
        {faq.map((f: any) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}

    <PlanTrip city={d.city} country={d.country} />

    <Newsletter
      compact
      lang={lang}
      region={d.city}
      country={d.country}
      heading={t('post.moreTips').replace('{region}', regionLabel)}
      dek={t('region.newsletterDek').replace('{region}', regionLabel)}
    />

    <p class="itin-related-link">
      <a href={localizePath(`/regions/${slugifyRegion(d.city)}`, lang)}>{t('itin.moreRegion').replace('{region}', regionLabel)} →</a>
    </p>
  </article>
</BaseLayout>

