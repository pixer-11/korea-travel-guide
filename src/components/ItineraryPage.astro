  .ith-arrival small { font-size: .75rem; font-weight: 700; opacity: .85; }
  .ith-arrival input { font: inherit; font-weight: 800; font-size: 1.05rem; color: #fff; background: transparent; border: 0; padding: 0; color-scheme: dark; cursor: pointer; }
  .ith-arrival input:focus-visible { outline: 2px solid #fff; outline-offset: 3px; border-radius: 4px; }
  .ith-clash { display: flex; gap: .6rem; align-items: flex-start; margin: 0; font-size: .9rem; line-height: 1.55; opacity: .92; }
