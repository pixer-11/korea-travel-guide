  :global(:root[data-theme='dark']) .itin-page { --x-brown-ink: #f0b184; --x-leaf: #33422a; --x-peach: #3a2620; --x-sand: #2c261d; --x-card: #221f19; }

  .ith { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 2.4rem; align-items: center; margin-bottom: 1.6rem; }
