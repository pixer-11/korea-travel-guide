</style>

<script>
  // Progressive-enhancement filter/date/ics layer for the itinerary page.
  // Everything the server already rendered (every stop, every leg, every
  // fact) stays complete and correct with this script absent — it only
  // shows/hides/re-labels what's already in the DOM, per data-* attributes
  // the server put there. The one place real arithmetic happens (recomputing
  // a leg that bridges two stops the server never placed next to each other)
  // duplicates src/lib/itinerary.mjs's constants EXACTLY: WALK_KMH=4.5, a
  // 1.3x street-grid detour factor, and >2km ⇒ transit with NO minutes ever
  // shown (the solver refuses to invent a subway ETA; so do we).
  const form = document.querySelector('[data-itin-filters]') as HTMLFormElement | null;
  if (form) {
    const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const locale = form.dataset.locale || 'en';
    const tWalk = form.dataset.tWalkLeg || '~{min} min walk ({km} km)';
    const tTransit = form.dataset.tTransitLeg || 'Take the subway or a taxi';
    const tClosedWarning = form.dataset.tClosedWarning || '';
    const tClosedWarningNoSwap = form.dataset.tClosedWarningNoSwap || '';
    const tLongWalk = form.dataset.tLongWalk || '';
    const tripTitle = form.dataset.tripTitle || document.title;
    const pageUrl = form.dataset.pageUrl || location.href.split('#')[0];

    type Leg = { km: number; minutes: number | null; transit: boolean };

    // ---- Same haversine + constants as src/lib/itinerary.mjs's walkLeg(). No
    // water-crossing detection here (that reads a post's body text, which
    // isn't available client-side) — a real limitation, but this path only
    // ever runs for a stop pair the pace filter newly made adjacent, which
    // never happens under today's thresholds (relaxed/normal/packed only ever
    // truncate a day's trailing stops — see below). Kept correct and defensive
    // for future itinerary shapes anyway. ----
    const WALK_KMH = 4.5;
    const DETOUR_FACTOR = 1.3;
    const TRANSIT_KM = 2;
    function haversineKm(aLat: number, aLng: number, bLat: number, bLng: number): number {
      const R = 6371;
      const rad = (x: number) => (x * Math.PI) / 180;
      const dLat = rad(bLat - aLat), dLng = rad(bLng - aLng);
      const s = Math.sin(dLat / 2) ** 2 + Math.cos(rad(aLat)) * Math.cos(rad(bLat)) * Math.sin(dLng / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(s));
    }
    function computeLeg(a: HTMLElement, b: HTMLElement): Leg {
      const km = haversineKm(Number(a.dataset.lat), Number(a.dataset.lng), Number(b.dataset.lat), Number(b.dataset.lng)) * DETOUR_FACTOR;
      const transit = km > TRANSIT_KM;
      return { km: Math.round(km * 10) / 10, minutes: transit ? null : Math.round((km / WALK_KMH) * 60), transit };
    }
    function readLegData(legEl: HTMLElement): Leg {
      const minutes = legEl.dataset.minutes;
      return {
        km: Number(legEl.dataset.km),
        minutes: minutes === undefined || minutes === '' ? null : Number(minutes),
        transit: legEl.dataset.transit === 'true',
      };
    }
    function directionsUrl(aLat: number, aLng: number, bLat: number, bLng: number, transit: boolean): string {
      const mode = transit ? 'transit' : 'walking';
      return `https://www.google.com/maps/dir/?api=1&origin=${aLat},${aLng}&destination=${bLat},${bLng}&travelmode=${mode}`;
    }

    // Re-renders a leg row from a Leg value — used ONLY for a genuinely new
    // (recomputed) bridge between two stops. An already-correct server leg is
    // never passed through this — see updateDayLegs below.
    function renderLeg(legEl: HTMLElement, leg: Leg, aLat: number, aLng: number, bLat: number, bLng: number) {
      const textEl = legEl.querySelector('.itin-leg-text');
      if (textEl) textEl.textContent = leg.transit ? tTransit : tWalk.replace('{min}', String(leg.minutes)).replace('{km}', String(leg.km));
      const walkIcon = legEl.querySelector('[data-icon-walk]') as HTMLElement | null;
      const transitIcon = legEl.querySelector('[data-icon-transit]') as HTMLElement | null;
      if (walkIcon) walkIcon.hidden = leg.transit;
      if (transitIcon) transitIcon.hidden = !leg.transit;
      const dirEl = legEl.querySelector('.itin-leg-directions') as HTMLAnchorElement | null;
      if (dirEl) dirEl.href = directionsUrl(aLat, aLng, bLat, bLng, leg.transit);
    }

    // For one day's <ol>: applies pace visibility, then works out which leg
    // row (if any) sits between each pair of now-adjacent VISIBLE stops.
    // Adjacent-in-the-original-order pairs reuse the server's own leg
    // untouched (never recomputed — "prefer not recomputing" whenever the
    // server already computed the exact right number). Only a genuine gap
    // (stops hidden between them) gets a fresh haversine-based leg.
    function updateDayLegs(stops: HTMLElement[], legs: HTMLElement[]): Map<number, Leg | null> {
      const visIdx: number[] = [];
      stops.forEach((el, i) => { if (!el.hidden) visIdx.push(i); });
      const effective = new Map<number, Leg | null>();
      // Start from nothing shown: the relaxed pace left the rows between two
      // hidden stops on the page, a walk to nowhere (Codex D5, 10-01).
      legs.forEach((l) => { if (l) l.hidden = true; });

      for (let k = 0; k < visIdx.length; k++) {
        const i = visIdx[k];
        const legEl = legs[i];
        if (k === visIdx.length - 1) {
          if (legEl) legEl.hidden = true;
          effective.set(i, null);
          continue;
        }
        const j = visIdx[k + 1];
        if (j === i + 1) {
          // No gap — the server's own leg is exactly right. Show it, touch nothing else.
          if (legEl) {
            legEl.hidden = false;
            effective.set(i, readLegData(legEl));
          }
        } else {
          // A gap: everything between i and j is hidden. Recompute from real
          // coordinates (never happens under today's suffix-only pace
          // thresholds, but handled correctly if that ever changes).
          const a = stops[i], b = stops[j];
          const leg = computeLeg(a, b);
          if (legEl) {
            legEl.hidden = false;
            renderLeg(legEl, leg, Number(a.dataset.lat), Number(a.dataset.lng), Number(b.dataset.lat), Number(b.dataset.lng));
          }
          effective.set(i, leg);
          for (let h = i + 1; h < j; h++) { if (legs[h]) legs[h].hidden = true; }
        }
      }
      return effective;
    }

    // ---- Arrival-date helpers. Dates come from a plain <input type=date>
    // (calendar day only, no timezone) so everything below stays in LOCAL
    // date math — no Date.UTC, no off-by-one across timezones. ----
    function parseLocalDate(value: string): Date {
      const [y, m, d] = value.split('-').map(Number);
      return new Date(y, m - 1, d);
    }
    function addDays(date: Date, n: number): Date {
      const d = new Date(date);
      d.setDate(d.getDate() + n);
      return d;
    }
    function formatDayDate(date: Date): string {
      try {
        return new Intl.DateTimeFormat(locale, { weekday: 'short', month: 'short', day: 'numeric' }).format(date);
      } catch {
        return date.toDateString();
      }
    }

    // ---- Minimal RFC 5545 .ics builder, same fold/escape rules as
    // src/lib/ics.ts (duplicated per the brief — that file lives server-side
    // only, this script is a client bundle). All-day precision only: the
    // solver never stamps an absolute clock time for a stop, only a slot
    // (morning/lunch/afternoon/evening) and relative dwell/leg minutes, so an
    // hourly start time would be invented, not read. ----
    function icsEscape(s: string): string {
      return String(s ?? '').replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n');
    }
    function icsFold(line: string): string {
      const enc = new TextEncoder();
      if (enc.encode(line).length <= 75) return line;
      const out: string[] = [];
      let cur = '', len = 0;
      for (const ch of line) {
        const w = enc.encode(ch).length;
        if (len + w > 74) { out.push(cur); cur = ' '; len = 1; }
        cur += ch; len += w;
      }
      out.push(cur);
      return out.join('\r\n');
    }
    const pad2 = (n: number) => String(n).padStart(2, '0');
    const icsDayStr = (d: Date) => `${d.getFullYear()}${pad2(d.getMonth() + 1)}${pad2(d.getDate())}`;
    function icsStampNow(): string {
      const n = new Date();
      return `${n.getUTCFullYear()}${pad2(n.getUTCMonth() + 1)}${pad2(n.getUTCDate())}T${pad2(n.getUTCHours())}${pad2(n.getUTCMinutes())}${pad2(n.getUTCSeconds())}Z`;
    }
    function buildDayIcsHref(dayNum: number, date: Date, summary: string, stopNames: string[]): string {
      const endExclusive = addDays(date, 1);
      const slug = location.pathname.split('/').filter(Boolean).pop() || 'itinerary';
      const lines = [
        'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Wander Atlas//Itinerary//EN', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH',
        `X-WR-CALNAME:${icsEscape(tripTitle)}`,
        'BEGIN:VEVENT',
        `UID:itin-${icsEscape(slug)}-day${dayNum}-${icsDayStr(date)}@wanderatlasguides.com`,
        `DTSTAMP:${icsStampNow()}`,
        `DTSTART;VALUE=DATE:${icsDayStr(date)}`,
        `DTEND;VALUE=DATE:${icsDayStr(endExclusive)}`,
        `SUMMARY:${icsEscape(summary)}`,
        `DESCRIPTION:${icsEscape(stopNames.join(' \u2192 '))}`,
        `URL:${icsEscape(pageUrl)}`,
        'END:VEVENT', 'END:VCALENDAR',
      ];
      const text = lines.map(icsFold).join('\r\n') + '\r\n';
      return 'data:text/calendar;charset=utf-8,' + encodeURIComponent(text);
    }

    // ---- Hash (share) round-trip: #p=relaxed&i=food,shopping&d=2026-03-06 ----
    function serializeHash(): string {
      const pace = (form!.querySelector('input[name=pace]:checked') as HTMLInputElement | null)?.value;
      const party = (form!.querySelector('input[name=party]:checked') as HTMLInputElement | null)?.value;
      const interests = Array.from(form!.querySelectorAll('input[name=interest]:checked')).map((el) => (el as HTMLInputElement).value);
      const arrival = (form!.querySelector('input[name=arrival]') as HTMLInputElement | null)?.value;
      const parts: string[] = [];
      if (pace && pace !== 'normal') parts.push('p=' + pace);
      if (party) parts.push('pa=' + party);
      if (interests.length) parts.push('i=' + interests.join(','));
      if (arrival) parts.push('d=' + arrival);
      return parts.join('&');
    }
    function updateHash() {
      const h = serializeHash();
      history.replaceState(null, '', location.pathname + location.search + (h ? '#' + h : ''));
    }
    function applyHash() {
      const h = location.hash.replace(/^#/, '');
      if (!h) return;
      const params = new URLSearchParams(h);
      const p = params.get('p');
      if (p) { const r = form!.querySelector(`input[name=pace][value="${p}"]`) as HTMLInputElement | null; if (r) r.checked = true; }
      const pa = params.get('pa');
      if (pa) { const r = form!.querySelector(`input[name=party][value="${pa}"]`) as HTMLInputElement | null; if (r) r.checked = true; }
      const i = params.get('i');
      if (i) { i.split(',').forEach((v) => { const c = form!.querySelector(`input[name=interest][value="${v}"]`) as HTMLInputElement | null; if (c) c.checked = true; }); }
      const d = params.get('d');
      if (d) { const a = form!.querySelector('input[name=arrival]') as HTMLInputElement | null; if (a) a.value = d; }
    }

    // ---- IKEA-effect save-plan hint: un-hides after the first real filter
    // interaction. No popup — just an affordance link to the "email me this
    // itinerary" box after Day 1. It pointed at #newsletter, a block this
    // page dropped on 08-23, so the link went nowhere (Codex D10, 10-01). ----
    const saveHint = document.querySelector('[data-itin-save-hint]') as HTMLElement | null;
    const saveLink = document.querySelector('[data-itin-save-link]') as HTMLAnchorElement | null;
    let interacted = false;
    function onFirstInteraction() {
      if (interacted) return;
      interacted = true;
      if (saveHint) saveHint.hidden = false;
    }
    saveLink?.addEventListener('click', (e) => {
      e.preventDefault();
      const slot = document.getElementById('itin-email-slot');
      slot?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      (slot?.querySelector('input[type=email]') as HTMLInputElement | null)?.focus({ preventScroll: true });
    });

    // ---- Main apply: pace visibility + leg recompute, interests dim/highlight,
    // party advisories, arrival-date weekday + closed-day flip + .ics links. ----
    function applyFilters() {
      const pace = (form!.querySelector('input[name=pace]:checked') as HTMLInputElement | null)?.value || 'normal';
      const party = (form!.querySelector('input[name=party]:checked') as HTMLInputElement | null)?.value || '';
      const interests = Array.from(form!.querySelectorAll('input[name=interest]:checked')).map((el) => (el as HTMLInputElement).value);
      const arrivalVal = (form!.querySelector('input[name=arrival]') as HTMLInputElement | null)?.value || '';
      const paceThreshold = pace === 'relaxed' ? 3 : pace === 'packed' ? Infinity : 4;
      const arrivalDate = arrivalVal ? parseLocalDate(arrivalVal) : null;

      document.querySelectorAll('.itin-day').forEach((daySectionEl, dayIdx) => {
        const daySection = daySectionEl as HTMLElement;
        const listEl = daySection.querySelector('.itin-stops');
        if (!listEl) return;
        const stops = Array.from(listEl.querySelectorAll(':scope > .itin-stop')) as HTMLElement[];
        // legs[i] is the row after stops[i] (or undefined). A stop without a
        // walk figure renders no row, so a plain list of rows would misalign.
        const legs = stops.map((s) => (s.nextElementSibling?.classList.contains('itin-leg') ? s.nextElementSibling : undefined)) as HTMLElement[];

        // Pace: relaxed hides priority>3, normal >4, packed shows all.
        stops.forEach((stopEl) => {
          stopEl.hidden = Number(stopEl.dataset.priority) > paceThreshold;
        });

        // Interests: ring the matches, dim (never hide) the rest.
        stops.forEach((stopEl) => {
          const cats = (stopEl.dataset.cats || '').split(',').filter(Boolean);
          const active = interests.length > 0;
          const match = active && interests.some((x) => cats.includes(x));
          stopEl.classList.toggle('itin-stop-match', match);
          stopEl.classList.toggle('itin-stop-dim', active && !match);
        });

        const effectiveLegs = updateDayLegs(stops, legs);

        // The day's map follows the pace too: it routed through every stop,
        // the hidden ones included (Codex D6, 10-01).
        const routeEl = daySection.querySelector('[data-day-route]') as HTMLAnchorElement | null;
        if (routeEl) {
          const pts = stops.filter((s) => !s.hidden).map((s) => `${s.dataset.lat},${s.dataset.lng}`);
          routeEl.hidden = pts.length < 2;
          if (pts.length >= 2) {
            const mids = pts.slice(1, -1).join('|');
            routeEl.href = `https://www.google.com/maps/dir/?api=1&origin=${pts[0]}&destination=${pts[pts.length - 1]}${mids ? `&waypoints=${encodeURIComponent(mids)}` : ''}`;
          }
        }

        // Party: family/seniors get a long-walk advisory on the CURRENT stop
        // when its effective (possibly recomputed) outgoing leg is a real,
        // non-transit minute figure over 15 — never shown for a transit leg,
        // since transit legs carry no minutes to report honestly.
        stops.forEach((stopEl, i) => {
          const advisoryEl = stopEl.querySelector('[data-advisory]') as HTMLElement | null;
          if (!advisoryEl) return;
          const leg = effectiveLegs.get(i);
          const show = (party === 'family' || party === 'seniors') && !!leg && !leg.transit && leg.minutes != null && leg.minutes > 15;
          advisoryEl.hidden = !show;
          if (show && leg) advisoryEl.textContent = tLongWalk.replace('{min}', String(leg.minutes));
        });

        // Arrival date: real weekday label + closed-that-day chip flip + ics.
        const dateSpan = daySection.querySelector('[data-day-date]') as HTMLElement | null;
        const icsLink = daySection.querySelector('[data-ics-link]') as HTMLAnchorElement | null;
        if (arrivalDate) {
          const dayDate = addDays(arrivalDate, dayIdx);
          const weekdayName = WEEKDAYS[dayDate.getDay()];
          if (dateSpan) { dateSpan.hidden = false; dateSpan.textContent = ' \u00b7 ' + formatDayDate(dayDate); }

          const hasRain = daySection.dataset.hasRain === '1';
          const warningText = hasRain ? tClosedWarning : tClosedWarningNoSwap;
          stops.forEach((stopEl) => {
            const chip = stopEl.querySelector('.chip-closed') as HTMLElement | null;
            if (!chip) return;
            if (chip.dataset.orig === undefined) chip.dataset.orig = chip.textContent || '';
            const closedList = (stopEl.dataset.closed || '').split(',').filter(Boolean);
            const isClosed = closedList.includes(weekdayName);
            chip.textContent = isClosed && warningText ? warningText : chip.dataset.orig;
            chip.classList.toggle('chip-closed-warning', isClosed);
          });

          if (icsLink) {
            const visibleStops = stops.filter((s) => !s.hidden);
            const stopNames = visibleStops.map((s) => (s.querySelector('h3 a')?.textContent || '').trim()).filter(Boolean);
            const headingEl = daySection.querySelector('.itin-day-title');
            const summary = (headingEl?.textContent || tripTitle).replace(/\s+/g, ' ').trim();
            icsLink.href = buildDayIcsHref(dayIdx + 1, dayDate, summary, stopNames);
            icsLink.hidden = false;
          }
        } else {
          if (dateSpan) { dateSpan.hidden = true; dateSpan.textContent = ''; }
          if (icsLink) { icsLink.hidden = true; icsLink.href = '#'; }
          stops.forEach((stopEl) => {
            const chip = stopEl.querySelector('.chip-closed') as HTMLElement | null;
            if (chip && chip.dataset.orig !== undefined) {
              chip.textContent = chip.dataset.orig;
              chip.classList.remove('chip-closed-warning');
            }
          });
        }
      });
    }

    form.addEventListener('change', () => {
      onFirstInteraction();
      applyFilters();
      updateHash();
    });

    applyHash();
    applyFilters();

    // A shared link opened in a tab already on this page changes only the
    // hash, and the browser does not reload: start from the defaults and
    // apply the new choices (Codex D9, 10-01). Our own replaceState does not
    // fire this.
    addEventListener('hashchange', () => {
      // Only a plan link ("#p=…&d=…") resets the form; the day tabs and other
      // in-page anchors ("#day-2") are just a place to scroll to (Codex, 10-01).
      if (!/[#&](?:p|pa|i|d)=/.test(location.hash)) return;
      form!.reset();
      applyHash();
      applyFilters();
      form!.dispatchEvent(new Event('change', { bubbles: true }));
    });
  }
</script>
