  @media (max-width: 759px) { .ith-bar-row { grid-template-columns: minmax(0, 1fr); } .ith-rain-btn { justify-self: start; } }

  /* Day tabs */
  .itin-page .itin-day-nav { gap: .45rem; align-items: center; border-bottom: 1px solid var(--line); padding: .6rem 0; margin: 0 0 1.4rem; }
  .itin-page .itin-day-nav a { display: inline-flex; align-items: center; gap: .4rem; padding: .5rem 1rem; border-radius: var(--r-pill); border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); font-weight: 800; font-size: .9rem; text-decoration: none; }
  .itin-page .itin-day-nav a small { font-weight: 600; color: var(--muted); font-size: .8rem; }
  .itin-page .itin-day-nav a small:empty { display: none; }
  .itin-page .itin-day-nav a:hover { border-color: var(--x-brown); }
  .ith-tab-dot { width: .5rem; height: .5rem; border-radius: 50%; background: var(--x-rust); }
  .ith-tab-dot[hidden] { display: none; }
  .itin-page .itin-day-nav a.ith-prep { margin-left: auto; border: 0; background: none; color: var(--x-brown-ink); padding-inline: .3rem; }

  /* Two columns */
  .ith-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: 2rem; align-items: start; }
  .ith-main { min-width: 0; }
  .ith-side { position: sticky; top: 4.5rem; display: grid; gap: .9rem; }
  @media (max-width: 959px) { .ith-layout { grid-template-columns: minmax(0, 1fr); } .ith-side { position: static; } }
  .ith-card { border-radius: 24px; padding: 1.2rem 1.2rem 1.1rem; background: var(--x-card); border: 1px solid var(--line-soft); }
  .ith-stay { background: var(--x-leaf); border-color: transparent; }
  .ith-card-title { display: block; font-size: .95rem; color: var(--ink); }
  .ith-card-dek { margin: .3rem 0 .8rem; font-size: .85rem; line-height: 1.55; color: var(--ink-soft); }
