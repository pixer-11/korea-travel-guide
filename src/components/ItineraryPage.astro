  .ith-clash[data-state='warn'] .ith-clash-dot { background: var(--x-rust); }
  .ith-clash[data-state='ok'] .ith-clash-dot { background: #9fc27a; }
  .ith-clash[data-state='warn'] { font-weight: 600; }
  .ith-rain-btn { display: inline-flex; align-items: center; gap: .5rem; font: inherit; font-weight: 800; font-size: .9rem; padding: .6rem 1.1rem; border-radius: var(--r-pill); border: 1px solid rgba(255, 255, 255, .35); background: transparent; color: #fff; cursor: pointer; white-space: nowrap; }
  .ith-rain-btn[aria-pressed='true'] { background: #e3ecd0; color: #262d1b; border-color: #e3ecd0; }
  .ith-more { margin-top: .8rem; border-top: 1px solid rgba(255, 255, 255, .14); padding-top: .7rem; }
  .ith-more summary { cursor: pointer; font-size: .88rem; font-weight: 700; opacity: .85; }
  .ith-more-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: .8rem 1.4rem; margin-top: .8rem; }
  .ith-more fieldset { border: 0; margin: 0; padding: 0; }
  .ith-more legend { font-size: .75rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; opacity: .7; margin-bottom: .35rem; padding: 0; }
