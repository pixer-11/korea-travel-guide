  .ith-mosaic--3 img:nth-child(2) { border-radius: 100px 100px 20px 20px; }
  .ith-mosaic--3 img:nth-child(3) { border-radius: 20px 20px 100px 20px; }
  @media (max-width: 899px) { .ith { grid-template-columns: minmax(0, 1fr); } .ith-mosaic { height: 15rem; order: -1; } }

  /* The dark arrival bar */
  .ith-bar { background: var(--x-night); color: var(--x-on-dark); border-radius: 26px; padding: 1.1rem 1.3rem; margin: 0 0 1.2rem; }
