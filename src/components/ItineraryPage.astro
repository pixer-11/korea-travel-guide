  .ith-h1 span { display: block; color: var(--x-brown); }
  :global(:root[data-theme='dark']) .ith-h1 span { color: #e8a577; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .ith-h1 span { color: #e8a577; } }
  .ith-dek { color: var(--ink-soft); font-size: 1.02rem; line-height: 1.75; margin: 0 0 1.2rem; }
  .ith-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr)); gap: .6rem; margin-bottom: .9rem; }
  .ith-stats > div { padding: .8rem .9rem; border-radius: 18px; background: var(--x-card); border: 1px solid var(--line-soft); display: flex; flex-direction: column; gap: .2rem; }
  .ith-stats small { font-size: .75rem; font-weight: 700; color: var(--muted); }
