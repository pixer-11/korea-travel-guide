---
import ShareRow from './ShareRow.astro';
import { perDayBusyness, DAY_NAMES } from '../lib/busyness.mjs';
import { siteHref } from '../lib/urls.mjs';
// Shared itinerary view for BOTH the English page (/itinerary/<slug>) and the
// localized pages (/ko/itinerary/<slug> etc). One template, same pattern as
// PostArticle.astro. `translation` is an itinerariesI18n entry — it supplies
// PROSE only (day labels/intros, per-stop "why", FAQ, title/description). Every
// HARD FACT shown on a stop card (rating, review count, address, hours, closed
// days, quiet windows, coordinates) is read from the source POST at render
// time — never from the itinerary file, which carries connective prose only.
// A translation is optional and never blocks the build: missing fields fall
// back to the English source, per stop.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ItineraryEmailBox from './ItineraryEmailBox.astro';
import ItineraryGuideCard from './ItineraryGuideCard.astro';
import PlanTrip from './PlanTrip.astro';
import Emoji from './Emoji.astro';
import { slugifyRegion } from '../lib/slug';
import { thumbOr } from '../lib/wall';
import { getLangFromUrl, useTranslations, localeCodes, localizePath, klookLocale, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { shortPlaceLabel } from '../lib/placeLabel.mjs';
import TypesetPlate from './TypesetPlate.astro';
import { formatHourRanges, openHourSetsByDay } from '../lib/hours.mjs';
import { klookCityDest } from '../lib/klookCities';
import { tiqetsCityUrl } from '../lib/tiqets-link.mjs';
import { closedDaysOf } from '../lib/itinerary.mjs';
import SaveButton from './SaveButton.astro';
import { hotelUrl } from '../lib/hotel-link.mjs';
import { itinUi } from '../i18n/itinerary-ui-strings';
import { recommendsBooking } from '../lib/bookAhead.mjs';
import { gocityFor } from '../lib/gocity.mjs';

interface Props {
  itinerary: any; // CollectionEntry<'itineraries'>
  translation?: any; // CollectionEntry<'itinerariesI18n'>
}
const { itinerary, translation } = Astro.props;
const d = itinerary.data;
const tr = translation?.data;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = tr?.title ?? d.title;
const description = tr?.description ?? d.description;
const quickAnswer = tr?.quickAnswer ?? d.quickAnswer;
const faq = (tr?.faq?.length ? tr.faq : d.faq) ?? [];

const regionLabel = localizePlace(d.city, lang);
const countryLabel = localizePlace(d.country, lang);
const countrySlug = String(d.country).toLowerCase().replace(/\s+/g, '-');
const sameRegionCountry = d.city.toLowerCase() === String(d.country).toLowerCase();
const updated = d.updatedDate ?? d.pubDate;

// ---- Resolve every stop's post. Facts NEVER come from the itinerary file. ----
// Loud failure by design: a stop that can't resolve to a live, non-draft post
// would otherwise silently vanish from the page — a wrong itinerary is worse
// than a broken build.
const allPosts = await getCollection('posts');
const postsById = new Map(allPosts.map((p) => [p.id, p]));
function resolveStop(slug: string) {
  const post = postsById.get(slug);
  if (!post) {
    throw new Error(`Itinerary "${itinerary.id}": stop slug "${slug}" has no matching post in the posts collection.`);
  }
  if (post.data.draft) {
    // A quarantined stop must not be RECOMMENDED — but throwing here held the
    // ENTIRE site's deploy hostage to one post's photo quarantine (Fuglen
    // Tokyo went draft overnight and every build from 21:04 UTC failed,
    // 2026-08-10). The stop is silently dropped instead; the course stays
    // valid minus one stop, and the nightly itinerary rebuild re-slots a
    // replacement when it runs. A missing post (typo) still throws above —
    // that one IS a data bug a human must see.
    console.warn(`Itinerary "${itinerary.id}": stop "${slug}" is quarantined — dropped from render.`);
    return null;
  }
  return post;
}

// Same-language post titles/links as PostArticle's postHref/postTitle: a stop
// links to its localized post page only when that translation actually exists,
// otherwise falls back to the English post URL rather than a 404.
// Keep the whole translation entry, not just its title: the transit tip is
// lifted from the post BODY, so an English body here printed English prose on
// every localized itinerary page.
const sameLangPosts =
  lang === 'en'
    ? new Map<string, any>()
    : new Map((await getCollection('postI18n', ({ data }) => data.lang === lang)).map((e) => [e.data.slug, e]));
const sameLangPostTitles = new Map([...sameLangPosts].map(([k, e]) => [k, e.data.title]));
// The same map already holds the translated DESCRIPTION, which is what the
// rain-day line should show. translate-itineraries always writes rainWhys: {}
// (deliberately — it does not translate those separately), so the fallback
// below fired on 100% of non-English pages and printed the English sentence
// under a Japanese heading: 「雨の日は: 東京のオクソモコ — Oxomoco, the
// Brooklyn-born, Michelin-starred modern Mexican restaurant, has relocated…」
// The translation of that very sentence was sitting in this map. (2026-09-10)
const sameLangPostDescriptions = new Map([...sameLangPosts].map(([k, e]) => [k, e.data.description]));

// Does any day hold more stops than the loosest pace keeps? If not, the pace
// radios are decorative (see the filter block below).
const maxStopsPerDay = Math.max(0, ...(d.itinerary ?? []).map((day: any) => (day.stops ?? []).length));
const paceCanChangeSomething = maxStopsPerDay > 3;
const postHref = (id: string) => (sameLangPostTitles.has(id) ? localizePath(`/posts/${id}`, lang) : `/posts/${id}`);
const postTitleFor = (post: any) => sameLangPostTitles.get(post.id) ?? post.data.title;

// Weekday name from Google's "Tuesday: Closed" style string, localized via the
// same Intl formatter used for dates elsewhere — no separate translation table
// needed. 2023-01-01 was a Sunday, so index 0 = Sunday.
const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
function localizedWeekday(name: string): string {
  const idx = WEEKDAYS.indexOf(name);
  if (idx === -1) return name;
  const date = new Date(Date.UTC(2023, 0, 1 + idx));
  return date.toLocaleDateString(localeCodes[lang], { weekday: 'long', timeZone: 'UTC' });
}

// Real foot-traffic hour ranges (same shape as PostArticle's fmtHourRanges),
// restricted to hours that fall inside the stop's own visit slot — never guess.
const SLOT_HOURS: Record<string, [number, number]> = {
  morning: [6, 11],
  lunch: [11, 14],
  afternoon: [14, 17],
  evening: [17, 23],
};
// The private copy this replaced hardcoded `${x.t}–${y.t} ${y.m}`, so every
// quiet chip on a localized itinerary read 「7–8 오전」 — the meridiem after the
// number, which is backwards in ko/ja/zh. lib/hours.mjs has known better since
// it grew MERIDIEM_FIRST; this file just had its own. (2026-09-10)
function fmtHourRanges(xs: number[]): string {
  return formatHourRanges(xs, { am: t('post.am'), pm: t('post.pm'), lang }) ?? '';
}
function quietWindowFor(post: any, slot: string): string | null {
  // An itinerary does not know which weekday the reader will walk it, so the
  // hour has to hold on ALL of them. Printing weekdayQuiet whole promised a
  // quiet 9am at a museum that opens at ten on the Monday. "All" means every
  // day it opens, weekends too: Monday to Friday only promised 9am at the
  // Sagrada Familia on a Sunday it opens at 10:30 (Codex D1, 10-01). A day it
  // is shut is left out; the closed-day chip speaks for that one.
  const perDay = perDayBusyness(post.data.place?.busyness, post.data.place?.openingHours);
  const openDays = perDay ? DAY_NAMES.filter((day: string) => (openHourSetsByDay(post.data.place?.openingHours)?.get(day)?.size ?? 0) > 0) : [];
  const q = perDay
    ? (openDays.length ? openDays.map((day: string) => perDay.get(day)!.quiet).reduce((a, b) => a.filter((h) => b.includes(h))) : [])
    : post.data.place?.busyness?.weekdayQuiet;
  if (!Array.isArray(q) || !q.length) return null;
  const [lo, hi] = SLOT_HOURS[slot] ?? [0, 24];
  const hours = [...new Set(q)].filter((h: number) => Number.isInteger(h) && h >= lo && h <= hi).sort((a: number, b: number) => a - b);
  if (!hours.length) return null;
  return fmtHourRanges(hours as number[]);
}

// First line of the post's own (already vetted) body that names a concrete
// transit detail — never invented, always lifted verbatim from the post.
// Latin patterns plus the localized equivalents, so a Korean/Japanese/Chinese
// body yields a tip instead of silently falling through to the English source.
//
// `[역駅站]` used to sit here followed by a `\b` that had been swallowed into a
// literal backspace character — so the branch searched for "역 followed by a
// backspace", which no page has ever contained, and it was dead from the day it
// was written (found 2026-08-04 by the invisible-character scan now in
// lint-regex.mjs). Restoring the `\b` is not the fix either: it is a \w
// boundary and means nothing between CJK characters, while a bare 역 also
// matches 지역/역사/구역 — measured against the 671 live Korean posts, it
// hijacked the tip on 485 of them. Korean is already served by 호선/출구/번 출구,
// so what replaces it is only the forms that cannot be anything but transit.
const TRANSIT_RE = /(Line\s*\d|Station|Exit\s*\d|BTS|MRT|호선|출구|번 출구|駅から|駅より|駅前|駅徒歩|車站|车站|地下鉄|地铁|捷運|Estación|Línea\s*\d)/;
function transitTip(post: any): string | null {
  // Prefer the reader's own language; fall back to the English source only when
  // no translation exists for this post.
  const localized = sameLangPosts.get(post.id);
  const body = String(localized?.body || post.body || '');
  const lines = body.split(/\r?\n/).map((l) => l.replace(/^#+\s*/, '').replace(/[*_`]/g, '').trim()).filter(Boolean);
  return lines.find((l) => TRANSIT_RE.test(l)) ?? null;
}

// ---- Client filter data: coarse interest buckets from category + tags/title
// keywords. This powers the "Interests" filter's highlight/dim treatment
// ONLY — a stop never disappears from an interest mismatch, so a loose
// heuristic here can't misinform a reader the way a hard fact (hours,
// rating, distance) would. category:'restaurant' always buckets as food;
// everything else falls back to 'culture' so no stop is ever unmatched.
const FOOD_RE = /food|cuisine|caf[eé]|pizza|dining|bbq|dessert|bakery|noodle|snack/i;
const SHOPPING_RE = /market|shopping|mall|boutique|\bstore\b/i;
const CULTURE_RE = /palace|museum|temple|shrine|heritage|history|\bart\b|gallery|design|craft|traditional|architecture/i;
const NATURE_RE = /\bpark\b|garden|stream|river|mountain|forest|beach|nature|hike|trail|island/i;
const NIGHTLIFE_RE = /\bbar\b|\bclub\b|\bnight\b|\bpub\b|rooftop|newtro/i;
function interestCatsFor(post: any): string[] {
  const text = [post.data.title, post.data.category, ...(post.data.tags || [])].join(' ');
  const cats = new Set<string>();
  if (post.data.category === 'restaurant' || FOOD_RE.test(text)) cats.add('food');
  if (SHOPPING_RE.test(text)) cats.add('shopping');
  if (CULTURE_RE.test(text)) cats.add('culture');
  if (NATURE_RE.test(text)) cats.add('nature');
  if (NIGHTLIFE_RE.test(text)) cats.add('nightlife');
  if (!cats.size) cats.add('culture');
  return [...cats];
}

function formatDwell(min: number): string {
  // "min"/"h" are words, not symbols — they have to follow the page language.
  if (min < 60) return `~${min}${t('itin.unitMin')}`;
  const hours = Math.round((min / 60) * 2) / 2;
  const hStr = Number.isInteger(hours) ? String(hours) : hours.toFixed(1);
  return `~${hStr}${t('itin.unitHour')}`;
}

function legText(leg: { km: number; minutes: number; transit: boolean } | null): string | null {
  if (!leg) return null;
  if (leg.transit) return t('itin.legTransit');
  return t('itin.legWalk').replace('{min}', String(leg.minutes)).replace('{km}', String(leg.km));
}

function directionsUrl(a: any, b: any, transit: boolean): string {
  const mode = transit ? 'transit' : 'walking';
  return `https://www.google.com/maps/dir/?api=1&origin=${a.lat},${a.lng}&destination=${b.lat},${b.lng}&travelmode=${mode}`;
}

function dayRouteUrl(posts: any[]): string | null {
  if (posts.length < 2) return null;
  const first = posts[0].data.place, last = posts[posts.length - 1].data.place;
  const mids = posts.slice(1, -1).map((p) => `${p.data.place.lat},${p.data.place.lng}`).join('|');
  return `https://www.google.com/maps/dir/?api=1&origin=${first.lat},${first.lng}&destination=${last.lat},${last.lng}${mids ? `&waypoints=${encodeURIComponent(mids)}` : ''}`;
}

// Same Klook affiliate builder as PlanTrip.astro — mapped city → curated
// destination page, unmapped → search fallback.
const klookDayHref = tiqetsCityUrl({ city: d.city, country: d.country, lang, subId: 'itinerary_tours' })
  ?? `/go/klook?to=${encodeURIComponent(klookCityDest(d.city, klookLocale(lang), d.country))}`;

// ---- Resolve every day's stops once, up front (throws loudly on any gap). ----
const days = d.itinerary.map((day: any, di: number) => {
  const label = tr?.days?.[di]?.label ?? day.label;
  const intro = tr?.days?.[di]?.intro ?? day.intro;
  let dropped = false;
  const stops = day.stops.flatMap((s: any) => {
    const post = resolveStop(s.slug);
    if (!post) { dropped = true; return []; } // quarantined stop — dropped, course continues
    const why = tr?.whys?.[s.slug] ?? s.why;
    return [{ ...s, post, why }];
  });
  if (dropped) {
    // A dropped stop invalidates its neighbours' walking legs: the previous
    // stop's "12 min walk to next" now points at a different place (or at
    // nothing — the first failed rebuild crashed on stops[si+1].post). Wipe
    // every leg on an altered day; the nightly itinerary rebuild restores
    // accurate ones when it re-slots a replacement stop.
    for (const s of stops) delete s.walkToNext;
  }
  const rainPost = day.rainSwapSlug ? resolveStop(day.rainSwapSlug) : null;
  const rainWhy = day.rainSwapSlug
    ? (tr?.rainWhys?.[day.rainSwapSlug] ?? (rainPost && sameLangPostDescriptions.get(rainPost.id)) ?? rainPost?.data.description ?? null)
    : null;
  return { label, intro, stops, rainPost, rainWhy };
});

// ---- Structured data: TouristTrip + BreadcrumbList + FAQPage. No aggregateRating
// (same site precedent as PostArticle — the ratings are Google's, not ours). ----
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteHref(Astro.url.pathname, Astro.site);
const allStopPosts = days.flatMap((day: any) => day.stops.map((s: any) => s.post));

const graph: Record<string, unknown>[] = [
  {
    '@type': 'TouristTrip',
    name: title,
    description,
    itinerary: {
      '@type': 'ItemList',
      itemListElement: allStopPosts.map((post: any, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'TouristAttraction',
          name: post.data.place?.name || post.data.title,
          url: siteHref(postHref(post.id), Astro.site),
        },
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: t('post.home'), item: siteHref(lang === 'en' ? '/' : `/${lang}/`, Astro.site) },
      { name: countryLabel, item: siteHref(localizePath(`/destinations/${countrySlug}`, lang), Astro.site) },
      ...(sameRegionCountry ? [] : [{ name: regionLabel, item: siteHref(localizePath(`/regions/${slugifyRegion(d.city)}`, lang), Astro.site) }]),
      { name: title, item: pageUrl },
    ].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })),
  },
];

if (faq.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };

// Which locales this itinerary route exists in — always all 5 (unlike posts,
// every itinerary renders at every locale immediately; missing translations
// fall back to English prose per-field rather than skipping the page).
const availableLangs: Lang[] = ['en', 'ko', 'ja', 'es', 'zh'];

// ── Redesign 2026-09-30 ("바르셀로나 일정 개선안"): hero numbers, photo mosaic,
// the dark arrival bar, a sidebar. Every number below is counted from the
// course itself; nothing is estimated beyond what the page already shows. ──
const u = itinUi(lang);
const [titleA, titleB] = (() => {
  const i = title.search(/[:：]/);
  return i > 0 ? [title.slice(0, i + 1), title.slice(i + 1).trim()] : [title, ''];
})();
// Counted over what the page shows by default: the normal pace keeps the first
// four stops of a day (the filter script hides the rest), so a fifth stop must
// not add hours, kilometres or a booking the reader cannot see.
const shownByDefault = (si: number) => !paceCanChangeSomething || si < 4;
const everyStop = days.flatMap((day: any) => day.stops.filter((_: any, si: number) => shownByDefault(si)));
const dwellHours = Math.round((everyStop.reduce((n: number, s: any) => n + (s.dwellMin || 0), 0) / 60) * 2) / 2;
const walkKm = Math.round(days.flatMap((day: any) => day.stops.filter((_: any, si: number) => shownByDefault(si + 1)))
  .reduce((n: number, s: any) => n + (s.walkToNext && !s.walkToNext.transit ? s.walkToNext.km : 0), 0) * 10) / 10;
// "Book ahead": the stop's own (vetted) guide recommends booking — read
// sentence by sentence from the English body (lib/bookAhead.mjs).
// Every candidate is rendered; the filter script hides the ones whose stop the
// chosen pace hides (a packed day's fifth stop was never listed — Codex D6,
// 10-01). The hero number counts the default pace, like the hours above it.
const bookAll = days.flatMap((day: any, di: number) => day.stops
  .filter((s: any) => recommendsBooking(String(s.post.body ?? '')))
  .map((s: any) => ({ slug: s.post.id, di, label: shortPlaceLabel(postTitleFor(s.post), lang) || s.post.data.place?.name || postTitleFor(s.post) })));
const bookAhead = days.flatMap((day: any, di: number) => day.stops
  .filter((s: any, si: number) => shownByDefault(si) && recommendsBooking(String(s.post.body ?? '')))
  .map((s: any) => ({ slug: s.post.id, di })));
const bookSet = new Set(bookAll.map((b: any) => b.slug));
// City pass card (lib/gocity.mjs): only on plans whose paid stops the pass
// covers, naming them in this plan's order; a stop the plan no longer has is
// not listed, and fewer than two left drops the card.
const pass = gocityFor(itinerary.id);
const passStops = !pass ? [] : days.flatMap((day: any) => day.stops)
  .filter((s: any, i: number, a: any[]) => pass.covers.includes(s.post.id) && a.findIndex((x: any) => x.post.id === s.post.id) === i)
  .map((s: any) => ({ slug: s.post.id, label: shortPlaceLabel(postTitleFor(s.post), lang) || s.post.data.place?.name || postTitleFor(s.post) }));
// The count is a live number: the pace filter hides stops (Codex, 10-04).
const [passDekA, passDekB = ''] = u('passDek', { n: '{n}' }).split('{n}');
const hasRain = days.some((day: any) => day.rainPost);
const mosaic = allStopPosts
  .filter((p: any) => p.data.heroImage?.url && p.data.heroImage.license !== 'placeholder')
  .filter((p: any, i: number, a: any[]) => a.findIndex((q: any) => q.id === p.id) === i)
  .slice(0, 3)
  .map((p: any) => ({ src: thumbOr(p.data.heroImage.url), pos: p.data.heroImage.focus ? `${p.data.heroImage.focus.x}% ${p.data.heroImage.focus.y}%` : '50% 50%' }));
const stayHref = hotelUrl({ submarker: 'itinerary_side', locale: klookLocale(lang), place: d.city, country: d.country });
const coverImage = mosaic[0]?.src;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  localized={true}
  localizedLangs={availableLangs}
  suppressPopup={true}
>
  <article class="article wrap itin-page" data-itin-page data-slug={itinerary.id}
    data-clash-none={u('clashNone')} data-clash-n={u('clashN')} data-clash-tip={u('clashTip')} data-day-word={t('itin.day')}
    data-rain-on={u('rainOn')} data-rain-off={u('rainOff')} data-copied={u('copied')} data-book-count={u('bookCount')}>
    <div class="ith">
      <div class="ith-copy">
        <nav class="crumbs ith-crumbs" aria-label={t('a11y.breadcrumb')}>
          <a href={lang === 'en' ? '/' : `/${lang}/`}>{t('post.home')}</a> <span>·</span>
          <a href={localizePath(`/destinations/${countrySlug}`, lang)}>{countryLabel}</a> <span>·</span>
          {!sameRegionCountry && (
            <><a href={localizePath(`/regions/${slugifyRegion(d.city)}`, lang)}>{regionLabel}</a> <span>·</span></>
          )}
          <span aria-current="page">{t('itin.badge').replace('{n}', String(d.days))}</span>
        </nav>
        <p class="ith-badges">
          <span class="ith-badge">{t('itin.badge').replace('{n}', String(d.days))}</span>
          {hasRain && <span class="ith-badge ith-badge--leaf">{u('badgeRain')}</span>}
        </p>
        <h1 class="ith-h1">{titleA}{titleB && <span>{titleB}</span>}</h1>
        {quickAnswer && <p class="ith-dek">{quickAnswer}</p>}
        <div class="ith-stats">
          <div><small>{u('statPlaces')}</small><strong>{u('statN', { n: allStopPosts.length })}</strong></div>
          {dwellHours > 0 && <div><small>{u('statDwell')}</small><strong>{u('statDwellV', { h: dwellHours })}</strong></div>}
          {walkKm >= 1 && <div><small>{u('statWalk')}</small><strong>{u('statWalkV', { km: walkKm })}</strong></div>}
          {bookAhead.length > 0 && <div class="ith-stat--peach"><small>{u('statBook')}</small><strong>{u('statN', { n: bookAhead.length })}</strong></div>}
        </div>
        <p class="itin-trust">
          ✓ {t('itin.trustStrip').replace('{date}', updated.toLocaleDateString(localeCodes[lang], { year: 'numeric', month: 'long', day: 'numeric' }))}
        </p>
        <details class="disclosure-details">
          <summary>{t('post.disclosureTitle')}</summary>
          <p>{t('post.disclosureBody')} <a href={localizePath('/about', lang)}>{t('post.editorialPolicy')}</a></p>
        </details>
      </div>
      {mosaic.length > 0 && (
        <div class:list={['ith-mosaic', `ith-mosaic--${mosaic.length}`]} aria-hidden="true">
          {mosaic.map((m: any) => <img src={m.src} alt="" width="640" height="640" loading="eager" decoding="async" style={`object-position:${m.pos}`} />)}
        </div>
      )}
    </div>

    {/* The dark bar: arrival date, what it clashes with, the rainy-day view,
        and the older fine-tuning controls folded underneath. The form keeps
        every name and data-* the page script reads. */}
    <div class="ith-bar">
      <form
        class="ith-form"
        data-itin-filters
        data-locale={localeCodes[lang]}
        data-trip-title={title}
        data-page-url={pageUrl}
        data-t-walk-leg={t('itin.legWalk')}
        data-t-transit-leg={t('itin.legTransit')}
        data-t-closed-warning={t('itin.closedOnArrival')}
        data-t-closed-warning-no-swap={t('itin.closedOnArrivalNoSwap')}
        data-t-long-walk={t('itin.longWalkAdvisory')}
      >
        <div class="ith-bar-row">
          <label class="ith-arrival" for="itin-arrival">
            <small>{u('arrivalLabel')}</small>
            <input type="date" name="arrival" id="itin-arrival" />
          </label>
          <p class="ith-clash" data-itin-clash aria-live="polite"><span class="ith-clash-dot" aria-hidden="true"></span><span data-itin-clash-text>{u('arrivalHint')}</span></p>
          {hasRain && (
            <button type="button" class="ith-rain-btn" data-itin-rain aria-pressed="false">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M7 16a4 4 0 0 1-.5-7.97A6 6 0 0 1 18 9a3.5 3.5 0 0 1 0 7M8 19l-1 2M12 19l-1 2M16 19l-1 2"/></svg>
              <span data-itin-rain-label>{u('rainOn')}</span>
            </button>
          )}
        </div>
        <details class="ith-more" name="itin-filters">
          <summary>{t('itin.filterTitle')}</summary>
          <div class="ith-more-grid">
            {/* Pace only ever trims a day's trailing stops (relaxed keeps 3, normal
                keeps 4), so on an itinerary whose busiest day already has 3 stops
                every option renders the identical plan — shown only when it can
                actually change something. */}
            {paceCanChangeSomething && (
              <fieldset>
                <legend>{t('itin.pace')}</legend>
                <label><input type="radio" name="pace" value="relaxed" /> {t('itin.paceRelaxed')}</label>
                <label><input type="radio" name="pace" value="normal" checked /> {t('itin.paceNormal')}</label>
                {d.packedAvailable && (
                  <label><input type="radio" name="pace" value="packed" /> {t('itin.pacePacked')}</label>
                )}
              </fieldset>
            )}
            <fieldset>
              <legend>{t('itin.party')}</legend>
              <label><input type="radio" name="party" value="solo" /> {t('itin.partySolo')}</label>
              <label><input type="radio" name="party" value="couple" /> {t('itin.partyCouple')}</label>
              <label><input type="radio" name="party" value="family" /> {t('itin.partyFamily')}</label>
              <label><input type="radio" name="party" value="seniors" /> {t('itin.partySeniors')}</label>
            </fieldset>
            <fieldset>
              <legend>{t('itin.interests')}</legend>
              <label><input type="checkbox" name="interest" value="food" /> {t('itin.interestFood')}</label>
              <label><input type="checkbox" name="interest" value="culture" /> {t('itin.interestCulture')}</label>
              <label><input type="checkbox" name="interest" value="nature" /> {t('itin.interestNature')}</label>
              <label><input type="checkbox" name="interest" value="shopping" /> {t('itin.interestShopping')}</label>
              <label><input type="checkbox" name="interest" value="nightlife" /> {t('itin.interestNightlife')}</label>
            </fieldset>
          </div>
        </details>
      </form>
      <p class="itin-save-hint" data-itin-save-hint hidden>
        <a href="#itin-email-slot" data-itin-save-link>{t('itin.savePlanHeading')}</a>
      </p>
    </div>

    {/* Sticky day tabs; the date and a clash dot are filled in by the script. */}
    <nav class="itin-day-nav" aria-label={t('itin.indexEyebrow')}>
      {days.map((_: any, i: number) => (
        <a href={`#day-${i + 1}`} data-day-tab={i}>{t('itin.day').replace('{n}', String(i + 1))} <small data-tab-date></small><span class="ith-tab-dot" data-tab-dot hidden aria-hidden="true"></span></a>
      ))}
      <a class="ith-prep" href="#itin-side">{u('prep')}</a>
    </nav>

    <div class="ith-layout">
    <div class="ith-main">

    {/* 5–7. Per-day sections: label+intro → stop cards → legs → day footer */}
    {days.map((day: any, di: number) => (
      <>
      <section id={`day-${di + 1}`} class="itin-day" data-has-rain={day.rainPost ? '1' : ''}>
        <h2 class="itin-day-title">
          {t('itin.day').replace('{n}', String(di + 1))}
          <span class="itin-day-date" data-day-date hidden></span> · {day.label}
        </h2>
        <p class="itin-day-intro">{day.intro}</p>

        <ol class="itin-stops">
          {day.stops.map((stop: any, si: number) => {
            const post = stop.post;
            const p = post.data.place ?? {};
            const rating = typeof p.rating === 'number' ? p.rating : null;
            const stars = rating ? '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating)) : null;
            const closedRaw = closedDaysOf(p.openingHours);
            const closed = closedRaw.map(localizedWeekday);
            const quiet = quietWindowFor(post, stop.slot);
            const tip = transitTip(post);
            // Prefer the clean Google Places venue name over the full SEO post
            // title ("Gwangjang Market: Seoul Travel Guide") — an itinerary card
            // is a list of places, not a list of articles. Falls back to the
            // (localized, when available) post title for posts without a place.
            // shortPlaceLabel handles the full-width separators and the suffix-with-no-
            // separator shapes that the old ASCII split could not see (2026-09-10).
            const stopLabel = shortPlaceLabel(postTitleFor(post), lang) || post.data.place?.name || postTitleFor(post);
            const stopRegionLabel = localizePlace(post.data.region, lang);
            const leg = stop.walkToNext;
            return (
              <>
                <li
                  class="itin-stop"
                  data-slug={post.id}
                  data-priority={si + 1}
                  data-lat={p.lat}
                  data-lng={p.lng}
                  data-cats={interestCatsFor(post).join(',')}
                  data-closed={closedRaw.join(',')}
                  data-dwell={stop.dwellMin}
                >
                  <div class="itin-stop-thumb">
                    <span class="itin-slot-badge">{t(`itin.slot.${stop.slot}` as any)}</span>
                    {/* No photo: the typeset cover, not an empty beige box
                        (owner report, 2026-09-22 — a stop with no hero read as
                        a failed image load). */}
                    {!post.data.heroImage && (
                      <TypesetPlate name={p.name || stopLabel} />
                    )}
                    {post.data.heroImage && (
                      /* thumbOr, not the raw hero. These render at 300×200 and were
                         pulling the 1920px Wikimedia originals — 602KB and 701KB for
                         two of the nine on /itinerary/tokyo-3-days/, roughly 4–5MB to
                         paint nine thumbnails. Rewriting the width in the URL is not
                         an option: Wikimedia now serves only a fixed set of sizes
                         (960 and 1280 answer, 320–800 return 400 "Use thumbnail sizes
                         listed on w.wiki/GHai"). The 640px WebP the wall build already
                         made is ~40KB, self-hosted, and thumbOr falls back to the
                         original when a hero has no thumbnail yet. */
                      <img src={thumbOr(post.data.heroImage.url)} alt={stopLabel} width="300" height="200" loading="lazy" decoding="async" />
                    )}
                  </div>
                  <div class="itin-stop-body">
                    <div class="itin-stop-meta">
                      <span class="itin-slot">{t(`itin.slot.${stop.slot}` as any)}</span>
                      <span class="itin-region-tag">{stopRegionLabel}</span>
                    </div>
                    <h3><a href={postHref(post.id)}>{stopLabel}</a></h3>
                    {stars && (
                      <p class="itin-rating"><span class="stars">{stars}</span> {rating}{p.userRatingsTotal ? ` (${p.userRatingsTotal.toLocaleString()})` : ''}</p>
                    )}
                    <p class="itin-why">{stop.why}</p>

                    <div class="itin-chips">
                      {closed.length > 0 && (
                        <span class="chip chip-closed">{t('itin.closedChip').replace('{days}', closed.join(', '))}</span>
                      )}
                      {quiet && <span class="chip chip-quiet">{t('itin.quietBadge').replace('{range}', quiet)}</span>}
                      {bookSet.has(post.id) && <span class="chip chip-book">{u('ticketChip')}</span>}
                      <span class="chip chip-dwell"><Emoji name="three-oclock" /> {t('itin.dwellLabel')}: {formatDwell(stop.dwellMin)}</span>
                      {/* Family/seniors-only advisory — filled in and shown by the
                          client script from the stop's OWN (possibly recomputed
                          after a pace filter) leg minutes; never rendered with a
                          guessed value, so it starts empty and hidden. */}
                      <span class="chip chip-advisory" data-advisory hidden></span>
                    </div>

                    {tip && (
                      <details class="itin-how">
                        <summary>{u('howToGet')}</summary>
                        <p class="itin-transit-tip">{tip}</p>
                      </details>
                    )}
                  </div>
                </li>

                {/* 6. Leg row between cards */}
                {leg && day.stops[si + 1] && (
                  <li class="itin-leg" aria-hidden="false" data-km={leg.km} data-minutes={leg.minutes ?? ''} data-transit={String(leg.transit)}>
                    <span class="itin-leg-icon">
                      {/* Both icons render server-side; the script only toggles
                          which is hidden — it never reconstructs an <Emoji> SVG
                          client-side, so a recomputed (post-filter) leg still
                          shows the exact same icon the server would have drawn. */}
                      <span data-icon-walk hidden={leg.transit}><Emoji name="compass" /></span>
                      <span data-icon-transit hidden={!leg.transit}><Emoji name="metro" /></span>
                    </span>
                    <span class="itin-leg-text">{legText(leg)}</span>
                    <a class="itin-leg-directions" href={directionsUrl(p, day.stops[si + 1].post.data.place, leg.transit)} target="_blank" rel="noopener">
                      {t('itin.directions')} →
                    </a>
                  </li>
                )}
              </>
            );
          })}
        </ol>

        {/* 7. Day footer: rain swap + full-day route + day-scoped Klook CTA */}
        <div class="itin-day-footer">
          {day.rainPost && (
            <p class="itin-rain">
              <Emoji name="umbrella" class="nav-ico" /> {t('itin.ifItRains').replace('{title}', '')}
              {/* The place, not the headline. This one leaked on the ENGLISH page
                  too: "If it rains: ArtScience Museum: Marina Bay Travel Guide
                  (4.4★)" and "If it rains: Ise Sueyoshi: Where to Eat in Tokyo"
                  (2026-09-10). */}
              <a href={postHref(day.rainPost.id)}>{shortPlaceLabel(postTitleFor(day.rainPost), lang) || postTitleFor(day.rainPost)}</a>
              {day.rainWhy && <span class="itin-rain-why"> — {day.rainWhy}</span>}
            </p>
          )}
          <div class="itin-day-actions">
            {dayRouteUrl(day.stops.map((s: any) => s.post)) && (
              <a class="itin-day-route" data-day-route href={dayRouteUrl(day.stops.map((s: any) => s.post))!} target="_blank" rel="noopener">
                <Emoji name="round-pushpin" /> {t('itin.dayRoute').replace('{n}', String(di + 1))}
              </a>
            )}
            {/* Enabled by the script once an arrival date is chosen — a day plan
                has no absolute dates until then, so there is nothing honest to
                put in an .ics file yet. */}
            <a class="itin-day-route itin-ics-link" data-ics-link download hidden href="#">
              <Emoji name="spiral-calendar" /> {t('itin.addToCalendar').replace('{n}', String(di + 1))}
            </a>
            <a class="book-btn book-btn-primary" href={klookDayHref} target="_blank" rel="sponsored noopener">
              <Emoji name="admission-tickets" /> {t('itin.bookDay').replace('{n}', String(di + 1))}
            </a>
          </div>
        </div>
      </section>
      {/* Contextual lead magnet after Day 1 — the reader has just seen the
          plan's value; "email me this itinerary" converts here, not at the
          footer. */}
      {di === 0 && (
        <div class="itin-email-slot" id="itin-email-slot">
          <ItineraryEmailBox lang={lang} region={d.city} country={d.country} slug={itinerary.id} />
          <ItineraryGuideCard lang={lang} slug={itinerary.id} />
        </div>
      )}
      </>
    ))}

    {/* 8. FAQ, PlanTrip, related region link */}
    {faq.length > 0 && (
      <section class="faq">
        <h2>{t('post.faqTitle')}</h2>
        {faq.map((f: any) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}

    </div>{/* .ith-main */}

    <aside class="ith-side" id="itin-side" aria-label={u('sideTitle')}>
      {bookAll.length > 0 && (
        <section class="ith-card ith-book" data-itin-book>
          <strong class="ith-card-title">{u('bookTitle')}</strong>
          <p class="ith-card-dek">{u('bookDek')}</p>
          <ul>
            {bookAll.map((b: any) => (
              <li data-book-day={b.di} data-book-slug={b.slug}>
                <label>
                  <input type="checkbox" data-book={b.slug} />
                  <span class="ith-book-box" aria-hidden="true"></span>
                  <span class="ith-book-text"><b>{b.label}</b><small>{t('itin.day').replace('{n}', String(b.di + 1))}<span data-book-date={b.di}></span></small></span>
                </label>
              </li>
            ))}
          </ul>
          <a class="ith-btn" href={klookDayHref} target="_blank" rel="sponsored noopener">{u('bookCta')}</a>
          <p class="ith-book-count" data-book-count-text>{u('bookCount', { d: 0, n: bookAhead.length })}</p>
        </section>
      )}
      {pass && passStops.length >= 2 && (
        <section class="ith-card ith-pass" data-affiliate-placement="itinerary-city-pass">
          <strong class="ith-card-title">{u('passTitle')}</strong>
          <p class="ith-card-dek">{passDekA}<span data-pass-n>{passStops.length}</span>{passDekB}</p>
          <ul class="ith-pass-list">{passStops.map((x: any) => <li data-pass-stop={x.slug}>{x.label}</li>)}</ul>
          <a class="ith-btn" href={pass.href} rel="sponsored noopener" target="_blank">{u('passCta')}</a>
          <p class="tp-disclosure">{u('passNote')}</p>
        </section>
      )}
      <section class="ith-card ith-stay">
        <strong class="ith-card-title">{u('stayTitle')}</strong>
        <p class="ith-card-dek">{u('stayDek', { city: regionLabel })}</p>
        <a class="ith-btn ith-btn--dark" href={stayHref} target="_blank" rel="sponsored noopener">{u('stayCta', { city: regionLabel })}</a>
        <p class="tp-disclosure">{t('widget.livePrices')}</p>
      </section>
      <div class="ith-side-actions">
        <SaveButton slug={`itinerary-${itinerary.id}`} title={title} region={regionLabel} country={countryLabel} href={Astro.url.pathname} image={coverImage} lang={lang} compact />
      </div>
      <div class="itin-share"><ShareRow url={Astro.url.toString()} title={title} lang={lang} live /></div>
    </aside>
    </div>{/* .ith-layout */}

    {/* hotels: on a "3 days in <city>" page the stay is the highest-intent
        product, and the card was the one place it was missing (2026-09-02). */}
    <PlanTrip city={d.city} country={d.country} hotels />

    {/* No second newsletter block here (2026-08-23): the itinerary already
        asks for an email after Day 1 ("email me this itinerary") and the
        site-wide popup asks once more — a third ask at the foot of an
        8,000px page was the fourth interruption on a page with one
        subscriber to show for it (UX audit). */}

    <p class="itin-related-link">
      <a href={localizePath(`/regions/${slugifyRegion(d.city)}`, lang)}>{t('itin.moreRegion').replace('{region}', regionLabel)} →</a>
    </p>
  </article>

  {/* Mobile sticky CTA (growth research A1, 2026-08-13): post pages have had a
      sticky booking bar for weeks; itinerary pages — the lead-magnet money
      page — had nothing pinned. 58M-session meta-analysis puts sticky bottom
      CTAs at +31% conversion on mobile, no effect on desktop, so this stays
      mobile-only and reveals only after 500px of scroll (same contract as
      StickyBook: never covers the top of the page, well under the 15%
      interstitial threshold). Tapping scrolls to the existing email box after
      Day 1 — one CTA, no new form. */}
  <div class="sticky-book itin-sticky" data-itin-sticky hidden aria-hidden="true">
    <button class="sb-btn sb-primary" type="button" data-itin-sticky-go>
      <Emoji name="incoming-envelope" /> {t('itin.emailTitle')}
    </button>
  </div>
</BaseLayout>

<script>
  const bar = document.querySelector('[data-itin-sticky]') as HTMLElement | null;
  const slot = document.getElementById('itin-email-slot');
  if (bar && slot) {
    const update = () => {
      // Hide while the email box itself is on screen — a CTA pointing at
      // something already visible is clutter.
      const r = slot.getBoundingClientRect();
      const slotVisible = r.top < window.innerHeight && r.bottom > 0;
      const show = window.scrollY > 500 && !slotVisible;
      bar.hidden = !show;
      bar.setAttribute('aria-hidden', String(!show));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
    bar.querySelector('[data-itin-sticky-go]')?.addEventListener('click', () => {
      slot.scrollIntoView({ behavior: 'smooth', block: 'center' });
      (slot.querySelector('input[type=email]') as HTMLInputElement | null)?.focus({ preventScroll: true });
      if ((window as any).plausible) (window as any).plausible('Itinerary sticky CTA');
    });
  }
</script>

<script>
  // Redesign 2026-09-30: the arrival bar's clash summary, dates and dots on
  // the day tabs, the rainy-day view, the book-ahead checklist and "copy
  // link". It only READS what the filter script above already does to the
  // page (hidden stops, the arrival field), so the two cannot disagree.
  const DAY = 86_400_000;
  const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const page = document.querySelector<HTMLElement>('[data-itin-page]');
  const form = document.querySelector<HTMLFormElement>('[data-itin-filters]');
  if (page && form) {
    const P = page.dataset;
    const locale = form.dataset.locale || undefined;
    const arrivalEl = form.querySelector<HTMLInputElement>('input[name=arrival]');
    const clash = page.querySelector<HTMLElement>('[data-itin-clash]');
    const clashText = page.querySelector<HTMLElement>('[data-itin-clash-text]');
    const hint = clashText?.textContent ?? '';
    // "10/16 금" where dates are written that way (Intl gives "10. 16. (금)").
    const numeric = /^(ko|ja|zh)/.test(locale || '');
    const wdFmt = new Intl.DateTimeFormat(locale, { weekday: 'short', timeZone: 'UTC' });
    const mdFmt = new Intl.DateTimeFormat(locale, { month: 'short', day: 'numeric', weekday: 'short', timeZone: 'UTC' });
    const tabFmt = { format: (d: Date) => (numeric ? `${d.getUTCMonth() + 1}/${d.getUTCDate()} ${wdFmt.format(d)}` : mdFmt.format(d)) };
    const dayWord = (n: number) => (P.dayWord || '{n}').replace('{n}', String(n));

    const refresh = () => {
      const t = arrivalEl?.value ? Date.parse(arrivalEl.value) : NaN;
      const has = Number.isFinite(t);
      const hits: string[] = [];
      document.querySelectorAll<HTMLElement>('.itin-day').forEach((day, i) => {
        const date = has ? new Date(t + i * DAY) : null;
        const tab = page.querySelector<HTMLElement>(`[data-day-tab="${i}"]`);
        const tabDate = tab?.querySelector<HTMLElement>('[data-tab-date]');
        if (tabDate) tabDate.textContent = date ? tabFmt.format(date) : '';
        page.querySelectorAll<HTMLElement>(`[data-book-date="${i}"]`).forEach((el) => { el.textContent = date ? ` · ${tabFmt.format(date)}` : ''; });
        let dayHit = false;
        if (date) {
          const wd = WEEKDAYS[date.getUTCDay()];
          day.querySelectorAll<HTMLElement>('.itin-stop:not([hidden])').forEach((stop) => {
            if ((stop.dataset.closed || '').split(',').includes(wd)) {
              dayHit = true;
              hits.push(`${dayWord(i + 1)} ${(stop.querySelector('h3 a')?.textContent || '').trim()}`);
            }
          });
        }
        tab?.querySelector<HTMLElement>('[data-tab-dot]')?.toggleAttribute('hidden', !dayHit);
      });
      if (clash && clashText) {
        clash.dataset.state = !has ? '' : hits.length ? 'warn' : 'ok';
        clashText.textContent = !has ? hint
          : hits.length ? `${(P.clashN || '').replace('{n}', String(hits.length))} — ${hits.join(', ')}. ${P.clashTip || ''}`
          : P.clashNone || '';
      }
    };
    form.addEventListener('change', () => setTimeout(refresh, 0));
    form.addEventListener('input', () => setTimeout(refresh, 0));
    // After the filter script has restored any saved choices.
    setTimeout(refresh, 0);
    addEventListener('load', refresh);

    // Rainy-day view: bring each day's indoor swap forward and quiet the
    // outdoor stops. Nothing is removed; it is a way of reading the plan.
    const rain = page.querySelector<HTMLButtonElement>('[data-itin-rain]');
    rain?.addEventListener('click', () => {
      const on = !page.classList.contains('is-rain');
      page.classList.toggle('is-rain', on);
      rain.setAttribute('aria-pressed', String(on));
      const label = rain.querySelector('[data-itin-rain-label]');
      if (label) label.textContent = (on ? P.rainOff : P.rainOn) || '';
      if (on) page.querySelector('.itin-rain')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // Book-ahead checklist, kept in this browser only.
    const bookBox = page.querySelector<HTMLElement>('[data-itin-book]');
    if (bookBox) {
      const KEY = `wa-itin-book-${P.slug}`;
      let saved: string[] = [];
      try { saved = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { /* none */ }
      const boxes = [...bookBox.querySelectorAll<HTMLInputElement>('input[data-book]')];
      const count = bookBox.querySelector<HTMLElement>('[data-book-count-text]');
      const paint = () => {
        // Only what the chosen pace shows: an item follows its stop (Codex D6).
        const days = document.querySelectorAll<HTMLElement>('.itin-day');
        const shown = boxes.filter((b) => {
          const li = b.closest<HTMLElement>('li[data-book-day]');
          const day = li ? days[Number(li.dataset.bookDay)] : null;
          const stop = day?.querySelector<HTMLElement>(`.itin-stop[data-slug="${CSS.escape(li!.dataset.bookSlug || '')}"]`);
          const on = !stop || !stop.hidden;
          if (li) li.hidden = !on;
          return on;
        });
        const done = shown.filter((b) => b.checked).length;
        if (count) count.textContent = (P.bookCount || '').replace('{d}', String(done)).replace('{n}', String(shown.length));
      };
      form.addEventListener('change', () => setTimeout(paint, 0));
      for (const b of boxes) {
        b.checked = saved.includes(b.dataset.book!);
        b.addEventListener('change', () => {
          try { localStorage.setItem(KEY, JSON.stringify(boxes.filter((x) => x.checked).map((x) => x.dataset.book))); } catch { /* not kept */ }
          paint();
        });
      }
      // After the filter script has applied the pace from the link or form.
      setTimeout(paint, 0);
    }

    // The city pass card follows the pace too: a stop the pace hides is not
    // listed, the count says how many are left, and under two the card goes.
    const passCard = page.querySelector<HTMLElement>('.ith-pass');
    if (passCard) {
      const items = [...passCard.querySelectorAll<HTMLElement>('[data-pass-stop]')];
      const num = passCard.querySelector<HTMLElement>('[data-pass-n]');
      const paintPass = () => {
        let n = 0;
        for (const li of items) {
          const stops = [...document.querySelectorAll<HTMLElement>(`.itin-stop[data-slug="${CSS.escape(li.dataset.passStop || '')}"]`)];
          li.hidden = stops.length > 0 && stops.every((s) => s.hidden);
          if (!li.hidden) n++;
        }
        if (num) num.textContent = String(n);
        passCard.hidden = n < 2;
      };
      form.addEventListener('change', () => setTimeout(paintPass, 0));
      setTimeout(paintPass, 0);
    }

  }
</script>

<style>
  .itin-trust { font-size: 0.8rem; color: var(--ink-soft); margin: 0.6rem 0 0.4rem; }

  .itin-filters { margin: 1.4rem 0; padding: 0.9rem 1.1rem; background: var(--surface-2); border: 1px solid var(--line-soft); border-radius: var(--r-lg); }
  .itin-filters summary { cursor: pointer; font-weight: 700; color: var(--ink); }
  .itin-filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem 1.4rem; margin-top: 0.9rem; }
  .itin-filter-grid fieldset { border: none; padding: 0; margin: 0; }
  .itin-filter-grid legend { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); padding: 0; margin-bottom: 0.4rem; }
  .itin-filter-grid label { display: flex; align-items: center; gap: 0.4rem; font-size: 0.92rem; padding: 0.15rem 0; }
  /* The bare date control renders as an OS widget that ignores the site's type
     scale and palette, so it read as an unstyled leftover next to the radios. */
  .itin-filter-grid input[type='date'] {
    font: inherit;
    font-size: 0.92rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm, 8px);
    padding: 0.5rem 0.7rem;
    width: 100%;
    max-width: 15rem;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .itin-filter-grid input[type='date']:hover { border-color: var(--accent); }
  .itin-filter-grid input[type='date']:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  /* Tint the picker glyph to the brand instead of the browser's default blue-grey. */
  .itin-filter-grid input[type='date']::-webkit-calendar-picker-indicator {
    cursor: pointer;
    opacity: 0.65;
    filter: sepia(1) saturate(4) hue-rotate(-18deg);
  }
  .itin-filter-grid input[type='date']::-webkit-calendar-picker-indicator:hover { opacity: 1; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }

  /* IKEA-effect save-plan hint: server-hidden, un-hidden by the script after
     the first filter interaction (see Step 1's <script>). */
  .itin-save-hint { margin: 0.6rem 0 0; font-size: 0.85rem; color: var(--ink-soft); }
  .itin-save-hint a { color: var(--accent); font-weight: 700; text-decoration: none; }
  .itin-save-hint a:hover { text-decoration: underline; }

  /* Under the sticky site header (z-index 50, 65px measured), not behind it: at top 0
     the Day buttons slid beneath the header and could not be clicked once the
     page scrolled (2026-10-05 audit). The day sections clear both bars. */
  .itin-day-nav {
    position: sticky; top: 65px; z-index: 20; display: flex; gap: 0.4rem; flex-wrap: wrap;
    margin: 1.2rem 0; padding: 0.6rem 0.2rem; background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(6px); border-bottom: 1px solid var(--line-soft);
  }
  .itin-day-nav a {
    padding: 0.4rem 0.9rem; border-radius: var(--r-pill); font-weight: 600; font-size: 0.88rem;
    color: var(--ink-soft); border: 1px solid var(--line); text-decoration: none; transition: background .15s, color .15s;
  }
  .itin-day-nav a:hover, .itin-day-nav a:focus-visible { background: var(--accent-fill); color: #fff; border-color: var(--accent-fill); }

  .itin-day { margin: 2.2rem 0; scroll-margin-top: calc(65px + 4rem); }
  @media (max-width: 640px) { .itin-day { scroll-margin-top: calc(65px + 7.5rem); } } /* the bar wraps to two rows */
  .itin-day-title { font-family: var(--font-display); margin-bottom: 0.3rem; }
  .itin-day-date { font-family: var(--font-body); font-weight: 500; font-size: 0.62em; color: var(--ink-soft); }
  .itin-day-intro { color: var(--ink-soft); margin-bottom: 1.2rem; max-width: 68ch; }

  .itin-stops { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .itin-stop {
    display: grid; grid-template-columns: 140px 1fr; gap: 1rem;
    padding: 1rem; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface);
    transition: opacity .15s, box-shadow .15s;
  }
  .itin-stop[hidden] { display: none; }
  /* Interests filter: matches ring, non-matches dim — a stop never disappears
     from an interest mismatch (see the "Interests" behavior in the brief). */
  .itin-stop-match { box-shadow: 0 0 0 2px var(--accent); }
  .itin-stop-dim { opacity: 0.6; }
  .itin-stop-thumb { border-radius: var(--r-md); overflow: hidden; background: var(--surface-2); aspect-ratio: 3/2; }
  .itin-stop-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .itin-stop-meta { display: flex; gap: 0.5rem; align-items: center; font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; margin-bottom: 0.2rem; }
  .itin-stop-body h3 { margin: 0 0 0.25rem; font-size: 1.15rem; }
  .itin-stop-body h3 a { color: var(--ink); text-decoration: none; }
  .itin-stop-body h3 a:hover { color: var(--accent); }
  .itin-rating { margin: 0 0 0.4rem; font-size: 0.88rem; color: var(--ink-soft); }
  .itin-why { margin: 0 0 0.6rem; color: var(--ink-soft); font-size: 0.94rem; }

  .itin-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.4rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.78rem; font-weight: 600; padding: 0.28rem 0.6rem; border-radius: var(--r-pill); border: 1px solid var(--line); background: var(--surface-2); color: var(--ink-soft); }
  .chip[hidden] { display: none; }
  /* Closed-day chip is the feature's headline differentiator — render it loud. */
  .chip-closed { background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); color: var(--accent-text); font-weight: 700; }
  .chip-quiet { background: color-mix(in srgb, var(--gold) 14%, var(--surface-2)); border-color: color-mix(in srgb, var(--gold) 35%, var(--line)); color: var(--ink); }
  /* Arrival-date awareness: a stop's OWN closed-day data says today is a closed
     day — flipped in by the script, never guessed. */
  .chip-closed-warning { background: var(--accent-fill); border-color: var(--accent-deep); color: #fff; font-weight: 800; }
  /* Party=family/seniors advisory — same visual family as chip-quiet (gold),
     kept distinct from the red closed-warning so the two can't be confused. */
  .chip-advisory { background: color-mix(in srgb, var(--gold) 18%, var(--surface-2)); border: 1px dashed color-mix(in srgb, var(--gold) 45%, var(--line)); color: var(--ink); }

  .itin-transit-tip { margin: 0.2rem 0 0; font-size: 0.85rem; color: var(--ink-soft); }

  .itin-leg {
    display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 1rem 0.55rem 1.6rem;
    margin-left: 1.6rem; border-left: 2px dashed var(--line); font-size: 0.85rem; color: var(--muted);
  }
  .itin-leg[hidden] { display: none; }
  .itin-leg-text { flex: 1; }
  .itin-leg-directions { color: var(--accent); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .itin-leg-directions:hover { text-decoration: underline; }

  .itin-day-footer { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--line-soft); }
  .itin-rain { font-size: 0.9rem; color: var(--ink-soft); margin: 0 0 0.8rem; }
  .itin-rain a { color: var(--accent); font-weight: 600; }
  .itin-rain-why { color: var(--muted); }
  .itin-day-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .itin-day-route { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.5rem 0.95rem; border-radius: var(--r-pill); font-weight: 600; font-size: 0.9rem; border: 1px solid var(--line); background: var(--surface); color: var(--ink); text-decoration: none; }
  .itin-day-route:hover { border-color: var(--accent); color: var(--accent); }
  .itin-day-route[hidden] { display: none; }

  .itin-related-link { margin: 2rem 0; font-weight: 600; }
  .itin-related-link a { color: var(--accent); }

  @media (max-width: 640px) {
    .itin-stop { grid-template-columns: minmax(0, 1fr); }
    .itin-stop-thumb { aspect-ratio: 16/9; }
  }

  /* 10. Print stylesheet — hide interactive/monetization chrome, linearize cards. */
  @media print {
    .itin-filters, .ith-bar, .ith-side, .ith-mosaic, .itin-day-nav, .itin-day-actions, .book-cta, .newsletter, .plan-trip, .itin-email-slot { display: none !important; }
    .itin-stop { grid-template-columns: minmax(0, 1fr); border: none; border-bottom: 1px solid #ccc; border-radius: 0; page-break-inside: avoid; }
    .itin-stop-thumb { display: none; }
    .itin-leg { margin-left: 0; }
  }

  /* ── Redesign 2026-09-30 ("바르셀로나 일정 개선안") ── */
