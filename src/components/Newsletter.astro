---
// Reusable newsletter signup — our own design, wired to MailerLite.
// Single email field + subscribe button (NO account). Submits directly to the
// MailerLite embedded-form endpoint (double opt-in is ON in MailerLite, so the
// real confirmation happens via an email we don't send ourselves). The endpoint
// returns {"success":true} with open CORS, so we read it for accurate feedback.
import { SITE } from '../siteConfig';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';
import Emoji from './Emoji.astro';
import { interestFields } from '../lib/interest';
// `heading`/`dek` optionally override the default translated copy so the signup
// can MESSAGE-MATCH the page context (e.g. "Planning a trip to Busan?" on a Busan
// page). When omitted, the i18n defaults render unchanged — localized pages that
// don't pass overrides keep full translation.
interface Props { compact?: boolean; lang?: Lang; heading?: string; dek?: string; cta?: string; region?: string; country?: string }
const { compact = false, lang: langProp, heading, dek, cta, region = '', country = '' } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const interest = interestFields({ region, country, lang, source: Astro.url.pathname });
// Same-origin relay (worker/index.mjs → MailerLite form 193609989933237794).
// Direct posts to assets.mailerlite.com get killed by tracker blocklists in
// many browsers ("Network hiccup"); a first-party path can't be blocked.
const ML_ACTION = '/api/subscribe';
---
<section id="newsletter" class:list={['newsletter', { 'newsletter-compact': compact }]}>
  <div class="wrap">
    <div class="nl-inner">
      <p class="kicker gold">{SITE.name} {t('home.newsletterKicker')}</p>
      <h2>{heading ?? t('home.newsletterTitle')}</h2>
      <p class="nl-dek">{dek ?? t('home.newsletterDek')}</p>
      <p class="nl-bonus"><Emoji name="wrapped-gift" /> {t('home.newsletterBonus')}</p>
      <form class="nl-form" data-ml-action={ML_ACTION} novalidate
        data-msg-ok={t('nl.msgOk')} data-msg-err={t('nl.msgErr')} data-msg-net={t('nl.msgNet')}
        data-msg-invalid={t('nl.msgInvalid')} data-sending={t('nl.sending')}
        data-checklist-href={lang === 'en' ? '/free/trip-checklist' : `/${lang}/free/trip-checklist`}>
        <input type="email" name="email" placeholder="you@email.com" aria-label={t('a11y.email')} autocomplete="email" required />
        <input type="hidden" name="region" value={interest.region} />
        <input type="hidden" name="lang" value={interest.lang} />
        <input type="hidden" name="source" value={interest.source} />
        <button type="submit" class="btn btn-primary">{cta ?? t('home.subscribe')}</button>
      </form>
      <p class="nl-note" hidden aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  // Wires every newsletter form on the page to MailerLite. Double opt-in means a
  // subscriber isn't active until they click the confirmation email — so on a
  // successful POST we tell them to check their inbox.
  document.querySelectorAll('.nl-form').forEach((el) => {
    const form = el as HTMLFormElement;
    const note = form.parentElement?.querySelector('.nl-note') as HTMLElement | null;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement | null;
    const action = form.dataset.mlAction;
    const say = (msg: string, ok = false) => {
      if (!note) return;
      note.hidden = false;
      note.textContent = msg;
      note.classList.toggle('nl-note-ok', ok);
      note.classList.toggle('nl-note-err', !ok);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[name=email]') as HTMLInputElement | null;
      const email = input?.value?.trim() ?? '';
      // These two strings were hardcoded English, so a Korean/Japanese/Spanish/
      // Chinese reader who mistyped their address got an English scolding — and
      // watched the button flip to "Subscribing…" mid-submit.
      if (!email || !/.+@.+\..+/.test(email)) { say(form.dataset.msgInvalid || 'Please enter a valid email address.'); return; }
      if (!action) { say('Newsletter is launching soon — thanks for your interest!', true); return; }

      const data = new FormData();
      data.append('fields[email]', email);
      const rd = (n) => (form.querySelector(`input[name=${n}]`)?.value || '');
      if (rd('region')) data.append('fields[region]', rd('region'));
      data.append('fields[lang]', rd('lang') || 'en');
      data.append('fields[signup_source]', rd('source'));
      // Itinerary lead-magnet forms carry the page URL so the welcome email
      // can link straight back to the plan the reader asked for.
      if (rd('itinerary')) data.append('fields[itinerary_url]', rd('itinerary'));
      data.append('ml-submit', '1');
      data.append('anticsrf', 'true');

      const label = btn?.textContent ?? 'Subscribe';
      if (btn) { btn.disabled = true; btn.textContent = form.dataset.sending || 'Sending…'; }
      try {
        // FormData keeps this a CORS-safelisted request (no preflight); the
        // endpoint allows any origin, so we can read the JSON result.
        const res = await fetch(action, { method: 'POST', body: data });
        const json = await res.json().catch(() => ({} as any));
        if (json && json.success) {
          form.reset();
          // Also suppresses the site-wide capture popup for this browser.
          try { localStorage.setItem('wa_nl_subscribed', '1'); } catch {}
          if ((window as any).plausible)
            (window as any).plausible('Newsletter signup', form.dataset.via ? { props: { via: form.dataset.via } } : undefined);
          if (note) {
            note.hidden = false;
            note.classList.add('nl-note-ok');
            note.classList.remove('nl-note-err');
            if (form.dataset.okPlain) {
              // Itinerary box: the success line stands alone ("check your
              // inbox") — a link back to the page the reader is already on
              // would be noise.
              note.textContent = form.dataset.msgOk || '';
            } else {
              // Copy comes from the form's data attributes, which the component
              // filled from the page's language. This string was hardcoded English
              // — URL and all — on 3,786 localized pages: the one moment a reader
              // has just handed over their email, answered in the wrong language.
              const a = document.createElement('a');
              a.href = form.dataset.checklistHref || '/free/trip-checklist';
              a.textContent = (form.dataset.msgOk || '') + ' →';
              note.textContent = '';
              note.appendChild(a);
            }
          }
        } else {
          say(form.dataset.msgErr || 'Please try again in a moment.');
        }
      } catch {
        say(form.dataset.msgNet || 'Please try again in a moment.');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = label; }
      }
    });
  });
</script>
