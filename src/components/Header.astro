---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Flag from './Flag.astro';
import EmojiColor from './EmojiColor.astro';
import { SITE } from '../siteConfig';
import { getLangFromUrl, useTranslations, localizePath, languages, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import countriesData from '../../data/countries.json';
import { orderedContinents, continentSlug, continentLabel } from '../lib/continents';

interface Props { availableLangs?: Lang[] }
const { availableLangs } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getCollection('posts', ({ data }) => !data.draft);
const live = countriesData.countries.filter((c) =>
  posts.some((p) => (p.data.country ?? 'South Korea') === c.name)
);
const CONT_ORDER = orderedContinents();
const contSlug = continentSlug;
// 상단 스트립 — 일본어가 우리 최강 언어인데 언어 전환이 드롭다운 안에 숨어 있었다.
// 5개 언어를 펼쳐 놓아 첫 화면에서 바로 자기 언어로 갈 수 있게 한다.
const topLangs = (Object.keys(languages) as Lang[]).map((l) => ({
  code: l,
  name: languages[l],
  href: availableLangs?.includes(l) ? localizePath(Astro.url.pathname, l) : (l === 'en' ? '/' : `/${l}/`),
  active: l === lang,
}));
// 빌드 시각 = 사이트가 실제로 갱신된 날. 매일 자동 발행되므로 지어낸 값이 아니다.
const builtOn = new Date().toLocaleDateString(
  ({ en: 'en-GB', ko: 'ko-KR', ja: 'ja-JP', es: 'es-ES', zh: 'zh-CN' })[lang] ?? 'en-GB',
  { year: 'numeric', month: 'short', day: 'numeric' }
);

const navGroups = CONT_ORDER
  .map((k) => ({ name: k, slug: contSlug(k), countries: live.filter((c) => (c.continent || 'Other') === k) }))
  .filter((g) => g.countries.length);
---

<div class="topbar">
  <div class="wrap">
    <p class="topbar-fact"><span class="topbar-dot" aria-hidden="true"></span>{t('top.lastCheck')} · {builtOn}</p>
    <nav class="topbar-langs" aria-label={t('lang.label')}>
      <span class="topbar-readin">{t('top.readIn')}</span>
      {topLangs.map((l) => (
        <a href={l.href} lang={l.code} hreflang={l.code}
           class:list={['topbar-lang', { 'is-active': l.active }]}
           aria-current={l.active ? 'true' : undefined}>{l.name}</a>
      ))}
    </nav>
  </div>
</div>

<header class="site-header">
  <div class="wrap">
    <a href={localizePath('/', lang)} class="brand"><Logo size={26} /> <span>{SITE.name}</span></a>

    <input type="checkbox" id="nav-toggle" hidden />
    <label for="nav-toggle" class="menu-toggle" aria-label={t('a11y.menu')} role="button" tabindex="0" aria-expanded="false" aria-controls="site-nav">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </label>

    {/* Named: a screen reader announcing two unlabelled <nav> landmarks (this
        one and the footer's) gives the user no way to tell them apart. */}
    <nav class="nav" id="site-nav" data-level="1" aria-label={t('a11y.mainNav')}>
      {/* Mobile drill-down header. On phones the flat list ran far past the fold,
          so the menu steps down: top level → continents → that continent's
          countries. Desktop ignores all of this and keeps the hover dropdown. */}
      <button type="button" class="nav-back" hidden>
        <span aria-hidden="true">←</span> <span class="nav-back-label"></span>
      </button>

      <div class="nav-dd dest-dd">
        <a href={localizePath('/destinations', lang)} class="nav-dd-toggle">{t('nav.destinations')} ▾</a>
        <button type="button" class="nav-drill" data-to="2">
          <span><EmojiColor name="round-pushpin" class="nav-ico" /> {t('nav.destinations')}</span> <span aria-hidden="true">›</span>
        </button>
        <div class="nav-dd-menu">
          {navGroups.map((g) => (
            <div class="nav-cont" data-cont={g.slug}>
              <a class="nav-dd-head nav-dd-head-link" href={localizePath(`/continents/${g.slug}`, lang)}><EmojiColor name="globe-showing-asia-australia" class="nav-ico" /> {continentLabel(t, g.name)} →</a>
              <button type="button" class="nav-drill" data-to="3" data-cont={g.slug} data-label={continentLabel(t, g.name)}>
                {continentLabel(t, g.name)} <span aria-hidden="true">›</span>
              </button>
              <div class="nav-cont-list">
                {g.countries.map((c) => (
                  <a href={localizePath(`/destinations/${c.slug}`, lang)}><Flag code={c.iso2} class="flag-ico" /> {localizePlace(c.name, lang)}</a>
                ))}
              </div>
            </div>
          ))}
          <a href={localizePath('/destinations', lang)} class="nav-dd-all"><EmojiColor name="world-map" /> {t('nav.allDestinations')} →</a>
          {/* "When to go" is a where/when-to-travel tool, so it belongs beside the
              destination list rather than competing for a top-level slot — that
              slot now goes to itineraries, the thing this site has that plain
              guide blogs don't. Keeps the bar at 5 items (mobile-safe). */}
          <a href={localizePath('/tools/when-to-go', lang)} class="nav-dd-all"><EmojiColor name="cherry-blossom" /> {t('nav.tools')} →</a>
          {/* Two tools, two questions: which month to come, and which hour to
              turn up. They shared the "when to go" label until the month one
              existed, and the crowd finder was the one wearing it. */}
          <a href={localizePath('/tools/best-time', lang)} class="nav-dd-all"><EmojiColor name="three-oclock" /> {t('nav.quietTimes')} →</a>
        </div>
      </div>
      {/* Icons ride along on every top item but only paint on mobile (see the
          ≤820px rule in global.css). The phone menu is a plain vertical stack of
          same-looking text rows, so an icon is the fastest thing to aim at; the
          desktop bar is a short horizontal row where the same icons only add
          noise and width. */}
      <a href={localizePath('/itinerary', lang)}><EmojiColor name="spiral-calendar" class="nav-ico" /> {t('nav.itineraries')}</a>
      {/* Appears only once something is saved. Without it a visitor taps Save, the
          button says "Saved", and nothing else on the site ever acknowledges that a
          list exists — the footer link alone was not discovery. */}
      <a href={localizePath('/my-trip', lang)} class="nav-trip" hidden>
        <EmojiColor name="round-pushpin" class="nav-ico" /> {t('trip.title')} <span class="nav-trip-n"></span>
      </a>
      <a href={localizePath('/events', lang)}><EmojiColor name="admission-tickets" class="nav-ico" /> {t('nav.events')}</a>
      <a href={localizePath('/flights', lang)}><EmojiColor name="airplane" class="nav-ico" /> {t('nav.flights')}</a>
      <a href={localizePath('/about', lang)}><EmojiColor name="compass" class="nav-ico" /> {t('nav.about')}</a>
      {/* The language dropdown lived here until 2026-08-08. The topbar strip
          above the header now shows all five languages on every viewport
          (44px touch targets on phones), so a second selector in the nav was
          pure duplication — the owner called it. hreflang links in <head>
          still carry the SEO signal; LanguageSwitcher.astro stays in the tree
          for any future surface that has no topbar. */}
    </nav>
  </div>
</header>

<script>
  // Reveals the header link and keeps its count current. Listens for both the
  // in-page event and `storage`, so another tab saving is reflected here too.
  (() => {
    const KEY = 'wa_trip_v1';
    const paint = () => {
      let n = 0;
      try {
        const v = JSON.parse(localStorage.getItem(KEY) || '[]');
        n = Array.isArray(v) ? v.length : 0;
      } catch { n = 0; }
      document.querySelectorAll<HTMLElement>('.nav-trip').forEach((el) => {
        el.hidden = n === 0;
        const badge = el.querySelector('.nav-trip-n');
        if (badge) badge.textContent = n ? String(n) : '';
      });
    };
    if (document.readyState !== 'loading') paint();
    else document.addEventListener('DOMContentLoaded', paint);
    window.addEventListener('wa-trip-change', paint);
    window.addEventListener('storage', (e) => { if (e.key === KEY) paint(); });
  })();
</script>

<script>
  // Desktop hover-intent for the continent flyouts. Pure :hover closed the
  // flyout under the pointer whenever the cursor drifted diagonally from the
  // "Asia" row toward a country low in its list — the diagonal crosses the
  // "All destinations" links under the row, hover ends, and CSS can't grant a
  // grace period because pointer-events:none lands the instant hover does
  // (owner's report + live probe, 2026-08-15). So: on mouseleave, keep the
  // row .is-open for GRACE ms; cancel if the cursor re-enters the row or its
  // flyout; opening another continent closes the rest at once (no two
  // flyouts). Mouse-only — touch/keyboard paths are untouched.
  (() => {
    if (!window.matchMedia('(min-width: 821px) and (hover: hover)').matches) return;
    const GRACE = 450;
    const conts = Array.from(document.querySelectorAll<HTMLElement>('.nav-dd-menu .nav-cont'));
    if (!conts.length) return;
    const timers = new WeakMap<HTMLElement, number>();
    const closeAll = (except?: HTMLElement) => conts.forEach((c) => { if (c !== except) { c.classList.remove('is-open'); const t = timers.get(c); if (t) { clearTimeout(t); timers.delete(c); } } });
    conts.forEach((c) => {
      c.addEventListener('mouseenter', () => { const t = timers.get(c); if (t) { clearTimeout(t); timers.delete(c); } closeAll(c); c.classList.add('is-open'); });
      c.addEventListener('mouseleave', () => { timers.set(c, window.setTimeout(() => { c.classList.remove('is-open'); timers.delete(c); }, GRACE)); });
    });
    // Leaving the whole dropdown clears everything so a flyout never lingers
    // after the menu itself has gone.
    document.querySelector('.dest-dd')?.addEventListener('mouseleave', () => closeAll());
  })();
</script>

<script>
  // Mobile-only drill-down. Levels: 1 = top menu, 2 = continents, 3 = countries of
  // the chosen continent. Desktop never changes level (the CSS only reacts to
  // data-level below 820px), so the hover dropdown is untouched.
  (() => {
    const nav = document.querySelector('.nav');
    const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
    if (!nav) return;
    const back = nav.querySelector('.nav-back') as HTMLButtonElement | null;
    const backLabel = nav.querySelector('.nav-back-label') as HTMLElement | null;
    const rootLabel = (nav.querySelector('.nav-drill[data-to="2"]')?.textContent || '').replace('›', '').trim();

    const setLevel = (level: string, contSlug?: string, label?: string) => {
      nav.setAttribute('data-level', level);
      nav.querySelectorAll('.nav-cont').forEach((el) => el.classList.toggle('open', el.getAttribute('data-cont') === contSlug));
      if (back) back.hidden = level === '1';
      if (backLabel) backLabel.textContent = level === '3' ? rootLabel : level === '2' ? '' : '';
      if (level === '3' && backLabel && label) backLabel.textContent = rootLabel;
      nav.scrollTop = 0;
    };

    nav.querySelectorAll('.nav-drill').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const b = btn as HTMLButtonElement;
        setLevel(b.dataset.to || '1', b.dataset.cont, b.dataset.label);
      });
    });

    back?.addEventListener('click', () => {
      setLevel(nav.getAttribute('data-level') === '3' ? '2' : '1');
    });

    // Closing the hamburger resets to the top level for the next open.
    toggle?.addEventListener('change', () => { if (!toggle.checked) setLevel('1'); });
  })();
</script>

<script>
  // A <label> is not keyboard-operable: browsers give it no tab stop and no
  // activation key, so the phone menu button could be neither reached nor
  // pressed. Enter and Space now toggle it, Escape closes it, and aria-expanded
  // tells a screen reader which state it is in.
  {
    // Typed lookups: querySelector returns Element, which has no .checked or
    // .focus(). The code was always right at runtime — the annotations just
    // say so, which is what lets `astro check` be a gate instead of noise.
    const box = document.getElementById('nav-toggle') as HTMLInputElement | null;
    const btn = document.querySelector<HTMLElement>('.menu-toggle');
    if (box && btn) {
      const sync = () => btn.setAttribute('aria-expanded', String(box.checked));
      btn.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        box.checked = !box.checked;
        sync();
        if (box.checked) document.querySelector<HTMLElement>('.nav a, .nav button')?.focus();
      });
      box.addEventListener('change', sync);
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key !== 'Escape' || !box.checked) return;
        box.checked = false;
        sync();
        btn.focus();
      });
      sync();
    }
  }
</script>
