---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Flag from './Flag.astro';
import Emoji from './Emoji.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SITE } from '../siteConfig';
import { getLangFromUrl, useTranslations, localizePath, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import countriesData from '../../data/countries.json';
import { orderedContinents, continentSlug, continentLabel } from '../lib/continents';

interface Props { availableLangs?: Lang[] }
const { availableLangs } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getCollection('posts', ({ data }) => !data.draft);
const live = countriesData.countries.filter((c) =>
  posts.some((p) => (p.data.country ?? 'South Korea') === c.name)
);
const CONT_ORDER = orderedContinents();
const contSlug = continentSlug;
const navGroups = CONT_ORDER
  .map((k) => ({ name: k, slug: contSlug(k), countries: live.filter((c) => (c.continent || 'Other') === k) }))
  .filter((g) => g.countries.length);
---

<header class="site-header">
  <div class="wrap">
    <a href={localizePath('/', lang)} class="brand"><Logo size={26} /> <span>{SITE.name}</span></a>

    <input type="checkbox" id="nav-toggle" hidden />
    <label for="nav-toggle" class="menu-toggle" aria-label="Menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </label>

    <nav class="nav" data-level="1">
      {/* Mobile drill-down header. On phones the flat list ran far past the fold,
          so the menu steps down: top level → continents → that continent's
          countries. Desktop ignores all of this and keeps the hover dropdown. */}
      <button type="button" class="nav-back" hidden>
        <span aria-hidden="true">←</span> <span class="nav-back-label"></span>
      </button>

      <div class="nav-dd dest-dd">
        <a href={localizePath('/destinations', lang)} class="nav-dd-toggle">{t('nav.destinations')} ▾</a>
        <button type="button" class="nav-drill" data-to="2">
          <span><Emoji name="round-pushpin" class="nav-ico" /> {t('nav.destinations')}</span> <span aria-hidden="true">›</span>
        </button>
        <div class="nav-dd-menu">
          {navGroups.map((g) => (
            <div class="nav-cont" data-cont={g.slug}>
              <a class="nav-dd-head nav-dd-head-link" href={localizePath(`/continents/${g.slug}`, lang)}>{continentLabel(t, g.name)} →</a>
              <button type="button" class="nav-drill" data-to="3" data-cont={g.slug} data-label={continentLabel(t, g.name)}>
                {continentLabel(t, g.name)} <span aria-hidden="true">›</span>
              </button>
              <div class="nav-cont-list">
                {g.countries.map((c) => (
                  <a href={localizePath(`/destinations/${c.slug}`, lang)}><Flag code={c.iso2} class="flag-ico" /> {localizePlace(c.name, lang)}</a>
                ))}
              </div>
            </div>
          ))}
          <a href={localizePath('/destinations', lang)} class="nav-dd-all"><Emoji name="world-map" /> {t('nav.allDestinations')} →</a>
          {/* "When to go" is a where/when-to-travel tool, so it belongs beside the
              destination list rather than competing for a top-level slot — that
              slot now goes to itineraries, the thing this site has that plain
              guide blogs don't. Keeps the bar at 5 items (mobile-safe). */}
          <a href={localizePath('/tools/when-to-go', lang)} class="nav-dd-all"><Emoji name="cherry-blossom" /> {t('nav.tools')} →</a>
          {/* Two tools, two questions: which month to come, and which hour to
              turn up. They shared the "when to go" label until the month one
              existed, and the crowd finder was the one wearing it. */}
          <a href={localizePath('/tools/best-time', lang)} class="nav-dd-all"><Emoji name="three-oclock" /> {t('nav.quietTimes')} →</a>
        </div>
      </div>
      {/* Icons ride along on every top item but only paint on mobile (see the
          ≤820px rule in global.css). The phone menu is a plain vertical stack of
          same-looking text rows, so an icon is the fastest thing to aim at; the
          desktop bar is a short horizontal row where the same icons only add
          noise and width. */}
      <a href={localizePath('/itinerary', lang)}><Emoji name="spiral-calendar" class="nav-ico" /> {t('nav.itineraries')}</a>
      {/* Appears only once something is saved. Without it a visitor taps Save, the
          button says "Saved", and nothing else on the site ever acknowledges that a
          list exists — the footer link alone was not discovery. */}
      <a href={localizePath('/my-trip', lang)} class="nav-trip" hidden>
        <Emoji name="round-pushpin" class="nav-ico" /> {t('trip.title')} <span class="nav-trip-n"></span>
      </a>
      <a href={localizePath('/events', lang)}><Emoji name="admission-tickets" class="nav-ico" /> {t('nav.events')}</a>
      <a href={localizePath('/flights', lang)}><Emoji name="airplane" class="nav-ico" /> {t('nav.flights')}</a>
      <a href={localizePath('/about', lang)}><Emoji name="compass" class="nav-ico" /> {t('nav.about')}</a>
      <LanguageSwitcher availableLangs={availableLangs} />
    </nav>
  </div>
</header>

<script>
  // Reveals the header link and keeps its count current. Listens for both the
  // in-page event and `storage`, so another tab saving is reflected here too.
  (() => {
    const KEY = 'wa_trip_v1';
    const paint = () => {
      let n = 0;
      try {
        const v = JSON.parse(localStorage.getItem(KEY) || '[]');
        n = Array.isArray(v) ? v.length : 0;
      } catch { n = 0; }
      document.querySelectorAll('.nav-trip').forEach((el) => {
        el.hidden = n === 0;
        const badge = el.querySelector('.nav-trip-n');
        if (badge) badge.textContent = n ? String(n) : '';
      });
    };
    if (document.readyState !== 'loading') paint();
    else document.addEventListener('DOMContentLoaded', paint);
    window.addEventListener('wa-trip-change', paint);
    window.addEventListener('storage', (e) => { if (e.key === KEY) paint(); });
  })();
</script>

<script>
  // Mobile-only drill-down. Levels: 1 = top menu, 2 = continents, 3 = countries of
  // the chosen continent. Desktop never changes level (the CSS only reacts to
  // data-level below 820px), so the hover dropdown is untouched.
  (() => {
    const nav = document.querySelector('.nav');
    const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
    if (!nav) return;
    const back = nav.querySelector('.nav-back') as HTMLButtonElement | null;
    const backLabel = nav.querySelector('.nav-back-label') as HTMLElement | null;
    const rootLabel = (nav.querySelector('.nav-drill[data-to="2"]')?.textContent || '').replace('›', '').trim();

    const setLevel = (level: string, contSlug?: string, label?: string) => {
      nav.setAttribute('data-level', level);
      nav.querySelectorAll('.nav-cont').forEach((el) => el.classList.toggle('open', el.getAttribute('data-cont') === contSlug));
      if (back) back.hidden = level === '1';
      if (backLabel) backLabel.textContent = level === '3' ? rootLabel : level === '2' ? '' : '';
      if (level === '3' && backLabel && label) backLabel.textContent = rootLabel;
      nav.scrollTop = 0;
    };

    nav.querySelectorAll('.nav-drill').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const b = btn as HTMLButtonElement;
        setLevel(b.dataset.to || '1', b.dataset.cont, b.dataset.label);
      });
    });

    back?.addEventListener('click', () => {
      setLevel(nav.getAttribute('data-level') === '3' ? '2' : '1');
    });

    // Closing the hamburger resets to the top level for the next open.
    toggle?.addEventListener('change', () => { if (!toggle.checked) setLevel('1'); });
  })();
</script>
