---
import { getCollection } from 'astro:content';
import { createHash } from 'node:crypto';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from './Newsletter.astro';
import AboutNav from './AboutNav.astro';
import countriesData from '../../data/countries.json';
import { EDITOR_VISITED } from '../lib/editorVisited';
import { localizePath, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';

// /about (+ /[lang]/about): the editorial policy, rebuilt 2026-10-01 from the
// owner's "편집 원칙 개선안" mock-up. Everything that counts is computed at build
// time — visited places and their continents (src/lib/editorVisited.ts), guide
// counts per country, the photos in the image section and the credits under
// them — so a new country, a new guide or a new trip changes the page without
// anyone editing it. The two hero photos are the editor's own (Saigon,
// 2026-08-15), not stock: the page that says "a real person checks this" shows
// that person's camera roll first.
interface Props { lang: Lang }
const { lang } = Astro.props as Props;

const posts = await getCollection('posts', ({ data }) => !data.draft);
const byCountry = new Map<string, number>();
const byRegion = new Map<string, number>();
for (const p of posts) {
  byCountry.set(p.data.country, (byCountry.get(p.data.country) ?? 0) + 1);
  if (p.data.region) byRegion.set(p.data.region, (byRegion.get(p.data.region) ?? 0) + 1);
}
const countrySlug = new Map(countriesData.countries.map((c: { name: string; slug: string }) => [c.name, c.slug]));
const visited = EDITOR_VISITED.map((v) => {
  const n = v.region ? (byRegion.get(v.place) ?? 0) : (byCountry.get(v.place) ?? 0);
  const slug = v.region ? null : countrySlug.get(v.place);
  const href = n > 0 ? (slug ? localizePath(`/destinations/${slug}`, lang) : localizePath(`/regions/${v.place.toLowerCase().replace(/\s+/g, '-')}`, lang)) : null;
  return { ...v, n, href };
});
const continents = ['Asia', 'Europe', 'North America', 'Oceania'] as const;
const contCount = Object.fromEntries(continents.map((c) => [c, visited.filter((v) => v.continent === c).length]));
const visitedWithGuides = visited.filter((v) => v.href).length;
const continentsVisited = continents.filter((c) => contCount[c] > 0).length;
const totalGuides = posts.length;
const countriesCovered = new Set(posts.map((p) => p.data.country)).size;

// Image section: three real heroes with their real credits — the claim
// "every photo is credited" shown, not told. Newest licensed-source posts with a
// built wall thumbnail, one per country so the three do not look alike.
const wallHash = (s: string) => createHash('sha1').update(s).digest('hex').slice(0, 16);
const WALL_DIR = fileURLToPath(new URL('../../public/wall/', import.meta.url));
const seenCountry = new Set<string>();
// A localized page links only to posts that exist in that language (codex:
// /ko/posts/<untranslated> is a 404).
const translated = lang === 'en' ? null : new Set((await getCollection('postI18n')).map((e) => e.id).filter((id) => id.startsWith(`${lang}/`)).map((id) => id.slice(lang.length + 1)));
const proofPhotos = posts
  .filter((p) => !translated || translated.has(p.id))
  .filter((p) => ['wikimedia', 'kto-open', 'openverse-cc'].includes(p.data.heroImage?.license ?? '') && p.data.heroImage?.credit)
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))
  .flatMap((p) => {
    const url = p.data.heroImage!.url;
    const name = `${wallHash(url)}.webp`;
    if (!existsSync(WALL_DIR + name) || seenCountry.has(p.data.country)) return [];
    seenCountry.add(p.data.country);
    return [{ src: `/wall/${name}`, credit: p.data.heroImage!.credit!, href: localizePath(`/posts/${p.id}`, lang), place: p.data.place?.name ?? p.data.region }];
  })
  .slice(0, 3);

