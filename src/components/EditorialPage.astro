      ['信息有误怎么办？', '请使用上面的更正表单或给我们写信。确认的错误会被更正，指南也会重新核对。'],
      ['网站靠什么运营？', '部分链接是联属链接：通过它预订，我们可能获得佣金，您无需额外付费。写什么、推荐什么，与此无关。'],
    ],
    nlEyebrow: '编辑的下一段旅程', nlHeading: '新指南上线，第一时间收到',
    nlDek: '每周一篇真正有用的旅行指南。订阅还能获得可打印的行前准备清单。',
    nlCta: '免费订阅 →',
  },
} as const;
const t = L[lang];

// Names of visited places that have no content yet are not in i18n/places;
// keep them here so a Korean reader never sees "Mongolia".
const EXTRA: Record<string, Partial<Record<Lang, string>>> = {
  Laos: { ko: '라오스', ja: 'ラオス', es: 'Laos', zh: '老挝' },
  Macau: { ko: '마카오', ja: 'マカオ', es: 'Macao', zh: '澳门' },
  Mongolia: { ko: '몽골', ja: 'モンゴル', es: 'Mongolia', zh: '蒙古' },
  Georgia: { ko: '조지아', ja: 'ジョージア', es: 'Georgia', zh: '格鲁吉亚' },
  'Czech Republic': { ko: '체코', ja: 'チェコ', es: 'Chequia', zh: '捷克' },
  Russia: { ko: '러시아', ja: 'ロシア', es: 'Rusia', zh: '俄罗斯' },
  'New Zealand': { ko: '뉴질랜드', ja: 'ニュージーランド', es: 'Nueva Zelanda', zh: '新西兰' },
};
const placeName = (p: string) => (lang !== 'en' && EXTRA[p]?.[lang]) || localizePlace(p, lang);
const CONT: Record<string, Record<Lang, string>> = {
  Asia: { en: 'Asia', ko: '아시아', ja: 'アジア', es: 'Asia', zh: '亚洲' },
  Europe: { en: 'Europe', ko: '유럽', ja: 'ヨーロッパ', es: 'Europa', zh: '欧洲' },
  'North America': { en: 'Americas', ko: '아메리카', ja: 'アメリカ', es: 'América', zh: '美洲' },
  Oceania: { en: 'Oceania', ko: '오세아니아', ja: 'オセアニア', es: 'Oceanía', zh: '大洋洲' },
};
const nf = new Intl.NumberFormat(lang === 'zh' ? 'zh-CN' : lang);
const contactEmail = 'hello@wanderatlasguides.com';
const methodHref = localizePath('/methodology', lang);
const contactHref = localizePath('/contact', lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<BaseLayout title={t.metaTitle} description={t.metaDesc} localized={true} image="/editor-photos/la-scene-saigon-facade.jpg" jsonLd={jsonLd}>
  <div class="ep">
    <AboutNav lang={lang} current="about" />

    <!-- 1. Hero -->
    <section class="ep-hero">
      <div class="ep-hero-copy">
        <span class="ep-pill">{t.eyebrow}</span>
        <h1><span>{t.h1a}</span> <em>{t.h1b}</em> <em>{t.h1c}</em></h1>
        <p class="ep-dek">{t.dek}</p>
        <div class="ep-ctas">
          <a class="ep-btn ep-btn-cta" href="#visited">{t.ctaVisited}</a>
          <a class="ep-btn ep-btn-ghost" href={methodHref}>{t.ctaMethod}</a>
        </div>
      </div>
      <div class="ep-hero-media">
        <a class="ep-arch" href={localizePath('/posts/ho-chi-minh-city-la-scene', lang)}>
          <img src="/editor-photos/la-scene-saigon-facade.jpg" alt="" width="520" height="680" loading="eager" fetchpriority="high" />
          <span class="ep-phototag">📷 {t.photoTag}</span>
        </a>
        <a class="ep-circle" href={localizePath('/posts/ho-chi-minh-city-yakiuo-ishikawa', lang)} aria-label={t.photoTag}>
          <img src="/editor-photos/yakiuo-ishikawa-saigon-entrance.jpg" alt="" width="200" height="200" loading="lazy" />
        </a>
        <div class="ep-card">
          <div class="ep-card-head"><span class="ep-avatar" aria-hidden="true">P</span><div><strong>{t.cardName}</strong><span>{t.cardRole}</span></div></div>
          <div class="ep-stats">
            <div><span>{t.statPlaces}</span><b>{visited.length}</b></div>
            <div><span>{t.statConts}</span><b>{continentsVisited}</b></div>
            <div><span>{t.statGuides}</span><b>{nf.format(totalGuides)}</b></div>
          </div>
        </div>
      </div>
    </section>
    <p class="ep-strip">✓ {t.strip(nf.format(totalGuides), countriesCovered)}</p>

    <!-- 2. Four promises -->
    <section class="ep-promises">
      {t.p.map(([h, b], i) => (
        <article class={`ep-promise ep-promise-${i}`}>
          <span class="ep-promise-ico" aria-hidden="true">{['◎', '↻', '✦', '▣'][i]}</span>
          <h2>{h}</h2>
          <p>{b}</p>
        </article>
      ))}
    </section>

    <!-- 3. Editor + visited places -->
    <section class="ep-editor" id="visited">
      <div class="ep-editor-who">
        <span class="ep-avatar ep-avatar-lg" aria-hidden="true">P</span>
        <span class="ep-kicker">{t.edEyebrow}</span>
        <h2 class="ep-edname">{t.edName}</h2>
        <p>{t.edBio}</p>
        <p class="ep-pen"><strong>{t.edPen}</strong>{t.edPenRest}</p>
        <div class="ep-social">
          <a href="https://www.instagram.com/wander_atlas_guides/" rel="me noopener" target="_blank">Instagram</a>
          <a href="https://www.pinterest.com/pixervtm/" rel="me noopener" target="_blank">Pinterest</a>
          <a href="https://www.threads.net/@wander_atlas_guides" rel="me noopener" target="_blank">Threads</a>
        </div>
      </div>
      <div class="ep-visited" data-visited>
        <div class="ep-visited-head">
          <h2>{t.visTitle}</h2>
          <span>{t.visSub(visited.length, visitedWithGuides)}</span>
        </div>
        <div class="ep-filters" role="group">
          <button type="button" class="ep-chip is-on" data-cont="all">{t.all} <small>{visited.length}</small></button>
          {continents.filter((c) => contCount[c] > 0).map((c) => (
            <button type="button" class="ep-chip" data-cont={c}>{CONT[c][lang]} <small>{contCount[c]}</small></button>
          ))}
        </div>
        <label class="ep-toggle"><input type="checkbox" data-only-guides /> <span>{t.onlyGuides}</span></label>
        <ul class="ep-places">
          {visited.map((v) => (
            <li data-cont={v.continent} data-has={v.href ? '1' : '0'}>
              {v.href
                ? <a href={v.href}><span class="ep-pname">{placeName(v.place)}</span>{v.scope && <span class="ep-scope">{t.scope[v.scope]}</span>}<span class="ep-gcount">{t.guides(v.n)} →</span></a>
                : <span class="ep-nolink"><span class="ep-pname">{placeName(v.place)}</span>{v.scope && <span class="ep-scope">{t.scope[v.scope]}</span>}</span>}
            </li>
          ))}
        </ul>
        <p class="ep-note">{t.visNote}</p>
      </div>
    </section>

    <!-- 4. Pipeline -->
    <section class="ep-pipe" data-pipe>
      <h2 class="ep-h2">{t.pipeTitle}</h2>
      <p class="ep-sub">{t.pipeDek}</p>
      <div class="ep-steps" role="tablist">
        {t.steps.map((s, i) => (
          <button type="button" role="tab" id={`ep-tab-${i}`} aria-controls={`ep-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} class={`ep-step who-${s.who}`} data-i={i}>
            <span class="ep-step-n">{i + 1}</span><span class="ep-step-who">{t.whoLabel[s.who as keyof typeof t.whoLabel]}</span>
            <span class="ep-step-t">{s.title}</span>
          </button>
        ))}
      </div>
      {t.steps.map((s, i) => (
        <div class="ep-panel" role="tabpanel" id={`ep-panel-${i}`} aria-labelledby={`ep-tab-${i}`} hidden={i !== 0}>
          <div>
            <span class={`ep-tag who-${s.who}`}>{i + 1} · {t.whoLabel[s.who as keyof typeof t.whoLabel]}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
          <div class="ep-keep">
            <span class="ep-keep-t">{t.keepTitle}</span>
            <ul>{s.keep.map((k) => <li>{k}</li>)}</ul>
            <div class="ep-nav">
              <button type="button" class="ep-btn ep-btn-ghost ep-sm" data-go={i - 1} disabled={i === 0}>{t.prev}</button>
              {i < t.steps.length - 1 && <button type="button" class="ep-btn ep-btn-cta ep-sm" data-go={i + 1}>{t.next}</button>}
            </div>
          </div>
        </div>
      ))}
      <div class="ep-ai">
        <div class="ep-ai-yes"><span>{t.aiDoes}</span><ul>{t.aiDoesList.map((x) => <li>{x}</li>)}</ul></div>
        <div class="ep-ai-no"><span>{t.aiNot}</span><ul>{t.aiNotList.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <!-- 5. Images -->
    <section class="ep-images">
      <div class="ep-images-copy">
        <span class="ep-pill ep-pill-dark">{t.imgEyebrow}</span>
        <h2>{t.imgTitle}</h2>
        <p>{t.imgDek}</p>
        <ul class="ep-sources">{t.imgSources.map(([a, b]) => <li><strong>{a}</strong><span>{b}</span></li>)}</ul>
      </div>
      {proofPhotos.length > 0 && (
        <figure class="ep-proof">
          <div class="ep-proof-grid">
            {proofPhotos.map((ph) => (
              <a href={ph.href} class="ep-proof-item">
                <img src={ph.src} alt={ph.place} loading="lazy" width="320" height="240" />
                <span class="ep-credit">{ph.credit}</span>
              </a>
            ))}
          </div>
          <figcaption>{t.imgProof}</figcaption>
        </figure>
      )}
    </section>

    <!-- 6. Corrections -->
    <section class="ep-fix" id="corrections">
      <div class="ep-fix-copy">
        <span class="ep-kicker">{t.fixEyebrow}</span>
        <h2>{t.fixTitle}</h2>
        <p>{t.fixDek}</p>
        <a class="ep-link" href={contactHref}>{t.fixOther}</a>
      </div>
      <form class="ep-form" data-fix data-email={contactEmail} data-page={Astro.url.pathname}>
        <fieldset>
          <legend>{t.fType}</legend>
          <div class="ep-types">
            {t.fTypes.map((x, i) => (
              <label class="ep-type"><input type="radio" name="kind" value={x} checked={i === 0} /><span>{x}</span></label>
            ))}
          </div>
        </fieldset>
        <label class="ep-field"><span>{t.fPlace}</span><input name="place" required placeholder={t.fPlacePh} /></label>
        <label class="ep-field"><span>{t.fWhat}</span><textarea name="what" rows="4" required placeholder={t.fWhatPh}></textarea></label>
        <button class="ep-btn ep-btn-cta ep-wide" type="submit">{t.fSend}</button>
        <p class="ep-form-note">{t.fNote} <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
      </form>
    </section>

    <!-- 7. FAQ -->
    <section class="ep-faq">
      <div>
        <h2 class="ep-h2">{t.faqTitle}</h2>
        <p class="ep-sub">{t.faqDek} <a href={methodHref}>{t.faqLink}</a>.</p>
      </div>
      <div class="ep-faq-list">
        {t.faq.map(([q, a], i) => (
          <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>
        ))}
      </div>
    </section>

    <!-- 8. Newsletter -->
    <section class="ep-nl">
      <Newsletter lang={lang} heading={t.nlHeading} dek={t.nlDek} cta={t.nlCta} />
    </section>
  </div>
</BaseLayout>

<script>
  // Visited-places filter: continent chips + "with guides only".
  document.querySelectorAll<HTMLElement>('[data-visited]').forEach((box) => {
    let cont = 'all';
    const only = box.querySelector<HTMLInputElement>('[data-only-guides]');
    const apply = () => {
      box.querySelectorAll<HTMLElement>('.ep-places li').forEach((li) => {
        const okCont = cont === 'all' || li.dataset.cont === cont;
        const okGuide = !only?.checked || li.dataset.has === '1';
        li.hidden = !(okCont && okGuide);
      });
    };
    box.querySelectorAll<HTMLButtonElement>('.ep-chip').forEach((b) => b.addEventListener('click', () => {
      cont = b.dataset.cont || 'all';
      box.querySelectorAll('.ep-chip').forEach((x) => x.classList.toggle('is-on', x === b));
      apply();
    }));
    only?.addEventListener('change', apply);
  });

  // Pipeline tabs (+ arrow keys, + the panel's own back/next buttons).
  document.querySelectorAll<HTMLElement>('[data-pipe]').forEach((pipe) => {
    const tabs = [...pipe.querySelectorAll<HTMLButtonElement>('.ep-step')];
    const panels = [...pipe.querySelectorAll<HTMLElement>('.ep-panel')];
    const show = (i: number, focus = false) => {
      if (i < 0 || i >= tabs.length) return;
      tabs.forEach((t, j) => t.setAttribute('aria-selected', String(j === i)));
      panels.forEach((p, j) => (p.hidden = j !== i));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(i + 1, true);
        if (e.key === 'ArrowLeft') show(i - 1, true);
      });
    });
    pipe.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.go), true)));
  });

  // Correction form: no server, no tracking — it composes an email in the
  // reader's own mail app, so nothing is stored on our side.
  document.querySelectorAll<HTMLFormElement>('[data-fix]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const kind = String(fd.get('kind') || '');
      const place = String(fd.get('place') || '').trim();
      const what = String(fd.get('what') || '').trim();
      const subject = `[Correction] ${kind}: ${place}`.slice(0, 140);
      const body = `${kind}\n${place}\n\n${what}\n\n— ${location.origin}${form.dataset.page || ''}`;
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  });
</script>

<style>
  .ep {
    --ep-brown: #7a3b1d; --ep-olive: #3d4a2c; --ep-forest: #26301f; --ep-peach: #f6dccb; --ep-cream: #fbf3e8; --ep-sand: #efe4d3;
    --ep-on-dark: #fbf3e8;
    max-width: var(--max); margin: 0 auto; padding: 18px 20px 64px;
    display: grid; gap: 28px;
  }
  @media (prefers-color-scheme: dark) {
    .ep { --ep-peach: #3a2a20; --ep-cream: #221d17; --ep-sand: #2a241c; }
  }
  .ep a { color: inherit; }
  /* Grid children default to min-width:auto, so the scrollable step row pushed
     the whole page to ~800px on a phone. */
  .ep :is(section, div, figure, form, article, ul) { min-width: 0; }
  .ep-crumb { font-size: .82rem; color: var(--muted); display: flex; gap: 8px; }
  .ep-crumb a { text-decoration: none; }
  .ep-pill { display: inline-block; font-size: .78rem; font-weight: 600; padding: 4px 12px; border-radius: var(--r-pill); background: var(--ep-peach); color: var(--cta-deep); }
  .ep-pill-dark { background: rgba(255,255,255,.12); color: var(--ep-on-dark); }
  .ep-pill-light { background: rgba(255,255,255,.16); color: var(--ep-on-dark); }
  .ep-kicker { font-size: .8rem; font-weight: 700; color: var(--cta); letter-spacing: .02em; }
  .ep-h2 { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2rem); margin: 0; }
  .ep-sub { color: var(--muted); margin: 6px 0 0; }
  .ep-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 11px 18px; border-radius: var(--r-pill); font-weight: 600; text-decoration: none; border: 1px solid transparent; cursor: pointer; font: inherit; font-weight: 600; }
  .ep-btn-cta { background: var(--cta); color: #fff !important; }
  .ep-btn-cta:hover { background: var(--cta-deep); }
  .ep-btn-ghost { background: var(--surface); border-color: var(--line-strong); color: var(--ink); }
  .ep-btn[disabled] { opacity: .4; cursor: default; }
  .ep-sm { padding: 8px 14px; font-size: .88rem; }
  .ep-wide { width: 100%; }

  /* hero */
  .ep-hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 32px; align-items: center; }
  .ep-hero h1 { font-family: var(--font-display); font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.12; margin: 14px 0 16px; letter-spacing: -.01em; }
  .ep-hero h1 span { display: block; }
  .ep-hero h1 em { font-style: normal; color: var(--cta); }
  .ep-dek { color: var(--ink-soft); font-size: 1.05rem; line-height: 1.7; max-width: 34em; }
  .ep-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .ep-hero-media { position: relative; min-height: 460px; }
  .ep-arch { position: absolute; inset: 0 12% 40px 6%; border-radius: 999px 999px 24px 24px; overflow: hidden; box-shadow: var(--shadow-md); display: block; }
  .ep-arch img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ep-phototag { position: absolute; left: 14px; bottom: 14px; background: rgba(20,16,12,.7); color: #fff; font-size: .74rem; padding: 4px 10px; border-radius: var(--r-pill); }
  .ep-circle { position: absolute; top: -6px; right: 0; width: 128px; height: 128px; border-radius: 50%; overflow: hidden; border: 4px solid var(--bg); box-shadow: var(--shadow-md); }
  .ep-circle img { width: 100%; height: 100%; object-fit: cover; }
  .ep-card { position: absolute; right: 0; bottom: 0; width: min(300px, 78%); background: var(--ep-forest); color: var(--ep-on-dark); border-radius: var(--r-lg); padding: 16px; box-shadow: var(--shadow-lg); }
  .ep-card-head { display: flex; gap: 10px; align-items: center; }
  .ep-card-head strong { display: block; font-family: var(--font-display); font-size: 1.15rem; }
  .ep-card-head span { font-size: .76rem; opacity: .8; }
  .ep-avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--cta); color: #fff; display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; flex: none; }
  .ep-avatar-lg { width: 72px; height: 72px; font-size: 2rem; }
  .ep-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 12px; }
  .ep-stats div { background: rgba(255,255,255,.08); border-radius: var(--r-sm); padding: 8px; }
  .ep-stats span { display: block; font-size: .68rem; opacity: .8; line-height: 1.3; }
  .ep-stats b { font-family: var(--font-display); font-size: 1.35rem; }
  .ep-strip { margin: -6px 0 0; text-align: center; font-size: .9rem; color: var(--pine); font-weight: 600; background: var(--ep-sand); border-radius: var(--r-pill); padding: 9px 14px; }

  /* promises */
  .ep-promises { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .ep-promise { border-radius: var(--r-lg); padding: 20px 18px 22px; }
  .ep-promise h2 { font-family: var(--font-display); font-size: 1.15rem; margin: 12px 0 8px; line-height: 1.3; }
  .ep-promise p { font-size: .9rem; line-height: 1.6; margin: 0; }
  .ep-promise-ico { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: rgba(255,255,255,.16); }
  .ep-promise-0 { background: var(--ep-brown); color: var(--ep-on-dark); }
  .ep-promise-1 { background: var(--ep-olive); color: var(--ep-on-dark); }
  .ep-promise-2 { background: var(--ep-cream); border: 1px solid var(--line); }
  .ep-promise-3 { background: var(--ep-peach); }
  .ep-promise-2 .ep-promise-ico, .ep-promise-3 .ep-promise-ico { background: var(--surface); }

  /* editor */
  .ep-editor { display: grid; grid-template-columns: .8fr 1.6fr; gap: 28px; background: var(--ep-cream); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 28px; scroll-margin-top: 80px; }
  .ep-edname { font-family: var(--font-display); font-size: 1.9rem; margin: 2px 0 8px; }
  .ep-editor-who p { color: var(--ink-soft); line-height: 1.7; font-size: .95rem; }
  .ep-pen { background: var(--ep-sand); border-radius: var(--r-md); padding: 10px 12px; font-size: .88rem !important; }
  .ep-social { display: flex; flex-wrap: wrap; gap: 6px; }
  .ep-social a { font-size: .82rem; padding: 5px 12px; border: 1px solid var(--line-strong); border-radius: var(--r-pill); text-decoration: none; background: var(--surface); }
  .ep-visited-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .ep-visited-head h2 { font-family: var(--font-display); font-size: 1.4rem; margin: 0; }
  .ep-visited-head span { font-size: .85rem; color: var(--muted); }
  .ep-filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 8px; }
