import { getCollection } from 'astro:content';
import { heroOf, TOOL_OG } from '../lib/toolOgPhoto.mjs';
import { tileSize, pickRepHeroUrl, regionCoverUrl } from '../lib/repImage';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from './Newsletter.astro';
import Flag from './Flag.astro';
import { slugifyRegion } from '../lib/slug';
import { canonicalRegion } from '../lib/region-alias.mjs';
import { siteHref } from '../lib/urls.mjs';
import { SITE } from '../siteConfig';
import countriesData from '../../data/countries.json';
import { orderedContinents, continentLabel } from '../lib/continents';
import { whenToGoCountryPages } from '../lib/when-to-go-paths.mjs';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';

// Shared /regions index for en + /[lang]/regions — owner's mock-up "전체 지역
// 개선안" (2026-10-02). Every city and district we cover, findable by name,
// initial consonant (ko), English name or country; grouped by country or
// listed A–Z/가나다; districts of a few big cities folded into the city's
// card. The old page was one photo grid sorted by English name, which read as
// random in every other language and gave no country, so "Jordan" (a Hong
// Kong district) looked like the country. Counts are the live posts at build.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const nf = new Intl.NumberFormat(lang === 'zh' ? 'zh-CN' : lang);
const coll = new Intl.Collator(lang === 'zh' ? 'zh-CN' : lang);

const posts = await getCollection('posts', ({ data }) => !data.draft);
// pickRepHeroUrl, not "the first post that happens to have a photo": taking
// the first one put concert photos on 26 of 174 city tiles (Madrid showed The
// Weeknd on stage in Milan). One picker for every city/country tile.
const byRegion = new Map<string, typeof posts>();
// A region whose hub 301s elsewhere (src/lib/region-alias.mjs) is listed under
// the city it lands on, so no card here points at a redirect.
for (const p of posts) {
  const key = canonicalRegion(p.data.region) ?? p.data.region;
  const list = byRegion.get(key) ?? [];
  list.push(p);
  byRegion.set(key, list);
}
const countryByName = new Map(countriesData.countries.map((c: any) => [c.name, c]));
const wtgCountries = new Set((await whenToGoCountryPages()).map((c: any) => c.countrySlug));

// Districts shown inside their city's card in the by-country view. A city-state
// (Hong Kong, Singapore) folds every district into the region named after it;
// elsewhere only the places that are plainly part of, or the stadium town of,
// one city. A new district outside this list simply shows as its own card.
const PARENT: Record<string, string> = {
  Deira: 'Dubai', Jumeirah: 'Dubai', 'Palm Jumeirah': 'Dubai', 'Dubai Marina': 'Dubai', 'Downtown Dubai': 'Dubai', 'Al Barsha': 'Dubai',
  'East Rutherford': 'New York', Foxborough: 'Boston',
  Pasay: 'Manila', Makati: 'Manila', 'Quezon City': 'Manila',
};
const CITY_STATES = new Set(['Hong Kong', 'Singapore']);

// Hangul initial consonants, so "ㄱㅈ" finds 경주 and 광저우.
const CHO = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ';
const FOLD: Record<string, string> = { 'ㄲ': 'ㄱ', 'ㄸ': 'ㄷ', 'ㅃ': 'ㅂ', 'ㅆ': 'ㅅ', 'ㅉ': 'ㅈ' };
const cho = (s: string) => [...s].map((ch) => {
  const c = ch.charCodeAt(0) - 0xac00;
  return c >= 0 && c < 11172 ? CHO[Math.floor(c / 588)] : ch;
}).join('');
const fold = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').normalize('NFC').toLowerCase();
const indexKey = (name: string) => {
  if (lang === 'ko') { const k = cho(name)[0] ?? ''; return /[ㄱ-ㅎ]/.test(k) ? (FOLD[k] ?? k) : '#'; }
  if (lang === 'en' || lang === 'es') { const k = name.normalize('NFD').replace(/[\u0300-\u036f]/g, '')[0]?.toUpperCase() ?? ''; return /[A-Z]/.test(k) ? k : '#'; }
  return '';
};

const regions = [...byRegion].map(([name, list]) => {
  const tally = new Map<string, number>();
  for (const p of list) { const c = (p.data.country ?? 'South Korea').trim(); tally.set(c, (tally.get(c) ?? 0) + 1); }
  const countryName = [...tally].sort((a, b) => b[1] - a[1])[0][0];
  const c: any = countryByName.get(countryName) ?? {};
  const url = pickRepHeroUrl(list) || regionCoverUrl(name);
  const local = localizePlace(name, lang);
  const parent = CITY_STATES.has(countryName) && name !== countryName ? countryName : PARENT[name];
  return {
    name, local, count: list.length, slug: slugifyRegion(name),
    country: countryName, countryLocal: localizePlace(countryName, lang), countrySlug: c.slug ?? '', iso2: c.iso2 ?? '',
    continent: c.continent ?? 'Other', img: url ? tileSize(url) : '',
    parent: parent && byRegion.has(parent) ? parent : '',
    key: indexKey(local),
  };
});
// A district whose parent city has no hub stays a city in its own right.
const childrenOf = new Map<string, typeof regions>();
for (const r of regions) if (r.parent) (childrenOf.get(r.parent) ?? childrenOf.set(r.parent, []).get(r.parent)!).push(r);
for (const list of childrenOf.values()) list.sort((a, b) => b.count - a.count || coll.compare(a.local, b.local));

const totalGuides = regions.reduce((s, r) => s + r.count, 0);
const countryList = [...new Set(regions.map((r) => r.country))].map((name) => {
  const rs = regions.filter((r) => r.country === name);
  const c: any = countryByName.get(name) ?? {};
  return { name, local: localizePlace(name, lang), slug: c.slug ?? '', iso2: c.iso2 ?? '', continent: c.continent ?? 'Other', regions: rs.length, guides: rs.reduce((s, r) => s + r.count, 0) };
}).sort((a, b) => b.guides - a.guides || coll.compare(a.local, b.local));
const continents = orderedContinents()
  .map((k) => ({ name: k, label: continentLabel(t, k), slug: k.toLowerCase().replace(/\s+/g, '-'), regions: regions.filter((r) => r.continent === k).length }))
  .filter((c) => c.regions > 0);
const maxCont = Math.max(...continents.map((c) => c.regions));
const maxCount = Math.max(...regions.map((r) => r.count));
const top = [...regions].filter((r) => !r.parent).sort((a, b) => b.count - a.count).slice(0, 8);
const heroPhotos = top.filter((r) => r.img).slice(0, 2);
const slugOfContinent = (k: string) => k.toLowerCase().replace(/\s+/g, '-');
const DEEP = 15; // a city with this many guides gets the "well covered" tint

