---
import { getCollection } from 'astro:content';
import { tileSize, pickRepHeroUrl } from '../lib/repImage';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from './Newsletter.astro';
import { slugifyRegion } from '../lib/slug';
import { SITE } from '../siteConfig';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';

// Shared /regions index for en + /[lang]/regions.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getCollection('posts', ({ data }) => !data.draft);
// pickRepHeroUrl, not "the first post that happens to have a photo". Taking the
// first one put an EVENT hero on 26 of 174 city tiles: "Madrid" showed The
// Weeknd on stage in MILAN, "Istanbul" a studio portrait of Amr Diab holding
// trophies, "Foxborough" BTS in Los Angeles. A concert photograph is a picture
// of a performer and says nothing about the destination — which is exactly the
// rule repImage.ts already encodes and which the country hubs, its only caller,
// have been following correctly all along.
//
// Same shape as the Alhambra captioned "South Korea": an image chosen by one
// piece of code sitting under a label chosen by another. The fix is not a
// better heuristic here, it is having one picker.
const counts = new Map<string, number>();
const byRegion = new Map<string, typeof posts>();
for (const p of posts) {
  counts.set(p.data.region, (counts.get(p.data.region) ?? 0) + 1);
  const list = byRegion.get(p.data.region) ?? [];
  list.push(p);
  byRegion.set(p.data.region, list);
}
const regionImg = new Map<string, string>();
for (const [region, list] of byRegion) {
  const url = pickRepHeroUrl(list);
  // tileSize on the RAW stored url — repImage returns it untransformed on
  // purpose, because hashing a transformed string once produced /wall/ names
  // that exist nowhere and blacked out every tile.
  if (url) regionImg.set(region, tileSize(url));
}
const regions = [...counts.entries()]
  .map(([name, count]) => ({ name, count, img: regionImg.get(name) ?? '' }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title={`${t('reg.allRegions')} — ${SITE.name}`}
  description={t('reg.allRegionsDek').replace('{n}', String(regions.length))}
  localized={true}
>
  <div class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{t('reg.explore')}</p>
      <h1>{t('reg.allRegions')}</h1>
      <p>{t('reg.allRegionsDek').replace('{n}', String(regions.length))}</p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="region-grid">
        {regions.map((r) => (
          <a class="region-tile" href={localizePath(`/regions/${slugifyRegion(r.name)}/`, lang)} style={r.img ? `background-image:url(${r.img})` : ''}>
            <span>{localizePlace(r.name, lang)}<br /><small style="font-size:0.7rem;opacity:0.85;font-weight:500">{t('home.guides').replace('{n}', String(r.count))}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Newsletter lang={lang} />
</BaseLayout>
