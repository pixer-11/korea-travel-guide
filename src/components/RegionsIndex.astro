  heart: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  calendar: '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/>',
  route: '<circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/>',
  plane: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
};
const svg = (n: string, s = 18) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[n] ?? ''}</svg>`;
const regionHref = (r: { slug: string }) => localizePath(`/regions/${r.slug}/`, lang);

// Alphabetical groups (ko ㄱ–ㅎ, en/es A–Z). Japanese and Chinese names are
// largely kanji/hanzi with no reading to bucket by, so those two get one
// collated list instead of a fake index.
const alphaKeys = lang === 'ko' ? [...'ㄱㄴㄷㄹㅁㅂㅅㅇㅈㅊㅋㅌㅍㅎ', '#'] : lang === 'en' || lang === 'es' ? [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', '#'] : [];
const usedKeys = new Set(regions.map((r) => r.key));

const ogPhoto = heroOf(posts, TOOL_OG.regions);
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteHref(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: t('reg.allRegions'), url: pageUrl, isPartOf: { '@id': `${site}/#site` } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.home'), item: siteHref(localizePath('/', lang), Astro.site) },
      { '@type': 'ListItem', position: 2, name: t('nav.destinations'), item: siteHref(localizePath('/destinations', lang), Astro.site) },
      { '@type': 'ListItem', position: 3, name: t('reg.allRegions'), item: pageUrl },
    ] },
    { '@type': 'FAQPage', mainEntity: L.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};
---

<BaseLayout image={ogPhoto}
  title={`${t('reg.allRegions')} — ${SITE.name}`}
  description={t('reg.allRegionsDek').replace('{n}', String(regions.length))}
  jsonLd={jsonLd}
  localized={true}
>
  <div class="rg" data-rg data-lang={lang}>
    <nav class="rg-crumb" aria-label="breadcrumb"><a href={localizePath('/', lang)}>{t('post.home')}</a><span aria-hidden="true">·</span><a href={localizePath('/destinations', lang)}>{t('nav.destinations')}</a><span aria-hidden="true">·</span><b>{t('reg.allRegions')}</b></nav>

    <section class="rg-hero">
      <div>
        <span class="rg-pill">{L.pill}</span>
        <h1><span>{t('reg.allRegions')}</span><em>{fill(L.accent, { n: nf.format(regions.length) })}</em></h1>
        <p class="rg-dek">{fill(L.dek, { c: countryList.length })}</p>
        <form class="rg-search" role="search" data-search-form>
          <Fragment set:html={svg('search', 17)} />
          <label class="sr-only" for="rg-q">{L.search}</label>
          <input id="rg-q" type="search" placeholder={L.search} autocomplete="off" data-q />
          <button type="submit">{L.go}</button>
        </form>
        <p class="rg-quick"><span>{L.quick}</span>{top.map((r) => <a href={regionHref(r)}>{r.local}</a>)}</p>
      </div>
      <div class="rg-art">
        {heroPhotos[0] && <a class="rg-arch" href={regionHref(heroPhotos[0])} aria-label={heroPhotos[0].local}><img src={heroPhotos[0].img} alt="" width="300" height="380" /></a>}
        {heroPhotos[1] && <a class="rg-circle" href={regionHref(heroPhotos[1])} aria-label={heroPhotos[1].local}><img src={heroPhotos[1].img} alt="" width="150" height="150" loading="lazy" /></a>}
        <div class="rg-conts">
          <p><b>{L.byCont}</b><small>{L.byContHint}</small></p>
          <ul>
            {continents.map((c, i) => (
              <li><button type="button" data-cont-pick={c.slug}>
                <span>{c.label}</span>
                <i aria-hidden="true"><em class={`c${i}`} style={`width:${Math.max(6, Math.round((c.regions / maxCont) * 100))}%`}></em></i>
                <small>{fill(L.nPlaces, { n: nf.format(c.regions) })}</small>
              </button></li>
            ))}
          </ul>
          <div class="rg-tot">
            <div><small>{L.sRegions}</small><b>{fill(L.nPlaces, { n: nf.format(regions.length) })}</b></div>
            <div><small>{L.sCountries}</small><b>{fill(L.nCountries, { n: nf.format(countryList.length) })}</b></div>
            <div><small>{L.sGuides}</small><b>{fill(L.nGuides, { n: nf.format(totalGuides) })}</b></div>
          </div>
        </div>
      </div>
    </section>

    <section class="rg-top">
      <div class="rg-head">
        <div><h2>{L.topH}</h2><p>{L.topSub}</p></div>
        <a href={localizePath('/itinerary', lang)}>{L.topCta}</a>
      </div>
      <div class="rg-top-grid">
        {top.map((r, i) => (
          <article class={`rg-big t${i % 4}`}>
            <a class="rg-big-photo" href={regionHref(r)} style={r.img ? `background-image:url(${r.img})` : undefined} aria-label={r.local}></a>
            <div class="rg-big-body">
              <p class="rg-big-country"><span class="rg-flag"><Flag code={r.iso2} /></span>{r.countryLocal}</p>
              <h3><a href={regionHref(r)}>{r.local}</a></h3>
              <p class="rg-big-n"><b>{nf.format(r.count)}</b> {L.guidesBig}</p>
              <p class="rg-big-acts">
                <a href={regionHref(r)}>{L.open}</a>
                {wtgCountries.has(r.countrySlug) && <a href={localizePath(`/tools/when-to-go/${r.countrySlug}/`, lang)}>{L.when}</a>}
              </p>
            </div>
            <button type="button" class="rg-fav" data-fav={r.slug} data-fav-name={r.local} aria-pressed="false" aria-label={`${L.save}: ${r.local}`} data-save={L.save} data-unsave={L.unsave}><Fragment set:html={svg('heart', 16)} /></button>
          </article>
        ))}
      </div>
    </section>

    <section class="rg-browse" id="rg-browse">
      <div class="rg-head"><div><h2>{L.browseH}</h2><p>{L.browseSub}</p></div></div>
      <div class="rg-countries" role="group">
        <button type="button" class="is-on" aria-pressed="true" data-country="">{L.allCountries} <small>{regions.length}</small></button>
        {countryList.map((c) => <button type="button" aria-pressed="false" data-country={c.slug} data-country-cont={slugOfContinent(c.continent)}><span class="rg-flag"><Flag code={c.iso2} /></span>{c.local} <small>{c.regions}</small></button>)}
      </div>

      <div class="rg-tools">
        <div class="rg-seg" role="group">
          <button type="button" class="is-on" aria-pressed="true" data-cont="">{L.all} <small>{regions.length}</small></button>
          {continents.map((c) => <button type="button" aria-pressed="false" data-cont={c.slug}>{c.label} <small>{c.regions}</small></button>)}
        </div>
        <div class="rg-seg is-dark" role="group">
          <button type="button" class="is-on" aria-pressed="true" data-view="country">{L.byCountry}</button>
          <button type="button" aria-pressed="false" data-view="alpha">{L.alpha}</button>
        </div>
        <div class="rg-seg is-dark" role="group" data-sort-group>
          <button type="button" class="is-on" aria-pressed="true" data-sort="count">{L.byGuides}</button>
          <button type="button" aria-pressed="false" data-sort="name">{L.byName}</button>
        </div>
        <label class="rg-switch"><input type="checkbox" data-five /><span aria-hidden="true"></span>{L.fivePlus}</label>
        {alphaKeys.length > 0 && (
          <nav class="rg-keys" aria-label={L.alpha} data-keys hidden>
            {alphaKeys.filter((k) => usedKeys.has(k)).map((k) => <a href={`#rg-k-${k.codePointAt(0)}`}>{k}</a>)}
          </nav>
        )}
      </div>

      <p class="rg-showing" aria-live="polite" data-showing data-tpl={L.showing}>{fill(L.showing, { p: nf.format(regions.length), g: nf.format(totalGuides) })}</p>

      <div class="rg-list" data-list>
        {countryList.map((c) => (
          <section class="rg-country" data-group={c.slug} data-group-cont={slugOfContinent(c.continent)}>
            <div class="rg-country-head">
              <span class="rg-flag rg-flag-lg"><Flag code={c.iso2} /></span>
              <h3>{c.local} <small data-group-sum data-tpl={L.regSum}>{fill(L.regSum, { r: c.regions, g: nf.format(c.guides) })}</small></h3>
              {c.slug && <a href={localizePath(`/destinations/${c.slug}`, lang)}>{fill(L.countryAll, { x: c.local })}</a>}
            </div>
            <div class="rg-grid">
              {regions.filter((r) => r.country === c.name).sort((a, b) => b.count - a.count || coll.compare(a.local, b.local)).map((r) => (
                <div class:list={['rg-card', { 'is-deep': r.count >= DEEP, 'is-child': !!r.parent }]}
                  data-card data-slug={r.slug} data-count={r.count} data-name={r.local} data-key={r.key} data-country={c.slug} data-cont={slugOfContinent(r.continent)}
                  data-search={fold([r.local, r.name, r.countryLocal, r.country, lang === 'ko' ? cho(r.local) : ''].join(' '))}>
                  <a class="rg-card-link" href={regionHref(r)}>
                    <span class="rg-thumb">{r.img ? <img src={r.img} alt="" width="44" height="44" loading="lazy" /> : null}</span>
                    <span class="rg-card-txt">
                      <b>{r.local}</b>
                      <small class="rg-card-country">{r.countryLocal}</small>
                      <span class="rg-card-n">{nGuidesTxt(r.count)}<i aria-hidden="true"><em style={`width:${Math.max(4, Math.round((r.count / maxCount) * 100))}%`}></em></i></span>
                    </span>
                  </a>
                  <button type="button" class="rg-fav" data-fav={r.slug} data-fav-name={r.local} aria-pressed="false" aria-label={`${L.save}: ${r.local}`} data-save={L.save} data-unsave={L.unsave}><Fragment set:html={svg('heart', 15)} /></button>
                  {childrenOf.has(r.name) && (
                    <p class="rg-kids"><span>{L.districts}</span>{childrenOf.get(r.name)!.map((k) => <a href={regionHref(k)} data-kid-count={k.count}>{k.local} <small>{k.count}</small></a>)}</p>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
      <div class="rg-empty" data-empty hidden><p>{L.empty}</p><button type="button" data-reset>{L.reset}</button></div>
    </section>

    <section class="rg-next">
      {L.next.map(([ico, title, sub, cta, href, tone, note]) => (
        <a class:list={['rg-next-card', tone]} href={localizePath(href, lang)} rel={note ? 'sponsored' : undefined}>
          <i><Fragment set:html={svg(ico)} /></i><b>{title}</b><span>{sub}</span><em>{cta}</em>{note && <small>{note}</small>}
        </a>
      ))}
    </section>

    <section class="rg-faq">
      <div><h2>{L.faqH}</h2><p>{L.faqSub} <a href={localizePath('/contact', lang)}>{L.faqLink}</a>.</p></div>
      <div class="rg-faq-list">
        {L.faq.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>

    <div class="rg-tray" data-tray hidden>
      <b>{L.saved} <span data-tray-n>0</span></b>
      <p data-tray-list></p>
      <a class="rg-tray-go" href={localizePath('/my-trip', lang)}>{L.openTrip}</a>
    </div>
  </div>
  <Newsletter lang={lang} />
</BaseLayout>

<script>
  import { readCities, toggleCity, onCitiesChange } from '../lib/saved-cities';
  document.querySelectorAll<HTMLElement>('[data-rg]').forEach((root) => {
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    const showing = root.querySelector<HTMLElement>('[data-showing]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const keys = root.querySelector<HTMLElement>('[data-keys]');
    const five = root.querySelector<HTMLInputElement>('[data-five]')!;
    const lang = root.dataset.lang!;
    const nf = new Intl.NumberFormat(lang === 'zh' ? 'zh-CN' : lang);
    const coll = new Intl.Collator(lang === 'zh' ? 'zh-CN' : lang);
    const state = { cont: '', country: '', view: 'country', sort: 'count' };
    const press = (sel: string, on: Element | null) => root.querySelectorAll(sel).forEach((b) => { b.classList.toggle('is-on', b === on); b.setAttribute('aria-pressed', String(b === on)); });
    const homeOf = new Map(cards.map((c) => [c, c.parentElement!]));
    let alphaBox: HTMLElement | null = null;

    const order = (xs: HTMLElement[]) => xs.sort((a, b) => state.sort === 'name'
      ? coll.compare(a.dataset.name!, b.dataset.name!)
      : (+b.dataset.count! - +a.dataset.count!) || coll.compare(a.dataset.name!, b.dataset.name!));

    // Two layouts over one set of cards: by country (server-rendered, with the
    // districts folded into their city) and alphabetical (built here on demand).
    const layout = () => {
      root.classList.toggle('is-alpha', state.view === 'alpha');
      if (keys) keys.hidden = state.view !== 'alpha';
      if (state.view === 'country') {
        alphaBox?.remove(); alphaBox = null;
        list.hidden = false;
        for (const g of groups) {
          const grid = g.querySelector<HTMLElement>('.rg-grid')!;
          grid.append(...order(cards.filter((c) => homeOf.get(c) === grid)));
        }
        return;
      }
      list.hidden = true;
      alphaBox?.remove();
      alphaBox = document.createElement('div');
      alphaBox.className = 'rg-alpha';
      const byKey = new Map<string, HTMLElement[]>();
      for (const c of [...cards].sort((a, b) => coll.compare(a.dataset.name!, b.dataset.name!))) {
        const k = c.dataset.key || '';
        (byKey.get(k) ?? byKey.set(k, []).get(k)!).push(c);
      }
      const ks = [...byKey.keys()].sort((a, b) => (a === '#' ? 1 : b === '#' ? -1 : coll.compare(a, b)));
      for (const k of ks) {
        const sec = document.createElement('section');
        sec.className = 'rg-letter';
        if (k) sec.id = `rg-k-${k.codePointAt(0)}`;
        sec.innerHTML = k ? `<span class="rg-letter-key">${k}</span>` : '';
        const grid = document.createElement('div');
        grid.className = 'rg-grid';
        grid.append(...byKey.get(k)!);
        sec.append(grid);
        alphaBox.append(sec);
      }
      list.after(alphaBox);
    };

    const matchOf = (c: HTMLElement) => (!state.cont || c.dataset.cont === state.cont)
      && (!state.country || c.dataset.country === state.country)
      && (!five.checked || +c.dataset.count! >= 5);
    const apply = () => {
      const words = q.value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').normalize('NFC').trim().toLowerCase().split(/\s+/).filter(Boolean);
      const alpha = state.view === 'alpha';
      let p = 0, g = 0;
      for (const c of cards) {
        const match = (!state.cont || c.dataset.cont === state.cont)
          && (!state.country || c.dataset.country === state.country)
          && (!five.checked || +c.dataset.count! >= 5)
          && words.every((w) => c.dataset.search!.includes(w));
        // A folded district is reachable from its city card in the country
        // view, so it still counts; it shows as its own card when listed A–Z
        // or found by search.
        c.hidden = !match || (!alpha && !words.length && c.classList.contains('is-child'));
        if (match) { p++; g += +c.dataset.count!; }
      }
      for (const grp of groups) {
        const mine = cards.filter((c) => homeOf.get(c)!.closest('[data-group]') === grp);
        const shown = mine.filter((c) => !c.hidden || (c.classList.contains('is-child') && !alpha && !words.length && matchOf(c)));
        grp.hidden = !mine.some((c) => !c.hidden);
        const sum = grp.querySelector<HTMLElement>('[data-group-sum]');
        if (sum) sum.textContent = sum.dataset.tpl!.replace('{r}', nf.format(shown.length)).replace('{g}', nf.format(shown.reduce((s, c) => s + +c.dataset.count!, 0)));
      }
      root.querySelectorAll<HTMLElement>('[data-kid-count]').forEach((a) => { a.hidden = words.length > 0 || (five.checked && +a.dataset.kidCount! < 5); });
      root.querySelectorAll<HTMLElement>('.rg-kids').forEach((k) => { k.hidden = !k.querySelector('a:not([hidden])'); });
      alphaBox?.querySelectorAll<HTMLElement>('.rg-letter').forEach((s) => { s.hidden = !s.querySelector('[data-card]:not([hidden])'); });
      keys?.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => {
        const s = document.getElementById(a.getAttribute('href')!.slice(1));
        const off = !s || s.hidden;
        a.classList.toggle('is-off', off);
        a.tabIndex = off ? -1 : 0;
        if (off) a.setAttribute('aria-disabled', 'true'); else a.removeAttribute('aria-disabled');
      });
      showing.textContent = showing.dataset.tpl!.replace('{p}', nf.format(p)).replace('{g}', nf.format(g));
      empty.hidden = p > 0;
    };

    q.addEventListener('input', apply);
    root.querySelector('[data-search-form]')!.addEventListener('submit', (e) => {
      e.preventDefault();
      apply();
      root.querySelector('#rg-browse')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    const setCont = (slug: string) => {
      state.cont = slug;
      press('[data-cont]', root.querySelector(`[data-cont="${slug}"]`));
      // A country outside the new continent would leave the list empty.
      const pick = root.querySelector<HTMLElement>(`[data-country="${state.country}"][data-country-cont]`);
      if (state.country && slug && pick?.dataset.countryCont !== slug) { state.country = ''; press('[data-country]', root.querySelector('button[data-country=""]')); }
      root.querySelectorAll<HTMLElement>('button[data-country-cont]').forEach((b) => { b.hidden = !!slug && b.dataset.countryCont !== slug; });
      apply();
    };
    root.querySelectorAll<HTMLButtonElement>('button[data-cont]').forEach((b) => b.addEventListener('click', () => setCont(b.dataset.cont || '')));
    root.querySelectorAll<HTMLButtonElement>('[data-cont-pick]').forEach((b) => b.addEventListener('click', () => {
      setCont(b.dataset.contPick!);
      root.querySelector('#rg-browse')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));
    root.querySelectorAll<HTMLButtonElement>('button[data-country]').forEach((b) => b.addEventListener('click', () => {
      state.country = b.dataset.country || '';
      press('button[data-country]', b);
      apply();
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
      state.view = b.dataset.view!;
      press('[data-view]', b);
      layout(); apply();
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((b) => b.addEventListener('click', () => {
      state.sort = b.dataset.sort!;
      press('[data-sort]', b);
      layout(); apply();
    }));
    five.addEventListener('change', apply);
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      q.value = ''; five.checked = false; state.country = '';
      press('button[data-country]', root.querySelector('button[data-country=""]'));
      setCont('');
    });

    // Saved cities: one list with the city hubs, /my-trip and the header
    // count (src/lib/saved-cities.ts). Slugs only — the name and the link are
    // read from this page's own card, so the tray is always in its language.
    const tray = root.querySelector<HTMLElement>('[data-tray]')!;
    const btnOf = (slug: string) => root.querySelector<HTMLButtonElement>(`[data-fav="${CSS.escape(slug)}"]`);
    const paint = () => {
      const saved = readCities().filter((slug) => btnOf(slug));
      const set = new Set(saved);
      root.querySelectorAll<HTMLButtonElement>('[data-fav]').forEach((b) => {
        const on = set.has(b.dataset.fav!);
        b.setAttribute('aria-pressed', String(on));
        b.setAttribute('aria-label', `${on ? b.dataset.unsave : b.dataset.save}: ${b.dataset.favName}`);
      });
      tray.hidden = !saved.length;
      tray.querySelector('[data-tray-n]')!.textContent = String(saved.length);
      const box = tray.querySelector<HTMLElement>('[data-tray-list]')!;
      box.replaceChildren(...saved.map((slug) => {
        const b = btnOf(slug)!;
        const a = document.createElement('a');
        a.href = b.closest('[data-card], .rg-big')?.querySelector('a[href]')?.getAttribute('href') ?? '#';
        a.textContent = b.dataset.favName!;
        return a;
      }));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-fav]').forEach((b) => b.addEventListener('click', () => { toggleCity(b.dataset.fav!); }));
    onCitiesChange(paint);

    layout(); apply(); paint();
  });
</script>

<style>
  .rg { max-width: var(--max); margin: 0 auto; padding: 18px 20px 56px; display: grid; gap: 40px; --rg-forest: #26301f; --rg-moss: #3b4a2b; --rg-brown: #7a3b1d; --rg-peach: #fbe0d4; --rg-green: #e3ecd9; --rg-sand: #f1e6d6; --rg-on-green: #34502a; --rg-link: #7a3b1d; }
  @media (prefers-color-scheme: dark) { .rg { --rg-peach: #3a2620; --rg-green: #2b3524; --rg-sand: #2a241c; --rg-on-green: #d6e8c4; --rg-link: #eaa57a; } }
  .rg :is(div, section, nav, form) { min-width: 0; }
  .rg [hidden] { display: none !important; }
  .rg-crumb { display: flex; gap: 8px; flex-wrap: wrap; font-size: .82rem; color: var(--muted); }
