      { k: 'press', icon: 'news', title: '媒体与数据引用', hint: '引用数字、数据相关问题', checks: ['媒体或所属机构', '想引用的数字和页面地址', '截稿时间'], tag: '[媒体/数据]', ph: '媒体名称', fields: ['媒体 / 机构:', '想引用的数字和页面地址:', '截稿时间:'], link: ['先看数据来源与计算 →', '/methodology'] },
      { k: 'privacy', icon: 'lock', title: '个人信息请求', hint: '查阅、更正、删除、订阅信息', checks: ['请求类型（查阅、更正、删除等）', '相关邮箱（订阅时使用的邮箱）'], tag: '[个人信息请求]', ph: '请求类型', fields: ['请求类型（查阅/更正/删除等）:', '相关邮箱:'], link: ['查看隐私政策 →', '/privacy'] },
      { k: 'other', icon: 'chat', title: '意见与其他', hint: '表扬、建议，什么都行', checks: ['不拘格式，随意写'], tag: '[意见]', ph: '', fields: [''] },
    ] as Kind[],
  },
};
const T = L[lang];
const kinds: Kind[] = T.kinds;
const first = kinds[0];
const bodyOf = (k: Kind) => k.fields.filter(Boolean).map((f) => `${f}\n\n`).join('');
---

<BaseLayout title={T.metaTitle} description={T.metaDesc} localized={true}>
  <div class="ct">
    <AboutNav lang={lang} current="contact" />

    <div class="ct-hero">
      <div>
        <span class="ct-pill">{T.pill}</span>
        <h1><span>{T.h1}</span><em>{T.accent}</em></h1>
        <p class="ct-dek">{T.dek}</p>
        <div class="ct-mail" data-copy-wrap>
          <i><Fragment set:html={svg('mail', 18)} /></i>
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          <button type="button" data-copy-addr={contactEmail} data-done={T.copied}>{T.copyAddr}</button>
        </div>
        <p class="ct-note">{T.replyNote}</p>
      </div>
      <div class="ct-art">
        {photos[0] && <a class="ct-arch" href={photos[0].href} aria-label={photos[0].label}><img src={photos[0].src} alt="" width="320" height="420" /><small>{photos[0].credit}</small></a>}
        {photos[1] && <a class="ct-circle" href={photos[1].href} aria-label={photos[1].label}><img src={photos[1].src} alt="" width="180" height="180" loading="lazy" /></a>}
        <div class="ct-social">
          <b>{T.social}</b>
          <p>{SOCIAL.map(([n, u]) => <a href={u} rel="me noopener" target="_blank">{n}</a>)}</p>
        </div>
      </div>
    </div>

    <section class="ct-pick" data-contact data-to={contactEmail} data-copied={T.copied} data-copy={T.copyAll}>
      <h2>{T.pickH}</h2>
      <p class="ct-sub">{T.pickSub}</p>
      <div class="ct-kinds" role="tablist">
        {kinds.map((k, i) => (
          <button type="button" role="tab" class:list={['ct-kind', { 'is-on': i === 0 }]} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="ct-panel" id={`ct-tab-${k.k}`} tabindex={i === 0 ? 0 : -1} data-kind={k.k}>
            <i><Fragment set:html={svg(k.icon, 16)} /></i><b>{k.title}</b><small>{k.hint}</small>
          </button>
        ))}
      </div>
      <div class="ct-panel" id="ct-panel" role="tabpanel" aria-labelledby={`ct-tab-${first.k}`}>
        <div>
          {kinds.map((k, i) => (
            <div class="ct-how" data-how={k.k} data-tag={k.tag} data-ph={k.ph} data-tpl-body={bodyOf(k)} hidden={i !== 0}>
              <span class="ct-tag">{k.title}</span>
              <h3>{T.howH}</h3>
              <ul>{k.checks.map((c) => <li><i><Fragment set:html={svg('check', 12)} /></i>{c}</li>)}</ul>
              {k.link && <a class="ct-more-link" href={localizePath(k.link[1], lang)}>{k.link[0]}</a>}
            </div>
          ))}
        </div>
        <div class="ct-draft">
          <p class="ct-row"><span>{T.to}</span><b>{contactEmail}</b></p>
          <label class="ct-row"><span>{T.subject}</span><b data-tag-out>{first.tag}</b><input type="text" data-subject placeholder={first.ph} aria-label={T.subjectInput} /></label>
          <label class="ct-bodylbl"><span class="sr-only">{T.bodyLbl}</span><textarea rows="7" data-body set:text={bodyOf(first)} /></label>
          <div class="ct-actions">
            <a class="ct-btn ct-btn-cta" data-mailto href={`mailto:${contactEmail}?subject=${encodeURIComponent(first.tag)}&body=${encodeURIComponent(bodyOf(first))}`}><Fragment set:html={svg('send', 15)} /><span>{T.open}</span></a>
            <button type="button" class="ct-btn ct-btn-ghost" data-copy-draft><span>{T.copyAll}</span></button>
          </div>
        </div>
      </div>
    </section>

    <div class="ct-sos">
      <i><Fragment set:html={svg('siren', 22)} /></i>
      <div><b>{T.sosH}</b><p>{T.sosP}</p></div>
      <a class="ct-btn ct-btn-cta" href={localizePath('/essentials/emergency', lang)}>{T.sosBtn}</a>
    </div>

    <section>
      <h2 class="ct-h2">{T.beforeH}</h2>
      <div class="ct-before">
        {(T.before as string[][]).map(([title, sub, href]) => <a href={localizePath(href, lang)}><b>{title}</b><span>{sub}</span></a>)}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const flash = (el: HTMLElement, text: string) => {
    const old = el.textContent;
    el.textContent = text;
    setTimeout(() => { el.textContent = old; }, 2000);
  };
  document.querySelectorAll<HTMLButtonElement>('[data-copy-addr]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copyAddr!); flash(b, b.dataset.done!); } catch { /* address stays visible to copy by hand */ }
  }));

  document.querySelectorAll<HTMLElement>('[data-contact]').forEach((box) => {
    const to = box.dataset.to!;
    const tagOut = box.querySelector<HTMLElement>('[data-tag-out]')!;
    const subject = box.querySelector<HTMLInputElement>('[data-subject]')!;
    const body = box.querySelector<HTMLTextAreaElement>('textarea[data-body]')!;
    const mailto = box.querySelector<HTMLAnchorElement>('[data-mailto]')!;
    const subj = () => [tagOut.textContent, subject.value.trim()].filter(Boolean).join(' ');
    const sync = () => { mailto.href = `mailto:${to}?subject=${encodeURIComponent(subj())}&body=${encodeURIComponent(body.value)}`; };
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-kind]')];
    const panel = box.querySelector<HTMLElement>('[role="tabpanel"]')!;
    // What the reader typed under each type survives switching away and back.
    const drafts = new Map<string, { s: string; b: string }>();
    let current = tabs[0]?.dataset.kind ?? '';
    const pick = (b: HTMLButtonElement) => {
      if (b.dataset.kind === current) return;
      drafts.set(current, { s: subject.value, b: body.value });
      current = b.dataset.kind!;
      panel.setAttribute('aria-labelledby', b.id);
      let tpl!: HTMLElement;
      box.querySelectorAll<HTMLElement>('[data-how]').forEach((h) => { h.hidden = h.dataset.how !== b.dataset.kind; if (!h.hidden) tpl = h; });
      tabs.forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-selected', String(x === b)); x.tabIndex = x === b ? 0 : -1; });
      tagOut.textContent = tpl.dataset.tag!;
      subject.placeholder = tpl.dataset.ph || '';
      subject.hidden = !tpl.dataset.ph;
      const saved = drafts.get(current);
      subject.value = saved?.s ?? '';
      body.value = saved?.b ?? tpl.dataset.tplBody!;
      body.placeholder = body.value ? '' : (tpl.querySelector('li')?.textContent ?? '');
      sync();
    };
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => pick(b));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = tabs[(i + d + tabs.length) % tabs.length];
        n.focus(); pick(n);
      });
    });
    subject.addEventListener('input', sync);
    body.addEventListener('input', sync);
    const copyBtn = box.querySelector<HTMLButtonElement>('[data-copy-draft]')!;
    copyBtn.addEventListener('click', async () => {
      const text = `${to}\n${subj()}\n\n${body.value}`;
      try { await navigator.clipboard.writeText(text); flash(copyBtn.querySelector('span')!, box.dataset.copied!); }
      catch { body.focus(); body.select(); }
    });
    // The page may open with a type already chosen: /contact?type=privacy
    const want = new URLSearchParams(location.search).get('type');
    const start = tabs.find((t) => t.dataset.kind === want);
    if (start) pick(start);
  });
</script>

<style>
  .ct { max-width: var(--max); margin: 0 auto; padding: 18px 20px 64px; display: grid; gap: 34px; --ct-forest: #26301f; --ct-moss: #3b4a2b; --ct-brown: #7a3b1d; --ct-peach: #fbe0d4; --ct-cream: #f7f1e8; --ct-sand: #f1e6d6; --ct-green: #e3ecd9; }
  @media (prefers-color-scheme: dark) { .ct { --ct-peach: #3a2620; --ct-cream: #221d17; --ct-sand: #2a241c; --ct-green: #2b3524; } }
  .ct :is(div, section) { min-width: 0; }
  .ct-pill { display: inline-block; font-size: .78rem; font-weight: 600; padding: 4px 12px; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line); }
  .ct-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; }
  .ct-hero h1 { font-family: var(--font-display); font-size: clamp(2.1rem, 4.8vw, 3.1rem); line-height: 1.15; margin: 12px 0; }
  .ct-hero h1 span, .ct-hero h1 em { display: block; }
  .ct-hero h1 em { font-style: normal; color: var(--ct-brown); }
  @media (prefers-color-scheme: dark) { .ct-hero h1 em { color: var(--cta); } }
  .ct-dek { color: var(--ink-soft); line-height: 1.75; margin: 0 0 18px; }
  .ct-mail { display: flex; align-items: center; gap: 10px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-pill); padding: 6px 6px 6px 6px; max-width: 470px; }
  .ct-mail i { width: 38px; height: 38px; border-radius: 50%; background: var(--ct-brown); color: #fff; display: grid; place-items: center; flex: none; }
  .ct-mail a { flex: 1; min-width: 0; font-weight: 700; color: var(--ink); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ct-mail button { font: inherit; font-size: .82rem; border: 1px solid var(--line-strong); background: var(--bg); color: var(--ink); padding: 6px 12px; border-radius: var(--r-pill); cursor: pointer; white-space: nowrap; }
  .ct-note { margin: 8px 0 0 8px; font-size: .8rem; color: var(--muted); }
  .ct-art { position: relative; min-height: 340px; }
  .ct-arch { position: absolute; left: 0; top: 0; width: 58%; height: 330px; border-radius: 999px 999px 18px 18px; overflow: hidden; display: block; background: var(--ct-sand); }
  .ct-arch img, .ct-circle img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ct-arch small { position: absolute; left: 0; right: 0; bottom: 0; font-size: .62rem; color: #fff; background: rgba(15,12,9,.6); padding: 4px 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ct-circle { position: absolute; right: 0; top: 0; width: 150px; height: 150px; border-radius: 50%; overflow: hidden; border: 5px solid var(--bg); }
  .ct-social { position: absolute; right: 0; bottom: 0; width: 56%; background: var(--ct-forest); color: #fbf3e8; border-radius: 22px; padding: 20px; box-shadow: 0 12px 30px rgba(20,25,15,.25); }
  .ct-social b { font-family: var(--font-display); font-size: 1.1rem; }
  .ct-social p { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 0; }
  .ct-social a { font-size: .82rem; font-weight: 700; color: #fbf3e8; background: rgba(255,255,255,.12); padding: 6px 13px; border-radius: var(--r-pill); text-decoration: none; }
  .ct-social a:hover { background: rgba(255,255,255,.22); }
  .ct-pick h2, .ct-h2 { font-family: var(--font-display); font-size: 1.7rem; margin: 0; }
  .ct-sub { margin: 6px 0 16px; color: var(--muted); font-size: .9rem; }
  .ct-kinds { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .ct-kind { font: inherit; text-align: left; display: grid; gap: 3px; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: 16px; cursor: pointer; color: var(--ink); }
  .ct-kind i { width: 32px; height: 32px; border-radius: 50%; background: var(--ct-sand); display: grid; place-items: center; margin-bottom: 10px; }
  .ct-kind b { font-size: .92rem; }
  .ct-kind small { font-size: .76rem; color: var(--muted); }
  .ct-kind.is-on { background: var(--ct-moss); border-color: var(--ct-moss); color: #fbf3e8; }
  .ct-kind.is-on i { background: rgba(255,255,255,.15); }
  .ct-kind.is-on small { color: rgba(251,243,232,.8); }
  .ct-panel { margin-top: 12px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 24px; display: grid; grid-template-columns: 1fr 1.05fr; gap: 24px; }
  .ct-tag { display: inline-block; font-size: .74rem; padding: 3px 10px; border-radius: var(--r-pill); background: var(--ct-green); }
  .ct-how h3 { font-family: var(--font-display); font-size: 1.25rem; margin: 12px 0; }
  .ct-how ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ct-how li { display: flex; gap: 10px; align-items: center; font-size: .92rem; }
  .ct-how li i { width: 20px; height: 20px; border-radius: 50%; background: var(--ct-green); display: grid; place-items: center; flex: none; }
  .ct-more-link { display: inline-block; margin-top: 16px; font-size: .86rem; font-weight: 700; color: var(--ct-brown); text-decoration: none; }
  .ct-draft { background: var(--ct-sand); border-radius: 20px; padding: 18px 20px; display: grid; gap: 8px; }
  .ct-row { display: flex; align-items: center; gap: 10px; margin: 0; font-size: .86rem; flex-wrap: wrap; }
  .ct-row > span { width: 72px; color: var(--muted); flex: none; }
  .ct-row input { flex: 1; min-width: 120px; font: inherit; font-size: .86rem; border: 0; border-bottom: 1px dashed var(--line-strong); background: transparent; color: var(--ink); padding: 3px 2px; }
  .ct-row input[hidden] { display: none; }
  .ct-bodylbl { display: block; border-top: 1px solid var(--line); padding-top: 10px; }
  .ct-draft textarea { width: 100%; box-sizing: border-box; font: inherit; font-size: .88rem; line-height: 1.6; border: 0; background: transparent; color: var(--ink); resize: vertical; }
  .ct-draft textarea:focus, .ct-row input:focus { outline: 2px solid var(--cta); outline-offset: 2px; border-radius: 6px; }
  .ct-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .ct-btn { display: inline-flex; gap: 6px; align-items: center; padding: 9px 16px; border-radius: var(--r-pill); font: inherit; font-size: .88rem; font-weight: 600; text-decoration: none; border: 1px solid transparent; cursor: pointer; }
  .ct-btn-cta { background: var(--cta); color: #fff !important; }
  .ct-btn-ghost { background: var(--surface); border-color: var(--line-strong); color: var(--ink); }
  .ct-sos { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; background: var(--ct-peach); border-radius: var(--r-lg); padding: 20px 24px; }
  .ct-sos > i { width: 46px; height: 46px; border-radius: 50%; background: var(--ct-brown); color: #fff; display: grid; place-items: center; }
  .ct-sos b { font-family: var(--font-display); font-size: 1.1rem; }
  .ct-sos p { margin: 2px 0 0; font-size: .86rem; color: var(--ink-soft); }
  .ct-before { margin-top: 14px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .ct-before a { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 14px 18px; text-decoration: none; display: grid; gap: 2px; }
  .ct-before b { font-size: .95rem; color: var(--ink); }
  .ct-before span { font-size: .8rem; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (max-width: 900px) {
    .ct-hero, .ct-panel { grid-template-columns: 1fr; }
    .ct-kinds { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ct-before { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .ct { padding: 14px 16px 48px; }
    .ct-art { min-height: 300px; }
    .ct-arch { height: 290px; }
    .ct-circle { width: 110px; height: 110px; }
    .ct-social { width: 64%; padding: 16px; }
    .ct-sos { grid-template-columns: auto 1fr; }
    .ct-sos .ct-btn { grid-column: 1 / -1; justify-self: start; }
    .ct-panel { padding: 16px; }
  }
</style>
