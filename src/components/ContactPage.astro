---
// /contact (+ /[lang]/contact), owner's mock-up "문의하기 개선안"
// (2026-10-01). There is no server form: the reader picks what the message
// is about, the page drafts a subject and a body skeleton they can edit, and
// "write in mail app" opens it as a mailto (or copies it). Meta title and
// description are unchanged so the page keeps its search identity.
import { getCollection } from 'astro:content';
import { createHash } from 'node:crypto';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutNav from './AboutNav.astro';
import { localizePath, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';

interface Props { lang: Lang }
const { lang } = Astro.props;
const contactEmail = 'hello@wanderatlasguides.com';
const SOCIAL = [
  ['Instagram', 'https://www.instagram.com/wander_atlas_guides/'],
  ['Pinterest', 'https://www.pinterest.com/pixervtm/'],
  ['Threads', 'https://www.threads.net/@wander_atlas_guides'],
];

// Two real, credited place photos for the hero (mock-up arch + circle),
// from posts that exist in this language, two different countries.
const wallHash = (s: string) => createHash('sha1').update(s).digest('hex').slice(0, 16);
const WALL_DIR = fileURLToPath(new URL('../../public/wall/', import.meta.url));
const posts = await getCollection('posts', ({ data }) => !data.draft && data.category === 'attraction');
const translated = lang === 'en' ? null : new Set((await getCollection('postI18n')).map((e) => e.id).filter((id) => id.startsWith(`${lang}/`)).map((id) => id.slice(lang.length + 1)));
const seen = new Set<string>();
const photos = posts
  .filter((p) => !translated || translated.has(p.id))
  .filter((p) => ['wikimedia', 'kto-open', 'openverse-cc'].includes(p.data.heroImage?.license ?? '') && p.data.heroImage?.credit)
  .sort((a, b) => (b.data.place?.userRatingsTotal ?? 0) - (a.data.place?.userRatingsTotal ?? 0))
  .flatMap((p) => {
    const name = `${wallHash(p.data.heroImage!.url)}.webp`;
    if (!existsSync(WALL_DIR + name) || seen.has(p.data.country)) return [];
    seen.add(p.data.country);
    return [{ src: `/wall/${name}`, credit: p.data.heroImage!.credit!, href: localizePath(`/posts/${p.id}`, lang), label: localizePlace(p.data.region, lang) }];
  })
  .slice(0, 2);

