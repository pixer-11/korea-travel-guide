---
// The Wander Atlas pin in its own colours (vermilion pin, gold ring, cream
// lens, star) — the favicon, inline. Logo.astro is the single-colour version
// the header tints; this one stands in where a guide has no photo
// (픽서님 10-08: "아무것도 없는 것보다 컬러 로고가 낫다").
interface Props { size?: number; class?: string; }
const { size = 28, class: cls } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" class:list={['brand-pin', cls]} aria-hidden="true" focusable="false">
  <path fill="#c8443a" d="M16 2.6 A 10.8 10.8 0 0 1 26.8 13.4 C 26.8 19.3 21.9 23.2 16 30.2 C 10.1 23.2 5.2 19.3 5.2 13.4 A 10.8 10.8 0 0 1 16 2.6 Z" />
  <circle cx="16" cy="13.4" r="7.7" fill="#e8a13c" />
  <circle cx="16" cy="13.4" r="6.6" fill="#f6f1e6" />
  <path fill="#c8443a" d="M16 8.6 L17 12.4 L20.8 13.4 L17 14.4 L16 18.2 L15 14.4 L11.2 13.4 L15 12.4 Z" />
</svg>
