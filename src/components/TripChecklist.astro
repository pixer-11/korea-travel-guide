// Shared trip-planning checklist lead magnet for /free/trip-checklist (en) +
// /[lang]/free/trip-checklist. Redesign 2026-09-30 after the owner's
// "체크리스트 개선안": a one-sheet layout (header card with departure date and
// destination, five numbered stages, notes in grey, a closing band) that
// prints as two A4 pages. On screen it does what paper cannot: the departure
// date fills each stage's "do by" date, and ticks are kept in this browser
// (localStorage; nothing is sent anywhere). The item wording is the same list
// as before, with the parenthetical asides moved into the grey notes.
interface Props { lang: Lang }
const { lang } = Astro.props as Props;

type Item = [string, string?];
interface Group { title: string; sub: string; by?: number; items: Item[] }
const T: Record<Lang, {
  metaTitle: string; metaDesc: string; eyebrow: string; h1a: string; h1b: string; h1c: string; dek: string;
  depart: string; dest: string; destPh: string; by: string; byBlank: string; printBtn: string; reset: string;
  nlHeading: string; nlDek: string; nlCta: string; bandLead: string; bandEss: string; bandClosed: string; bandEsim: string; bandBye: string;
  groups: Group[];
