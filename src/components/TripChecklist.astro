    bandEss: '나라별 필수정보', bandClosed: '내 날짜에 뭐가 닫나', bandEsim: 'eSIM 가이드', bandBye: '즐거운 여행 되세요!',
    groups: [
      { title: '2~3개월 전', sub: '서류와 큰 예약', by: 60, items: [['여권 유효기간 확인', '많은 나라가 6개월 이상 요구'], ['비자·입국 규정 확인, 필요하면 일찍 신청'], ['대략적인 예산 정하고 항공권 가격 살피기'], ['항공권과 처음 며칠 숙소 예약'], ['권장·필수 예방접종 확인']] },
      { title: '1개월 전', sub: '보험·티켓·백업', by: 30, items: [['인기 투어와 우선입장 티켓 예약'], ['여행자 보험 준비', '의료 + 여행 취소'], ['여권·티켓·예약 사본 만들기', '클라우드 한 부 + 인쇄 한 부'], ['카드사에 여행 알리고 해외 결제 수수료 확인'], ['오프라인 지도와 번역 앱 다운로드']] },
      { title: '1주일 전', sub: '연결·돈·짐', by: 7, items: [['eSIM 구매 또는 로밍 확인', '도착하자마자 연결되도록'], ['현지 통화 조금 준비 / 해외에서 카드 되는지 확인'], ['날씨 확인하고 짐 싸기 마무리'], ['공항 이동편과 체크인 시간 확인'], ['집에 있는 사람에게 일정 공유']] },
      { title: '기내 필수품', sub: '출발 당일 가방에', items: [['여권, 탑승권, 예약 확인서'], ['휴대폰, 충전기, 보조배터리, 플러그 어댑터', '보조배터리는 기내 반입만 가능'], ['상비약 + 간단한 구급 키트'], ['갈아입을 옷과 기본 세면도구', '위탁 수하물이 늦게 올 때를 대비'], ['결제 카드 + 약간의 현금']] },
      { title: '도착 후', sub: '공항에서 숙소까지', items: [['eSIM 활성화 / Wi-Fi 연결'], ['예약한 이동편이나 공식 택시로 공항에서 이동'], ['숙소 주소를 현지 언어로 저장', '택시 기사에게 그대로 보여줄 수 있게'], ['현지 긴급 전화번호와 대사관 확인'], ['교통카드 사고 핵심 표현 한두 개 익히기']] },
    ],
  },
  ja: {
    metaTitle: '無料の旅行準備チェックリスト',
    metaDesc: '実用的で印刷できる旅行チェックリスト — 3か月前、1週間前にやること、荷造り、到着後にやることまで。Wander Atlasが無料でお届け。',
    eyebrow: 'Wander Atlas · 無料の旅行準備チェックリスト',
    h1a: '出発3か月前から', h1b: '到着の日まで', h1c: '、1枚で',
