      { title: '機内持ち込みの必需品', sub: '出発当日のかばんに', items: [['パスポート、搭乗券、予約確認書'], ['スマホ、充電器、モバイルバッテリー、変換プラグ', 'モバイルバッテリーは機内持ち込みのみ'], ['常備薬＋簡単な救急セット'], ['着替えと基本の洗面用具', '預け荷物が遅れて届くときのために'], ['決済カード＋少しの現金']] },
      { title: '到着後', sub: '空港から宿まで', items: [['eSIMを有効化／Wi-Fiに接続'], ['予約した送迎か公式タクシーで空港から移動'], ['宿の住所を現地の言語で保存', 'タクシーの運転手にそのまま見せられるように'], ['現地の緊急番号と大使館を控える'], ['交通カードを買い、キーフレーズを1〜2個覚える']] },
