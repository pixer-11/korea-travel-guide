      { title: '随身必备', sub: '出发当天放进包里', items: [['护照、登机牌、预订确认单'], ['手机、充电器、充电宝、转换插头', '充电宝只能随身携带，不能托运'], ['常备药＋小型急救包'], ['一套换洗衣物和基本洗漱用品', '以防托运行李晚到'], ['支付卡＋少量现金']] },
      { title: '抵达后', sub: '从机场到住处', items: [['激活 eSIM／连接 Wi-Fi'], ['用预订的接送或正规出租车离开机场'], ['用当地语言保存住宿地址', '可以直接给出租车司机看'], ['记下当地紧急电话和你的使馆'], ['办张交通卡，学一两句关键用语']] },
    ],
