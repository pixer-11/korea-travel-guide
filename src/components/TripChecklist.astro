    groups: [
      { title: '2–3 meses antes', sub: 'Documentos y grandes reservas', by: 60, items: [['Comprueba la validez del pasaporte', 'muchos países exigen 6+ meses'], ['Infórmate sobre visados y normas de entrada, y solicítalos pronto si hace falta'], ['Fija un presupuesto aproximado y vigila los precios de los vuelos'], ['Reserva los vuelos y las primeras noches de alojamiento'], ['Comprueba las vacunas recomendadas u obligatorias']] },
      { title: '1 mes antes', sub: 'Seguro, entradas, copias', by: 30, items: [['Reserva los tours importantes y las entradas sin colas'], ['Contrata un seguro de viaje', 'médico + cancelación'], ['Haz copias del pasaporte, billetes y reservas', 'una en la nube + una impresa'], ['Avisa a tu banco de que viajas; revisa las comisiones en el extranjero'], ['Descarga mapas sin conexión y una app de traducción']] },
      { title: '1 semana antes', sub: 'Conexión, dinero, maleta', by: 7, items: [['Compra una eSIM o revisa el roaming', 'para aterrizar conectado'], ['Consigue algo de moneda local / confirma que tus tarjetas funcionan fuera'], ['Mira el tiempo y termina la maleta'], ['Confirma los traslados al aeropuerto y las horas de facturación'], ['Comparte tu itinerario con alguien en casa']] },
      { title: 'Equipaje de mano', sub: 'En tu bolsa el día de salida', items: [['Pasaporte, tarjetas de embarque, confirmaciones de reserva'], ['Móvil, cargador, batería externa, adaptador de enchufe', 'la batería externa va en cabina, nunca facturada'], ['Medicamentos + un pequeño botiquín'], ['Una muda de ropa y artículos de aseo básicos', 'por si tu maleta facturada llega tarde'], ['Tarjetas de pago + algo de efectivo']] },
      { title: 'Al llegar', sub: 'Del aeropuerto a tu alojamiento', items: [['Activa tu eSIM / conéctate al Wi-Fi'], ['Sal del aeropuerto con un traslado reservado o un taxi oficial'], ['Guarda la dirección de tu alojamiento en el idioma local', 'para enseñársela tal cual al taxista'], ['Anota los números de emergencia locales y tu embajada'], ['Consigue una tarjeta de transporte y aprende una o dos frases clave']] },
