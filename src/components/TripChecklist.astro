const L = T[lang];
const clientData = JSON.stringify({ by: L.by, byBlank: L.byBlank, locale: localeCodes[lang] });
---

<BaseLayout title={L.metaTitle} description={L.metaDesc} localized={true}>
  <div class="ck" data-ck data-strings={clientData}>
    <div class="wrap ck-sheet">
      <header class="ck-head">
        <div class="ck-head-copy">
          <p class="ck-eyebrow">{L.eyebrow}</p>
          <h1 class="ck-h1">{L.h1a}<span><em>{L.h1b}</em>{L.h1c}</span></h1>
          <p class="ck-dek">{L.dek}</p>
          <p class="ck-actions no-print">
            <button type="button" class="ck-print" data-ck-print>{L.printBtn}</button>
            <button type="button" class="ck-reset" data-ck-reset>{L.reset}</button>
          </p>
        </div>
        <div class="ck-trip">
          <label class="ck-field">
            <span>{L.depart}</span>
            <input type="date" data-ck-depart autocomplete="off" />
          </label>
          <label class="ck-field">
            <span>{L.dest}</span>
            <input type="text" data-ck-dest placeholder={L.destPh} maxlength="60" autocomplete="off" />
          </label>
        </div>
      </header>

      {L.groups.map((g, gi) => (
        <section class="ck-stage" data-ck-stage data-by={g.by ?? ''}>
          <div class="ck-stage-head">
            <h2><span class="ck-num">{String(gi + 1).padStart(2, '0')}</span> {g.title}</h2>
            <p class="ck-stage-meta">
              <span>{g.sub}</span>
              {g.by && <span class="ck-by" data-ck-by>· {L.byBlank}</span>}
              <span class="ck-count no-print" data-ck-count>0/{g.items.length}</span>
            </p>
          </div>
          <ul class="ck-items">
            {g.items.map(([text, note], ii) => (
              <li>
                <label class="ck-item">
                  <input type="checkbox" data-ck-id={`${gi}-${ii}`} />
                  <span class="ck-box" aria-hidden="true"></span>
                  <span class="ck-text">{text}{note && <small> · {note}</small>}</span>
                </label>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <footer class="ck-band">
        <p>
          {L.bandLead}{' '}
          <a href={localizePath('/essentials', lang)}>{L.bandEss}</a> ·{' '}
          <a href={localizePath('/tools/whats-closed', lang)}>{L.bandClosed}</a> ·{' '}
          <a href={localizePath('/tools/esim', lang)}>{L.bandEsim}</a>
          <span class="print-only"> — wanderatlasguides.com{lang === 'en' ? '' : `/${lang}`}</span>
        </p>
        <strong>{L.bandBye}</strong>
      </footer>
    </div>
  </div>

  <div class="no-print">
    <Newsletter lang={lang} heading={L.nlHeading} dek={L.nlDek} cta={L.nlCta} />
  </div>
</BaseLayout>

<script>
  // Everything stays in this browser: the departure date, the destination and
  // the ticks go to localStorage (wrapped — private windows and blocked
  // storage throw), never to a server.
  const KEY = 'wa-trip-checklist-v1';
  const DAY = 86_400_000;
  for (const root of document.querySelectorAll<HTMLElement>('[data-ck]')) {
    let S: { by?: string; byBlank?: string; locale?: string } = {};
    try { S = JSON.parse(root.dataset.strings || '{}'); } catch { /* defaults */ }
    const load = () => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
    const save = (v: any) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch { /* not kept */ } };
    const state = Object.assign({ depart: '', dest: '', done: [] as string[] }, load());

    const depart = root.querySelector<HTMLInputElement>('[data-ck-depart]')!;
    const dest = root.querySelector<HTMLInputElement>('[data-ck-dest]')!;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[data-ck-id]')];
    // "10/21" as on the printed sheet where that is how dates are written
    // (ko/ja/zh — Intl gives "10. 21." for Korean); "Oct 21" / "21 oct" elsewhere.
    const numeric = /^(ko|ja|zh)/.test(S.locale || '');
    const intl = new Intl.DateTimeFormat(S.locale || undefined, { month: 'short', day: 'numeric', timeZone: 'UTC' });
    const fmt = { format: (d: Date) => (numeric ? `${d.getUTCMonth() + 1}/${d.getUTCDate()}` : intl.format(d)) };

    const render = () => {
      const t = Date.parse(state.depart);
      for (const stage of root.querySelectorAll<HTMLElement>('[data-ck-stage]')) {
        const by = Number(stage.dataset.by);
        const out = stage.querySelector<HTMLElement>('[data-ck-by]');
        if (out && by) out.textContent = '· ' + (Number.isFinite(t) && S.by ? S.by.replace('{d}', fmt.format(new Date(t - by * DAY))) : S.byBlank || '');
        const mine = [...stage.querySelectorAll<HTMLInputElement>('input[data-ck-id]')];
        const c = stage.querySelector<HTMLElement>('[data-ck-count]');
        if (c) c.textContent = `${mine.filter((b) => b.checked).length}/${mine.length}`;
        stage.classList.toggle('is-done', mine.length > 0 && mine.every((b) => b.checked));
      }
    };

    depart.value = state.depart || '';
    dest.value = state.dest || '';
    for (const b of boxes) b.checked = state.done.includes(b.dataset.ckId!);
    render();

    depart.addEventListener('change', () => { state.depart = depart.value; save(state); render(); });
    dest.addEventListener('input', () => { state.dest = dest.value; save(state); });
    for (const b of boxes) b.addEventListener('change', () => {
      state.done = boxes.filter((x) => x.checked).map((x) => x.dataset.ckId!);
      save(state); render();
    });
    root.querySelector('[data-ck-reset]')?.addEventListener('click', () => {
      for (const b of boxes) b.checked = false;
      state.done = []; save(state); render();
    });
    root.querySelector('[data-ck-print]')?.addEventListener('click', () => {
      (window as any).plausible?.('Checklist print');
      window.print();
    });
  }
</script>

<style>
  .ck {
    --ck-sand: #f3e8d8; --ck-paper: #f8f3ea; --ck-row: #f1e6d6; --ck-night: #262d1b;
    --ck-brown: #8a4a1c; --ck-peach: #fde3d4; --ck-ring: #a89478; --ck-on-dark: #e8eed9;
    padding: 1.6rem 0 2rem;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .ck { --ck-sand: #2c261d; --ck-paper: #24201a; --ck-row: #2e2820; --ck-peach: #3a2620; --ck-ring: #8a7a63; --ck-brown: #e8a577; }
  }
  :global(:root[data-theme='dark']) .ck { --ck-sand: #2c261d; --ck-paper: #24201a; --ck-row: #2e2820; --ck-peach: #3a2620; --ck-ring: #8a7a63; --ck-brown: #e8a577; }
  .ck-sheet { max-width: 860px; display: grid; gap: 1rem; }

  /* Header card */
  .ck-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 15rem); gap: 1.4rem; align-items: center; background: var(--ck-sand); border-radius: 22px; padding: 1.6rem 1.7rem; }
  .ck-eyebrow { margin: 0 0 .6rem; font-size: .88rem; font-weight: 700; color: var(--ink-soft); }
  .ck-h1 { font-family: var(--font-display); font-size: clamp(1.8rem, 4.6vw, 2.5rem); line-height: 1.2; letter-spacing: -0.02em; margin: 0 0 .7rem; color: var(--ink); word-break: keep-all; }
  .ck-h1 span { display: block; }
  .ck-h1 em { font-style: normal; color: var(--ck-brown); }
  .ck-dek { margin: 0; color: var(--ink-soft); line-height: 1.6; }
  .ck-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1rem 0 0; }
  .ck-print, .ck-reset { font: inherit; font-weight: 700; font-size: .9rem; border-radius: var(--r-pill); padding: .55rem 1.1rem; cursor: pointer; }
  .ck-print { background: var(--ck-brown); color: #fff; border: 0; }
  :global(:root[data-theme='dark']) .ck-print { color: #1d1a15; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .ck-print { color: #1d1a15; } }
  .ck-reset { background: transparent; color: var(--ink-soft); border: 1px solid var(--line-strong); }
  .ck-trip { background: var(--ck-night); color: var(--ck-on-dark); border-radius: 18px; padding: 1.1rem 1.2rem; display: grid; gap: .9rem; }
  .ck-field { display: grid; gap: .35rem; font-size: .85rem; font-weight: 700; }
  .ck-field input { font: inherit; font-weight: 500; color: #fff; background: transparent; border: 0; border-bottom: 1.5px solid #8fa06f; padding: .3rem 0; width: 100%; color-scheme: dark; }
  .ck-field input::placeholder { color: rgba(255, 255, 255, .45); }
  .ck-field input:focus { outline: none; border-bottom-color: #fff; }

  /* Stages */
  .ck-stage { background: var(--surface); border: 1px solid var(--line-soft); border-radius: 22px; padding: 1.2rem 1.3rem 1.3rem; }
  .ck-stage-head { display: flex; justify-content: space-between; align-items: baseline; gap: .3rem 1rem; flex-wrap: wrap; margin-bottom: .8rem; }
  .ck-stage h2 { font-family: var(--font-display); font-size: 1.35rem; margin: 0; color: var(--ink); }
  .ck-num { color: var(--ck-brown); }
  .ck-stage-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .5rem; margin: 0; font-size: .85rem; color: var(--ink-soft); }
  .ck-count { font-weight: 700; font-size: .78rem; padding: .1rem .55rem; border-radius: var(--r-pill); background: var(--ck-row); }
  .ck-stage.is-done .ck-count { background: #d7e4c0; color: #2f4a1b; }
  .ck-items { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; }
  .ck-item { position: relative; display: flex; align-items: center; gap: .75rem; padding: .6rem .9rem; border-radius: 16px; background: var(--ck-row); cursor: pointer; line-height: 1.45; }
  .ck-item input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .ck-box { flex: none; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--ck-ring); display: grid; place-items: center; }
  .ck-item input:checked + .ck-box { background: var(--ck-brown); border-color: var(--ck-brown); }
  .ck-item input:checked + .ck-box::after { content: ''; width: 6px; height: 11px; border: solid #fff; border-width: 0 2.5px 2.5px 0; transform: translateY(-1px) rotate(45deg); }
  .ck-item input:checked ~ .ck-text { color: var(--muted); text-decoration: line-through; text-decoration-color: rgba(0, 0, 0, .25); }
  .ck-item input:focus-visible + .ck-box { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ck-text { color: var(--ink); overflow-wrap: anywhere; }
  .ck-text small { color: var(--muted); font-size: .82em; }

  /* Closing band */
  .ck-band { display: flex; justify-content: space-between; align-items: center; gap: .6rem 1.2rem; flex-wrap: wrap; background: var(--ck-peach); border-radius: 22px; padding: 1.1rem 1.3rem; }
  .ck-band p { margin: 0; font-size: .92rem; line-height: 1.6; color: var(--ink-soft); flex: 1 1 20rem; }
  .ck-band a { color: var(--ink); font-weight: 700; }
  .ck-band strong { font-family: var(--font-display); font-size: 1.2rem; color: var(--ink); }
  .print-only { display: none; }

  @media (max-width: 640px) {
    .ck-head { grid-template-columns: 1fr; padding: 1.3rem 1.2rem; }
    .ck-stage { padding: 1rem 1rem 1.1rem; }
    .ck-item { padding: .55rem .75rem; }
  }

  /* Print: the two-page sheet of the mock-up. Site chrome, the buttons, the
     counters and the newsletter go; the fields print what was typed, or a
     blank line to write on. */
  @media print {
    :global(.site-header), :global(.site-footer), :global(.topbar), :global(.nl-popup), .no-print { display: none !important; }
    .print-only { display: inline; }
    .ck { padding: 0; --ck-sand: #f3e8d8; --ck-paper: #f8f3ea; --ck-row: #f1e6d6; --ck-peach: #fde3d4; --ck-brown: #8a4a1c; }
    .ck, .ck * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .ck-sheet { max-width: none; gap: .7rem; }
    .ck-head { padding: 1.1rem 1.3rem; }
    .ck-trip { padding: .9rem 1rem; }
    .ck-field input { color: #fff; }
    .ck-stage { break-inside: avoid; padding: .9rem 1rem 1rem; }
    .ck-stage:nth-of-type(3) { break-before: page; }
    .ck-item { padding: .45rem .8rem; }
    .ck-band a { text-decoration: none; }
  }
</style>
