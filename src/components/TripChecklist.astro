---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from './Newsletter.astro';
import { localizePath, localeCodes, type Lang } from '../i18n/utils';

// Shared trip-planning checklist lead magnet for /free/trip-checklist (en) +
// /[lang]/free/trip-checklist. Redesign 2026-09-30 after the owner's
// "체크리스트 개선안": a one-sheet layout (header card with departure date and
// destination, five numbered stages, notes in grey, a closing band) that
// prints as two A4 pages. On screen it does what paper cannot: the departure
// date fills each stage's "do by" date, and ticks are kept in this browser
// (localStorage; nothing is sent anywhere). The item wording is the same list
// as before, with the parenthetical asides moved into the grey notes.
interface Props { lang: Lang }
const { lang } = Astro.props as Props;

type Item = [string, string?];
interface Group { title: string; sub: string; by?: number; items: Item[] }
const T: Record<Lang, {
  metaTitle: string; metaDesc: string; eyebrow: string; h1a: string; h1b: string; h1c: string; dek: string;
  depart: string; dest: string; destPh: string; by: string; byBlank: string; printBtn: string; reset: string;
  nlHeading: string; nlDek: string; nlCta: string; bandLead: string; bandEss: string; bandClosed: string; bandEsim: string; bandBye: string;
  groups: Group[];
}> = {
  en: {
    metaTitle: 'Free trip-planning checklist',
    metaDesc: 'A practical, printable travel checklist — what to do 3 months out, 1 week out, what to pack, and what to do on arrival. Free from Wander Atlas.',
    eyebrow: 'Wander Atlas · Free trip checklist',
    h1a: 'From three months out', h1b: 'to landing day', h1c: ', on one sheet',
    dek: 'Enter your departure date and each stage gets its own deadline. Tick things off as you go.',
    depart: 'Departure', dest: 'Destination', destPh: 'Where to?', by: 'do by {d}', byBlank: 'do by ____ / ____',
    printBtn: 'Print / Save as PDF', reset: 'Clear ticks',
    nlHeading: 'Get the checklist — plus one genuinely useful guide a week',
    nlDek: 'Pop in your email and confirm — the full checklist is above to print or save anytime. No spam, unsubscribe in one click.',
    nlCta: 'Send me the checklist',
    bandLead: 'Visa, transport and emergency numbers by country, what is closed on your dates, and eSIM comparisons:',
    bandEss: 'Country essentials', bandClosed: 'What’s closed on my dates', bandEsim: 'eSIM guides', bandBye: 'Safe travels!',
    groups: [
      { title: '2–3 months before', sub: 'Documents and big bookings', by: 60, items: [['Check passport validity', 'many countries require 6+ months'], ['Research visa / entry rules and apply early if needed'], ['Set a rough budget and start watching flight prices'], ['Book flights and the first few nights of accommodation'], ['Check recommended / required vaccinations']] },
      { title: '1 month before', sub: 'Insurance, tickets, backups', by: 30, items: [['Book the big-ticket tours and skip-the-line tickets'], ['Sort travel insurance', 'medical + trip cancellation'], ['Make copies of passport, tickets and bookings', 'one in the cloud + one printed'], ['Tell your bank you’re traveling; check card foreign-transaction fees'], ['Download offline maps and a translation app']] },
      { title: '1 week before', sub: 'Connection, money, packing', by: 7, items: [['Buy an eSIM or check roaming', 'so you land connected'], ['Get some local currency / confirm your cards work abroad'], ['Check the weather and finalize packing'], ['Confirm airport transfers and check-in times'], ['Share your itinerary with someone at home']] },
      { title: 'Carry-on essentials', sub: 'In your bag on the day', items: [['Passport, boarding passes, booking confirmations'], ['Phone, charger, power bank, plug adapter', 'power banks go in the cabin, never in checked bags'], ['Medications + a small first-aid kit'], ['A change of clothes and basic toiletries', 'in case your checked bag arrives late'], ['Payment cards + a little cash']] },
      { title: 'On arrival', sub: 'From the airport to your bed', items: [['Activate your eSIM / connect to Wi-Fi'], ['Leave the airport by pre-booked transfer or official taxi'], ['Save your accommodation’s address in the local language', 'to show a taxi driver as it is'], ['Note local emergency numbers and your embassy'], ['Get a transit card and learn one or two key phrases']] },
    ],
  },
  ko: {
    metaTitle: '무료 여행 준비 체크리스트',
    metaDesc: '실용적이고 인쇄 가능한 여행 체크리스트 — 3개월 전, 1주일 전 할 일, 짐 싸기, 도착 후 할 일까지. Wander Atlas가 무료로 드립니다.',
