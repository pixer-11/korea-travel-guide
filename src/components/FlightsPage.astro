// Shared flights page for /flights (en) + /[lang]/flights.
//
// 2026-10-08 redesign from the "항공권 개선안" mock. Kept from the mock: a
// two-column hero with the search beside the promise, a default departure
// city per language (the widget otherwise guessed the reader's IP — a Korean
// reader in Vietnam saw SGN), destination chips that load the search with that
// destination, a 12-month "good month" strip, "what to sort next" tiles and a
// FAQ. Left out on purpose: every fare number (route averages, the price bars,
// "Tue–Wed 15–25% cheaper", "6–8 weeks ahead") — the mock's own note says they
// were placeholders, fares change by the minute and this site never prints a
// price it did not measure; and the fare-alert e-mail, which would promise a
// mail nothing sends. The month strip is when-to-go's own climate verdict
// (monthComfort), named with the one city its record comes from.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const H = homeT(lang);
const P = (p: string) => localizePath(p, lang);

