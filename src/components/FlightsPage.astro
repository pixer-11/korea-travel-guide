      ['通过 Wander Atlas 会更贵吗？', '不会。价格与直接去预订网站相同。你预订后，该网站可能会付给我们佣金，用来维持这些免费指南。'],
      ['“适合去的月份”依据是什么？', '依据每个国家一座城市的近年气候平均值（NASA POWER），该城市写在月份条下方：气温越舒适、雨越少，排名越靠前。只看天气，不涉及票价或人流。'],
      ['为什么这页没有价格？', '机票价格每分钟都在变，也因日期和座位而异。印在这里的数字等你看到时可能已过时，所以真实票价请以实时搜索为准。'],
    ],
    disclosure: `本页部分链接为联盟链接。通过它们预订，${SITE.name} 可能获得佣金，你无需支付额外费用——这有助于我们保持指南免费。`,
  },
}[lang];

// Default departure city per language: the reader of /ko/ is most likely
// flying out of Seoul, /ja/ out of Tokyo. es/zh/en readers are spread over
// too many countries to guess, so the widget keeps its own detection there.
const ORIGIN: Partial<Record<Lang, string>> = { ko: 'SEL', ja: 'TYO' };
const origin = ORIGIN[lang] ?? '';

// Destinations: cities this site covers in depth, by metro IATA code. The
// month strip is the COUNTRY's climate verdict (one city's record), so the
// chip names the country beside the city and the strip names its record city.
const DESTS: { code: string; city: string; country: string }[] = [
  { code: 'TYO', city: 'Tokyo', country: 'Japan' },
  { code: 'OSA', city: 'Osaka', country: 'Japan' },
  { code: 'SEL', city: 'Seoul', country: 'South Korea' },
  { code: 'TPE', city: 'Taipei', country: 'Taiwan' },
  { code: 'HKG', city: 'Hong Kong', country: 'Hong Kong' },
  { code: 'BKK', city: 'Bangkok', country: 'Thailand' },
  { code: 'DAD', city: 'Da Nang', country: 'Vietnam' },
  { code: 'SIN', city: 'Singapore', country: 'Singapore' },
  { code: 'DPS', city: 'Bali', country: 'Indonesia' },
  { code: 'PAR', city: 'Paris', country: 'France' },
];
const factsBy = (countryFacts as any).countries ?? countryFacts;
const slugOf = Object.fromEntries((countriesData as any).countries.map((c: any) => [c.name, c.slug]));
const BAND_KEY: Record<string, 'good' | 'fine' | 'fair' | 'harsh'> = { g: 'good', f: 'fine', a: 'fair', h: 'harsh' };
const locale = lang === 'zh' ? 'zh-CN' : lang;
const monthShort = Array.from({ length: 12 }, (_, i) =>
  new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, i, 15))));
const nowMonth = buildToday().getUTCMonth() + 1;
const dests = DESTS
  .filter((d) => d.code !== origin)
  .map((d) => {
    const f = factsBy[d.country];
    const bands = bandString(f?.climate);
    const slug = slugOf[d.country];
    return {
      ...d,
      slug,
      name: localizePlace(d.city, lang),
      countryName: localizePlace(d.country, lang),
      bands,
      climateCity: f?.climateCity ? localizePlace(f.climateCity, lang) : '',
      years: f?.climateYears ?? 10,
      best: bands ? [...bands].map((b, i) => (b === 'g' ? monthShort[i] : '')).filter(Boolean).slice(0, 4) : [],
      now: bands ? BAND_KEY[bands.charAt(nowMonth - 1)] : null,
    };
  });
const wtg = (slug: string, m?: number) => P(`/tools/when-to-go/${slug}/${m ? `${MONTH_SLUGS[m - 1]}/` : ''}`);

const widgetSrc = (dest = '') =>
  `https://tpemd.com/content?currency=usd&trs=553157&shmarker=754088.flights_page&show_hotels=false&powered_by=true&locale=${lang}` +
  `&searchUrl=www.aviasales.com%2Fsearch&primary_override=%23c8443a&color_button=%23c8443a&color_icons=%23857c6f&dark=%23201c17&light=%23FFFFFF` +
  `&secondary=%23f4eee3&special=%23e6e1d6&color_focused=%23c8443a&border_radius=10&plain=true&promo_id=7879&campaign_id=100` +
  (origin ? `&origin=${origin}` : '') + (dest ? `&destination=${dest}` : '');

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteHref(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: `${T.h1a} ${T.h1b}`, description: T.metaDesc, url: pageUrl, isPartOf: { '@id': `${site}/#site` } },
    {
      '@type': 'FAQPage',
      mainEntity: T.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ],
};
---

<BaseLayout title={T.metaTitle} description={T.metaDesc} jsonLd={jsonLd} localized={true}>
  <section class="fl-hero">
    <div class="wrap fl-hero-grid">
      <div class="fl-hero-copy">
        <p class="eyebrow"><Emoji name="airplane" /> {T.eyebrow}</p>
        <h1>{T.h1a}<br /><span>{T.h1b}</span></h1>
        <p class="fl-dek">{T.dek}</p>
        <ul class="fl-checks">
          {T.checks.map((c) => <li><span aria-hidden="true">✓</span>{c}</li>)}
        </ul>
      </div>
      <div class="fl-search" id="fl-search">
        <!-- locale follows the page language; origin is the language's home
             city (ko/ja) and destination is set by the chips below. -->
        <div class="tp-widget-card" id="fl-widget" data-src={widgetSrc()}>
          <script is:inline async src={widgetSrc()} charset="utf-8"></script>
        </div>
      </div>
    </div>
  </section>

  <section class="section fl-dest">
    <div class="wrap">
      <h2>{T.destH}</h2>
      <p class="fl-sub">{T.destSub}</p>
      <div class="fl-chips">
        {dests.map((d) => (
          <button type="button" class="fl-chip" data-code={d.code} data-slug={d.slug} data-bands={d.bands} aria-controls="fl-months fl-search">
            <span class="fl-chip-city">{d.name} <small>{d.code}</small></span>
            <span class="fl-chip-country">{d.countryName}</span>
            {d.now && <span class={`fl-pill b-${d.now}`}>{T.nowLabel}: {H(d.now)}</span>}
          </button>
        ))}
      </div>

      <div class="fl-months" id="fl-months" aria-live="polite"
        data-labels={JSON.stringify({ now: T.nowLabel, good: H('good'), fine: H('fine'), fair: H('fair'), harsh: H('harsh') })}>
        <p class="fl-pick" data-empty>{T.pickPrompt}</p>
        {dests.filter((d) => d.bands).map((d) => (
          <div class="fl-year" data-for={d.code} hidden>
            <h3>{T.monthsH.replace('{country}', d.countryName)}</h3>
            <ol class="fl-strip">
              {[...d.bands].map((b, i) => (
                <li>
                  <a class={`b-${BAND_KEY[b]}${i + 1 === nowMonth ? ' is-now' : ''}`} href={wtg(d.slug, i + 1)} title={H(BAND_KEY[b])}>
                    <span>{monthShort[i]}</span>
                  </a>
                </li>
              ))}
            </ol>
            <ul class="fl-legend">
              {(['good', 'fine', 'fair', 'harsh'] as const).map((k) => <li><span class={`sw b-${k}`} aria-hidden="true"></span>{H(k)}</li>)}
            </ul>
            <p class="fl-basis">{T.basis.replace('{city}', d.climateCity).replace('{years}', String(d.years))}</p>
            {d.best.length > 0 && <p class="fl-best"><strong>{T.bestLabel}:</strong> {d.best.join(' · ')}</p>}
            <a class="fl-all" href={wtg(d.slug)}>{T.allMonths.replace('{country}', d.countryName)}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section fl-tips-sec">
    <div class="wrap">
      <h2>{T.tipsH}</h2>
      <div class="fl-tips">
        {T.tips.map(([h, p]) => (
          <div class="fl-card">
            <h3>{h}</h3>
            <p>{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section fl-next-sec">
    <div class="wrap">
      <h2>{T.nextH}</h2>
      <p class="fl-sub">{T.nextSub}</p>
      <div class="fl-next">
        {T.next.map(([icon, h, p, href, aff]) => (
          aff
            ? <a class="fl-tile" href={href as string} target="_blank" rel="sponsored noopener" data-affiliate-placement="flights-next">
                <Emoji name={icon as string} /><strong>{h}</strong><span>{p}</span><em class="aff">{T.partner}</em>
              </a>
            : <a class="fl-tile" href={P(href as string)}>
                <Emoji name={icon as string} /><strong>{h}</strong><span>{p}</span>
              </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section fl-faq-sec">
    <div class="wrap fl-faq-grid">
      <h2>{T.faqH}</h2>
      <div class="fl-faq">
        {T.faq.map(([q, a], i) => (
          <details open={i === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
    <div class="wrap">
      <p class="tp-disclosure">{T.disclosure}</p>
    </div>
  </section>
</BaseLayout>

<script>
  // Chips: reload the search widget with that destination (the widget reads
  // origin/destination from its own script URL — verified live 2026-10-08)
  // and open the destination's month strip.
  function init() {
    const box = document.getElementById('fl-widget');
    const months = document.getElementById('fl-months');
    if (!box || !months) return;
    const base = box.dataset.src || '';
    // "This month" was decided at build time (UTC). A page built on the 31st
    // and read on the 1st — or read in a later month before the next deploy —
    // would name the wrong month, so the reader's own month wins here.
    const KEY: Record<string, string> = { g: 'good', f: 'fine', a: 'fair', h: 'harsh' };
    let labels: Record<string, string> = {};
    try { labels = JSON.parse(months.dataset.labels || '{}'); } catch { /* keep build text */ }
    const m = new Date().getMonth() + 1;
    document.querySelectorAll<HTMLButtonElement>('.fl-chip').forEach((chip) => {
      const k = KEY[(chip.dataset.bands || '').charAt(m - 1)];
      const pill = chip.querySelector<HTMLElement>('.fl-pill');
      if (!k || !pill || !labels[k]) return;
      pill.className = `fl-pill b-${k}`;
      pill.textContent = `${labels.now}: ${labels[k]}`;
    });
    months.querySelectorAll('.fl-strip').forEach((strip) => {
      strip.querySelectorAll('a').forEach((a, i) => a.classList.toggle('is-now', i + 1 === m));
    });
    document.querySelectorAll<HTMLButtonElement>('.fl-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const code = chip.dataset.code || '';
        document.querySelectorAll('.fl-chip').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        const url = new URL(base);
        url.searchParams.set('destination', code);
        box.replaceChildren();
        const s = document.createElement('script');
        s.async = true;
        s.charset = 'utf-8';
        s.src = url.toString();
        box.appendChild(s);
        let shown = false;
        months.querySelectorAll<HTMLElement>('.fl-year').forEach((y) => {
          const on = y.dataset.for === code;
          y.hidden = !on;
          shown ||= on;
        });
        const empty = months.querySelector<HTMLElement>('[data-empty]');
        if (empty) empty.hidden = shown;
        if (window.matchMedia('(max-width: 900px)').matches) {
          document.getElementById('fl-search')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }
  init();
</script>

<style>
  .fl-hero { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .fl-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .fl-hero h1 { font-family: var(--font-display); font-size: clamp(2rem, 4.4vw, 3.1rem); line-height: 1.12; margin: 0.4rem 0 0.9rem; }
  .fl-hero h1 span { color: var(--accent-text); }
  /* Korean breaks between words, not inside them ("한/번에"). Korean only:
     keep-all on Japanese has no spaces to break at and overflowed (09-30). */
  :global(html[lang='ko']) .fl-hero h1 { word-break: keep-all; }
  .fl-dek { color: var(--ink-soft); font-size: 1.02rem; line-height: 1.6; margin: 0 0 1rem; }
  .fl-checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; font-size: 0.92rem; color: var(--ink-soft); }
  .fl-checks li { display: flex; gap: 0.5rem; align-items: baseline; }
  .fl-checks span { color: var(--pine); font-weight: 700; }
  .fl-search .tp-widget-card { margin: 0; min-height: 220px; }

  .fl-dest h2, .fl-tips-sec h2, .fl-next-sec h2, .fl-faq-sec h2 { font-family: var(--font-display); margin: 0 0 0.3rem; }
  .fl-sub { color: var(--muted); margin: 0 0 1rem; font-size: 0.92rem; }
  .fl-chips { display: grid; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); gap: 0.6rem; }
  .fl-chip { display: grid; gap: 0.2rem; text-align: left; padding: 0.75rem 0.85rem; border-radius: var(--r-md);
    border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; font: inherit; }
  .fl-chip:hover { border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
  .fl-chip[aria-pressed='true'] { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }
  .fl-chip-city { font-weight: 700; }
  .fl-chip-city small { color: var(--muted); font-weight: 500; font-size: 0.72rem; margin-left: 0.2rem; }
  .fl-chip-country { color: var(--muted); font-size: 0.82rem; }
  .fl-pill { justify-self: start; font-size: 0.72rem; font-weight: 600; padding: 0.12rem 0.5rem; border-radius: var(--r-pill); border: 1px solid; margin-top: 0.2rem; }

  .fl-months { margin-top: 1.1rem; padding: 1.1rem 1.2rem; border-radius: var(--r-lg); background: var(--surface-2); border: 1px solid var(--line-soft); }
  .fl-pick { margin: 0; color: var(--muted); }
  .fl-year h3 { margin: 0 0 0.75rem; font-size: 1.1rem; }
  .fl-strip { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0.3rem; }
  .fl-strip a { display: flex; align-items: flex-end; justify-content: center; height: 3.4rem; border-radius: var(--r-sm); border: 1px solid;
    text-decoration: none; font-size: 0.74rem; font-weight: 600; padding-bottom: 0.3rem; }
  .fl-strip a.is-now { outline: 2px solid var(--ink); outline-offset: 2px; }
  .fl-legend { list-style: none; padding: 0; margin: 0.7rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.8rem; color: var(--ink-soft); }
  .fl-legend li { display: flex; align-items: center; gap: 0.35rem; }
  .sw { width: 0.8rem; height: 0.8rem; border-radius: 999px; border: 1px solid; display: inline-block; }
  .fl-basis { margin: 0.6rem 0 0; font-size: 0.8rem; color: var(--muted); }
  .fl-best { margin: 0.4rem 0 0; font-size: 0.9rem; }
  .fl-all { display: inline-block; margin-top: 0.6rem; font-weight: 600; }

  .fl-tips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
  .fl-card { padding: 1rem 1.1rem; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line-soft); }
  .fl-card h3 { margin: 0 0 0.4rem; font-size: 1rem; }
  .fl-card p { margin: 0; color: var(--ink-soft); font-size: 0.9rem; line-height: 1.55; }

  .fl-next { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.7rem; }
  .fl-tile { position: relative; display: grid; gap: 0.25rem; padding: 0.9rem; border-radius: var(--r-md); background: var(--surface);
    border: 1px solid var(--line-soft); color: var(--ink); text-decoration: none; }
  .fl-tile:hover { border-color: var(--line-strong); }
  .fl-tile strong { font-size: 0.95rem; }
  .fl-tile span { font-size: 0.82rem; color: var(--muted); }
  .fl-tile .aff { position: absolute; top: 0.55rem; right: 0.6rem; font-size: 0.66rem; font-style: normal; font-weight: 700; color: var(--gold-text); }

  .fl-faq-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); gap: 1.5rem; align-items: start; }
  .fl-faq details { border: 1px solid var(--line-soft); border-radius: var(--r-md); background: var(--surface); padding: 0.75rem 1rem; margin-bottom: 0.5rem; }
  .fl-faq summary { cursor: pointer; font-weight: 600; }
  .fl-faq p { margin: 0.55rem 0 0; color: var(--ink-soft); font-size: 0.92rem; line-height: 1.6; }

  /* Same four colours as the when-to-go pages (WhenToGoCountry.astro) —
     one scale across the site, not a fourth set of greens. */
  .b-good  { background: #8fa06a; color: #1d2812; border-color: #7c8d59; }
  .b-fine  { background: #dfe8ce; color: #45573a; border-color: #c8d5b4; }
  .b-fair  { background: #efab80; color: #63300f; border-color: #dd9366; }
  .b-harsh { background: #7b451d; color: #f6e7d7; border-color: #663810; }
  @media (prefers-color-scheme: dark) {
    .b-good  { background: #5f7340; color: #f0f6e2; border-color: #85995b; }
    .b-fine  { background: #3f4a35; color: #d3e0c1; border-color: #526043; }
    .b-fair  { background: #b4763f; color: #2a1608; border-color: #c78d56; }
    .b-harsh { background: #8c3f16; color: #ffe6d5; border-color: #a5522a; }
  }

  @media (max-width: 900px) {
    .fl-hero-grid, .fl-faq-grid { grid-template-columns: 1fr; }
    .fl-tips { grid-template-columns: 1fr; }
    .fl-next { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fl-strip { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }
</style>
