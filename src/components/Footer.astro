---
import Logo from './Logo.astro';
import { SITE } from '../siteConfig';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div>
      <a href={localizePath('/', lang)} class="brand"><Logo size={24} /> <span>{SITE.name}</span></a>
      <p>{t('footer.tagline')}</p>
      <p style="margin-top:0.6rem">&copy; {year} {SITE.name}</p>
    </div>
    <nav aria-label={t('a11y.footerNav')}>
      <a href={localizePath('/destinations', lang)}>{t('nav.destinations')}</a>
      <a href={localizePath('/regions', lang)}>{t('reg.allRegions')}</a>
      <a href={localizePath('/itinerary', lang)}>{t('nav.itineraries')}</a>
      {/* Two different tools that were briefly sharing one name: "when to go"
          answers which MONTH, the crowd finder answers which HOUR. */}
      <a href={localizePath('/tools/when-to-go', lang)}>{t('nav.tools')}</a>
      <a href={localizePath('/tools/best-time', lang)}>{t('nav.quietTimes')}</a>
      <a href={localizePath('/tools/esim', lang)}>{t('nav.esim')}</a>
      {/* /essentials/ had exactly ONE inbound link on the whole site — the
          homepage — while 23 English pages (17 country guides + 5 topic hubs +
          the index), 115 across languages, hung off it, and the topic hubs got
          two each. Every other section index is linked from here and sits at
          1,224 inbound; this one was simply missed. */}
      <a href={localizePath('/essentials', lang)}>{t('home.travelEssentials')}</a>
      <a href={localizePath('/events', lang)}>{t('nav.events')}</a>
      <a href={localizePath('/flights', lang)}>{t('nav.flights')}</a>
      <a href={localizePath('/my-trip', lang)}>{t('trip.title')}</a>
      <a href={localizePath('/free/trip-checklist', lang)}>{t('footer.checklist')}</a>
      <a href={localizePath('/about', lang)}>{t('footer.editorialPolicy')}</a>
      <a href={localizePath('/methodology', lang)}>{t('footer.methodology')}</a>
      <a href={localizePath('/contact', lang)}>{t('footer.contact')}</a>
      <a href={localizePath('/privacy', lang)}>{t('footer.privacy')}</a>
      <a href={localizePath('/terms', lang)}>{t('footer.terms')}</a>
    </nav>
    {/* The site's own profiles, for readers who want to follow and for
        crawlers tying the entity together (mirrors Organization.sameAs in
        BaseLayout). Until 2026-08-18 the footer had ZERO external links —
        three live accounts and nothing on the site pointed at them. Brand
        names, so no i18n. rel=me is the reciprocal of the profiles' own
        link back to wanderatlasguides.com. */}
    <nav class="footer-social" aria-label="Wander Atlas on social media">
      <a href="https://www.instagram.com/wander_atlas_guides/" rel="me noopener" target="_blank">Instagram</a>
      <a href="https://www.pinterest.com/pixervtm/" rel="me noopener" target="_blank">Pinterest</a>
      <a href="https://www.threads.net/@wander_atlas_guides" rel="me noopener" target="_blank">Threads</a>
    </nav>
  </div>
</footer>
