---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import Flag from './Flag.astro';
import Emoji from './Emoji.astro';
import Newsletter from './Newsletter.astro';
import Search from './Search.astro';
import { SITE } from '../siteConfig';
import { useTranslations, localizePath, localeCodes, type Lang } from '../i18n/utils';
import { eventSchemaName } from '../lib/eventName';
import { editorHasTraveled } from '../lib/editorVisited';
import { localizePlace } from '../i18n/places';
import { loadCardTranslations, cardHelpers } from '../i18n/cards';
import { pickRepHeroUrl, tileSize } from '../lib/repImage';
import countriesData from '../../data/countries.json';
import wallData from '../../data/wall.json';
import { heroIsWideEnough } from '../lib/ogPhoto.mjs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
// Localized card titles/descriptions (from postI18n) so the homepage shows
// translated post titles, not the English source — matches the region/country hubs.
const tr = await loadCardTranslations(lang);
const card = cardHelpers(tr, lang);

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const flagship = ['jeju-seongsan-ilchulbong', 'seoul-gyeongbokgung-palace', 'sokcho-seoraksan-cable-car', 'busan-haeundae'];
// The homepage cover used to be a hardcoded list of four Korean posts, and the
// first entry always won — so the badge read "Jeju" forever, on a site that now
// spans dozens of countries. It is now drawn from posts that EARN the slot, and
// the pick rotates by ISO week so a returning visitor sees somewhere new without
// anyone editing a list. The rotation is derived, not random: the same week
// always yields the same cover, so builds stay reproducible.
const isoWeek = (d: Date) => {
  const t = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()));
  t.setUTCDate(t.getUTCDate() + 4 - (t.getUTCDay() || 7));           // Thursday of this week
  const yearStart = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
  return Math.ceil(((t.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
};

// Eligible = a real place, a photo good enough to fill the cover, and enough
// reviews that it is genuinely a landmark rather than a quiet local spot.
// heroIsWideEnough keeps a measured-narrow photo out of the rotation. The cover
// is also the home page's og:image, and one 1024px Wikimedia original (Fort
// Aguada) put the home page below Discover's 1200px large-card floor for a full
// week (found 2026-08-06). Unmeasured heroes still qualify — a new post has no
// probe yet, and the cover pool must not shrink to nothing.
const coverPool = posts.filter(
  (p) =>
    p.data.category === 'attraction' &&
    p.data.place?.name &&
    p.data.heroImage?.url &&
    !p.data.heroImage.url.includes('placeholder') &&
    heroIsWideEnough(p) &&
    (p.data.place?.userRatingsTotal ?? 0) >= 5000
);

// One per region, so a rotation moves across places instead of cycling through
// four spots in one city; the strongest-rated post represents its region.
const oneWeeklyPickPerRegion = (pool: any[]) => {
  const byRegion = new Map();
  for (const p of [...pool].sort((a, b) => (b.data.place?.userRatingsTotal ?? 0) - (a.data.place?.userRatingsTotal ?? 0))) {
    if (!byRegion.has(p.data.region)) byRegion.set(p.data.region, p);
  }
  const rotation = [...byRegion.values()].sort((a, b) => a.id.localeCompare(b.id)); // stable order
  return rotation.length ? rotation[isoWeek(new Date()) % rotation.length] : null;
};

const cover = oneWeeklyPickPerRegion(coverPool) ?? posts[0];

// The spotlight block below is SOUTH KOREA — its flag, heading, city links and
// button all say so. Its photo used to come from `cover`, which rotates across
// every country on the site, so the two had nothing to do with each other. It
// read correctly while the site was Korea-only and broke the week the rotation
// reached Spain: the home page showed the Alhambra, in Granada, captioned
// "South Korea" (owner caught it, 2026-08-06). Same pool, same weekly
// rotation, filtered to Korea — so it is a Korean landmark, and a different
// one each week.
const koreaCover = oneWeeklyPickPerRegion(
  coverPool.filter((p) => (p.data.country ?? 'South Korea') === 'South Korea'),
);
const rest = posts.filter((p) => p.id !== cover?.id);
const latest = rest.slice(0, 3);
// Don't showcase weak auto-generated cards on the highest-authority page. Food/
// trendy venues still on a city/landmark fallback hero undercut the "real places,
// real photos" promise; attractions/events read fine with a landmark shot, but
// food venues must have their OWN self-hosted photo (/venue-photos/) to appear here.
const trustworthyCard = (p: any) => {
  const cat = p.data.category;
  if (cat === 'attraction' || cat === 'event' || cat === 'essentials') return true;
  return (p.data.heroImage?.url || '').includes('/venue-photos/');
};
const latestIds = new Set(latest.map((p) => p.id));
const moreGuides = rest.filter((p) => !latestIds.has(p.id) && trustworthyCard(p)).slice(0, 6);

const seed = Number(new Date().toISOString().slice(0, 10).replace(/-/g, '')) || 1;
function shuffle<T>(arr: T[]) {
  const a = [...arr];
  let s = seed;
  for (let i = a.length - 1; i > 0; i--) {
    s = (s * 9301 + 49297) % 233280;
    const j = Math.floor((s / 233280) * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
// data/wall.json already stores the pre-generated 640px WebP thumbnail PATHS
// (scripts/build-wall.mjs) — e.g. "/wall/<hash>.webp" — so use them directly.
const wall = shuffle(wallData.images ?? []).slice(0, 12).map((url) => ({ url }));
const wallRow1 = wall.slice(0, 6);
const wallRow2 = wall.slice(6, 12);

const countFor = (name: string) => posts.filter((p) => (p.data.country ?? 'South Korea') === name).length;
const countries = countriesData.countries.map((c) => ({ ...c, count: countFor(c.name) }));
const live = countries.filter((c) => c.count > 0);
const soon = countries.filter((c) => c.count === 0);
const repImage = (name: string) => tileSize(pickRepHeroUrl(posts.filter((p) => (p.data.country ?? 'South Korea') === name)));

const koreaLinks = [
  { label: 'Seoul', href: '/regions/seoul' },
  { label: 'Busan', href: '/regions/busan' },
  { label: 'Jeju', href: '/regions/jeju' },
  { label: 'Gyeongju', href: '/regions/gyeongju' },
];

// ── This month's editor picks ───────────────────────────────────────────────
// The design mock's "where our editors would go this month" section, filled
// with what the data can actually stand behind: events genuinely happening
// this month, one per region, dates straight from each guide's frontmatter and
// re-checked on every (daily) build. No invented seasonal claims — the month's
// real calendar IS the recommendation. The editor is real, not a persona: the
// owner has personally traveled Vietnam, Korea, Thailand, Singapore, the US,
// Australia and more (src/lib/editorVisited.ts), so the "traveled here" badge
// is a country-level fact, never a city-level boast.
const nowD = new Date();
const monthlyPool = posts.filter((p) => {
  if (p.data.category !== 'event' || !p.data.eventStartDate) return false;
  if (!p.data.heroImage?.url || p.data.heroImage.url.includes('placeholder')) return false;
  const s = new Date(p.data.eventStartDate as any);
  const e = new Date((p.data.eventEndDate ?? p.data.eventStartDate) as any);
  if (e.getTime() < nowD.getTime() - 86400000) return false; // already over
  const sameMonth = s.getUTCFullYear() === nowD.getUTCFullYear() && s.getUTCMonth() === nowD.getUTCMonth();
  return sameMonth || s <= nowD; // starts this month, or already running
});
const monthlyPicks = (() => {
  const byRegion = new Map<string, any>();
  for (const p of [...monthlyPool].sort(
    (a, b) => new Date(a.data.eventStartDate as any).getTime() - new Date(b.data.eventStartDate as any).getTime(),
  )) {
    if (!byRegion.has(p.data.region)) byRegion.set(p.data.region, p);
    if (byRegion.size >= 3) break;
  }
  return [...byRegion.values()];
})();
const guidesIn = (region: string) => posts.filter((p) => p.data.region === region).length;
const monthLabel = new Intl.DateTimeFormat(localeCodes[lang] ?? 'en', { year: 'numeric', month: 'long' }).format(nowD);
const fmtEventDates = (p: any) => {
  const f = new Intl.DateTimeFormat(localeCodes[lang] ?? 'en', { month: 'short', day: 'numeric' });
  const s = new Date(p.data.eventStartDate as any);
  const e = new Date((p.data.eventEndDate ?? p.data.eventStartDate) as any);
  return s.getTime() === e.getTime() ? f.format(s) : `${f.format(s)} – ${f.format(e)}`;
};
---

<BaseLayout
  title={`${SITE.name} — ${t('home.tagline')}`}
  description={t('home.heroDek')}
  image={cover?.data.heroImage?.url}
  localized={true}
>
  <section class="hero-wall">
    <div class="wall-rows" aria-hidden="true">
      <div class="wall-row r1">
        {[...wallRow1, ...wallRow1].map((im) => <img src={im.url} alt="" width="640" height="427" decoding="async" />)}
      </div>
      <div class="wall-row r2">
        {[...wallRow2, ...wallRow2].map((im) => <img src={im.url} alt="" width="640" height="427" loading="lazy" decoding="async" />)}
      </div>
    </div>
    <div class="cover-scrim"></div>
    <div class="cover-inner wrap">
      <p class="kicker gold">{t('home.tagline')}</p>
      <h1>{t('home.heroTitle')}</h1>
      <p class="cover-dek">{t('home.heroDek')}</p>
      <Search placeholder={t('home.searchPlaceholder')} />
      <div class="cover-cta-row">
        <a class="cover-cta" href={localizePath('/destinations', lang)}>{t('home.exploreDestinations')} <span class="arw">→</span></a>
        {cover && <a class="cover-cta cover-cta-soft" href={localizePath(`/posts/${cover.id}`, lang)}>{t('home.featured')}: {localizePlace(cover.data.region, lang)} <span class="arw">→</span></a>}
      </div>
      <p class="cover-scale">{t('home.trustBar').replace('{n}', String(live.length))}</p>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="rule-head"><h2 class="kicker">{t('home.latestStories')}</h2></div>
        <div class="stories">
          {latest.map((post) => (
            <a class="story" href={localizePath(`/posts/${post.id}`, lang)}>
              <div class="story-thumb">
                <img src={tileSize(post.data.heroImage?.url ?? '/images/placeholder-market.svg')} alt={post.data.place?.name ?? post.data.title} loading="lazy" width="600" height="400" />
              </div>
              <span class="kicker gold">{t(`cat.${post.data.category}` as any)}</span>
              <h3>{card.title(post.id, post.data.title)}</h3>
              <p class="story-meta">{localizePlace(post.data.region, lang)} · {localizePlace(post.data.country ?? 'South Korea', lang)}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {monthlyPicks.length >= 2 && (
    <section class="section">
      <div class="wrap">
        <p class="kicker gold">{t('home.monthly.kicker').replace('{month}', monthLabel)}</p>
        <h2>{t('home.monthly.title')}</h2>
        <p class="ess-dek">{t('home.monthly.dek')}</p>
        <div class="stories">
          {monthlyPicks.map((p) => (
            <a class="story" href={localizePath(`/posts/${p.id}`, lang)}>
              <div class="story-thumb">
                <img src={tileSize(p.data.heroImage?.url ?? '')} alt={eventSchemaName(p.data.title)} loading="lazy" width="600" height="400" />
              </div>
              <span class="kicker gold">{fmtEventDates(p)}</span>
              <h3>{lang === 'en' ? eventSchemaName(p.data.title) : card.title(p.id, p.data.title)}</h3>
              <p class="story-meta">
                {localizePlace(p.data.region, lang)} · {localizePlace(p.data.country ?? 'South Korea', lang)} · {t('home.monthly.guides').replace('{n}', String(guidesIn(p.data.region)))}
              </p>
              {editorHasTraveled(p.data.country, p.data.region) && (
                <p class="story-meta editor-traveled">{t('home.monthly.visited')}</p>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="spotlight">
        <div class="spotlight-media">
          {/* This block is the SOUTH KOREA spotlight: flag, heading, Seoul/Busan/
              Jeju links, and a button to /destinations/south-korea. The photo
              used to come from `cover` — the weekly rotation, which draws from
              every country on the site — so the picture had nothing to do with
              the label beside it. Back when the site was Korea-only the cover
              was always Korean and it looked right; the day the rotation
              picked Granada, the home page showed the Alhambra under the words
              "South Korea" (owner caught it, 2026-08-06). The image now comes
              from Korean posts, like everything else in this block. */}
          <img src={tileSize(koreaCover?.data.heroImage?.url ?? '') || repImage('South Korea') || '/images/placeholder-market.svg'} alt={localizePlace('South Korea', lang)} loading="lazy" width="800" height="1000" />
        </div>
        <div class="spotlight-body">
          <p class="kicker gold"><Flag code="kr" class="flag-ico" /> {t('home.destinations')}</p>
          <h2>{localizePlace('South Korea', lang)}</h2>
          <p>{t('home.spotlightDesc').replace('{n}', String(countFor('South Korea')))}</p>
          <div class="spotlight-links">
            {koreaLinks.map((l) => <a href={localizePath(l.href, lang)}>{localizePlace(l.label, lang)}</a>)}
          </div>
          <a class="btn btn-primary" href={localizePath('/destinations/south-korea', lang)}>{localizePlace('South Korea', lang)} →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="rule-head">
        <h2 class="kicker">{t('home.destinations')}</h2>
        <a href={localizePath('/destinations', lang)} class="rule-link">{t('nav.allDestinations')} →</a>
      </div>
      <p class="bento-note">{t('home.bentoNote').replace('{n}', String(live.length))}</p>
      <div class="dest-bento">
        {live.map((c, i) => (
          <a class:list={['dest-tile', 'dest-live', { 'dest-feat': i === 0 }]} href={localizePath(`/destinations/${c.slug}`, lang)} style={`background-image:url(${repImage(c.name)})`}>
            {i === 0 && <span class="dest-ribbon">{t('home.featured')}</span>}
            <div class="dest-tile-inner">
              <span class="dest-flag"><Flag code={c.iso2} /></span>
              <h3>{localizePlace(c.name, lang)}</h3>
              <p>{t('home.guides').replace('{n}', String(c.count))} →</p>
            </div>
          </a>
        ))}
        {soon.map((c) => (
          <div class="dest-tile dest-soon">
            <div class="dest-tile-inner">
              <span class="dest-flag"><Flag code={c.iso2} /></span>
              <h3>{localizePlace(c.name, lang)}</h3>
              <p class="dest-pill">{t('home.comingSoon')}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="widget essentials-widget">
      <div class="ess-copy">
        <p class="kicker gold">{t('ess.sectionKicker')}</p>
        <h2>{t('ess.sectionTitle')}</h2>
        <p class="ess-dek">{t('ess.sectionDek')}</p>
      </div>
      {/* 여섯 칸. eSIM 과 항공권은 원래 푸터에 묻혀 있었는데, 둘 다 실제로 수익이
          나는 페이지라 여기로 끌어올렸다. 대신 '가기 좋은 시기'는 뺐다 — 같은 일을
          하는 when-to-go 도구가 메뉴에 따로 있고, 그쪽 페이지는 클릭이 0이다. */}
      <div class="essentials-strip">
        <a class="essential-card" href={localizePath('/essentials/visa', lang)}><span class="ico"><Emoji name="passport-control" /></span><div><h3>{t('ess.visa')}</h3><p>{t('ess.visaDek')}</p></div></a>
        <a class="essential-card" href={localizePath('/essentials/transport', lang)}><span class="ico"><Emoji name="metro" /></span><div><h3>{t('ess.transport')}</h3><p>{t('ess.transportDek')}</p></div></a>
        <a class="essential-card" href={localizePath('/tools/esim', lang)}><span class="ico"><Emoji name="antenna-bars" /></span><div><h3>{t('ess.esim')}</h3><p>{t('ess.esimDek')}</p></div></a>
        <a class="essential-card" href={localizePath('/essentials/money', lang)}><span class="ico"><Emoji name="credit-card" /></span><div><h3>{t('ess.money')}</h3><p>{t('ess.moneyDek')}</p></div></a>
        <a class="essential-card" href={localizePath('/flights', lang)}><span class="ico"><Emoji name="airplane" /></span><div><h3>{t('ess.flights')}</h3><p>{t('ess.flightsDek')}</p></div></a>
        <a class="essential-card" href={localizePath('/essentials/emergency', lang)}><span class="ico"><Emoji name="police-car-light" /></span><div><h3>{t('ess.emergency')}</h3><p>{t('ess.emergencyDek')}</p></div></a>
      </div>
      </div>
      <p style="margin-top:1.1rem"><a href={localizePath('/essentials', lang)} class="rule-link">{t('ess.all')} →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="trust">
        <div><span class="ico"><Emoji name="passport-control" /></span><h3>{t('trust.reviewedTitle')}</h3><p>{t('trust.reviewedText')}</p></div>
        <div><span class="ico"><Emoji name="round-pushpin" /></span><h3>{t('trust.factsTitle')}</h3><p>{t('trust.factsText')}</p></div>
        <div><span class="ico"><Emoji name="three-oclock" /></span><h3>{t('trust.updatedTitle')}</h3><p>{t('trust.updatedText')}</p></div>
      </div>
    </div>
  </section>

  <Newsletter lang={lang} />

  {moreGuides.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="rule-head"><h2 class="kicker">{t('home.moreToRead')}</h2></div>
        <div class="grid">
          {moreGuides.map((post) => (
            <PostCard
              href={localizePath(`/posts/${post.id}`, lang)}
              title={card.title(post.id, post.data.title)}
              description={card.desc(post.id, post.data.description)}
              region={post.data.region}
              category={post.data.category}
              image={post.data.heroImage?.url}
                  eventEndDate={post.data.eventEndDate}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      const els = Array.from(document.querySelectorAll('main .story, main .dest-tile, main .essential-card, main .card')) as HTMLElement[];
      els.forEach((el) => el.classList.add('js-reveal'));
      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('in'); obs.unobserve(e.target); } });
      }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
      els.forEach((el) => io.observe(el));
      setTimeout(() => els.forEach((el) => el.classList.add('in')), 1500);
    }
  </script>
</BaseLayout>
