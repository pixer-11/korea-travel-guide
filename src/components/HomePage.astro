---
import TypesetPlate from './TypesetPlate.astro';
import { getCollection } from 'astro:content';
import { busynessDayGroups, dayGroupText } from '../lib/busyness.mjs';
import { pickFeatured } from '../lib/featuredItineraries.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import Flag from './Flag.astro';
import Emoji from './Emoji.astro';
import Newsletter from './Newsletter.astro';
import Search from './Search.astro';
import { useTranslations, localizePath, localeCodes, type Lang } from '../i18n/utils';
import { homeT } from '../i18n/home-strings';
import { eventSchemaName } from '../lib/eventName';
import { editorHasTraveled, EDITOR_VISITED } from '../lib/editorVisited';
import { localizePlace, localizeVenueOrTitle } from '../i18n/places';
import { loadCardTranslations, cardHelpers } from '../i18n/cards';
import { pickRepHeroUrl, tileSize } from '../lib/repImage';
import { wallFor } from '../lib/wall';
import { COUNTRY_TIME } from '../lib/countryTime';
import { buildToday } from '../lib/buildDay.mjs';
import { venueTimeZone } from '../lib/venue-tz.mjs';
import { MONTH_SLUGS } from '../lib/when-to-go.mjs';
import { esimCountries } from '../lib/esim-paths.mjs';
import { longWeekends, homeGroup, GROUP_ORDER, bandString, diverseNewest, roundRobinByCountry, countLastWeek } from '../lib/home-data.mjs';
import countriesData from '../../data/countries.json';
import countryFacts from '../../data/country-facts.json';
import refreshCursor from '../../data/refresh-cursor.json';
import { heroIsWideEnough } from '../lib/ogPhoto.mjs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const H = homeT(lang);
// Localized card titles/descriptions (from postI18n) so the homepage shows
// translated post titles, not the English source — matches the region/country hubs.
const tr = await loadCardTranslations(lang);
const card = cardHelpers(tr, lang);
const P = (path: string) => localizePath(path, lang);
const locale = localeCodes[lang] ?? 'en';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// The build's one "today" (lib/buildDay.mjs) — every count on this page is "as
// of the build", and the script at the bottom re-dates what depends on the
// reader's own day (month, holidays, events).
const today = buildToday();
const todayISO = today.toISOString().slice(0, 10);

// ISO week number: the cover and the crowd demo rotate weekly, reproducibly.
const isoWeek = (d: Date) => {
  const t = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()));
  t.setUTCDate(t.getUTCDate() + 4 - (t.getUTCDay() || 7));           // Thursday of this week
  const yearStart = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
  return Math.ceil(((t.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
};

// The home page's og:image: a landmark that EARNS the slot (real place, wide
// enough photo, 5,000+ reviews), one per region, rotating by ISO week.
// heroIsWideEnough keeps a measured-narrow photo out: one 1024px original put
// the home page below Discover's 1200px floor for a week (2026-08-06).
const coverPool = posts.filter(
  (p) =>
    p.data.category === 'attraction' &&
    p.data.place?.name &&
    p.data.heroImage?.url &&
    !p.data.heroImage.url.includes('placeholder') &&
    heroIsWideEnough(p) &&
    (p.data.place?.userRatingsTotal ?? 0) >= 5000
);
const oneWeeklyPickPerRegion = (pool: any[]) => {
  const byRegion = new Map();
  for (const p of [...pool].sort((a, b) => (b.data.place?.userRatingsTotal ?? 0) - (a.data.place?.userRatingsTotal ?? 0))) {
    if (!byRegion.has(p.data.region)) byRegion.set(p.data.region, p);
  }
  const rotation = [...byRegion.values()].sort((a, b) => a.id.localeCompare(b.id)); // stable order
  return rotation.length ? rotation[isoWeek(today) % rotation.length] : null;
};
const cover = oneWeeklyPickPerRegion(coverPool) ?? posts[0];
// The SOUTH KOREA spotlight's photo comes from Korean posts only: the weekly
// cover once put the Alhambra under the words "South Korea" (2026-08-06).
const koreaCover = oneWeeklyPickPerRegion(
  coverPool.filter((p) => (p.data.country ?? 'South Korea') === 'South Korea'),
);

// Don't showcase weak auto-generated cards on the highest-authority page: food/
// trendy venues must have their OWN self-hosted photo (/venue-photos/) to appear.
const trustworthyCard = (p: any) => {
  const cat = p.data.category;
  if (cat === 'attraction' || cat === 'event' || cat === 'essentials') return true;
  return (p.data.heroImage?.url || '').includes('/venue-photos/');
};

const seed = Number(todayISO.replace(/-/g, '')) || 1;
function shuffle<T>(arr: T[]) {
  const a = [...arr];
  let s = seed;
  for (let i = a.length - 1; i > 0; i--) {
    s = (s * 9301 + 49297) % 233280;
    const j = Math.floor((s / 233280) * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const countryOf = (p: any) => p.data.country ?? 'South Korea';
const countFor = (name: string) => posts.filter((p) => countryOf(p) === name).length;
const countries = countriesData.countries.map((c) => ({ ...c, count: countFor(c.name) }));
const live = countries.filter((c) => c.count > 0);
const repImage = (name: string) => tileSize(pickRepHeroUrl(posts.filter((p) => countryOf(p) === name)));
// A country card's 64px photo: the best-known non-event place in that country
// that already has a 640px wall thumbnail, so a 64px slot never pulls a 960px
// remote original; falls back to the hub's representative image.
const repThumb = (name: string) => {
  const best = posts
    .filter((p) => countryOf(p) === name && p.data.category !== 'event' && p.data.heroImage?.url && wallFor(p.data.heroImage.url))
    .sort((a, b) => (b.data.place?.userRatingsTotal ?? 0) - (a.data.place?.userRatingsTotal ?? 0))[0];
  return best ? wallFor(best.data.heroImage!.url) : repImage(name);
};
const guidesLabel = (n: number) => (n === 1 ? H('cGuidesOne') : H('cGuides', { n }));

// ── The interactive photo wall ──────────────────────────────────────────────
// It used to be 12 anonymous thumbnails from data/wall.json, aria-hidden. Each
// tile is now a real place with its guide one click away: the same 640px
// thumbnails (wallFor finds the one build-wall.mjs made for a hero URL), drawn
// round-robin across countries so the wall shows the world rather than the
// country with the most posts, reshuffled daily.
const wallPool = posts.filter(
  (p) =>
    (p.data.category === 'attraction' || (p.data.heroImage?.url || '').includes('/venue-photos/')) &&
    p.data.heroImage?.url && !p.data.heroImage.url.includes('placeholder') &&
    wallFor(p.data.heroImage.url),
);
const wallTiles = roundRobinByCountry(shuffle(wallPool), 14).map((p) => ({
  img: wallFor(p.data.heroImage!.url),
  href: card.href(p.id, true),
  name: localizeVenueOrTitle(p.data.place?.name, card.title(p.id, p.data.title), lang),
  where: `${localizePlace(p.data.region, lang)} · ${localizePlace(countryOf(p), lang)}`,
}));
const wallRow1 = wallTiles.slice(0, 7);
const wallRow2 = wallTiles.slice(7, 14);

// ── The hero's three-way selector ───────────────────────────────────────────
// Month verdicts are when-to-go's own monthComfort bands (climate normals of
// one city per country, ranked inside that country's year) — the same verdict
// the linked month page prints. A country without a full climate record has no
// verdict and is left out of the month picker rather than guessed.
const factsBy = (countryFacts as any).countries ?? countryFacts;
const esimSlugs = new Set(esimCountries().map((c: any) => c.slug));
const itins = (await getCollection('itineraries')).sort((a, b) => a.data.city.localeCompare(b.data.city));
const itinFor = (c: any) => {
  const it = itins.filter((i) => (c.regions ?? []).includes(i.data.city)).sort((a, b) => a.data.days - b.data.days)[0];
  return it ? { href: P(`/itinerary/${it.id}/`), city: localizePlace(it.data.city, lang) } : null;
};
const pickCountries = live.map((c) => {
  const f = factsBy[c.name];
  const bands = bandString(f?.climate);
  const tz = COUNTRY_TIME[c.iso2.toUpperCase()];
  return {
    slug: c.slug,
    en: c.name,
    name: localizePlace(c.name, lang),
    iso2: c.iso2,
    guides: c.count,
    bands,
    climate: bands ? f.climate.map((m: any) => ({ hi: Math.round(m.hi), rain: Math.round(m.rain) })) : null,
    city: f?.climateCity ? localizePlace(f.climateCity, lang) : '',
    itin: itinFor(c),
    esim: esimSlugs.has(c.slug),
    // The Korean visa/emergency pickers leave South Korea out (TopicHub: a
    // Korean reader at home needs neither); #c=south-korea would fall back to
    // another country's numbers, so Korea goes to its own essentials page.
    ess: lang === 'ko' && c.slug === 'south-korea' ? P('/essentials/south-korea/') : '',
    tz: tz && !tz.multi ? tz.tz : '',
    tzCity: tz && !tz.multi ? localizePlace(tz.city, lang) : '',
    img: repThumb(c.name),
  };
});
const monthNames = Array.from({ length: 12 }, (_, i) =>
  new Intl.DateTimeFormat(locale, { month: 'long', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, i, 15))),
);
const buildMonth = today.getUTCMonth() + 1;
const bandOf = (c: any, m: number) => c.bands.charAt(m - 1);
const BAND_KEY: Record<string, 'good' | 'fine' | 'fair' | 'harsh'> = { g: 'good', f: 'fine', a: 'fair', h: 'harsh' };
const wtgHref = (slug: string, m: number) => P(`/tools/when-to-go/${slug}/${MONTH_SLUGS[m - 1]}/`);
// The reader most likely to land on /ko/ is going abroad: the default country
// in the "I know where I'm going" tab is the most-covered one that is not home,
// and the Korean home's "where to go" month picks are all abroad (the mock's
// own note: /ko/ recommending Korea was the old page's mistake).
const HOME_MARKET: Partial<Record<Lang, string>> = { ko: 'South Korea', ja: 'Japan', zh: 'China', es: 'Spain' };
const homeCountry = HOME_MARKET[lang];
const monthPickable = pickCountries.filter((c) => c.bands && !(lang === 'ko' && c.en === homeCountry));
const defaultCountry = [...pickCountries].sort((a, b) => b.guides - a.guides).find((c) => c.en !== homeCountry) ?? pickCountries[0];
const verdictText = (c: any, m: number) =>
  c.bands ? H('verdict', { country: c.name, month: monthNames[m - 1], band: H(BAND_KEY[bandOf(c, m)]) }) : c.name;
const climateText = (c: any, m: number) =>
  c.climate ? H('climate', { hi: c.climate[m - 1].hi, rain: c.climate[m - 1].rain, city: c.city }) : H('noClimate');
const heroData = JSON.stringify({
  months: monthNames,
  monthSlugs: MONTH_SLUGS,
  band: { g: H('good'), f: H('fine'), a: H('fair'), h: H('harsh') },
  tpl: { verdict: H('verdict'), climate: H('climate'), noClimate: H('noClimate'), guides: H('scGuides'), itin: H('scItin'), nowIn: H('nowIn') },
  base: {
    dest: P('/destinations/'), wtg: P('/tools/when-to-go/'), esim: P('/tools/esim/'),
    visa: P('/essentials/visa/'), closed: P('/tools/whats-closed/'), emer: P('/essentials/emergency/'),
  },
  c: Object.fromEntries(pickCountries.map((c) => [c.slug, {
    n: c.name, en: c.en, g: c.guides, b: c.bands, cl: c.climate, city: c.city, itin: c.itin, esim: c.esim, ess: c.ess, tz: c.tz, tzc: c.tzCity,
  }])),
}).replace(/</g, '\\u003c');

// ── Trust numbers, all from the build's own records ─────────────────────────
// refresh.mjs re-checks places against Google Places daily and records the day
// in data/refresh-cursor.json; that log is the "re-checked" count. Closures
// and hours changes are not logged by date, so the mock's figures for those
// are not shown.
const rechecked = countLastWeek((refreshCursor as any).checked, todayISO);
const weekAgo = Date.parse(`${todayISO}T00:00:00Z`) - 6 * 86400000;
const newThisWeek = posts.filter((p) => p.data.pubDate.getTime() >= weekAgo).length;

// ── Upcoming long weekends (Korean and Japanese homes) ──────────────────────
// Holidays from data/country-facts.json (the MIT `holidays` package); only for
// markets with a Sat–Sun weekend and no make-up workdays (see longWeekends).
const HOLIDAY_MARKET: Partial<Record<Lang, string>> = { ko: 'South Korea', ja: 'Japan' };
const holMarket = HOLIDAY_MARKET[lang];
const holidayBlocks = holMarket
  ? longWeekends(factsBy[holMarket]?.holidays ?? [], { fromISO: new Date(today.getTime() - 86400000).toISOString().slice(0, 10), limit: 6 })
  : [];
const holFmt = new Intl.DateTimeFormat(locale, { month: 'short', day: 'numeric', weekday: 'short', timeZone: 'UTC' });
const holRange = (b: any) => `${holFmt.format(new Date(`${b.start}T12:00:00Z`))} – ${holFmt.format(new Date(`${b.end}T12:00:00Z`))}`;

// ── This month's editor picks ───────────────────────────────────────────────
// Events genuinely happening this month, one per region, dates straight from
// each guide's frontmatter. The build makes picks for its own month AND the
// neighbours; the script shows the reader's month and skips what has ended by
// the venue's date (lib/evDay, as on the events hubs; 2026-10-05 audit). On the Korean home the picks are abroad:
// its readers are outbound travellers, and the mock flagged a Korean event
// topping /ko/ as the wrong recommendation.
const monthKeyOf = (d: Date) => `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
const PICKS = 3;
function picksFor(anchor: Date, n = PICKS * 2) {
  const pool = posts.filter((p) => {
    if (p.data.category !== 'event' || !p.data.eventStartDate) return false;
    if (lang === 'ko' && countryOf(p) === 'South Korea') return false;
    if (!p.data.heroImage?.url || p.data.heroImage.url.includes('placeholder')) return false;
    const s = new Date(p.data.eventStartDate as any);
    const e = new Date((p.data.eventEndDate ?? p.data.eventStartDate) as any);
    if (e.getTime() < anchor.getTime() - 86400000) return false; // already over
    const sameMonth = s.getUTCFullYear() === anchor.getUTCFullYear() && s.getUTCMonth() === anchor.getUTCMonth();
    return sameMonth || s <= anchor; // starts this month, or already running
  });
  const byRegion = new Map<string, any>();
  for (const p of [...pool].sort(
    (a, b) => new Date(a.data.eventStartDate as any).getTime() - new Date(b.data.eventStartDate as any).getTime(),
  )) {
    if (!byRegion.has(p.data.region)) byRegion.set(p.data.region, p);
    if (byRegion.size >= n) break;
  }
  return [...byRegion.values()];
}
const nextMonth = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() + 1, 1));
const prevMonth = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 0));
const monthFmt = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', timeZone: 'UTC' });
const monthSets = [today, prevMonth, nextMonth].map((d, i) => ({ key: monthKeyOf(d), label: monthFmt.format(d), m: d.getUTCMonth() + 1, picks: picksFor(d), current: i === 0 }));
const monthlyPicks = monthSets[0].picks.slice(0, PICKS);
const evEndOf = (p: any) => new Date((p.data.eventEndDate ?? p.data.eventStartDate) as any).toISOString().slice(0, 10);
const guidesIn = (region: string) => posts.filter((p) => p.data.region === region).length;
const goodMonthFor = (country: string, m: number) => {
  const c = pickCountries.find((x) => x.en === country);
  return !!c?.bands && bandOf(c, m) === 'g';
};
const fmtEventDates = (p: any) => {
  const f = new Intl.DateTimeFormat(locale, { month: 'short', day: 'numeric', timeZone: 'UTC' });
  const s = new Date(p.data.eventStartDate as any);
  const e = new Date((p.data.eventEndDate ?? p.data.eventStartDate) as any);
  return s.getTime() === e.getTime() ? f.format(s) : `${f.format(s)} – ${f.format(e)}`;
};

// ── Crowd demo: ONE real venue's measured hours, rotating weekly ────────────
const crowdDemoPool = posts
  .filter((p) => {
    const b = p.data.place?.busyness;
    return (
      p.data.category === 'attraction' && !!b &&
      (b.weekdayQuiet?.length || 0) > 0 && (b.weekendBusy?.length || 0) > 0 &&
      (p.data.place?.userRatingsTotal ?? 0) >= 5000
    );
  })
  .sort((a, b) => a.id.localeCompare(b.id));
// Each language's home leans the demo toward countries its readers search for.
const demoAffinity: Record<string, string[]> = {
  ko: ['South Korea', 'Japan', 'Thailand', 'Vietnam'],
  ja: ['Japan', 'South Korea', 'Taiwan', 'Thailand'],
  zh: ['Japan', 'Thailand', 'Singapore', 'South Korea'],
  es: ['Spain', 'Japan', 'Thailand'],
};
const affinityPool = crowdDemoPool.filter((p) => (demoAffinity[lang] ?? []).includes(p.data.country ?? ''));
const demoPickPool = affinityPool.length ? affinityPool : crowdDemoPool;
const crowdDemo = demoPickPool.length ? demoPickPool[isoWeek(today) % demoPickPool.length] : null;
const demoHours = Array.from({ length: 16 }, (_, i) => i + 7);
// One bar per group of days that agree on EVERY cell (busynessDayGroups — the
// tool's own hour-bar grouping). The first version drew quietDayGroups' biggest
// group, which narrows busy hours to what all its days share, so a group that
// took in Sunday painted Sunday's crowded noon "normal" (Codex, live, 10-04:
// Ikuta Shrine 12:00, Wolmi 16:00) — and the "now" mark then pointed at it.
// The script shows the group holding the venue's local weekday.
const cellsOf = (q: Set<number>, busy: Set<number>) => demoHours.map((h) => (busy.has(h) ? 'busy' : q.has(h) ? 'quiet' : 'mid'));
const demoGroups = crowdDemo
  ? (() => {
      const b = crowdDemo.data.place!.busyness!;
      const groups = busynessDayGroups(b, crowdDemo.data.place?.openingHours);
      if (groups?.length) {
        return groups.map((g: any) => ({ days: g.days as string[], label: dayGroupText(g.days, t), cells: cellsOf(new Set(g.quiet), new Set(g.busy)) }));
      }
      // No readable opening hours: the stored weekday / weekend split as is.
      const wk = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
      return [
        { days: wk, label: t('post.weekdays'), cells: cellsOf(new Set(b.weekdayQuiet ?? []), new Set((b as any).weekdayBusy ?? [])) },
        { days: ['Saturday', 'Sunday'], label: t('post.weekends'), cells: cellsOf(new Set(b.weekendQuiet ?? []), new Set(b.weekendBusy ?? [])) },
      ];
    })()
  : [];
// 24-hour labels read the same in all five languages (they were a hard-coded
// English "7am/2pm/10pm" on every home).
const hourLabel = (h: number) => `${h}:00`;
const demoTz = crowdDemo ? COUNTRY_TIME[(countriesData.countries.find((c) => c.name === countryOf(crowdDemo))?.iso2 ?? '').toUpperCase()] : undefined;
// Same eligibility the crowd tool itself uses — the number must match the tool.
const busynessCount = posts.filter((p) => {
  const b = p.data.place?.busyness;
  return !!b && !!(b.weekdayQuiet?.length || b.weekendQuiet?.length || b.weekendBusy?.length);
}).length;

// Itinerary band: the REAL courses, pinned flagships + two weekly rotations.
const featured = pickFeatured(itins, { pinned: ['Tokyo', 'Bangkok', 'Seoul'], rotate: 2 });
const itinMeta = (it: any) => {
  const slugs: string[] = (it.data.itinerary ?? []).flatMap((d: any) => (d.stops ?? []).map((s: any) => s.slug));
  const ratings = slugs
    .map((s) => Number(posts.find((p) => p.id === s)?.data.place?.rating))
    .filter((r) => Number.isFinite(r) && r > 0);
  const avg = ratings.length >= 3 ? (ratings.reduce((a, b) => a + b, 0) / ratings.length).toFixed(1) : null;
  return { stops: slugs.length, avg };
};

// ── Countries by region, each with its photo ────────────────────────────────
// A country added but not yet published shows as a "coming soon" tile, the way
// the continent and destinations pages show it (owner, 10-06: Macau was added
// and the home list simply left it out). Not a link: its country page is built
// with its first guide. Its eSIM page exists from day one, so that link stays.
const soonCountries = countries
  .filter((c) => c.active !== false && c.count === 0)
  .map((c) => ({ slug: c.slug, name: localizePlace(c.name, lang), iso2: c.iso2, guides: 0, esim: esimSlugs.has(c.slug), soon: true, img: '' }));
const groups = GROUP_ORDER.map((g) => ({
  key: g,
  label: H(({ east: 'gEast', sea: 'gSea', meca: 'gMeca', europe: 'gEurope', amoc: 'gAmoc', africa: 'gAfrica' } as const)[g as 'east']),
  items: [...pickCountries, ...soonCountries]
    .filter((c) => homeGroup(countriesData.countries.find((x) => x.slug === c.slug)?.continent, c.iso2) === g)
    .sort((a, b) => b.guides - a.guides),
})).filter((g) => g.items.length);

// ── One "fresh guides" list (was two, both all-German after a bulk publish) ──
const freshGuides = diverseNewest(posts.filter((p) => p.id !== cover?.id && trustworthyCard(p)), { n: 6 });

const koreaLinks = ['Seoul', 'Busan', 'Jeju', 'Gyeongju'];
const editorCountries = EDITOR_VISITED.filter((v) => !v.region).length;
---

<BaseLayout
  title={H('metaTitle')}
  description={H('metaDesc', { c: live.length })}
  image={cover?.data.heroImage?.url}
  localized={true}
>
  <section class="hero-wall hv3">
    <div class="wall-rows" aria-label={H('wallHint')} role="group">
      {[wallRow1, wallRow2].map((row, r) => (
        <div class:list={['wall-row', r === 0 ? 'r1' : 'r2']}>
          {/* The row is drawn twice for the endless scroll; the second copy is
              for the eye only (hidden from screen readers and the tab order).
              A phone shows two or three tiles, so only the first three load
              eagerly (24 images, ~1MB, on a 375px screen — 2026-08-22). */}
          {[...row, ...row].map((tile, i) => (
            <a class="wall-tile" href={tile.href} aria-hidden={i >= row.length ? 'true' : undefined} tabindex={i >= row.length ? -1 : undefined}>
              <img src={tile.img} alt={i >= row.length ? '' : tile.name} width="640" height="427" loading={r === 0 && i < 3 ? 'eager' : 'lazy'} decoding="async" />
              <span class="wall-cap"><b>{tile.name}</b><small>{tile.where}</small></span>
            </a>
          ))}
        </div>
      ))}
    </div>
    <div class="cover-scrim"></div>
    <div class="cover-inner wrap hv3-inner">
      <div class="hv3-copy">
        <h1>{H('h1')}</h1>
        <p class="cover-dek hv3-tag">{H('tag', { c: live.length, n: posts.length.toLocaleString(locale) })}</p>
        {/* The site's only search box — the header has none (Codex, 10-04). */}
        <Search placeholder={t('home.searchPlaceholder')} />
        <p class="hv3-hint">{H('wallHint')} →</p>
      </div>

      <div class="hv3-card" data-hero>
        <div class="hv3-tabs" role="tablist">
          <button type="button" role="tab" id="hv3-t0" aria-controls="hv3-p0" aria-selected="true" tabindex="0" data-tab="0">{H('tabWhere')}</button>
          <button type="button" role="tab" id="hv3-t1" aria-controls="hv3-p1" aria-selected="false" tabindex="-1" data-tab="1">{H('tabDecided')}</button>
          <button type="button" role="tab" id="hv3-t2" aria-controls="hv3-p2" aria-selected="false" tabindex="-1" data-tab="2">{H('tabTrip')}</button>
        </div>

