  <script>
    import { isOver } from '../lib/evDay';
    const DAY = 86_400_000;
    const n = new Date();
    const readerDay = Date.UTC(n.getFullYear(), n.getMonth(), n.getDate()) / DAY;
    const dayOf = (s?: string) => Date.parse(s || '') / DAY;

    // ── Hero selector ─────────────────────────────────────────────────────
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const raw = hero?.querySelector('[data-hero-json]')?.textContent;
    if (hero && raw) {
      const D = JSON.parse(raw);
      const fill = (tpl: string, v: Record<string, string | number>) => Object.entries(v).reduce((s, [k, x]) => s.split(`{${k}}`).join(String(x)), tpl);
      const tabs = [...hero.querySelectorAll<HTMLButtonElement>('[data-tab]')];
      const panels = [...hero.querySelectorAll<HTMLElement>('[data-panel]')];
      const showTab = (i: string) => {
        // Roving tab stop: Tab reaches the selected tab only, arrows move (Codex, 10-04).
        for (const b of tabs) { const on = b.dataset.tab === i; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; }
        for (const p of panels) p.classList.toggle('is-off', p.dataset.panel !== i);
      };
      tabs.forEach((b, k) => {
        b.addEventListener('click', () => showTab(b.dataset.tab || '0'));
        b.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          const nb = tabs[(k + step + tabs.length) % tabs.length];
          nb.focus(); showTab(nb.dataset.tab || '0');
        });
      });

      // Tab 1 — the reader's own month (the build may be on another one).
      let month = n.getMonth() + 1;
      const monthBtns = [...hero.querySelectorAll<HTMLButtonElement>('[data-months] [data-m]')];
      const pills = [...hero.querySelectorAll<HTMLAnchorElement>('[data-month-pills] [data-slug]')];
      const drawMonth = () => {
        for (const b of monthBtns) b.setAttribute('aria-pressed', String(Number(b.dataset.m) === month));
        for (const p of pills) {
          const band = (p.dataset.b || '').charAt(month - 1);
          p.className = `hv3-pill b-${band}`;
          p.href = `${D.base.wtg}${p.dataset.slug}/${D.monthSlugs[month - 1]}/`;
        }
      };
      for (const b of monthBtns) b.addEventListener('click', () => { month = Number(b.dataset.m); drawMonth(); });
      drawMonth();
      const on = monthBtns.find((b) => b.getAttribute('aria-pressed') === 'true');
      const row = on?.parentElement;
      if (on && row && row.scrollWidth > row.clientWidth) row.scrollLeft = on.offsetLeft - row.offsetLeft - 8;

      // Tabs 2 and 3 — one country choice, shared, remembered in this browser.
      const KEY = 'wa-home-country';
      let saved = '';
      try { saved = localStorage.getItem(KEY) || ''; } catch { /* private mode */ }
      const countrySels = [...hero.querySelectorAll<HTMLSelectElement>('[data-country]')];
      const monthSel = hero.querySelector<HTMLSelectElement>('[data-month]');
      if (monthSel) monthSel.value = String(month);
      let slug = saved && D.c[saved] ? saved : countrySels[0]?.value || '';
      const timeFmt = (tz: string) => new Intl.DateTimeFormat(document.documentElement.lang || undefined, { hour: 'numeric', minute: '2-digit', timeZone: tz }).format(new Date());
      const drawCountry = () => {
        const c = D.c[slug];
        if (!c) return;
        for (const s of countrySels) s.value = slug;
        const m = Number(monthSel?.value || month);
        const v = hero.querySelector<HTMLElement>('[data-verdict]');
        if (v) {
          const band = c.b ? c.b.charAt(m - 1) : '';
          v.className = `hv3-verdict${band ? ` b-${band}` : ''}`;
          v.querySelector('[data-v-head]')!.textContent = band ? fill(D.tpl.verdict, { country: c.n, month: D.months[m - 1], band: D.band[band] }) : c.n;
          v.querySelector('[data-v-climate]')!.textContent = c.cl ? fill(D.tpl.climate, { hi: c.cl[m - 1].hi, rain: c.cl[m - 1].rain, city: c.city }) : D.tpl.noClimate;
          (v.querySelector('[data-v-more]') as HTMLAnchorElement).href = c.b ? `${D.base.wtg}${slug}/${D.monthSlugs[m - 1]}/` : `${D.base.dest}${slug}/`;
        }
        const set = (k: string, href: string, text?: string) => {
          for (const a of hero.querySelectorAll<HTMLAnchorElement>(`[data-k="${k}"]`)) {
            a.href = href;
            const tx = a.querySelector('[data-k-text]');
            if (tx && text !== undefined) tx.textContent = text;
          }
        };
        set('guides', `${D.base.dest}${slug}/`, fill(D.tpl.guides, { n: c.g }));
        set('itin', c.itin ? c.itin.href : '#', c.itin ? fill(D.tpl.itin, { city: c.itin.city }) : '');
        for (const a of hero.querySelectorAll<HTMLElement>('[data-k="itin"]')) a.classList.toggle('is-off', !c.itin);
        set('visa', c.ess || `${D.base.visa}#c=${slug}`);
        set('esim', c.esim ? `${D.base.esim}${slug}/` : D.base.esim);
        set('closed', `${D.base.closed}?c=${encodeURIComponent(c.en)}`);
        set('emer', c.ess || `${D.base.emer}#c=${slug}`);
        const now = hero.querySelector<HTMLElement>('[data-now]');
        if (now) {
          now.hidden = !c.tz;
          if (c.tz) now.textContent = fill(D.tpl.nowIn, { city: c.tzc, time: timeFmt(c.tz) });
        }
      };
      for (const s of countrySels) s.addEventListener('change', () => {
        slug = s.value;
        try { localStorage.setItem(KEY, slug); } catch { /* private mode */ }
        drawCountry();
      });
      monthSel?.addEventListener('change', drawCountry);
      drawCountry();
    }

    // ── Long weekends: drop the ended ones by the reader's date ───────────
    const hol = document.querySelector<HTMLElement>('[data-hol]');
    if (hol) {
      let shown = 0;
      for (const li of hol.querySelectorAll<HTMLElement>('li[data-end]')) {
        const live = dayOf(li.dataset.end) >= readerDay && shown < 3;
        li.hidden = !live;
        if (live) {
          shown++;
          const nowOn = dayOf(li.dataset.start) <= readerDay;
          li.querySelector<HTMLElement>('[data-now-tag]')!.hidden = !nowOn;
        }
      }
      hol.hidden = shown === 0;
    }

    // ── Crowd demo: the venue's local time, and its hour lit ──────────────
    const crowd = document.querySelector<HTMLElement>('[data-crowd-tz]');
    if (crowd?.dataset.crowdTz) {
      const tz = crowd.dataset.crowdTz;
      const parts = new Intl.DateTimeFormat('en-US', { hour: 'numeric', hourCycle: 'h23', weekday: 'long', timeZone: tz }).formatToParts(new Date());
      const hour = Number(parts.find((p) => p.type === 'hour')?.value);
      const weekday = parts.find((p) => p.type === 'weekday')?.value || '';
      // The bar for the venue's own today; "now" only on a bar that is about today.
      const days = [...crowd.querySelectorAll<HTMLElement>('.crowd-day')];
      const today = days.find((d) => (d.dataset.days || '').split(',').includes(weekday));
      if (today) {
        for (const d of days) d.hidden = d !== today;
        today.querySelector(`.crowd-demo-bar i[data-h="${hour}"]`)?.classList.add('now');
      }
      const out = crowd.querySelector<HTMLElement>('[data-crowd-now]');
      if (out) {
        const time = new Intl.DateTimeFormat(document.documentElement.lang || undefined, { hour: 'numeric', minute: '2-digit', timeZone: tz }).format(new Date());
        out.textContent = (crowd.dataset.nowTpl || '').split('{city}').join(crowd.dataset.crowdCity || '').split('{time}').join(time);
        out.hidden = false;
      }
    }

    // ── "This month": the reader's month, picks not yet ended ─────────────
    {
      const key = `${n.getFullYear()}-${String(n.getMonth() + 1).padStart(2, '0')}`;
      // Ended where it happens, not on the reader's calendar (lib/evDay).
      const ended = (el: HTMLElement) => isOver(el.dataset.evEnd, el.dataset.tz);
      const sec = document.querySelector<HTMLElement>('[data-monthly]');
      if (sec) {
        const sets = new Set([...sec.querySelectorAll<HTMLElement>('[data-set]')].map((e) => e.dataset.set || ''));
        const use = sets.has(key) ? key : sec.dataset.build || key;
        for (const k of sec.querySelectorAll<HTMLElement>('.kicker[data-set]')) k.hidden = k.dataset.set !== use;
        let shown = 0;
        for (const c of sec.querySelectorAll<HTMLElement>('.story[data-set]')) {
          const on = c.dataset.set === use && !ended(c) && shown < 3;
          c.hidden = !on;
          if (on) shown++;
        }
        sec.hidden = shown < 2;
      }
    }

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      const els = Array.from(document.querySelectorAll('main .story, main .hv3-c, main .essential-card, main .card')) as HTMLElement[];
      els.forEach((el) => el.classList.add('js-reveal'));
      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('in'); obs.unobserve(e.target); } });
      }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
      els.forEach((el) => io.observe(el));
      setTimeout(() => els.forEach((el) => el.classList.add('in')), 1500);
    }
  </script>
</BaseLayout>

