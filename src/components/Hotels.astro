---
// Per-post "Where to stay" block. This Travelpayouts account has no dedicated
// hotel-search widget, and Hotels.com/Booking are locked until the site has 3
// months of stable traffic. Hotels are monetized through HOTELLOOK (Aviasales
// hotel meta-search — the marker below is 754088.hotels_widget). This comment
// used to say the block was "monetized through KLOOK", which the code below
// never matched — the 08-13 revenue audit flagged the mismatch as editor-trap
// doc rot. UPGRADE PLAN: switch to Hotels.com once traffic unlocks it (~3 months).
import Emoji from './Emoji.astro';
import { getLangFromUrl, useTranslations, klookLocale } from '../i18n/utils';
import { hotellookUrl } from '../lib/hotellook.mjs';
import { localizePlace } from '../i18n/places';
interface Props { city: string; country?: string }
const { city, country } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cityLabel = localizePlace(city, lang);
// Hotellook destination search (same surface as the other four hotel CTAs);
const href = hotellookUrl({ submarker: 'hotels_widget', lang, destination: city });
---
<section class="tp-hotels" data-affiliate-placement="hotels-widget">
  <div class="rule-head"><h2 class="kicker">{t('widget.whereToStay').replace('{city}', cityLabel)}</h2></div>
  <div class="hotels-cta">
    <span class="hotels-ico"><Emoji name="hotel" /></span>
    <div class="hotels-body">
      <p>{t('widget.hotelsDesc').replace('{city}', cityLabel)}</p>
      <a class="btn btn-primary" href={href} target="_blank" rel="sponsored noopener">{t('widget.searchHotels').replace('{city}', cityLabel)}</a>
    </div>
  </div>
  <p class="tp-disclosure">{t('widget.hotelsDisclosure')}</p>
</section>

<style>
  .hotels-cta {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 1.3rem 1.4rem;
    display: flex;
    align-items: flex-start;
    gap: 0.95rem;
  }
  .hotels-ico { flex: none; }
  .hotels-body { display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  .hotels-cta p { margin: 0; color: var(--muted); max-width: 46ch; }
</style>
