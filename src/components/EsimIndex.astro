---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { heroOf, TOOL_OG } from '../lib/toolOgPhoto.mjs';
import { siteHref } from '../lib/urls.mjs';
import Newsletter from './Newsletter.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';
import { localizePlace } from '../i18n/places';
import { esimCountries } from '../lib/esim-paths.mjs';
import { groupByRegion, carrierLine } from '../lib/esim-regions.mjs';
import { esimIndexT, type EsimIndexKey } from '../i18n/esim-index-strings';

// Hub for the per-country eSIM guides — the one page a crawler can reach every
// guide from. Countries appear here automatically when they gain a facts entry.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const ti = esimIndexT(lang);
const countries = esimCountries();
// Grouped by region so a visitor scans to their part of the world instead of
// reading a priority-ordered list of twenty cards that differ only by name.
const groups = groupByRegion(countries);

// "Which one suits you?" is the first question a first-time visitor has.
// No numbers, no prices (house rule: prices go stale; the country pages link
// to live pricing).
const options = [
  { id: 'esim', name: ti('esimName'), who: ti('esimFor'), pros: [ti('esimPro1'), ti('esimPro2')], cons: [ti('esimCon')] },
  { id: 'wifi', name: ti('wifiName'), who: ti('wifiFor'), pros: [ti('wifiPro1'), ti('wifiPro2')], cons: [ti('wifiCon')] },
  { id: 'roam', name: ti('roamName'), who: ti('roamFor'), pros: [ti('roamPro1')], cons: [ti('roamCon1'), ti('roamCon2')] },
];
// Only for the share image — see lib/toolOgPhoto.mjs.
const ogPosts = await getCollection('posts', ({ data }) => !data.draft);

const title = ti('title');
const dek = ti('dek');
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteHref(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: t('esim.indexMetaTitle'),
      description: t('esim.indexMetaDesc'),
      url: pageUrl,
      isPartOf: { '@id': `${site}/#site` },
    },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.home'), item: siteHref(localizePath('/', lang), Astro.site) },
      { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
    ] },
  ],
};
---

<BaseLayout image={heroOf(ogPosts, TOOL_OG.esim)} title={t('esim.indexMetaTitle')} description={t('esim.indexMetaDesc')} lang={lang} localized={true}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="esimi">
    <p class="eyebrow">{t('esim.eyebrow')}</p>
    <h1>{title}</h1>
    <p class="dek">{dek}</p>

    <section class="esimi-choose" aria-labelledby="esimi-choose-h">
      <h2 id="esimi-choose-h">{ti('chooseHeading')}</h2>
      <p class="esimi-sub">{ti('chooseDek')}</p>
      <div class="esimi-opts">
        {options.map((o) => (
          <div class={`esimi-opt esimi-opt--${o.id}`}>
            <h3>{o.name}</h3>
            <p class="esimi-who">{o.who}</p>
            <ul>
              {o.pros.map((x) => <li class="pro"><span aria-hidden="true">+</span>{x}</li>)}
              {o.cons.map((x) => <li class="con"><span aria-hidden="true">−</span>{x}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="esimi-countries" aria-labelledby="esimi-countries-h">
      <h2 id="esimi-countries-h">{ti('countriesHeading')}</h2>
      {groups.map((g) => (
        <div class="esimi-region">
          <h3>{ti(`region.${g.region}` as EsimIndexKey)}</h3>
          <ul class="esimi-pills">
            {g.countries.map((c) => {
              const carriers = carrierLine(c.facts?.carriers);
              return (
                <li>
                  <a class="esimi-pill" href={localizePath(`/tools/esim/${c.slug}`, lang)}>
                    <span class="esimi-code" aria-hidden="true">{String(c.iso2).toUpperCase()}</span>
                    <span class="esimi-body">
                      <strong>{localizePlace(c.name, lang)}</strong>
                      {carriers && <span class="esimi-carriers"><span class="sr-only">{ti('carriersLabel')}: </span>{carriers}</span>}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>
  </article>

  <Newsletter lang={lang} />
</BaseLayout>

<style>
  .esimi { max-width: var(--max); margin: 0 auto; padding: 2rem 1rem 0; }
  .eyebrow { color: var(--muted); font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 0.4rem; }
  .esimi h1 { margin: 0 0 0.5rem; }
  .dek { color: var(--muted); margin: 0 0 2rem; }
  .esimi h2 { margin: 0 0 0.35rem; }
  .esimi-sub { color: var(--muted); margin: 0 0 1rem; }

  /* Which one suits you? */
  .esimi-choose { margin: 0 0 2.5rem; }
  .esimi-opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 0.9rem; }
  .esimi-opt {
    padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: var(--r-md);
    background: var(--surface); border-top: 3px solid var(--accent);
  }
  .esimi-opt--wifi { border-top-color: var(--pine); }
  .esimi-opt--roam { border-top-color: var(--gold); }
  .esimi-opt h3 { margin: 0 0 0.25rem; font-size: 1.15rem; }
  .esimi-who { margin: 0 0 0.7rem; color: var(--ink-soft); font-weight: 600; font-size: 0.92rem; }
  .esimi-opt ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .esimi-opt li { display: flex; gap: 0.5rem; font-size: 0.9rem; line-height: 1.45; color: var(--ink); }
  .esimi-opt li span { flex: 0 0 1em; font-weight: 700; text-align: center; }
  .esimi-opt li.pro span { color: var(--pine); }
  .esimi-opt li.con span { color: var(--accent-text); }

  /* Countries by region */
  .esimi-region { margin: 1.1rem 0 1.6rem; }
  .esimi-region h3 {
    margin: 0 0 0.6rem; font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--muted); font-family: var(--font-body);
  }
  .esimi-pills {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 0.6rem;
  }
  .esimi-pill {
    display: flex; align-items: center; gap: 0.7rem; min-width: 0;
    padding: 0.6rem 0.9rem 0.6rem 0.6rem; border: 1px solid var(--line); border-radius: var(--r-lg);
    background: var(--surface); color: var(--ink); text-decoration: none; height: 100%;
  }
  .esimi-pill:hover, .esimi-pill:focus-visible { border-color: var(--accent); }
  .esimi-code {
    flex: 0 0 auto; display: inline-grid; place-items: center; width: 2.2rem; height: 2.2rem;
    border-radius: var(--r-pill); background: var(--surface-2); color: var(--ink-soft);
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em;
  }
  .esimi-pill:hover .esimi-code { background: var(--accent-soft); color: var(--accent-text); }
  .esimi-body { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .esimi-body strong { line-height: 1.25; }
  .esimi-carriers { color: var(--muted); font-size: 0.76rem; line-height: 1.3; overflow-wrap: anywhere; }
</style>
