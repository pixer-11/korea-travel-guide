---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';

// Public newsletter landing page (subscriber-growth research 2026-08-14):
// newsletter directories require a dedicated page with a sample-issue
// description, and it doubles as the invite link for outreach. Prose comes
// from the static-pages collection like /methodology; the live signup form
// renders below it.
const entry = await getEntry('staticPages', 'newsletter');
if (!entry) throw new Error('staticPages/newsletter is missing');
const { Content } = await render(entry);
const d = entry.data;
---

{/* The page IS the signup: the site-wide slide-in asked a reader who scrolled
    it to subscribe a second time (2026-10-05 audit). */}
<BaseLayout title={d.metaTitle} description={d.metaDescription} localized={true} suppressPopup={true}>
  <div class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{d.eyebrow}</p>
      <h1>{d.h1}</h1>
    </div>
  </div>
  <article class="article wrap">
    <div class="prose">
      <Content />
    </div>
  </article>
  <Newsletter lang="en" />
</BaseLayout>
