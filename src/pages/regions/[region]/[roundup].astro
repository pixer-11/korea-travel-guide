---
import { getCollection } from 'astro:content';
import RoundupHub from '../../../components/RoundupHub.astro';
import { slugifyRegion } from '../../../lib/slug';
import { buildRoundups } from '../../../lib/roundups.mjs';

// City roundup hubs: "N Best Restaurants in Busan", ranked from EXISTING venue
// posts. Auto-maintained — every build re-collects the city's posts and re-ranks
// them. Which (city, roundup) pairs qualify lives in src/lib/roundups.mjs, shared
// with the localized route so the two can never disagree about what exists.
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return buildRoundups(posts).map(({ region, key, cfg, items }) => ({
    params: { region: slugifyRegion(region), roundup: key },
    props: { region, key, items, cfg },
  }));
}

const { region, key, items, cfg } = Astro.props;
---

<RoundupHub region={region} key={key} items={items} cfg={cfg} lang="en" />
