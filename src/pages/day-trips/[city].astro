---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import { localizePlace } from '../../i18n/places';
import { slugifyRegion } from '../../lib/slug';
import { thumbOr } from '../../lib/wall';
import { buildDayTrips } from '../../lib/dayTrips';

// Day-trip hub (growth research B3): existing guides recombined by distance.
// See src/lib/dayTrips.ts for the quality gates that decide which hubs exist.
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return buildDayTrips(posts).map((hub) => ({ params: { city: hub.slug }, props: { hub } }));
}

const { hub } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cityLabel = localizePlace(hub.city, lang);

const metaTitle = t('detour.title').replace('{city}', cityLabel);
const metaDesc = t('detour.dek').replace('{city}', cityLabel);
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: metaTitle, description: metaDesc, url: pageUrl, isPartOf: { '@id': `${site}/#site` } },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('post.home'), item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: cityLabel, item: `${site}/regions/${hub.slug}/` },
        { '@type': 'ListItem', position: 3, name: t('detour.eyebrow'), item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout title={metaTitle} description={metaDesc} jsonLd={jsonLd} localized={true}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{t('detour.eyebrow')}</p>
      <h1>{metaTitle}</h1>
      <p class="region-blurb">{metaDesc}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {hub.neighbors.map((n) => (
        <div class="detour-group">
          <h2 class="detour-h">
            {localizePlace(n.region, lang)}
            <span class="detour-km">{t('detour.away').replace('{km}', String(n.km))}</span>
          </h2>
          <div class="grid">
            {n.posts.map((p) => (
              <PostCard
                href={`/posts/${p.id}/`}
                title={p.data.title}
                description={p.data.description}
                rating={p.data.place?.rating}
                region={localizePlace(p.data.region, lang)}
                category={p.data.category}
                image={thumbOr(p.data.heroImage?.url)}
                eventEndDate={p.data.eventEndDate}
              />
            ))}
          </div>
          <p class="detour-more">
            <a href={localizePath(`/regions/${slugifyRegion(n.region)}`, lang)}>{t('itin.moreRegion').replace('{region}', localizePlace(n.region, lang))} →</a>
          </p>
        </div>
      ))}
      <p class="detour-back">
        <a href={localizePath(`/regions/${hub.slug}`, lang)}>{t('itin.moreRegion').replace('{region}', cityLabel)} →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .detour-h { display: flex; align-items: baseline; gap: 0.7rem; margin: 0 0 1.1rem; font-size: 1.35rem; }
  .detour-km { font-size: 0.85rem; font-weight: 600; color: var(--muted); }
  .detour-group + .detour-group { margin-top: 2.6rem; }
  .detour-more { margin: 1rem 0 0; }
  .detour-more a, .detour-back a { color: var(--ink-soft); font-weight: 600; text-decoration: none; }
  .detour-more a:hover, .detour-back a:hover { color: var(--accent-text); }
  .detour-back { margin-top: 2.6rem; }
</style>
