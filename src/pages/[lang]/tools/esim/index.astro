---
import EsimIndex from '../../../../components/EsimIndex.astro';
import type { Lang } from '../../../../i18n/utils';

export function getStaticPaths() {
  return (['ko', 'ja', 'es', 'zh'] as Lang[]).map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
---

<EsimIndex lang={lang} />
