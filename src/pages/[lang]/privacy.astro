---
import { getEntry } from 'astro:content';
import LegalPage from '../../components/LegalPage.astro';
import type { Lang } from '../../i18n/utils';
export function getStaticPaths() {
  return (['ko', 'ja', 'es', 'zh'] as Lang[]).map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const entry = await getEntry('staticPages', 'privacy');
const translation = await getEntry('staticPagesI18n', `${lang}/privacy`);
---

<LegalPage entry={entry} translation={translation ?? null} lang={lang} kind="privacy" />
