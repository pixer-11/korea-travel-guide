---
import { getCollection } from 'astro:content';
import RoundupHub from '../../../../components/RoundupHub.astro';
import { slugifyRegion } from '../../../../lib/slug';
import { buildRoundups } from '../../../../lib/roundups.mjs';
import type { Lang } from '../../../../i18n/utils';

// Localized city roundup hubs: /ko/regions/busan/best-restaurants, /ja/…, etc.
// Qualification comes from src/lib/roundups.mjs, the same source the English
// route uses — otherwise a rule change lands in one of the two and the languages
// quietly stop matching.
export async function getStaticPaths() {
  const LANGS: Lang[] = ['ko', 'ja', 'es', 'zh'];
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const base = buildRoundups(posts);
  return LANGS.flatMap((lang) =>
    base.map(({ region, key, cfg, items }) => ({
      params: { lang, region: slugifyRegion(region), roundup: key },
      props: { region, key, items, cfg, lang },
    }))
  );
}

const { region, key, items, cfg, lang } = Astro.props;
---

<RoundupHub region={region} key={key} items={items} cfg={cfg} lang={lang} />
