---
import { getCollection } from 'astro:content';
import ContinentHub from '../../components/ContinentHub.astro';
import countriesData from '../../../data/countries.json';
// slugifyRegion, not an ad-hoc lowercase-and-dash: the sitemap keys these hubs
// by the same function, and a private copy is exactly how three region hubs
// ended up dated at a URL no route builds (2026-09-07).
import { slugifyRegion } from '../../lib/slug';

// One static page per continent that has any country in the data.
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const countFor = (name: string) => posts.filter((p) => (p.data.country ?? 'South Korea') === name).length;

  const byContinent: Record<string, any[]> = {};
  for (const c of countriesData.countries) {
    (byContinent[c.continent || 'Other'] ||= []).push({ ...c, count: countFor(c.name) });
  }
  return Object.entries(byContinent).map(([name, countries]) => ({
    params: { continent: slugifyRegion(name) },
    props: {
      continentName: name,
      countries: (countries as any[]).sort((a: any, b: any) => b.count - a.count || a.name.localeCompare(b.name)),
    },
  }));
}

const { continentName, countries } = Astro.props;
---

<ContinentHub continentName={continentName} countries={countries} lang="en" />
