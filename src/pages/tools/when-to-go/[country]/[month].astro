---
import WhenToGoPage from '../../../../components/WhenToGoPage.astro';
import { whenToGoPages } from '../../../../lib/when-to-go-paths.mjs';

// /tools/when-to-go/japan/march — one page per country × month, built from
// climate normals, public holidays and our own venue records.
export async function getStaticPaths() {
  return (await whenToGoPages()).map(({ countrySlug, monthSlug, data }) => ({
    params: { country: countrySlug, month: monthSlug },
    props: { data, countrySlug },
  }));
}

const { data, countrySlug } = Astro.props;
---

<WhenToGoPage data={data} countrySlug={countrySlug} lang="en" />
