---
import BaseLayout from '../../layouts/BaseLayout.astro';

// The crowd-data API was discontinued on 2026-09-26 at the data provider's
// request (see src/pages/api/crowd.json.ts for the reasons). This page stays
// because it is linked from outside (public-apis list, a few integrators):
// it says what happened and where to go instead. English-only, as before.
---

<BaseLayout title="Crowd data API (discontinued)" description="The Wander Atlas public crowd-data feed has been discontinued. Use the BestTime.app API for raw hourly data, or embed our crowd widgets." lang="en">
  <section class="section">
    <div class="wrap" style="max-width: 46rem">
      <p class="kicker gold">Developers</p>
      <h1>Crowd data API — discontinued</h1>
      <p>
        Our public JSON feed of quiet and busy hours (<code>/api/crowd.json</code>) was switched off on
        26 September 2026 at the request of the data provider, <a href="https://besttime.app" rel="noopener">BestTime.app</a>.
        The endpoint now returns an empty list with this notice.
      </p>
      <h2>What you can still use</h2>
      <ul>
        <li><strong>Embeddable crowd widgets</strong> — drop a live chart for a venue into your own page, with the source link visible: <a href="/tools/widget/">wanderatlasguides.com/tools/widget</a>.</li>
        <li><strong>Our guides and the crowd finder</strong> — the same quiet hours, read on the page: <a href="/tools/best-time/">wanderatlasguides.com/tools/best-time</a>.</li>
        <li><strong>Raw hourly data for your own app</strong> — get it directly from the <a href="https://besttime.app" rel="noopener">BestTime.app API</a>.</li>
      </ul>
      <p style="color: var(--muted); font-size: 0.92rem">Questions: <a href="/contact/">contact us</a>.</p>
    </div>
  </section>
</BaseLayout>
